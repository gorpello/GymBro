  "continueWorkoutBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The workout goes back to being in progress, with its sets already ticked. Finishing it again saves it on its original day."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيستأنف التمرين مع المجموعات المحددة مسبقًا. عند إنهائه مرة أخرى سيُحفظ بتاريخِه الأصلي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Training wird fortgesetzt und die Sätze bleiben markiert. Wenn du es erneut beendest, wird es am ursprünglichen Tag gespeichert."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El entreno vuelve a estar en curso, con sus series ya marcadas. Al terminarlo se guarda otra vez en su día."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "تمرین دوباره به حالت در حال انجام برمی‌گردد، با ست‌های انجام‌شده. تمام کردنش دوباره همان روز اصلی را ذخیره می‌کند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La séance repasse en cours avec les séries déjà cochées. En la terminant à nouveau, elle sera enregistrée à sa date d’origine."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'allenamento torna in corso, con le serie già spuntate. Finitolo di nuovo, viene salvato nel giorno originale."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "チェック済みのセットを保持したままワークアウトを再開します。再度終了すると元の日付で保存されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "체크된 세트를 유지한 채 운동이 다시 진행됩니다. 다시 종료하면 원래 날짜로 저장됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De training wordt hervat met de reeds afgevinkte sets. Als je hem opnieuw afrondt, wordt hij op de oorspronkelijke datum opgeslagen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Trening zostanie wznowiony z już zaznaczonymi seriami. Po ponownym zakończeniu zostanie zapisany z pierwotną datą."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
