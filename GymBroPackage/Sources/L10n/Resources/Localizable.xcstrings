  "noHistory": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No sessions logged yet. Train this exercise to build history."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد جلسات مسجلة بعد. تدرب على هذا التمرين لبناء السجل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Trainings protokolliert. Trainiere diese Übung, um einen Verlauf aufzubauen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay sesiones. Entrena este ejercicio para crear historial."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هنوز جلسه تمرینی ثبت نشده. این حرکت را تمرین کن تا تاریخچه ساخته شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucune séance enregistrée. Fais cet exercice pour créer un historique."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessuna sessione registrata. Allena questo esercizio per creare lo storico."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ記録がありません。この種目を行うと履歴が作成されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 기록된 운동이 없습니다. 이 운동을 수행해 기록을 쌓으세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nog geen trainingen gelogd. Train deze oefening om geschiedenis op te bouwen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nie zapisano jeszcze treningów. Wykonuj to ćwiczenie, aby zbudować historię."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há sessões registradas. Treine este exercício para criar um histórico."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренировок пока нет. Потренируй это упражнение, чтобы набрать историю."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Henüz antrenman kaydı yok. Geçmiş oluşturmak için bu egzersizi yap."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренувань ще не записано. Виконуй цю вправу, щоб з’явилася історія."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "暂无记录。开始练习此动作即可建立历史。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "尚無訓練紀錄。進行這個動作以建立歷史資料。"
     }
    }
