  "demoLoopHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plays for about 10 seconds and stops on the starting pose. Tap the demo to watch it again."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تتحرك نحو 10 ثوانٍ ثم تتوقف عند وضعية البداية. المس العرض لمشاهدته مرة أخرى."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Läuft etwa 10 Sekunden und bleibt in der Ausgangsposition stehen. Tippe auf die Demo, um sie erneut anzusehen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se mueve unos 10 segundos y se queda en la postura inicial. Toca la demo para volver a verla."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "حدود ۱۰ ثانیه پخش می‌شود و روی حالت شروع می‌ایستد. برای دیدن دوباره، روی نمایش بزنید."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tourne une dizaine de secondes puis s’arrête sur la position de départ. Touchez la démo pour la revoir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Si muove per circa 10 secondi e si ferma sulla posizione iniziale. Tocca la demo per rivederla."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "約10秒動いたあと、開始姿勢で止まります。もう一度見るにはデモをタップ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "약 10초 동안 움직인 뒤 시작 자세에서 멈춥니다. 다시 보려면 데모를 탭하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Speelt ongeveer 10 seconden en stopt in de beginhouding. Tik op de demo om hem opnieuw te zien."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Porusza się przez około 10 sekund i zatrzymuje w pozycji wyjściowej. Stuknij demo, aby obejrzeć je ponownie."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mexe-se durante cerca de 10 segundos e para na posição inicial. Toca na demo para a voltar a ver."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Двигается около 10 секунд и останавливается в исходной позе. Нажмите на демо, чтобы посмотреть снова."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Yaklaşık 10 saniye oynar ve başlangıç duruşunda durur. Tekrar izlemek için demoya dokun."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Рухається близько 10 секунд і зупиняється у вихідній позі. Торкніться демо, щоб переглянути знову."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "播放约 10 秒后停在起始姿势。点按演示可再次观看。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "播放約 10 秒後停在起始姿勢。點按示範即可再看一次。"
     }
    }
   }
  },
