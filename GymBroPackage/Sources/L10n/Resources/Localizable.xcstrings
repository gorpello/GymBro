  "planAskFirst": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If you don’t know my goal (strength, muscle, fat loss or general fitness) or how long each session can last, ask me first in one short message. Once you have it, answer with JSON only."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "إذا لم تكن تعرف هدفي (قوة أو عضل أو خسارة دهون أو لياقة عامة) أو مدة كل حصة، فاسألني أولًا برسالة قصيرة. بعدها أجب بـ JSON فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wenn du mein Ziel (Kraft, Muskeln, Fettabbau oder allgemeine Fitness) oder die Dauer einer Einheit nicht kennst, frag mich zuerst in einer kurzen Nachricht. Danach antworte nur mit JSON."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si no sabes mi objetivo (fuerza, músculo, perder grasa o forma general) o cuánto puede durar cada sesión, pregúntamelo primero en un mensaje corto. Cuando lo tengas, responde solo con JSON."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "اگر هدفم (قدرت، عضله، چربی‌سوزی یا آمادگی عمومی) یا مدت هر جلسه را نمی‌دانی، اول در یک پیام کوتاه بپرس. وقتی داشتی، فقط با JSON جواب بده."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Si tu ne connais pas mon objectif (force, muscle, perte de gras ou forme générale) ou la durée possible d’une séance, demande-le-moi d’abord en un court message. Ensuite, réponds uniquement en JSON."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se non conosci il mio obiettivo (forza, massa, dimagrimento o forma generale) o quanto può durare una sessione, chiedimelo prima con un breve messaggio. Poi rispondi solo in JSON."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "目標（筋力、筋肥大、減量、体力づくり）や1回の時間が分からなければ、まず短いメッセージで質問してください。分かったらJSONだけで答えてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 목표(근력, 근육, 체지방 감량, 전반적 체력)나 한 번에 운동할 수 있는 시간을 모르면 먼저 짧게 물어봐 주세요. 알게 되면 JSON으로만 답해 주세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Als je mijn doel (kracht, spiermassa, vetverlies of algemene fitheid) of de duur van een sessie niet weet, vraag het me eerst in één kort bericht. Antwoord daarna alleen met JSON."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeśli nie znasz mojego celu (siła, mięśnie, redukcja lub ogólna forma) albo długości sesji, najpierw zapytaj mnie krótko. Potem odpowiedz wyłącznie w JSON."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Se não souberes o meu objetivo (força, músculo, perder gordura ou forma geral) ou quanto pode durar cada sessão, pergunta-me primeiro numa mensagem curta. Depois responde só com JSON."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если ты не знаешь мою цель (сила, мышцы, сжигание жира или общая форма) или сколько может длиться тренировка, сначала спроси меня одним коротким сообщением. Потом отвечай только JSON."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hedefimi (güç, kas, yağ yakımı ya da genel form) veya bir seansın ne kadar sürebileceğini bilmiyorsan önce bana kısa bir mesajla sor. Sonra yalnızca JSON ile cevap ver."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Якщо ти не знаєш моєї мети (сила, м’язи, схуднення чи загальна форма) або тривалості тренування, спершу спитай мене одним коротким повідомленням. Потім відповідай лише JSON."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "如果你不知道我的目标（力量、增肌、减脂或一般体能）或每次能练多久，请先用一条简短消息问我。知道后只用 JSON 回答。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "如果你不知道我的目標（力量、增肌、減脂或一般體能）或每次能練多久，請先用一則簡短訊息問我。知道後只用 JSON 回答。"
     }
    }
   }
  },
