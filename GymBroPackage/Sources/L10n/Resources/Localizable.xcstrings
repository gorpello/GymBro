  },
  "noteEmptyBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cues, plans for next time, how a session felt — with photos or video if you want."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل الملاحظات وخطط المرة القادمة وشعورك بعد التمرين — مع صور أو فيديو إن أردت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinweise, Pläne fürs nächste Mal, wie sich ein Training angefühlt hat — mit Fotos oder Video, wenn du möchtest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Claves, planes para la próxima, cómo te fue la sesión — con fotos o vídeo si quieres."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "نکته، برنامه برای دفعه بعد، حس جلسه تمرین — با عکس یا ویدیو اگر بخواهی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Conseils, plan pour la prochaine fois, ressenti d’une séance — avec photos ou vidéo si tu veux."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spunti, piani per la prossima volta, come è andata — con foto o video se vuoi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "コツ、次回の計画、ワークアウトの感覚など — 必要なら写真や動画も添付できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "팁, 다음 계획, 운동 느낌 등을 기록하세요 — 원하면 사진이나 동영상도 첨부할 수 있습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Tips, plannen voor de volgende keer, hoe een training voelde — met foto's of video als je wilt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wskazówki, plany na następny raz, odczucia po treningu — opcjonalnie ze zdjęciami lub filmem."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Dicas, planos para a próxima vez, como foi a sessão — com fotos ou vídeo, se desejar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Подсказки, планы на следующий раз, ощущения от тренировки — с фото или видео, если хочешь."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "İpuçları, bir sonraki plan, antrenmanın nasıl hissettirdiği — istersen fotoğraf veya video ile."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Підказки, плани на наступний раз, відчуття від тренування — за бажанням із фото чи відео."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "随手记录要领心得、下次训练计划或体感状态，支持附带照片与视频。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "記錄提示、下次計畫、訓練感受 — 想的話也可附上照片或影片。"
     }
    }
   }
  },
