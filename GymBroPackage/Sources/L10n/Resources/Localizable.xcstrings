  "measuresHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Neck to calf — watch your body change, not just the bar."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "من الرقبة إلى ربلة الساق — راقب تغير جسمك لا البار فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Vom Hals bis zur Wade — beobachte, wie sich dein Körper verändert, nicht nur die Hantel."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Del cuello al gemelo — mira cómo cambia tu cuerpo, no solo la barra."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "از گردن تا ساق — بدنت را ببین، نه فقط میله را."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Du cou aux mollets — observe l’évolution de ton corps, pas seulement celle de la barre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dal collo al polpaccio — guarda come cambia il corpo, non solo il bilanciere."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "首からふくらはぎまで — バーの重量だけでなく体の変化も追跡。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "목부터 종아리까지 — 바벨 무게뿐 아니라 몸의 변화도 확인하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Van nek tot kuit — volg hoe je lichaam verandert, niet alleen het gewicht op de stang."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Od szyi po łydkę — obserwuj zmiany ciała, nie tylko ciężar na sztandze."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Do pescoço à panturrilha — veja as mudanças no seu corpo, não apenas na barra."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "От шеи до икр — следи, как меняется тело, а не только штанга."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Boyundan baldıra — yalnızca barı değil, vücudundaki değişimi de izle."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Від шиї до литки — стеж за змінами тіла, а не лише за штангою."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从颈围到小腿围，见证肉眼可见的身材蜕变，不仅关注杠铃重量。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "從頸部到小腿 — 不只看槓鈴，也觀察身體的變化。"
     }
    }
   }
  },
