  "awardTonne1Line": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A thousand kilos lifted across your sets."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "رفعت ألف كيلوغرام إجمالًا عبر مجموعاتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Über deine Sätze hast du tausend Kilo bewegt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mil kilos levantados entre todas tus series."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هزار کیلو در ست‌هایت جابه‌جا شد."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mille kilos soulevés au total sur tes séries."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mille chili sollevati tra tutte le tue serie."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "セット合計で1,000kgを持ち上げました。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "세트 전체에서 총 1,000kg을 들었습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "In totaal duizend kilo getild over al je sets."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Łącznie tysiąc kilogramów podniesionych w seriach."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mil quilos levantados entre todas as suas séries."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тысяча килограммов, поднятая за все подходы."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Setlerinde toplam bin kilo kaldırdın."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Загалом тисячу кілограмів піднято за підходи."
