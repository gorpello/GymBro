  "tapToEdit": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap the pencil to fix an entry, or the bin to remove it."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اضغط على القلم لتعديل الإدخال أو سلة المهملات لحذفه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Tippe auf den Stift, um einen Eintrag zu korrigieren, oder auf den Papierkorb, um ihn zu entfernen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca el lápiz para corregir algo mal anotado, o la papelera para quitarlo."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "مداد را برای اصلاح لمس کن، یا سطل را برای حذف."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touche le crayon pour corriger une entrée ou la corbeille pour la supprimer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca la matita per correggere una voce, o il cestino per rimuoverla."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "鉛筆をタップして記録を修正、ゴミ箱で削除します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연필을 탭해 항목을 수정하거나 휴지통을 탭해 삭제하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Tik op het potlood om een invoer te corrigeren of op de prullenbak om hem te verwijderen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Dotknij ołówka, aby poprawić wpis, lub kosza, aby go usunąć."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque no lápis para consertar uma entrada ou na lixeira para removê-la."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нажми на карандаш, чтобы исправить запись, или на корзину, чтобы удалить."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bir kaydı düzeltmek için kaleme, silmek için çöp kutusuna dokun."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Торкнися олівця, щоб виправити запис, або кошика, щоб видалити."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "点击铅笔修改记录，点击垃圾桶删除。"
