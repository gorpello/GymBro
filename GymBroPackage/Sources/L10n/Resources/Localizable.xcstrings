  "mathInsideWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Volume, records and streaks come from your own sets. Nothing here is decoration."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يتم حساب الحجم والأرقام القياسية والمجموعات من بياناتك أنت. لا شيء للزينة فقط."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Volumen, Rekorde und Serien stammen aus deinen eigenen Sätzen. Nichts hier ist bloße Dekoration."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El volumen, los récords y la racha salen de tus series. Aquí no hay nada decorativo."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "حجم، رکورد و استریک از ست‌های خودت می‌آید. اینجا چیزی تزئینی نیست."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Volume, records et séries sont calculés à partir de tes propres données. Rien n’est là pour faire joli."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Volume, record e serie vengono dalle tue serie. Qui niente è decorazione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ボリューム、記録、セットはあなた自身のデータから計算されます。見た目だけの数字はありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "볼륨, 기록, 세트는 사용자의 실제 데이터로 계산됩니다. 장식용 수치는 없습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Volume, records en sets worden uit je eigen gegevens berekend. Niets is alleen voor de sier."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Objętość, rekordy i serie są liczone z twoich danych. Nic nie jest tylko ozdobą."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Volume, recordes e sequências vêm das suas próprias séries. Nada aqui é falso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Объём, рекорды и серии считаются по твоим подходам. Здесь ничего не нарисовано для красоты."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hacim, rekorlar ve seriler kendi setlerinden hesaplanır. Buradaki hiçbir şey göstermelik değil."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Обсяг, рекорди й підходи розраховуються з твоїх даних. Нічого просто для краси."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "容量、纪录和打卡连胜均由你的真实训练组数如实计算，绝无虚饰。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "訓練量、紀錄與組數都依你的資料計算，沒有只是裝飾的數字。"
     }
    }
   }
  },
