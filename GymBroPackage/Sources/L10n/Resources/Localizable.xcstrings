     "stringUnit": {
      "state": "translated",
      "value": "운동의 마지막 세트를 체크하면 자동으로 다음 운동으로 넘어갑니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wanneer de laatste set van een oefening is afgevinkt, gaat de training automatisch naar de volgende."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Po zaznaczeniu ostatniej serii ćwiczenia trening automatycznie przejdzie dalej."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ao marcar a última série de um exercício, o treino passa para o próximo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Когда отметишь последний подход упражнения, тренировка перейдёт к следующему."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bir egzersizin son seti işaretlendiğinde antrenman otomatik olarak sonrakine geçer."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Коли останній підхід вправи позначено, тренування автоматично переходить до наступної."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "勾选一个动作的最后一组后，训练会自动进入下一个动作。"
     }
    },
