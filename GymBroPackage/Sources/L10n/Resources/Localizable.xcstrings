  "onbGoalWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sets your weekly goal ring. Be honest, not ambitious."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يحدد هدفك الأسبوعي. كن واقعيًا ولا تبالغ في الطموح."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Legt deinen wöchentlichen Zielring fest. Sei ehrlich, nicht ehrgeizig."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Define tu anillo de objetivo semanal. Sé sincero, no ambicioso."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "حلقه هدف هفتگی‌ات را تنظیم می‌کند. صادق باش، نه بلندپرواز."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Définit ton objectif hebdomadaire. Sois réaliste, pas trop ambitieux."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta l'anello dell'obiettivo settimanale. Sii onesto, non ambizioso."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "週間目標を設定します。無理のない現実的な回数にしましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "주간 목표를 설정합니다. 너무 무리하지 말고 현실적으로 정하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Stelt je weekdoel in. Wees realistisch, niet te ambitieus."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ustala cel tygodniowy. Bądź realistą, nie przesadzaj z ambicją."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Define sua meta semanal. Seja honesto, não ambicioso."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Задаёт кольцо недельной цели. Будь честен, а не амбициозен."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Haftalık hedef halkasını belirler. İddialı değil, gerçekçi ol."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Встановлює тижневу ціль. Будь реалістичним, не надто амбітним."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用于设定每周目标环。诚实记录，量力而行。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "設定每週目標。請務實，不要過度勉強。"
     }
    }
   }
  },
