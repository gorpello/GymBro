  "noStepsYet": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No steps yet. Write your own so you remember how you do it."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا توجد خطوات بعد. اكتب خطواتك لتتذكر كيف تؤديه."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Schritte. Schreib deine eigenen auf, damit du dich erinnerst, wie du sie machst."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no hay pasos. Escribe los tuyos para acordarte de cómo lo haces."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هنوز گامی نیست. مال خودت را بنویس تا یادت بماند چطور می‌زنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas encore d'étapes. Écris les tiennes pour te rappeler comment tu le fais."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancora nessun passaggio. Scrivi i tuoi per ricordare come lo esegui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ手順がありません。やり方を忘れないよう自分で書いておきましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 단계가 없어요. 어떻게 하는지 기억하도록 직접 적어 보세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nog geen stappen. Schrijf je eigen stappen op zodat je onthoudt hoe je het doet."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Brak kroków. Zapisz własne, żeby pamiętać, jak to robisz."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não há passos. Escreva os seus para lembrar como você faz."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Шагов пока нет. Запиши свои, чтобы не забыть, как ты это делаешь."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Henüz adım yok. Nasıl yaptığını hatırlamak için kendi adımlarını yaz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Кроків ще немає. Запишіть свої, щоб пам'ятати, як ви це робите."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有步骤。写下你自己的做法，方便以后回顾。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "還沒有步驟。寫下你自己的做法，免得忘記。"
     }
    }
   }
  },
