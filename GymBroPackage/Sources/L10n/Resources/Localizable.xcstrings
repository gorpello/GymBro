  "shareHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The card is built on your phone. Nothing leaves until you pick where it goes."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يتم إنشاء البطاقة على هاتفك. لا يغادر شيء الهاتف حتى تختار وجهة الإرسال."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Karte wird auf deinem Handy erstellt. Nichts verlässt es, bevor du auswählst, wohin sie soll."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La lámina se monta en tu móvil. No sale nada hasta que tú elijas dónde va."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "کارت روی گوشی‌ات ساخته می‌شود. تا جایی را انتخاب نکنی چیزی بیرون نمی‌رود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La carte est créée sur ton téléphone. Rien ne sort tant que tu ne choisis pas où l’envoyer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La scheda nasce sul tuo telefono. Niente esce finché non scegli tu dove mandarla."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "カードは端末上で作成されます。共有先を選ぶまで外部には送られません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "카드는 휴대전화에서 생성됩니다. 공유할 곳을 선택하기 전까지 아무것도 밖으로 나가지 않습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De kaart wordt op je telefoon gemaakt. Niets verlaat je telefoon totdat je kiest waarheen je hem stuurt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Karta powstaje na telefonie. Nic go nie opuszcza, dopóki nie wybierzesz, gdzie ją wysłać."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O cartão é criado no seu celular. Nada sai de lá até que você escolha para onde vai."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Карточка собирается на твоём телефоне. Никуда ничего не уйдёт, пока сам не выберешь куда."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Kart telefonunda oluşturulur. Nereye göndereceğini seçene kadar hiçbir şey dışarı çıkmaz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Картка створюється на телефоні. Нічого не залишає його, доки ти не вибереш, куди надіслати."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "卡片本地生成。未经允许，不会外传。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "卡片在你的手機上建立。直到你選擇傳送位置前，任何內容都不會離開手機。"
     }
    }
   }
  },
