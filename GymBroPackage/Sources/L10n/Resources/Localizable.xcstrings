  "onbPlaceTitle": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Where do you train?"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أين تتمرن؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wo trainierst du?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "¿Dónde entrenas?"
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "کجا تمرین می‌کنی؟"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Où t'entraînes-tu ?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dove ti alleni?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "どこでトレーニングしますか？"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "어디서 운동하나요?"
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Waar train je?"
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Gdzie trenujesz?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Onde você treina?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Где ты тренируешься?"
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Nerede antrenman yapıyorsun?"
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Де ви тренуєтеся?"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "你在哪里训练？"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "你在哪裡訓練？"
     }
    }
   }
  },
  "onbPlaceWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick every place you train. We'll only suggest what you can do in each one."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر كل الأماكن التي تتمرن فيها. سنقترح فقط ما يمكنك فعله في كل منها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle alle Orte, an denen du trainierst. Wir schlagen nur vor, was du dort jeweils machen kannst."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marca todos los sitios donde entrenas. Solo te propondremos lo que puedas hacer en cada uno."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هر جایی که تمرین می‌کنی را انتخاب کن. فقط چیزهایی را پیشنهاد می‌دهیم که آنجا می‌توانی بزنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisis tous les lieux où tu t'entraînes. On ne te proposera que ce que tu peux faire dans chacun."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna tutti i posti dove ti alleni. Ti proporremo solo quello che puoi fare in ognuno."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "トレーニングする場所をすべて選んでください。それぞれの場所でできる種目だけを提案します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "운동하는 장소를 모두 골라 주세요. 장소마다 할 수 있는 운동만 추천할게요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Kies alle plekken waar je traint. We stellen alleen voor wat je op elke plek kunt doen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zaznacz wszystkie miejsca, w których trenujesz. Zaproponujemy tylko to, co możesz zrobić w każdym z nich."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Marque todos os lugares onde você treina. Só vamos sugerir o que dá para fazer em cada um."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отметь все места, где тренируешься. Предложим только то, что можно сделать в каждом."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Antrenman yaptığın tüm yerleri seç. Her birinde yapabileceklerini önereceğiz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Познач усі місця, де тренуєшся. Пропонуватимемо лише те, що можна зробити в кожному."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "选出你训练的所有地点。我们只推荐你在每个地点能做的动作。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "選出你訓練的所有地點。我們只會推薦你在每個地點能做的動作。"
     }
    }
   }
  },
