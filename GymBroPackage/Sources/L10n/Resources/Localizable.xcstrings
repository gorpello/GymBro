  "timelineHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Same pose, same spot, same light. In a year you will not believe it."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "نفس الوضعية والمكان والإضاءة. بعد سنة لن تصدق الفرق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gleiche Pose, gleicher Ort, gleiches Licht. In einem Jahr wirst du es kaum glauben."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Misma pose, mismo sitio, misma luz. Dentro de un año no te lo vas a creer."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "همان ژست، همان جا، همان نور. یک سال بعد باور نمی‌کنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Même pose, même endroit, même lumière. Dans un an, tu n’en reviendras pas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stessa posa, stesso posto, stessa luce. Tra un anno non ci crederai."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "同じポーズ、同じ場所、同じ光。1年後、きっと驚きます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "같은 포즈, 같은 장소, 같은 조명. 1년 뒤에는 믿기 어려울 거예요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zelfde pose, zelfde plek, zelfde licht. Over een jaar geloof je je ogen niet."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ta sama poza, to samo miejsce, to samo światło. Za rok nie uwierzysz."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Mesma pose, mesmo lugar, mesma luz. Daqui a um ano você não vai acreditar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Та же поза, то же место, тот же свет. Через год сам не поверишь."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aynı poz, aynı yer, aynı ışık. Bir yıl sonra inanamayacaksın."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Та сама поза, те саме місце, те саме світло. За рік не повіриш."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同姿态、同机位、同光线。坚持一年，震撼由心而生。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "相同姿勢、相同地點、相同光線。一年後你會難以置信。"
     }
    }
   }
  },
