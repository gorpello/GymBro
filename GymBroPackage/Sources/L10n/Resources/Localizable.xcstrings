  "exerciseTypeHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cardio like running or swimming logs distance and time. Holds like a plank log time."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الكارديو مثل الجري أو السباحة يسجل المسافة والوقت. تمارين الثبات مثل البلانك تسجل الوقت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Cardio wie Laufen oder Schwimmen erfasst Distanz und Zeit. Halteübungen wie der Plank nur die Zeit."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El cardio, como correr o nadar, apunta distancia y tiempo. Los isométricos, como la plancha, solo tiempo."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "کاردیو مثل دویدن یا شنا مسافت و زمان ثبت می‌کند. نگه‌داشتن مثل پلانک فقط زمان."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le cardio comme la course ou la natation enregistre distance et temps. Les gainages comme la planche enregistrent le temps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il cardio, come correre o nuotare, registra distanza e tempo. Le tenute, come il plank, solo il tempo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ランニングや水泳などの有酸素は距離と時間を記録します。プランクのようなキープ系は時間を記録します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "달리기나 수영 같은 유산소는 거리와 시간을 기록해요. 플랭크 같은 버티기 운동은 시간을 기록해요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Cardio zoals hardlopen of zwemmen legt afstand en tijd vast. Houdingen zoals de plank leggen tijd vast."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Cardio, jak bieganie czy pływanie, zapisuje dystans i czas. Pozycje statyczne, jak deska, zapisują czas."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cardio, como correr ou nadar, registra distância e tempo. Isometrias, como a prancha, só tempo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Кардио, например бег или плавание, записывается дистанцией и временем. Статика, как планка, — временем."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Koşu veya yüzme gibi kardiyo mesafe ve süre kaydeder. Plank gibi duruşlar süre kaydeder."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Кардіо, як біг чи плавання, записує дистанцію й час. Статичні вправи, як планка, записують час."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跑步、游泳等有氧记录距离和时间；平板支撑等静态动作只记录时间。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "跑步或游泳等有氧運動記錄距離和時間。平板支撐等靜態動作記錄時間。"
     }
    }
   }
  },
