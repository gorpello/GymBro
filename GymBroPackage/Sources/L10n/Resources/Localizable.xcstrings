  "tplAbcd": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Four days: chest and triceps, back and biceps, legs, shoulders and abs."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أربعة أيام: صدر وترايسبس، ظهر وبايسبس، أرجل، أكتاف وبطن."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Vier Tage: Brust und Trizeps, Rücken und Bizeps, Beine, Schultern und Bauch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuatro días: pecho y tríceps, espalda y bíceps, pierna, hombro y abdomen."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "چهار روز: سینه و پشت‌بازو، پشت و جلو‌بازو، پا، شانه و شکم."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Quatre jours : pecs et triceps, dos et biceps, jambes, épaules et abdos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quattro giorni: petto e tricipiti, schiena e bicipiti, gambe, spalle e addome."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "4日：胸と三頭、背中と二頭、脚、肩と腹筋。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "4일: 가슴과 삼두, 등과 이두, 하체, 어깨와 복근."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Vier dagen: borst en triceps, rug en biceps, benen, schouders en buik."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Cztery dni: klatka i triceps, plecy i biceps, nogi, barki i brzuch."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Quatro dias: peito e tríceps, costas e bíceps, pernas, ombros e abdômen."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Четыре дня: грудь и трицепс, спина и бицепс, ноги, плечи и пресс."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Dört gün: göğüs ve arka kol, sırt ve ön kol, bacak, omuz ve karın."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Чотири дні: груди й трицепс, спина й біцепс, ноги, плечі й прес."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "四天：胸+三头、背+二头、腿、肩+腹。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "四天：胸和三頭、背和二頭、腿、肩和腹。"
     }
    }
   }
  },
  "tplAbcde": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Five days, one muscle group each: chest, back, legs, shoulders, arms."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "خمسة أيام، مجموعة عضلية لكل يوم: صدر، ظهر، أرجل، أكتاف، ذراعان."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Fünf Tage, je eine Muskelgruppe: Brust, Rücken, Beine, Schultern, Arme."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cinco días, un grupo cada uno: pecho, espalda, pierna, hombro y brazos."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "پنج روز، هر کدام یک گروه عضلانی: سینه، پشت، پا، شانه، بازو."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cinq jours, un groupe par jour : pecs, dos, jambes, épaules, bras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cinque giorni, un gruppo ciascuno: petto, schiena, gambe, spalle, braccia."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "5日、1日1部位：胸、背中、脚、肩、腕。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "5일, 하루 한 부위: 가슴, 등, 하체, 어깨, 팔."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Vijf dagen, één spiergroep per dag: borst, rug, benen, schouders, armen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Pięć dni, jedna partia dziennie: klatka, plecy, nogi, barki, ramiona."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Cinco dias, um grupo em cada: peito, costas, pernas, ombros, braços."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пять дней, по группе мышц на каждый: грудь, спина, ноги, плечи, руки."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Beş gün, her gün bir kas grubu: göğüs, sırt, bacak, omuz, kol."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "П'ять днів, одна група на день: груди, спина, ноги, плечі, руки."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "五天，每天一个部位：胸、背、腿、肩、手臂。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "五天，每天一個部位：胸、背、腿、肩、手臂。"
     }
    }
   }
  },
