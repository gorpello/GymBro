  "awardSets1000Line": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One set at a time, a thousand of them."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مجموعة تلو الأخرى حتى الألف."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ein Satz nach dem anderen, tausend davon."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Serie a serie, hasta mil."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "یکی‌یکی، هزار تا از آن‌ها."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Une série à la fois, jusqu’à mille."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una serie alla volta, fino a mille."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1セットずつ積み上げて1,000へ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "한 세트씩 쌓아 1,000세트까지."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Eén set tegelijk, tot duizend."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Seria po serii, aż do tysiąca."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Série a série, até mil."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "По одному подходу за раз — и вот их тысяча."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Her seferinde bir set; toplamda bin set."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Підхід за підходом, аж до тисячі."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一组一组，累积到一千组。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "一組一組累積到一千。"
     }
    }
   }
  },
