  "compareNeedTwo": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shoot the same pose on two different days and you can compare them here."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "التقط نفس الوضعية في يومين مختلفين لتتمكن من المقارنة هنا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nimm dieselbe Pose an zwei verschiedenen Tagen auf, um sie hier zu vergleichen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz la misma pose en dos días distintos y aquí las comparas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "همان ژست را در دو روز مختلف بگیر تا اینجا مقایسه کنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Prends la même pose à deux dates différentes pour pouvoir les comparer ici."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scatta la stessa posa in due giorni diversi e potrai confrontarle qui."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "同じポーズを別の日に2回撮ると、ここで比較できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "같은 포즈를 서로 다른 두 날에 촬영하면 여기서 비교할 수 있습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Maak dezelfde pose op twee verschillende dagen en vergelijk ze hier."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zrób tę samą pozę w dwa różne dni, aby porównać je tutaj."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Fotografe a mesma pose em dois dias diferentes e compare elas aqui."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сними одну и ту же позу в два разных дня — и сможешь сравнить их здесь."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aynı pozu iki farklı günde çek, burada karşılaştırabilirsin."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Зніми ту саму позу у два різні дні, щоб порівняти їх тут."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在不同日期拍摄同一姿态的照片，即可在此左右同屏对比。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "在不同的兩天拍攝相同姿勢，就能在這裡比較。"
     }
    }
   }
  },
