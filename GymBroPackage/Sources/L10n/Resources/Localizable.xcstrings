  "freeForeverWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No subscription, no ads, nothing locked behind a paywall."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا اشتراك ولا إعلانات ولا ميزات محجوبة بالدفع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kein Abo, keine Werbung, nichts hinter einer Bezahlschranke."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin suscripción, sin anuncios, nada escondido tras un muro de pago."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بدون اشتراک، بدون تبلیغ، بدون پرداخت اجباری."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Pas d’abonnement, pas de pub, rien de bloqué derrière un paiement."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun abbonamento, nessuna pubblicità, niente bloccato a pagamento."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "サブスクなし、広告なし、課金でロックされる機能なし。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "구독 없음, 광고 없음, 유료 잠금 없음."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Geen abonnement, geen advertenties, niets achter een betaalmuur."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Bez subskrypcji, bez reklam, bez płatnych blokad."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
