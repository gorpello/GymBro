  "fullyOfflineWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No account, no servers. Your training never leaves this phone."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا حساب ولا خادم. تمارينك لا تغادر هذا الهاتف أبدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kein Konto, keine Server. Dein Training verlässt dieses Handy nie."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin cuenta, sin servidores. Tu entreno no sale de este móvil."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بدون حساب، بدون سرور. تمرینت هرگز از این گوشی خارج نمی‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun compte, aucun serveur. Tes entraînements ne quittent jamais ce téléphone."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun account, nessun server. I tuoi allenamenti non lasciano mai questo telefono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アカウントもサーバーも不要。ワークアウトデータはこの端末から出ません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계정도 서버도 없습니다. 운동 데이터는 이 휴대전화 밖으로 나가지 않습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Geen account, geen server. Je trainingen verlaten deze telefoon nooit."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Bez konta, bez serwera. Twoje treningi nigdy nie opuszczają telefonu."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem conta, sem servidores. Seu treino nunca sai deste celular."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Без аккаунта и серверов. Твои тренировки не покидают этот телефон."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hesap yok, sunucu yok. Antrenman verilerin bu telefondan asla çıkmaz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Без облікового запису й серверів. Тренування ніколи не залишають телефон."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "无账号、无服务器。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "不需帳號、不連伺服器。你的訓練資料永遠不會離開這支手機。"
     }
    }
   }
  },
