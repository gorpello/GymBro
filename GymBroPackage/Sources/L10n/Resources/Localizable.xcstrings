  "liveChannelWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shows the current exercise, set and rest timer while you train"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يعرض التمرين الحالي والمجموعة ومؤقت الراحة أثناء التمرين"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
