  "dropExerciseBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" leaves this workout. Nothing logged is lost."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستتم إزالة \"%@\" من هذا التمرين. لن تفقد أي بيانات مسجلة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" wird aus diesem Training entfernt. Nichts Protokolliertes geht verloren."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" sale de este entreno. No se pierde nada de lo anotado."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "«%@» از این تمرین خارج می‌شود. چیزی که ثبت شده از بین نمی‌رود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« %@ » sera retiré de cette séance. Rien de déjà enregistré ne sera perdu."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" esce da questo allenamento. Niente di registrato va perso."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%@」をこのワークアウトから外します。記録済みの内容は失われません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”을 이 운동에서 뺍니다. 이미 기록된 내용은 유지됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "‘%@’ wordt uit deze training verwijderd. Reeds gelogde gegevens blijven behouden."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "„%@” zostanie usunięte z treningu. Zapisane dane nie zostaną utracone."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" sai deste treino. Nenhum registro será perdido"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "«%@» уйдёт из этой тренировки. Ничего записанного не потеряется."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@” bu antrenmandan çıkarılacak. Kaydedilen hiçbir şey kaybolmaz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "«%@» буде вилучено з тренування. Уже записані дані не втратяться."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@” 将从本次训练中移除，已记录的数据不会丢失。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "「%@」會從這次訓練移除。已記錄的內容不會遺失。"
     }
    }
   }
  },
