      "value": "لم يُكتب شيء بعد"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch nichts geschrieben"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todavía no has escrito nada"
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هنوز چیزی نوشته نشده"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Rien d’écrit pour l’instant"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non hai ancora scritto niente"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ何も書かれていません"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 작성된 내용이 없습니다"
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nog niets opgeschreven"
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Jeszcze nic nie zapisano"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Nada escrito ainda"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Пока ничего не записано"
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Henüz hiçbir şey yazılmadı"
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Поки нічого не записано"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "暂无备忘内容"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "尚無任何筆記"
     }
    }
