  "skipExerciseBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "You haven't marked any set as done, so nothing gets logged for \"%@\"."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم تحدد أي مجموعة كمكتملة، لذلك لن يتم تسجيل شيء لـ \"%@\"."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Du hast keine Sätze als fertig markiert, nicht wird gespeichert für \"%@\"."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No has marcado ninguna serie, así que no se anota nada de \"%@\"."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هیچ ستی را به‌عنوان انجام‌شده علامت نزدی، پس چیزی برای «%@» ثبت نمی‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu n’as marqué aucune série comme terminée, donc rien ne sera enregistré pour « %@ »."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non hai segnato nessuna serie, quindi di \"%@\" non viene registrato niente."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "完了にしたセットがないため、「%@」は記録されません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "완료로 표시한 세트가 없어 “%@”에 기록되는 내용이 없습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Je hebt geen set als voltooid gemarkeerd, dus er wordt niets gelogd voor ‘%@’."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nie oznaczono żadnej serii jako ukończonej, więc nic nie zostanie zapisane dla „%@”."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Você não marcou nenhuma série, então nada será registrado de \"%@\"."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Ты не отметил ни одного подхода, так что по «%@» ничего не запишется."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hiçbir seti tamamlandı olarak işaretlemedin, bu yüzden “%@” için hiçbir şey kaydedilmeyecek."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Ти не позначив жодного підходу як виконаний, тому для «%@» нічого не буде записано."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "你还没有标记任何一组，所以「%@」不会被记录。"
     }
    },
