  "planSetsHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Choose the type, reps and weight of each set. Leave the weight on Auto to start from your last session."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر النوع والتكرارات والوزن لكل مجموعة. اترك الوزن على «تلقائي» لتبدأ من آخر تمرين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle Typ, Wiederholungen und Gewicht jedes Satzes. Lass das Gewicht auf Auto, um bei deiner letzten Einheit anzuknüpfen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige el tipo, las repes y el peso de cada serie. Deja el peso en Auto para partir de tu última sesión."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "نوع، تکرار و وزن هر ست را انتخاب کن. وزن را روی خودکار بگذار تا از آخرین جلسه تمرینت شروع شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisis le type, les répétitions et le poids de chaque série. Laisse le poids sur Auto pour partir de ta dernière séance."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli tipo, ripetizioni e peso di ogni serie. Lascia il peso su Auto per partire dall'ultima sessione."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各セットの種類、回数、重量を選びます。重量を自動にすると前回のトレーニングから始まります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 세트의 종류, 횟수, 무게를 고르세요. 무게를 자동으로 두면 지난 운동에서 시작해요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Kies het type, de herhalingen en het gewicht van elke set. Laat het gewicht op Auto om vanaf je laatste training te beginnen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wybierz typ, powtórzenia i ciężar każdej serii. Zostaw ciężar na Auto, by zacząć od ostatniego treningu."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha o tipo, as repetições e o peso de cada série. Deixe o peso em Auto para partir da última sessão."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбери тип, повторы и вес каждого подхода. Оставь вес на «Авто», чтобы начать с прошлой тренировки."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Her setin türünü, tekrarını ve ağırlığını seç. Son antrenmanından başlamak için ağırlığı Otomatik bırak."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Виберіть тип, повтори й вагу кожного підходу. Залиште вагу на Авто, щоб почати з останнього тренування."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "设置每组的类型、次数和重量。重量留“自动”则沿用你上次的训练。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "選擇每一組的類型、次數和重量。重量設為自動就會從上次訓練開始。"
     }
    }
   }
  },
  "autoValue": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Auto"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تلقائي"
     }
    },
    "de": {
     "stringUnit": {
