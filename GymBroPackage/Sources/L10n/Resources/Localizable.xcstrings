  "planNoHistory": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No workouts logged yet: treat me as a beginner and keep volume and weights conservative."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لم أسجّل أي تمرين بعد: اعتبرني مبتدئًا وكن حذرًا في الحجم والأوزان."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Noch keine Trainings erfasst: Behandle mich als Anfänger und halte Volumen und Gewichte vorsichtig."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aún no he registrado entrenos: trátame como principiante y sé prudente con el volumen y los pesos."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هنوز تمرینی ثبت نشده: من را مبتدی حساب کن و حجم و وزن‌ها را محافظه‌کارانه نگه دار."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucune séance enregistrée : considère-moi comme débutant et reste prudent sur le volume et les charges."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun allenamento registrato: trattami da principiante e resta prudente con volume e carichi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "まだ記録がありません。初心者として扱い、ボリュームと重量は控えめにしてください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "아직 운동 기록이 없어요. 초보자로 보고 볼륨과 무게를 보수적으로 잡아 주세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nog geen trainingen gelogd: behandel me als beginner en houd volume en gewichten voorzichtig."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Nie mam jeszcze zapisanych treningów: traktuj mnie jak początkującego i ostrożnie dobieraj objętość i ciężary."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Ainda não registei treinos: trata-me como principiante e sê prudente com o volume e os pesos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренировок пока нет: считай меня новичком и будь осторожен с объёмом и весами."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Henüz kayıtlı antrenmanım yok: beni yeni başlayan olarak düşün, hacim ve ağırlıklarda temkinli ol."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренувань ще немає: вважай мене новачком і будь обережним з обсягом і вагами."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "还没有训练记录：请把我当作新手，训练量和重量要保守。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "還沒有訓練紀錄：請把我當作新手，訓練量和重量要保守。"
     }
    }
   }
  },
