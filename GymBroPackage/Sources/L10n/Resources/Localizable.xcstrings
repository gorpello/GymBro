  "stickerHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drag to move it, pinch to resize or turn it"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسحبها لتحريكها، واقرص لتغيير حجمها أو تدويرها"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zum Verschieben ziehen, mit zwei Fingern skalieren oder drehen"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrástrala para moverla y pellizca para cambiar su tamaño o girarla"
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بکش تا جابه‌جا شود، با دو انگشت اندازه یا چرخش را عوض کن"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Fais-la glisser pour la déplacer, pince pour la redimensionner ou la tourner"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trascinalo per spostarlo, pizzica per ridimensionarlo o ruotarlo"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ドラッグで移動、ピンチでサイズ変更や回転"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "드래그해서 옮기고, 두 손가락으로 크기를 바꾸거나 돌리세요"
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Sleep om te verplaatsen, knijp om te schalen of te draaien"
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Przeciągnij, by przesunąć, uszczypnij, by zmienić rozmiar lub obrócić"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arraste para mover e pinçe a tela para mudar o tamanho ou girar"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Перетащи, чтобы сдвинуть, и сведи пальцы, чтобы изменить размер или повернуть"
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Taşımak için sürükle, boyutunu değiştirmek veya döndürmek için iki parmakla sıkıştır"
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Перетягніть, щоб перемістити, зведіть пальці, щоб змінити розмір або повернути"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "拖动来移动，双指缩放或旋转"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "拖曳移動，雙指縮放或旋轉"
     }
    }
   }
  },
