     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 라이브러리로 구성된 기본 루틴입니다. 나중에 모두 수정할 수 있습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Klassieke routines opgebouwd uit je eigen bibliotheek. Je kunt daarna alles aanpassen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Klasyczne plany zbudowane z twojej biblioteki. Potem możesz wszystko zmienić."
