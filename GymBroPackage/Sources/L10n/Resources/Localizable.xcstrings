  "trainReminderHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A nudge at this time, only on the days your routine is planned."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تذكير في هذا الوقت، فقط في الأيام التي يكون فيها روتينك مجدولًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Eine Erinnerung zu dieser Zeit, nur an den Tagen, an denen dein Trainingsplan vorgesehen ist."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Un aviso a esta hora, solo los días que tengas rutina."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "فقط در روزهای برنامه‌ریزی‌شده روتین، همین ساعت یادآوری می‌کند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un rappel à cette heure, uniquement les jours où ton programme est prévu."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Un avviso a quest'ora, solo nei giorni in cui hai una scheda."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この時刻に、ルーティン予定日のみ通知します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 시간에, 루틴이 예정된 날에만 알림을 보냅니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Een herinnering op dit tijdstip, alleen op dagen waarop je routine gepland staat."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Przypomnienie o tej porze tylko w dni, na które zaplanowano plan."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Um aviso nesta hora, só nos dias com rotina planejada."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Напомнит в это время, только в те дни, на которые стоит программа."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Yalnızca programının olduğu günlerde bu saatte hatırlatır."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Нагадування в цей час лише в дні, коли заплановано програму."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在你安排了计划的日子，按这个时间提醒你。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "在這個時間提醒你，但只會在課表排定的日子提醒。"
     }
    }
   }
  },
