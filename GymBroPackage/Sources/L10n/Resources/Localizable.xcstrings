  "logHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No timer — just fill in what you did."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بدون مؤقت — فقط أدخل ما فعلته."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kein Timer — trage einfach ein, was du gemacht hast."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin cronómetro: solo rellenas lo que hiciste."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بدون تایمر — فقط آنچه کردی را پر کن."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sans minuteur — renseigne simplement ce que tu as fait."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Senza cronometro: riempi solo quello che hai fatto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "タイマーなし — 実施内容だけを入力します。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "타이머 없이 — 한 내용을 간단히 입력하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zonder timer — vul gewoon in wat je hebt gedaan."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Bez minutnika — po prostu wpisz, co zrobiłeś."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem cronômetro — só preencha o que você fez."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Без секундомера: просто заполни, что ты сделал."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Zamanlayıcı olmadan — sadece ne yaptığını gir."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Без таймера — просто вкажи, що зробив."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "没有计时器，只要填上你做过的内容。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "不使用計時器 — 只要填入你做了什麼。"
     }
    }
   }
  },
