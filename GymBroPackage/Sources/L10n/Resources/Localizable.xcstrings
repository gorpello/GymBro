  "levelUpBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld on %2$@ two workouts in a row. Ready for the next step?"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld في %2$@ في تمرينين متتاليين. هل أنت مستعد للخطوة التالية؟"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld bei %2$@ in zwei Trainings hintereinander. Bereit für die nächste Stufe?"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld en %2$@ dos entrenos seguidos. ¿Listo para el siguiente paso?"
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "دو تمرین پشت سر هم ۳×%1$lld در %2$@. آماده‌ی قدم بعدی هستی؟"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld sur %2$@ deux séances d’affilée. Prêt pour l’étape suivante ?"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld su %2$@ per due allenamenti di fila. Pronto per il passo successivo?"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@で3×%1$lldを2回連続で達成。次のステップに進みますか?"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@ 3×%1$lld을(를) 두 번 연속 달성했어요. 다음 단계로 갈까요?"
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Twee trainingen op rij 3×%1$lld bij %2$@. Klaar voor de volgende stap?"
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld w %2$@ dwa treningi z rzędu. Gotowy na następny krok?"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld em %2$@ dois treinos seguidos. Pronto para o próximo passo?"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld в «%2$@» две тренировки подряд. Готов к следующему шагу?"
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "%2$@ hareketinde üst üste iki antrenmanda 3×%1$lld. Sonraki adıma hazır mısın?"
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "3×%1$lld у «%2$@» два тренування поспіль. Готовий до наступного кроку?"
     }
    },
    "zh": {
