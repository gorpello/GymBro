  "deleteEntryBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" will be removed from this day, and from your records and charts."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستتم إزالة \"%@\" من هذا اليوم ومن سجلاتك ورسومك البيانية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" wird von diesem Tag sowie aus deinen Rekorden und Diagrammen entfernt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" desaparecerá de este día, y de tus récords y gráficas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "«%@» از این روز و از رکوردها و نمودارهایت حذف می‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "« %@ » sera supprimé de cette journée, ainsi que de tes records et graphiques."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" verrà rimosso da questo giorno, dai record e dai grafici."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "「%@」はこの日、記録、グラフから削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@”이(가) 이 날짜와 기록 및 차트에서 삭제됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "‘%@’ wordt van deze dag en uit je records en grafieken verwijderd."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "„%@” zostanie usunięte z tego dnia oraz z rekordów i wykresów."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "\"%@\" será removido deste dia, bem como de seus registros e gráficos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "«%@» исчезнет из этого дня, а также из рекордов и графиков."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "“%@” bu günden, rekorlarından ve grafiklerinden kaldırılacak."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
