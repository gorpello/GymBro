  "notHereWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swap it for something you can actually load today."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "استبدله بشيء يمكنك استخدامه فعليًا اليوم."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ersetze es gegen etwas aus, das du heute tatsächlich belasten kannst."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cámbialo por algo que sí puedas cargar hoy."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "با چیزی عوضش کن که امروز واقعاً می‌توانی بزنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Remplace-le par quelque chose que tu peux vraiment utiliser aujourd’hui."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sostituiscilo con qualcosa che puoi caricare oggi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "今日使えるものに入れ替えましょう。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "오늘 실제로 사용할 수 있는 것으로 바꾸세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Vervang het door iets dat je vandaag echt kunt gebruiken."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zamień na coś, czego możesz dziś faktycznie użyć."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
