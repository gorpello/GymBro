    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Tworzone z twoich serii — nic nie jest wysyłane."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Construído a partir de suas séries — nada de uploads."
     }
    },
    "ru": {
