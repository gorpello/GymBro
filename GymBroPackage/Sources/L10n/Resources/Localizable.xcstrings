  "welcomeBlurb": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Everything stays on your phone. No account, no internet, nothing to pay."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "كل شيء يبقى على هاتفك. لا حساب ولا إنترنت ولا دفع."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alles bleibt auf deinem Handy. Kein Konto, kein Internet, nichts zu bezahlen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todo se queda en tu móvil. Sin cuenta, sin internet, sin pagar nada."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "همه‌چیز روی گوشی‌ات می‌ماند. بدون حساب، بدون اینترنت، بدون پرداخت."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tout reste sur ton téléphone. Aucun compte, pas d’Internet, rien à payer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutto resta sul tuo telefono. Nessun account, niente internet, niente da pagare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "すべて端末内に保存。アカウント不要、インターネット不要、支払いなし。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "모든 데이터는 휴대전화에 남습니다. 계정, 인터넷, 결제가 필요 없습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Alles blijft op je telefoon. Geen account, geen internet, niets te betalen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wszystko zostaje na telefonie. Bez konta, bez internetu, bez opłat."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tudo fica no seu celular. Sem conta, sem internet, sem nada para pagar."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Всё остаётся на твоём телефоне. Без аккаунта, без интернета, без оплаты."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Her şey telefonunda kalır. Hesap yok, internet yok, ödeme yok."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Усе залишається на телефоні. Без облікового запису, без інтернету, без оплати."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "所有数据均保存在你的手机上。无账号、无网络连接要求、无任何费用。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "所有資料都留在手機上。不需帳號、不需網路、不用付費。"
     }
    }
   }
  },
