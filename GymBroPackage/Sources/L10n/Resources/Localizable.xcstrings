  "archivedBanner": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Archived. It stays out of lists and suggestions; your history is kept."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مؤرشف. لا يظهر في القوائم ولا الاقتراحات، ويبقى سجلك محفوظًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Archiviert. Sie erscheint nicht in Listen und Vorschlägen; dein Verlauf bleibt erhalten."
