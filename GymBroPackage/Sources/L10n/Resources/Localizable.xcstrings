  "rpeHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "10 is nothing left in the tank, 8 is two reps to spare."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = لا يمكن تكرار إضافي؛ 8 = نحو تكرارين احتياطيين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "10 bedeutet, dass keine Wiederholung mehr möglich ist; bei 8 bleiben zwei Wiederholungen übrig."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "10 es no poder con una más; 8, que te sobraban dos."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "۱۰ یعنی دیگر نمی‌توانی، ۸ یعنی دو تکرار مانده."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = plus aucune répétition possible ; 8 = environ deux répétitions en réserve."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "10 è non farne un'altra; 8, che te ne avanzavano due."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = もう1回もできない；8 = あと約2回できる。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = 더 이상 반복 불가; 8 = 약 2회 여유."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = geen herhaling meer mogelijk; 8 = ongeveer twee herhalingen over."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = brak możliwości kolejnego powtórzenia; 8 = około dwa powtórzenia w zapasie."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "10 é não conseguir fazer mais nenhuma repetição; 8, é que sobravam duas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "10 — больше ни одного повторения; 8 — оставалось ещё два."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = artık tekrar yok; 8 = yaklaşık iki tekrar yedekte."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = більше жодного повторення; 8 = приблизно два повторення в запасі."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "10 表示一次也做不动了，8 表示还能再做两次。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "10 = 無法再做一次；8 = 約還能做兩次。"
     }
    }
   }
  },
