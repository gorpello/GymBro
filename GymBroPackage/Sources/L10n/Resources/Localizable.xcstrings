  "deleteWorkoutBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This workout and all its sets will be removed from your history."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف هذا التمرين وكل مجموعاته من سجلك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Dieses Training und alle seine Sätze werden aus deinem Verlauf entfernt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se borrará este entreno con todas sus series del historial."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "این تمرین و همه ست‌هایش از تاریخچه‌ات حذف می‌شوند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Cette séance et toutes ses séries seront retirées de ton historique."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Questo allenamento e tutte le sue serie verranno tolti dallo storico."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "このトレーニングとすべてのセットが履歴から削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 운동과 모든 세트가 기록에서 삭제됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Deze training en al haar sets worden uit je geschiedenis verwijderd."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ten trening i wszystkie jego serie zostaną usunięte z historii."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Este treino e todas as suas séries serão removidos do histórico."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренировка и все её подходы будут удалены из истории."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bu antrenman ve tüm setleri geçmişinden silinecek."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Це тренування і всі його підходи буде видалено з історії."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "这次训练及其所有组都会从记录中删除。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "這次訓練及其所有組數都會從紀錄中刪除。"
     }
    }
   }
  },
