  "notifPhotoBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "%lld days since the last one. Same pose, same light."
     }
    },
    "ar": {
     "stringUnit": {
