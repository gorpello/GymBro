    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Archiviato. Non compare in elenchi e suggerimenti; lo storico resta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アーカイブ済み。一覧や提案には出ませんが、履歴は残ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "보관됨. 목록과 추천에 나오지 않고 기록은 그대로 남아요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Gearchiveerd. Hij staat niet meer in lijsten en suggesties; je geschiedenis blijft bewaard."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zarchiwizowane. Nie pojawia się na listach ani w propozycjach; historia zostaje."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arquivado. Não aparece em listas nem sugestões; o teu histórico mantém-se."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "В архиве. Не показывается в списках и подсказках; история сохраняется."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Arşivlendi. Listelerde ve önerilerde çıkmaz; geçmişin korunur."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "В архіві. Не з’являється у списках і підказках; історія зберігається."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "已归档：不会出现在列表和推荐中，训练记录会保留。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "已封存：不會出現在清單和推薦中，訓練紀錄會保留。"
     }
    }
   }
  },
  "videoMarksHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause on a step and tap the pin to jump there next time."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "أوقف مؤقتًا عند خطوة واضغط الدبوس لتنتقل إليها في المرة القادمة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausiere bei einem Schritt und tippe auf die Nadel, um nächstes Mal dorthin zu springen."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa en un paso y toca la chincheta para saltar ahí la próxima vez."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "روی یک گام مکث کن و سنجاق را بزن تا دفعه بعد همان‌جا بروی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Mets en pause sur une étape et touche l’épingle pour y revenir la prochaine fois."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti in pausa su un passo e tocca la puntina per saltarci la prossima volta."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "手順の場面で一時停止してピンをタップすると、次回そこへ移動できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "단계에서 일시정지하고 핀을 누르면 다음에 그 지점으로 이동해요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Pauzeer bij een stap en tik op de punaise om er de volgende keer naartoe te springen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zatrzymaj na kroku i dotknij pinezki, aby następnym razem tam przeskoczyć."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa num passo e toca no alfinete para saltar para lá da próxima vez."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Поставьте паузу на шаге и нажмите на булавку, чтобы в следующий раз перейти туда."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bir adımda duraklat ve bir dahaki sefere oraya atlamak için raptiyeye dokun."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Поставте паузу на кроці й торкніться шпильки, щоб наступного разу перейти туди."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在某一步暂停并点图钉，下次可直接跳到这里。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "在某一步暫停並點圖釘，下次可直接跳到這裡。"
     }
    }
   }
  },
