  "awardTonnes100Line": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Everything you have lifted adds up to 100,000 kg."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "بلغ مجموع ما رفعته 100,000 كغ."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Alles, was du gehoben hast, ergibt zusammen 100.000 kg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Todo lo que has levantado suma 100.000 kg."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هرچه جابه‌جا کرده‌ای به ۱۰۰٬۰۰۰ کیلو می‌رسد."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tout ce que tu as soulevé atteint 100 000 kg."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tutto quello che hai sollevato fa 100.000 kg."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "これまでの総挙上量が100,000kgに到達。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "지금까지 든 총 중량이 100,000kg에 도달했습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Alles wat je hebt getild komt uit op 100.000 kg."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wszystko, co podniosłeś, daje 100 000 kg."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Tudo o que você levantou soma 100.000 kg."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Всё, что ты поднял, складывается в 100 000 кг."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Kaldırdığın her şey toplam 100.000 kg'a ulaştı."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Усе, що ти підняв, сягнуло 100 000 кг."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "你举起的总重量达到 100,000 公斤。"
