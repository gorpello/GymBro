  "timelineBodyEmpty": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Log a session and your muscle map starts filling in here, no photos needed."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل تمرينًا وستبدأ خريطة العضلات بالامتلاء هنا — دون حاجة إلى صور."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Protokolliere ein Training und deine Muskelkarte füllt sich hier — ganz ohne Fotos."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Entrena y tu mapa muscular se va llenando aquí, sin subir ninguna foto."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "یک جلسه تمرین ثبت کن تا نقشه عضلات اینجا پر شود، بدون نیاز به عکس."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Enregistre une séance et ta carte musculaire commencera à se remplir ici, sans photo nécessaire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Registra una sessione e la mappa muscolare inizia a riempirsi qui, senza foto."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ワークアウトを記録すると筋肉マップが埋まり始めます — 写真は不要です。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "운동을 기록하면 근육 지도가 채워지기 시작합니다 — 사진은 필요 없습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Log een training en je spierkaart vult zich hier — zonder foto's."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zapisz trening, a mapa mięśni zacznie się tutaj wypełniać — bez zdjęć."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Registre uma sessão e seu mapa muscular começará a ser preenchido aqui, sem precisar de fotos."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши тренировку — и карта мышц начнёт заполняться здесь, без всяких фото."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bir antrenman kaydet, kas haritan burada dolmaya başlasın — fotoğrafa gerek yok."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши тренування, і карта м’язів почне заповнюватися тут — без фото."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "记录训练后，肌群热力图将在此自动点亮，无需拍照。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "記錄訓練後，肌肉地圖會開始填滿 — 不需要照片。"
     }
    }
   }
  },
  "timelineBodyHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Built from your own sets — nothing to upload."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "مبنية من مجموعاتك أنت — لا يتم رفع أي شيء."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aus deinen eigenen Sätzen erstellt — nichts muss hochgeladen werden."
     }
    },
    "es": {
