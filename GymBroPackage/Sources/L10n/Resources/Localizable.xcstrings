      "state": "translated",
      "value": "Sale de tus propias series — no hay nada que subir."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "از ست‌های خودت ساخته شده — چیزی برای آپلود نیست."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Créée à partir de tes propres séries — rien à envoyer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nata dalle tue serie — niente da caricare."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "あなたのセット記録から作成 — アップロードはありません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "내 세트 기록으로 생성되며 아무것도 업로드되지 않습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Gebouwd uit je eigen sets — niets wordt geüpload."
