  "tplFullbody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Three full-body days a week. The one to start with."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ثلاث تمارين لكامل الجسم أسبوعيًا. مثالي للبداية."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Drei Ganzkörpertage pro Woche. Der beste Einstieg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tres días de cuerpo entero a la semana. Por el que se empieza."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "سه روز فول‌بادی در هفته. برای شروع."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Trois séances corps entier par semaine. Idéal pour commencer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tre giorni a settimana di corpo intero. Quello da cui si parte."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "週3回の全身トレーニング。初心者に最適。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "주 3회 전신 운동. 시작하기에 좋습니다."
     }
    },
