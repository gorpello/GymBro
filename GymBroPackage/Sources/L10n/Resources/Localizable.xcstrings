  "tplRr": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The r/bodyweightfitness classic: full body three days a week. Move up a step when it gets easy."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الروتين الكلاسيكي من r/bodyweightfitness: الجسم كله ثلاثة أيام في الأسبوع. انتقل إلى المستوى التالي حين يصبح سهلًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Der Klassiker von r/bodyweightfitness: Ganzkörper an drei Tagen pro Woche. Geh eine Stufe höher, wenn es leicht wird."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El clásico de r/bodyweightfitness: cuerpo entero tres días a la semana. Sube un paso cuando te resulte fácil."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "روتین کلاسیک r/bodyweightfitness: کل بدن، سه روز در هفته. وقتی آسان شد یک پله بالاتر برو."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le classique de r/bodyweightfitness : tout le corps trois jours par semaine. Passe à l’étape suivante quand ça devient facile."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Il classico di r/bodyweightfitness: tutto il corpo tre giorni a settimana. Passa al livello successivo quando diventa facile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "r/bodyweightfitness の定番:週3日の全身トレーニング。楽になったら次の段階へ。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "r/bodyweightfitness의 대표 루틴: 주 3일 전신 운동. 쉬워지면 다음 단계로 넘어가세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De klassieker van r/bodyweightfitness: drie dagen per week het hele lichaam. Ga een stap verder als het makkelijk wordt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Klasyk z r/bodyweightfitness: całe ciało trzy dni w tygodniu. Przejdź o krok wyżej, gdy zrobi się łatwo."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O clássico do r/bodyweightfitness: corpo inteiro três dias por semana. Suba um nível quando ficar fácil."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Классика r/bodyweightfitness: всё тело три дня в неделю. Переходи на следующую ступень, когда станет легко."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "r/bodyweightfitness klasiği: haftada üç gün tüm vücut. Kolaylaşınca bir sonraki aşamaya geç."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Класика r/bodyweightfitness: усе тіло три дні на тиждень. Переходь на наступний щабель, коли стане легко."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "r/bodyweightfitness 的经典计划:每周三天全身训练。变轻松了就进阶到下一级。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "r/bodyweightfitness 的經典計畫:每週三天全身訓練。變輕鬆了就進階到下一級。"
     }
    }
   }
