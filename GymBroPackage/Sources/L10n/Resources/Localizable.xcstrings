  "supersetHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "No rest between chained exercises — you go straight to the next one."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا راحة بين التمارين المرتبطة — تنتقل مباشرة إلى التالي."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Keine Pause zwischen verknüpften Übungen — du gehst direkt zur nächsten."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sin descanso entre los ejercicios encadenados: pasas directo al siguiente."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بین حرکات سوپرست استراحت نیست — مستقیم می‌روی سراغ بعدی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Aucun repos entre les exercices enchaînés — tu passes directement au suivant."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nessun riposo tra gli esercizi concatenati: passi dritto al prossimo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "連結した種目の間は休憩なし — そのまま次へ進みます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "연결된 운동 사이에는 휴식 없이 바로 다음 운동으로 넘어갑니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Geen rust tussen gekoppelde oefeningen — je gaat meteen door naar de volgende."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Bez odpoczynku między połączonymi ćwiczeniami — przechodzisz od razu do następnego."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sem descanso entre exercícios encadeados: passa logo ao próximo."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Между связанными упражнениями отдыха нет: сразу идёшь к следующему."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bağlı egzersizler arasında dinlenme yok — doğrudan sonrakine geçersin."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Без відпочинку між поєднаними вправами — одразу переходиш до наступної."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "相连的动作之间不休息，直接进入下一个。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "連接的動作之間不休息 — 直接進入下一個動作。"
     }
    }
   }
  },
