     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca cada rutina de este día. Van en el orden en que las añadas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "هر روتین این روز را لمس کن. به ترتیبی که اضافه می‌کنی می‌آیند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touche chaque programme de ce jour. Ils suivent l’ordre dans lequel tu les ajoutes."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca ogni scheda di questo giorno. Seguono l’ordine in cui le aggiungi."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日のルーティンをすべてタップ。追加した順に進みます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이날 할 루틴을 모두 누르세요. 추가한 순서대로 진행돼요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Tik elke routine voor deze dag aan. Ze volgen de volgorde waarin je ze toevoegt."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Dotknij każdego planu na ten dzień. Idą w kolejności dodania."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca em cada rotina deste dia. Seguem a ordem em que as adicionas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Отметьте каждую программу на этот день. Они идут в порядке добавления."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bu günün her programına dokun. Eklediğin sırayla gelirler."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Позначте кожну програму на цей день. Вони йдуть у порядку додавання."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "点选这一天的每个计划，按添加顺序进行。"
