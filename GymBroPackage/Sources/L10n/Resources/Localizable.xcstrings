  "templatesHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Classic programmes, built from your own library. You can change anything afterwards."
     }
    },
    "ar": {
     "stringUnit": {
