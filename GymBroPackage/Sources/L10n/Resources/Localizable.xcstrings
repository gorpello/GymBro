  "aboutBlurb": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Built by lifters, for lifters."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "صنعه متدربون للمتدربين."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Von Trainierenden für Trainierende."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hecha por gente que entrena, para gente que entrena."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "ساخته توسط وزنه‌زن‌ها، برای وزنه‌زن‌ها."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Créé par des pratiquants, pour des pratiquants."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fatta da chi si allena, per chi si allena."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "トレーニングする人が、トレーニングする人のために作りました。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "운동하는 사람이 운동하는 사람을 위해 만들었습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Gemaakt door sporters, voor sporters."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Stworzone przez ćwiczących dla ćwiczących."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Feito por quem treina, para quem treina."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Сделано теми, кто тягает, для тех, кто тягает."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Spor yapanlar tarafından, spor yapanlar için geliştirildi."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Створено тими, хто тренується, для тих, хто тренується."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "由健身者打造，为健身者而生。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "由訓練者為訓練者打造。"
     }
    }
   }
  },
