  "onbNameWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Only used to greet you. It never leaves the phone."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يُستخدم فقط لتحيتك. لا يغادر هاتفك أبدًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wird nur zur Begrüßung verwendet und verlässt das Handy nie."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Solo para saludarte. No sale del móvil."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "فقط برای سلام. هرگز از گوشی خارج نمی‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Utilisé uniquement pour t’accueillir. Il ne quitte jamais ton téléphone."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Serve solo per salutarti. Non lascia mai il telefono."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "挨拶にのみ使用します。端末外には送信されません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "인사에만 사용됩니다. 휴대전화 밖으로 나가지 않습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Alleen gebruikt om je te begroeten. Verlaat je telefoon nooit."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Używane tylko do powitania. Nigdy nie opuszcza telefonu."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Usado apenas para cumprimentá-lo(a). Nunca sai do seu celular."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Нужно только для приветствия. Телефон оно не покидает."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Yalnızca sana hitap etmek için kullanılır. Telefonundan asla çıkmaz."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Використовується лише для привітання. Ніколи не залишає телефон."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仅用于应用内的日常问候，绝不会离开你的手机。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "僅用於稱呼你。永遠不會離開你的手機。"
     }
    }
   }
  },
