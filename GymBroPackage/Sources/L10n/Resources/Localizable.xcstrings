  "useTheirSchedule": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Also use its weekly schedule"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "استخدام جدوله الأسبوعي أيضًا"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Auch den Wochenplan übernehmen"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Usar también su plan semanal"
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "زمان‌بندی هفتگی‌اش را هم استفاده کن"
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Utiliser aussi son planning hebdo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa anche il suo piano settimanale"
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "その週間スケジュールも使う"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "주간 일정도 사용"
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ook het weekschema gebruiken"
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Użyj też jej planu tygodnia"
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Usar também o plano semanal"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Применить и расписание по дням"
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Haftalık planını da kullan"
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Також використати її тижневий розклад"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同时采用它的每周安排"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "也使用它的每週安排"
     }
    }
   }
  },
  "useTheirScheduleHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The days it brings replace what you have planned on them."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "الأيام التي يحملها تحل محل ما خططت له في تلك الأيام."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die mitgebrachten Tage ersetzen, was du an ihnen geplant hast."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los días que traiga sustituyen lo que tengas planificado en ellos."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "روزهایی که می‌آورد جایگزین آنچه روی آن‌ها برنامه‌ریزی کرده‌ای می‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les jours qu'elle apporte remplacent ce que tu avais prévu ces jours-là."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "I giorni che porta sostituiscono quello che hai pianificato in quei giorni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "含まれる曜日は、その曜日の予定を置き換えます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "가져온 요일이 그 요일의 기존 계획을 대신해요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De dagen die meekomen vervangen wat je op die dagen gepland had."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Dni, które zawiera, zastąpią to, co masz zaplanowane na te dni."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Os dias que ele traz substituem o que você tem planejado neles."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Дни из файла заменят то, что у тебя на них запланировано."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Getirdiği günler, o günlerde planladıklarının yerine geçer."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Дні з неї замінять те, що ви запланували на ці дні."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "它包含的日子会替换你在那些天的安排。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "它帶來的日子會取代你在那幾天的安排。"
     }
    }
   }
  },
