  "onbBodyWhy": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "They feed the calculators. You can change them any time in Settings."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تُستخدم في الحاسبات. يمكنك تغييرها في الإعدادات في أي وقت."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Sie versorgen die Rechner mit Daten. Du kannst sie jederzeit in den Einstellungen ändern."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alimentan las calculadoras. Puedes cambiarlos cuando quieras en Ajustes."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "برای ماشین‌حساب‌ها لازم‌اند. هر وقت در تنظیمات عوضشان کن."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ils servent aux calculateurs. Tu peux les modifier à tout moment dans les Paramètres."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alimentano le calcolatrici. Puoi cambiarli quando vuoi in Impostazioni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "計算ツールに使います。設定からいつでも変更できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "계산기에 사용됩니다. 설정에서 언제든 변경할 수 있습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Ze vullen de calculators in. Je kunt ze altijd wijzigen in Instellingen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Służą do kalkulatorów. Możesz je zmienić w Ustawieniach w dowolnym momencie."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Eles alimentam as calculadoras. Você pode alterá-los a qualquer momento nas Configurações."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Они питают калькуляторы. Поменять их можно в любой момент в настройках."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Hesaplayıcılarda kullanılır. Ayarlar'dan istediğin zaman değiştirebilirsin."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Вони використовуються в калькуляторах. Їх можна змінити в Налаштуваннях будь-коли."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用于为计算器提供基础参数，可随时在“设置”中修改。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "這些資料用於計算器，你可以隨時在設定中修改。"
     }
    }
   }
  },
  "onbGoalTitle": {
   "extractionState": "manual",
   "localizations": {
