  "placesHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Say what you have in each place and the library only shows what you can actually do there."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "حدّد المعدات الموجودة في كل مكان وستعرض المكتبة فقط ما يمكنك فعله هناك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Gib an, was du an jedem Ort hast, und die Bibliothek zeigt nur Übungen, die du dort machen kannst."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Di qué hay en cada sitio y la biblioteca te enseña solo lo que puedes hacer ahí."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بگو در هر مکان چه داری تا کتابخانه فقط چیزهایی را نشان دهد که واقعاً آنجا می‌توانی بزنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Indique le matériel disponible à chaque endroit et la bibliothèque n’affichera que ce que tu peux réellement y faire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dì cosa hai in ogni posto e la libreria mostra solo ciò che puoi fare lì."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各場所にある器具を設定すると、その場所でできる種目だけが表示されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 장소의 장비를 지정하면 그곳에서 할 수 있는 운동만 라이브러리에 표시됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Geef aan welke uitrusting je op elke plek hebt en de bibliotheek toont alleen wat je daar echt kunt doen."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Podaj sprzęt dostępny w każdym miejscu, a biblioteka pokaże tylko to, co możesz tam wykonać."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Diga o que você tem em cada lugar e a biblioteca mostrará apenas o que você realmente pode fazer ali."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Укажи, что есть в каждом месте, и библиотека покажет только то, что там реально можно сделать."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Her yerde hangi ekipmanların bulunduğunu belirt; kütüphanede yalnızca orada yapabileceğin egzersizler gösterilir."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Вкажи обладнання в кожному місці, і бібліотека покаже лише те, що там можна виконати."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "标记各个场地的可用器械，动作库将智能仅展示该场地支持的动作。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "設定每個地點有哪些器材，資料庫就只會顯示你實際能做的動作。"
     }
    }
   }
  },
