  "resetBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sessions, records, routines, notes and profile. This cannot be undone — export a backup first if you might want it."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "التمارين والسجلات والروتينات والملاحظات والملف الشخصي. لا يمكن التراجع عن ذلك — صدّر نسخة احتياطية أولًا إذا قد تحتاجها."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Trainings, Rekorde, Trainingspläne, Notizen und Profil. Dies kann nicht rückgängig gemacht werden — exportiere vorher ein Backup, falls du es noch brauchen könntest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sesiones, récords, rutinas, notas y perfil. No tiene vuelta atrás — exporta una copia antes si crees que la querrás."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "جلسه‌های تمرین، رکوردها، روتین‌ها، یادداشت‌ها و پروفایل. برگشتی نیست — اگر ممکن است بخواهی، اول یک بکاپ خروجی بگیر."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Séances, records, programmes, notes et profil. Cette action est irréversible — exporte d’abord une sauvegarde si tu veux pouvoir les récupérer."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sessioni, record, routine, note e profilo. Non si può annullare — esporta prima un backup se pensi di volerlo."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "ワークアウト、記録、ルーティン、メモ、プロフィールをすべて削除します。元に戻せません — 必要なら先にバックアップを書き出してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "운동, 기록, 루틴, 메모, 프로필이 모두 삭제됩니다. 되돌릴 수 없으니 필요하다면 먼저 백업을 내보내세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Trainingen, records, routines, notities en profiel. Dit kan niet ongedaan worden gemaakt — exporteer eerst een back-up als je ze wilt bewaren."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Treningi, rekordy, plany, notatki i profil. Tego nie można cofnąć — najpierw wyeksportuj kopię zapasową, jeśli możesz ich potrzebować."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Sessões, registros, rotinas, notas e perfil. Isso não pode ser desfeito — exporte um backup primeiro, caso queira mantê-lo"
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренировки, рекорды, программы, заметки и профиль. Это необратимо — сначала выгрузи резервную копию, если она может понадобиться."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Antrenmanlar, rekorlar, programlar, notlar ve profil silinecek. Bu işlem geri alınamaz — gerekebilecekse önce bir yedek dışa aktar."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Тренування, рекорди, програми, нотатки та профіль. Це незворотно — спочатку експортуй резервну копію, якщо дані можуть знадобитися."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将清空所有训练记录、个人纪录、计划、笔记及个人资料。此操作不可逆 — 如有需要，请先导出备份。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "訓練、紀錄、課表、筆記與個人檔案都會刪除。此操作無法復原 — 如有需要請先匯出備份。"
     }
    }
   }
  },
