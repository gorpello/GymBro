  "placeDeleteBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Only the place goes — your exercises and sessions stay."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيُحذف المكان فقط — ستبقى تمارينك وجلساتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nur der Ort wird gelöscht — deine Übungen und Trainings bleiben erhalten."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Se va solo el sitio — tus ejercicios y tus sesiones se quedan."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "فقط مکان حذف می‌شود — حرکات و جلسه‌های تمرین می‌مانند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Seul le lieu sera supprimé — tes exercices et tes séances resteront."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Va via solo il posto — esercizi e sessioni restano."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "場所だけが削除され、種目とワークアウトは残ります。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "장소만 삭제되며 운동과 운동 기록은 유지됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Alleen de plek wordt verwijderd — je oefeningen en trainingen blijven behouden."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Usunięte zostanie tylko miejsce — ćwiczenia i treningi zostaną."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Apenas o lugar muda — seus exercícios e sessões permanecem."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Уйдёт только место — упражнения и тренировки останутся."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Yalnızca yer silinir — egzersizlerin ve antrenmanların kalır."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Видалиться лише місце — вправи й тренування залишаться."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仅删除该场地配置，你的所有动作与训练记录均完整保留。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "只會刪除地點 — 你的動作與訓練會保留。"
     }
    }
   }
  },
  "placeGym": {
   "extractionState": "manual",
