  "deleteDayBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Its photos go with it, for good."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "ستُحذف صور هذا اليوم نهائيًا أيضًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Fotos dieses Tages werden ebenfalls endgültig gelöscht."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sus fotos se van con él, para siempre."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "عکس‌هایش هم برای همیشه پاک می‌شوند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ses photos seront définitivement supprimées avec elle."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Le sue foto vanno via con lui, per sempre."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "この日の写真も完全に削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "이 날의 사진도 영구적으로 삭제됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De foto's van deze dag worden ook permanent verwijderd."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zdjęcia z tego dnia zostaną również trwale usunięte."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "As fotos vão embora, para sempre."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Его фото уйдут вместе с ним, навсегда."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Bu günün fotoğrafları da kalıcı olarak silinir."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Фото цього дня також буде видалено назавжди."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当日拍摄的所有身材照都将被永久删除。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "這一天的照片也會永久刪除。"
     }
    }
   }
