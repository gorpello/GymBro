  "awardWorkouts365Line": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "A workout for every day of a year, logged one by one."
     }
    },
    "ar": {
     "stringUnit": {
