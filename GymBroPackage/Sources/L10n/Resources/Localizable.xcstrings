  "deleteNoteBody": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The note and anything attached to it go for good."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سيتم حذف الملاحظة وجميع مرفقاتها نهائيًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Die Notiz und alle Änhänge werden dauerhaft gelöscht."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La nota y todo lo que lleve adjunto se van para siempre."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "یادداشت و هرچه به آن پیوست شده برای همیشه پاک می‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "La note et toutes ses pièces jointes seront définitivement supprimées."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La nota e i suoi allegati vanno via per sempre."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "メモと添付ファイルは完全に削除されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "메모와 모든 첨부 파일이 영구적으로 삭제됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De notitie en alle bijlagen worden permanent verwijderd."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Notatka i wszystkie załączniki zostaną trwale usunięte."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "O nota e tudo o que estiver anexado a ela serão perdidos para sempre."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Заметка и всё вложенное исчезнут навсегда."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Not ve tüm ekleri kalıcı olarak silinir."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Нотатку й усі вкладення буде видалено назавжди."
     }
    },
    "zh": {
     "stringUnit": {
