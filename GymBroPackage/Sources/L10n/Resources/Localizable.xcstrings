  "suggestInWorkoutsHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Off keeps it out of the picks made for you. You can still add it by hand."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "عند إيقافه لن يظهر في الاقتراحات. يمكنك دائمًا إضافته يدويًا."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aus: Die Übung taucht nicht mehr in den Vorschlägen auf. Von Hand hinzufügen kannst du sie trotzdem."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Si lo apagas, no saldrá en lo que te proponemos. Podrás seguir añadiéndolo a mano."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "اگر خاموش باشد در پیشنهادهایی که برایت می‌آید نشان داده نمی‌شود. هنوز می‌توانی دستی اضافه‌اش کنی."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Désactivé, il n'apparaît plus dans les suggestions. Tu peux toujours l'ajouter à la main."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Se lo spegni, non comparirà tra le proposte. Potrai sempre aggiungerlo a mano."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "オフにすると提案に出なくなります。手動では追加できます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "끄면 추천에 나오지 않아요. 직접 추가는 계속 할 수 있어요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Uit houdt hem uit de voorstellen. Met de hand toevoegen kan nog steeds."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wyłączone nie trafia do propozycji. Nadal możesz dodać je ręcznie."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Desligado, não aparece nas sugestões. Você ainda pode adicioná-los manualmente."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Если выключить, упражнение не попадёт в подборку. Добавить его вручную всё равно можно."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Kapalıyken önerilerde çıkmaz. Yine de elle ekleyebilirsin."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Вимкнене не потрапить у пропозиції. Додати вручну все одно можна."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "关闭后不会出现在为你挑选的动作里，但仍可手动添加。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "關閉後不會出現在推薦中，但仍可手動加入。"
     }
    }
   }
  },
  "dontSuggest": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Don't suggest it again"
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "لا تقترحه مجددًا"
     }
    },
    "de": {
