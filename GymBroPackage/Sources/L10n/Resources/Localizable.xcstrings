  "reminderSmartHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It uses the days and the time you actually train, and stays quiet on a day you already trained."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "يستخدم الأيام والأوقات التي تتمرن فيها فعليًا ويبقى صامتًا إذا كنت قد تمرنت في ذلك اليوم بالفعل."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verwendet die Tage und die Zeit, zu denen du tatsächlich trainierst, und bleibt an einem bereits absolvierten Trainingstag ruhig."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa los días y la hora a los que sueles entrenar, y calla si ese día ya entrenaste."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "روزها و ساعتی که واقعاً تمرین می‌کنی را استفاده می‌کند و روزی که تمرین کرده‌ای ساکت می‌ماند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Il utilise les jours et l’heure auxquels tu t’entraînes réellement et reste silencieux si tu t’es déjà entraîné ce jour-là."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa i giorni e l'ora in cui ti alleni davvero, e sta zitto se quel giorno ti sei già allenato."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "実際にトレーニングする曜日と時刻を学習し、その日に既にトレーニング済みなら通知しません。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "실제로 운동하는 요일과 시간을 사용하며 그날 이미 운동했다면 알림을 보내지 않습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Gebruikt de dagen en tijden waarop je echt traint en blijft stil als je die dag al hebt getraind."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Używa dni i godzin, w których faktycznie trenujesz, i milczy, jeśli tego dnia trening już był."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa os dias e a hora em que você costuma treinar e não notifica se você já treinou nesse dia."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Берёт дни и время, когда ты реально тренируешься, и молчит, если в этот день ты уже потренировался."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Gerçekte antrenman yaptığın gün ve saatleri kullanır; o gün zaten antrenman yaptıysan sessiz kalır."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Використовує дні й час, коли ти реально тренуєшся, і мовчить, якщо цього дня тренування вже було."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按你实际训练的日子和时间提醒；当天已经练过就不再打扰。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "它會使用你實際訓練的日子與時間；如果當天已訓練，就不再提醒。"
     }
    }
   }
  },
  "reminderSmartEmpty": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Log a few more sessions and it will learn your days."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "سجّل بضعة تمارين أخرى ليتعلم عاداتك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Protokolliere noch ein paar Trainings, dann lernt die Funktion deine Tage."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Entrena unas cuantas veces más y aprenderá tus días."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "چند جلسه تمرین دیگر ثبت کن تا روزهایت را یاد بگیرد."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Enregistre encore quelques séances pour qu’il apprenne tes habitudes."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Registra ancora qualche allenamento e imparerà i tuoi giorni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "習慣を学習するため、もう数回ワークアウトを記録してください。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "습관을 학습할 수 있도록 운동을 몇 번 더 기록하세요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Log nog een paar trainingen zodat het je gewoonten kan leren."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Zapisz jeszcze kilka treningów, aby aplikacja poznała twoje nawyki."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Treine mais algumas vezes o app vai aprender a sua rotina."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши ещё несколько тренировок, и оно выучит твои дни."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Alışkanlıklarını öğrenmesi için birkaç antrenman daha kaydet."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Запиши ще кілька тренувань, щоб застосунок вивчив звички."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再多记录几次训练，它就会学到你的规律。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "再記錄幾次訓練，讓它學習你的習慣。"
     }
    }
   }
  },
