  "multiPlanHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap every routine for this day. They go in the order you add them."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اضغط كل روتين لهذا اليوم. تأتي بالترتيب الذي تضيفها به."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
