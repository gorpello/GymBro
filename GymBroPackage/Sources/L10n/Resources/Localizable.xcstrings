  "dragToReorder": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drag the dotted handle to reorder — this is the order you train in."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اسحب المقبض المنقّط لإعادة الترتيب — هذا هو ترتيب تمرينك."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Zieh am Punkte-Griff, um die Reihenfolge zu ändern — so trainierst du."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrastra el asa de puntos para reordenar: es el orden en que entrenas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "نگه‌دار و بکش تا جابه‌جا کنی — ترتیب تمرینت همین است."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Fais glisser la poignée à points pour réordonner : c’est l’ordre de ta séance."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trascina la maniglia a puntini per riordinare: è l’ordine in cui ti alleni."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "点のハンドルをドラッグして並べ替え。この順番でトレーニングします。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "점 손잡이를 끌어 순서를 바꾸세요. 이 순서대로 운동해요."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Sleep aan het stippengreepje om te herschikken — zo train je ze."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Przeciągnij uchwyt z kropkami, aby zmienić kolejność — w tej kolejności trenujesz."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrasta a pega de pontos para reordenar: é a ordem em que treinas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Потяните за ручку с точками, чтобы изменить порядок — в нём вы тренируетесь."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sıralamak için noktalı tutamacı sürükle — antrenman sırası budur."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Потягніть за ручку з крапками, щоб змінити порядок — у ньому ви тренуєтеся."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "拖动带点的手柄调整顺序，这就是你的训练顺序。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "拖曳帶點的把手調整順序，這就是你的訓練順序。"
     }
    }
   }
  },
