     "stringUnit": {
      "state": "translated",
      "value": "1RM والأقراص ومؤشر كتلة الجسم والسعرات ودهون الجسم والإحماء — كلها مبنية على معادلات منشورة."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, Scheiben, BMI, Kalorien, Körperfett und Aufwärmen — alle mit veröffentlichten Formeln."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, discos, IMC, calorías, grasa y calentamiento — todas con fórmulas publicadas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM، وزنه، BMI، کالری، چربی بدن و گرم‌کردن — همه با فرمول‌های منتشرشده."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, disques, IMC, calories, masse grasse et échauffement — tous basés sur des formules publiées."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Massimale, dischi, BMI, calorie, massa grassa e riscaldamento — tutte con formule pubblicate."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM、プレート、BMI、カロリー、体脂肪、ウォームアップ — すべて公開済みの式に基づきます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, 원판, BMI, 칼로리, 체지방, 워밍업 — 모두 공개된 공식에 기반합니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, schijven, BMI, calorieën, lichaamsvet en warming-up — allemaal gebaseerd op gepubliceerde formules."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, talerze, BMI, kalorie, tkanka tłuszczowa i rozgrzewka — wszystko na podstawie opublikowanych wzorów."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, pesos, IMC, calorias, gordura corporal e aquecimento — tudo com fórmulas publicadas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "1ПМ, блины, ИМТ, калории, жир и разминка — все по опубликованным формулам."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM, plakalar, VKİ, kalori, vücut yağı ve ısınma — hepsi yayımlanmış formüllere dayanır."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "1ПМ, диски, ІМТ, калорії, жир і розминка — усе базується на опублікованих формулах."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "涵盖 1RM、杠铃片、BMI、热量、体脂率和热身推算。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "1RM、槓片、BMI、卡路里、體脂與暖身 — 全都基於公開公式。"
     }
    }
   }
  },
