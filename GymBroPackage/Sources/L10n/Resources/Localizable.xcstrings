  "setsPlannedHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick how many sets you want of each one. The workout opens with them ready."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "اختر عدد المجموعات لكل تمرين. سيفتح التمرين وكل شيء جاهز."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wähle, wie viele Sätze du von jeder Übung möchtest. Beim Öffnen des Trainings sind sie bereits vorbereitet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige cuántas series quieres de cada uno. El entreno se abre con ellas puestas."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "بگو از هر کدام چند ست می‌خواهی. تمرین با آن‌ها آماده باز می‌شود."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Choisis le nombre de séries voulu pour chacun. La séance s’ouvrira avec tout prêt."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli quante serie vuoi di ognuno. L'allenamento si apre già con quelle."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "各種目のセット数を選択してください。ワークアウト開始時にすべて準備されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "각 운동의 원하는 세트 수를 선택하세요. 운동을 열면 모두 준비되어 있습니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "Kies voor elke oefening het gewenste aantal sets. De training opent dan helemaal klaar."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Wybierz liczbę serii dla każdego ćwiczenia. Trening otworzy się z gotowym planem."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Escolha quantas séries quer de cada um. O treino abre com elas prontas."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Выбери, сколько подходов хочешь в каждом. Тренировка откроется уже с ними."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Her egzersiz için istediğin set sayısını seç. Antrenman, setler hazır biçimde açılır."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Обери кількість підходів для кожної вправи. Тренування відкриється вже підготовленим."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "为每个动作选好组数，训练开始时就已经排好。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
