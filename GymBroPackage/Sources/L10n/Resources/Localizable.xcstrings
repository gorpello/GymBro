    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "L’alarme de repos ne sonnera pas lorsque l’écran est verrouillé"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "L'allarme di recupero non suonerà a schermo bloccato"
     }
