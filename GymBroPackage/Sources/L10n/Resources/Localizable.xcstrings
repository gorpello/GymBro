  "bgPhotoHint": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "It sits behind everything, dimmed so the app stays readable."
     }
    },
    "ar": {
     "stringUnit": {
      "state": "translated",
      "value": "تظهر خلف الواجهة كلها مع تعتيمها للحفاظ على وضوح التطبيق."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Es ist gedimmt hinter allem, damit die App lesbar bleibt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Va detrás de todo, oscurecida para que la app se siga leyendo."
     }
    },
    "fa": {
     "stringUnit": {
      "state": "translated",
      "value": "پشت همه‌چیز قرار می‌گیرد، تیره‌شده تا اپ خوانا بماند."
     }
    },
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Elle apparaît derrière toute l’interface, assombrie pour garder l’application lisible."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sta dietro a tutto, scurita perché l'app resti leggibile."
     }
    },
    "ja": {
     "stringUnit": {
      "state": "translated",
      "value": "アプリ全体の背景に表示され、読みやすいよう暗く処理されます。"
     }
    },
    "ko": {
     "stringUnit": {
      "state": "translated",
      "value": "전체 인터페이스 뒤에 표시되며 앱이 잘 보이도록 어둡게 처리됩니다."
     }
    },
    "nl": {
     "stringUnit": {
      "state": "translated",
      "value": "De foto verschijnt achter de hele interface, verduisterd zodat de app leesbaar blijft."
     }
    },
    "pl": {
     "stringUnit": {
      "state": "translated",
      "value": "Pojawia się za całym interfejsem, przyciemnione, aby aplikacja pozostała czytelna."
     }
    },
    "pt": {
     "stringUnit": {
      "state": "translated",
      "value": "Fica atrás de tudo, escurecida, para o app continuar legível."
     }
    },
    "ru": {
     "stringUnit": {
      "state": "translated",
      "value": "Оно стоит за всем, затемнённое, чтобы приложение читалось."
     }
    },
    "tr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tüm arayüzün arkasında, uygulama okunabilir kalsın diye karartılmış olarak görünür."
     }
    },
    "uk": {
     "stringUnit": {
      "state": "translated",
      "value": "Фото відображається за всім інтерфейсом і затемнюється для читабельності."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "照片在最底层，会调暗以保证界面清晰。"
     }
    },
    "zh-Hant": {
     "stringUnit": {
      "state": "translated",
      "value": "它會顯示在整個介面背後，並加深以保持可讀性。"
     }
    }
   }
  },
