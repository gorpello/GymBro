  "r0z6xzQ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend forward at the hips, keeping your back straight and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
