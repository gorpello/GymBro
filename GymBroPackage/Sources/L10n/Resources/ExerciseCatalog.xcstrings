  "belt-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your feet shoulder-width apart with your toes slightly out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca los pies a la anchura de los hombros con las puntas algo abiertas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti i piedi alla larghezza delle spalle con le punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽开立，脚尖微向外展。"
     }
