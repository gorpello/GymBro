{
 "sourceLanguage": "en",
 "strings": {
  "EIeI8Vf.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca piana con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃平板卧推"
     }
    }
   }
  },
  "EIeI8Vf.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your back pressed against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca con i piedi ben piantati a terra e la schiena aderente alla panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双脚踩实地面，背部紧贴凳面。"
     }
    }
   }
  },
  "EIeI8Vf.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "EIeI8Vf.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the barbell off the rack and hold it directly above your chest with your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y sujétala justo encima del pecho con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca il bilanciere dal rack e tienilo sopra il petto a braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃从卧推架上起出，手臂完全伸直，使杠铃位于胸部正上方。"
     }
    }
   }
  },
  "EIeI8Vf.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell slowly towards your chest, keeping your elbows tucked in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra despacio hacia el pecho, con los codos recogidos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere lentamente verso il petto, tenendo i gomiti vicini al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将杠铃下放至胸前，过程中保持手肘内收（与躯干夹角约45-70度）。"
     }
    }
   }
  },
  "EIeI8Vf.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment when the barbell touches your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento cuando la barra toque el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una breve pausa quando il bilanciere tocca il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当杠铃轻触胸部时稍作停顿。"
     }
    }
   }
  },
  "SpYC0Kp.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca piana con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃平板卧推"
     }
    }
   }
  },
  "SpYC0Kp.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your back pressed against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca con i piedi ben piantati a terra e la schiena aderente alla panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双脚平放踩实地面，背部贴紧凳面。"
     }
    }
   }
  },
  "SpYC0Kp.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand, with your palms facing forward and your arms extended above your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano, con las palmas hacia delante y los brazos estirados encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio per mano, palmi in avanti e braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，掌心朝前，双臂伸直将哑铃举于胸部上方。"
     }
    }
   }
  },
  "SpYC0Kp.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells slowly to the sides of your chest, keeping your elbows at a 90-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio a los lados del pecho, con los codos a 90 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa i manubri lentamente ai lati del petto, tenendo i gomiti a 90 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将哑铃下放至胸部两侧，手肘弯曲呈约90度角。"
     }
    }
   }
  },
  "SpYC0Kp.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push the dumbbells back up to the starting position, fully extending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja las mancuernas de vuelta a la posición inicial, estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi spingi i manubri su fino alla posizione iniziale, stendendo bene le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，然后将哑铃向上推回起始位置，双臂完全伸展。"
     }
    }
   }
  },
  "SpYC0Kp.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "3TZduzM.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Incline Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press inclinado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca inclinata con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜杠铃卧推"
     }
    }
   }
  },
  "3TZduzM.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up an incline bench at a 45-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca un banco inclinado a 45 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclina la panca a circa 45 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将上斜卧推凳调节至约45度角。"
     }
    }
   }
  },
  "3TZduzM.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie down on the bench with your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati con i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在卧推凳上，双脚平放踩实地面。"
     }
    }
   }
  },
  "3TZduzM.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "3TZduzM.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the barbell and lower it slowly towards your chest, keeping your elbows at a 45-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y bájala despacio hacia el pecho, con los codos a unos 45 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca il bilanciere e abbassalo lentamente verso il petto, con i gomiti a 45 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃起架，缓慢下放至上胸部位置，手肘与躯干保持约45度夹角。"
     }
    }
   }
  },
  "3TZduzM.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push the barbell back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja la barra de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in basso, poi spingi il bilanciere su fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部稍作停顿，然后发力将杠铃推回起始位置。"
     }
    }
   }
  },
  "ns0SIbU.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Incline Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press inclinado con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca inclinata con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜哑铃卧推"
     }
    }
   }
  },
  "ns0SIbU.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up an incline bench at a 45-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca un banco inclinado a 45 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta una panca inclinata a 45 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将上斜卧推凳调节至约45度角。"
     }
    }
   }
  },
  "ns0SIbU.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the bench with your feet flat on the ground and your back pressed firmly against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el banco con los pies apoyados en el suelo y la espalda bien pegada al respaldo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sulla panca con i piedi ben appoggiati a terra e la schiena premuta con forza contro la panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在卧推凳上，双脚踩实地面，背部紧贴椅背。"
     }
    }
   }
  },
  "ns0SIbU.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand, palms facing forward, and lift them to shoulder height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano con las palmas hacia delante y súbelas a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in ogni mano con i palmi rivolti in avanti e sollevali ad altezza spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，掌心向前，将哑铃举至与肩同高位置。"
     }
    }
   }
  },
  "ns0SIbU.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower the dumbbells to the sides of your chest, keeping your elbows at a 90-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio a los lados del pecho, con los codos a 90 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i manubri ai lati del petto mantenendo i gomiti a 90 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将哑铃下放至胸部外侧，手肘保持约90度角弯曲。"
     }
    }
   }
  },
  "ns0SIbU.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the dumbbells back up to the starting position, fully extending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las mancuernas de vuelta a la posición inicial estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i manubri verso la posizione iniziale distendendo completamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将哑铃向上推回起始位置，双臂充分伸展。"
     }
    }
   }
  },
  "GrO65fd.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Decline Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press declinado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca declinata con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜杠铃卧推"
     }
    }
   }
  },
  "GrO65fd.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your feet secured and your head lower than your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con los pies sujetos y la cabeza más baja que la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con i piedi bloccati e la testa più in basso dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，双脚固定，头部位置低于髋部。"
     }
    }
   }
  },
  "GrO65fd.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "GrO65fd.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the barbell and lower it slowly towards your chest, keeping your elbows tucked in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y bájala despacio hacia el pecho, con los codos recogidos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca il bilanciere dai supporti e abbassalo lentamente verso il petto tenendo i gomiti stretti al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃起出，缓慢下放至下胸位置，保持手肘内收不外展。"
     }
    }
   }
  },
  "GrO65fd.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push the barbell back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja la barra de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi spingi il bilanciere verso la posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部稍作停顿，然后将杠铃推回起始位置。"
     }
    }
   }
  },
  "GrO65fd.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "yz9nUhF.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Croci con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃飞鸟"
     }
    }
   }
  },
  "yz9nUhF.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with a dumbbell in each hand, palms facing each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco con una mancuerna en cada mano y las palmas enfrentadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca con un manubrio per mano, palmi uno di fronte all'altro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双手各握一只哑铃，掌心相对。"
     }
    }
   }
  },
  "yz9nUhF.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms straight up over your chest, with a slight bend in your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos hacia arriba encima del pecho, con los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stendi le braccia sopra il petto, con i gomiti appena piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂伸直位于胸部正上方，手肘保持微屈固定。"
     }
    }
   }
  },
  "yz9nUhF.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping a slight bend in your elbows, lower your arms out to the sides in a wide arc until you feel a stretch in your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los codos algo flexionados, baja los brazos a los lados en un arco amplio hasta notar el estiramiento en el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa le braccia lateralmente in un ampio arco finche senti allungare il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘微屈，双臂沿弧线向身体两侧下放展开，直至胸肌感受到充分拉伸。"
     }
    }
   }
  },
  "yz9nUhF.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then reverse the movement and bring the dumbbells back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento, invierte el movimiento y sube las mancuernas a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa un attimo, poi riporta i manubri su alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部稍作停顿，然后沿弧线反向发力将哑铃夹回起始位置。"
     }
    }
   }
  },
  "yz9nUhF.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "I4hDWkc.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti sulle braccia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "标准俯卧撑"
     }
    }
   }
  },
  "I4hDWkc.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a high plank position with your hands slightly wider than shoulder-width apart and your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha alta con las manos algo más abiertas que los hombros y los pies juntos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in plank alto, mani poco più larghe delle spalle e piedi uniti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以高位平板支撑姿势起始，双手略宽于肩撑地，双脚并拢。"
     }
    }
   }
  },
  "I4hDWkc.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lower your body towards the ground by bending your elbows, keeping your body in a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y baja el cuerpo hacia el suelo flexionando los codos, manteniéndote en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core e scendi piegando i gomiti, tenendo il corpo in linea retta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心肌群，屈肘将身体向地面下沉，全程保持身体呈一条直线。"
     }
    }
   }
  },
  "I4hDWkc.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment when your chest is just above the ground, then push yourself back up to the starting position by straightening your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento con el pecho justo encima del suelo y empuja para volver a la posición inicial estirando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa quando il petto sfiora terra, poi spingiti su stendendo le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸部接近地面时稍作停顿，然后双手推地伸直手臂，推回起始位置。"
     }
    }
   }
  },
  "I4hDWkc.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "9WTm7dq.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chest Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en paralelas para pecho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip per il petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双杠臂屈伸"
     }
    }
   }
  },
  "9WTm7dq.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Position yourself on parallel bars with your arms fully extended and your body straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en las paralelas con los brazos estirados del todo y el cuerpo recto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti alle parallele con le braccia tese e il corpo dritto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住双杠，双臂完全伸直支撑身体，身体保持平直。"
     }
    }
   }
  },
  "9WTm7dq.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows until your shoulders are below your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos hasta que los hombros queden por debajo de ellos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi piegando i gomiti finche le spalle superano i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲手肘下沉身体，直至肩关节低于肘关节位置（或上臂平行地面）。"
     }
    }
   }
  },
  "9WTm7dq.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back up to the starting position by straightening your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial estirando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti su fino alla posizione iniziale stendendo le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推杠、伸直双臂将身体推回起始位置。"
     }
    }
   }
  },
  "9WTm7dq.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "9XjtHvS.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Pullover"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃仰卧上拉"
     }
    }
   }
  },
  "9XjtHvS.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your head at one end and your feet on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con la cabeza en un extremo y los pies en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca con la testa a un'estremita e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在平凳上，头部靠近凳端，双脚平放于地面。"
     }
    }
   }
  },
  "9XjtHvS.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell with both hands and extend your arms straight above your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna con las dos manos y estira los brazos encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio con entrambe le mani e stendi le braccia sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手掌心重叠托住哑铃一端的内侧铃片，双臂伸展举至胸部正上方。"
     }
    }
   }
  },
  "9XjtHvS.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping a slight bend in your elbows, slowly lower the dumbbell behind your head until you feel a stretch in your chest and shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los codos algo flexionados, baja la mancuerna despacio por detrás de la cabeza hasta notar el estiramiento en pecho y hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con i gomiti appena piegati, abbassa il manubrio dietro la testa finche senti allungare petto e spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘保持微屈，缓慢将哑铃从头顶向后下方下放，直至胸肌和肩背感受到拉伸。"
     }
    }
   }
  },
  "9XjtHvS.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then raise the dumbbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y sube la mancuerna a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa un attimo, poi riporta il manubrio alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最深处停顿片刻，然后收缩胸背将哑铃拉回起始位置。"
     }
    }
   }
  },
  "9XjtHvS.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "Kyd9Rz5.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Standing Wide Military Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press militar de pie con barra y agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Military press in piedi con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿杠铃宽握推肩"
     }
    }
   }
  },
  "Kyd9Rz5.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold the barbell with an overhand grip, slightly wider than shoulder-width."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en pronación, algo más abierto que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e impugna il bilanciere con presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "Kyd9Rz5.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the barbell to shoulder height, keeping your elbows slightly in front of the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra a la altura de los hombros, con los codos algo por delante de ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il bilanciere all'altezza delle spalle, con i gomiti appena davanti alla sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃提起至胸前锁骨高度，手肘置于杠铃略靠前下方。"
     }
    }
   }
  },
  "Kyd9Rz5.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the barbell overhead, extending your arms fully."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra por encima de la cabeza estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere sopra la testa, stendendo bene le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧，将杠铃垂直向上推举至头顶上方，双臂完全伸直。"
     }
    }
   }
  },
  "Kyd9Rz5.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell back to shoulder height and repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra a la altura de los hombros y repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa all'altezza delle spalle e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将杠铃下落回肩胸高度，重复动作至建议的次数。"
     }
    }
   }
  },
  "A6wtbuL.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Standing Overhead Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press militar de pie con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spinte sopra la testa in piedi con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿哑铃推肩"
     }
    }
   }
  },
  "A6wtbuL.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell in each hand at shoulder level with your palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano a la altura de los hombros, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, manubri all'altezza delle spalle e palmi in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各持哑铃置于肩部高度，掌心向前。"
     }
    }
   }
  },
  "A6wtbuL.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbells upward until your arms are fully extended overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las mancuernas hacia arriba hasta estirar los brazos del todo sobre la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i manubri in alto finche le braccia sono tese sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上推举哑铃，直至手臂在头顶上方完全伸直。"
     }
    }
   }
  },
  "A6wtbuL.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the dumbbells back down to shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las mancuernas despacio a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa un attimo in alto, poi riabbassa lentamente all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶峰稍作停顿，随后缓慢将哑铃下放回肩部高度。"
     }
    }
   }
  },
  "A6wtbuL.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "Xy4jlWA.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Arnold Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press Arnold con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Arnold press con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃阿诺德推举"
     }
    }
   }
  },
  "Xy4jlWA.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with back support and hold a dumbbell in each hand at shoulder level, palms facing your body and elbows bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con respaldo y sujeta una mancuerna en cada mano a la altura de los hombros, con las palmas hacia ti y los codos flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti con la schiena appoggiata, manubri all'altezza delle spalle, palmi verso di te e gomiti piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在有靠背的训练凳上，双手持哑铃置于肩前，掌心朝向身体，手肘弯曲。"
     }
    }
   }
  },
  "Xy4jlWA.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbells upward until your arms are fully extended and your palms are facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las mancuernas hacia arriba hasta estirar los brazos del todo, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i manubri in alto finche le braccia sono tese e i palmi guardano in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上推举哑铃，推起过程中旋转手腕，直至手臂伸直且掌心朝向前方。"
     }
    }
   }
  },
  "Xy4jlWA.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate your wrists as you lift, so that your palms are facing forward at the top of the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira las muñecas mientras subes, de modo que arriba las palmas miren hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota i polsi mentre sali, così in alto i palmi guardano avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "推举过程中平稳旋转手腕，使到达最高点时掌心朝向正前方。"
     }
    }
   }
  },
  "Xy4jlWA.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点短暂停顿，然后沿原轨迹旋转并缓慢下放哑铃回起始位置。"
     }
    }
   }
  },
  "Xy4jlWA.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "DsgkuIt.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Lateral Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevaciones laterales con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate laterali con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃侧平举"
     }
    }
   }
  },
  "DsgkuIt.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a dumbbell in each hand, palms facing your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano, con las palmas hacia ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, manubri lungo i fianchi e palmi verso il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各持一只哑铃，掌心朝向身体。"
     }
    }
   }
  },
  "DsgkuIt.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and engage your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y aprieta el core."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸直背，收紧核心肌群。"
     }
    }
   }
  },
  "DsgkuIt.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your arms out to the sides until they are parallel to the floor, keeping a slight bend in your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los brazos a los lados hasta dejarlos paralelos al suelo, con los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alza le braccia lateralmente finche sono parallele al pavimento, con i gomiti appena piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘保持微屈，向身体两侧平稳举起手臂，直至上臂与地面平行。"
     }
    }
   }
  },
  "DsgkuIt.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your arms back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los brazos despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点稍作停顿，然后缓慢将手臂控制下放回起始位置。"
     }
    }
   }
  },
  "DsgkuIt.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
