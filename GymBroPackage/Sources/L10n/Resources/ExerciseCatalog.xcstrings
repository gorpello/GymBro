  },
  "otqIxU4.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a straight bar to a low pulley cable machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una barra recta a una polea baja."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Collega una sbarra dritta a una macchina a cavo con carrucola bassa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在低位绳索滑轮上连接直杆配件。"
     }
    }
   }
  },
  "otqIxU4.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face up on a flat bench with your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba en un banco plano con los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a faccia in su su una panca piana con i piedi piatti a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在平凳上，双脚踩实地面。"
     }
    }
   }
  },
  "otqIxU4.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the bar with an underhand grip, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en supinación, con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra con presa supina, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握直杆，握距与肩同宽。"
     }
    }
   }
  },
  "otqIxU4.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms fully, keeping your elbows close to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos del todo, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi del tutto le braccia, tenendo i gomiti vicini ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂充分伸展，肘部贴紧身体两侧。"
     }
    }
   }
  },
  "otqIxU4.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the bar up towards your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube la barra hacia los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega la sbarra verso le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定，呼气收缩肱二头肌将直杆向上弯举至肩部前方。"
     }
    }
   }
  },
  "61GrD55.name": {
