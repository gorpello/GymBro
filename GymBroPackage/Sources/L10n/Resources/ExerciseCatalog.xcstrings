   }
  },
  "belt-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handles and unload the weight from the support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta las asas y saca el peso del soporte."
     }
    },
