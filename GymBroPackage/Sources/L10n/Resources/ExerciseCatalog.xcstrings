     }
    }
   }
  },
  "seated-dumbbell-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the end of a bench with your feet flat and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de un banco con los pies apoyados y la espalda recta."
     }
    }
   }
  },
  "seated-dumbbell-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand with your arms hanging at your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano con los brazos colgando a los lados."
     }
    }
   }
  },
  "seated-dumbbell-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl the dumbbells up, turning your palms to face up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas girando las palmas hacia arriba."
     }
    }
   }
  },
  "seated-dumbbell-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your biceps at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los bíceps arriba."
     }
    }
   }
  },
  "seated-dumbbell-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells slowly back to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio hasta los costados."
     }
    }
   }
  },
  "single-arm-cable-curl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Arm Cable Curl"
     }
    },
    "es": {
