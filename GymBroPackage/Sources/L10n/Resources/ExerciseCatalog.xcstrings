  "0jp9Rlz.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and place your hands on a wall or sturdy object for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y apoya las manos en una pared o algo resistente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza dei fianchi e appoggia le mani a un muro o a un oggetto solido per equilibrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽站立，双手扶墙或稳固物体以维持平衡。"
     }
    }
   }
  },
  "0jp9Rlz.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift one foot off the ground and balance on the other foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega un pie del suelo y mantén el equilibrio sobre el otro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva un piede da terra e resta in equilibrio sull'altro piede"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬起一侧脚离地，仅靠另一只脚单腿支撑平衡。"
     }
    }
   }
  },
  "0jp9Rlz.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly raise your heel off the ground, lifting your body up onto the ball of your foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el talón despacio, quedándote sobre la punta del pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva lentamente il tallone da terra portando il corpo sull'avampiede"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑脚小腿缓慢发力抬起脚后跟，将身体重心推向前脚掌。"
     }
    }
   }
  },
  "0jp9Rlz.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heel back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el talón despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il tallone fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点停顿收缩片刻，然后缓慢将脚后跟下放回地面。"
     }
    }
   }
  },
  "0jp9Rlz.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch legs and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia gamba e ripeti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成目标次数后换另一条腿重复动作。"
     }
    }
   }
  },
  "wall-calf-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wall Calf Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de gemelo en pared"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch polpacci al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "靠墙小腿拉伸"
     }
    }
   }
  },
  "wall-calf-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing a wall and put both hands on it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de frente a una pared y apoya las dos manos en ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte a un muro e appoggia entrambe le mani al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面朝墙壁站立，双手手掌平贴于墙面上。"
     }
    }
   }
  },
  "wall-calf-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and keep that leg straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva un pie hacia atrás y mantén esa pierna estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro con un piede e tieni quella gamba tesa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一侧脚向后跨出一大步，并保持该腿伸直。"
     }
    }
   }
  },
  "wall-calf-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the back heel into the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Clava el talón de atrás en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Premi il tallone posteriore a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后脚脚跟牢牢踩向地面。"
     }
    }
   }
  },
  "wall-calf-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean towards the wall until you feel the calf stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia la pared hasta notar el estiramiento del gemelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati verso il muro finché senti allungare il polpaccio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体重心逐渐向墙面倾斜，直至后方小腿产生明显的拉伸感。"
     }
    }
   }
  },
  "wall-calf-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold, then swap legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione, poi cambia gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持拉伸姿势一段时间，然后换腿进行。"
     }
    }
   }
  },
  "jump-rope.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump Rope"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saltar a la comba"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salto con la corda"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跳绳"
     }
    }
   }
  },
  "jump-rope.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a handle in each hand with the rope behind your heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un mango con cada mano y deja la cuerda detrás de los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni una maniglia in ogni mano con la corda dietro i talloni"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持跳绳手柄，将绳身自然置于脚后跟后方地面。"
     }
    }
   }
  },
  "jump-rope.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your ribs and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados a las costillas y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti vicini alle costole e il petto alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双肘贴近肋骨两侧，保持胸部挺拔。"
     }
    }
   }
  },
  "jump-rope.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn the rope with your wrists, not your whole arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira la cuerda con las muñecas, no con los brazos enteros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota la corda con i polsi, non con tutte le braccia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "依靠手腕摇动绳子，而非摆动整条手臂。"
     }
    }
   }
  },
  "jump-rope.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hop just high enough to clear the rope, landing on the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta lo justo para pasar la cuerda y cae sobre la parte delantera del pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta appena abbastanza per far passare la corda, atterrando sugli avampiedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跃起高度只需刚好让绳子穿过脚底即可，以前脚掌轻盈落地缓冲。"
     }
    }
   }
  },
  "jump-rope.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a steady rhythm and stay light on your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén un ritmo constante y ligero."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni un ritmo costante e resta leggero sui piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持匀速平稳的呼吸节奏，动作轻盈连贯。"
     }
    }
   }
  },
  "band-calf-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Band Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf raise con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带提踵"
     }
    }
   }
  },
  "band-calf-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with the balls of your feet on the middle of a band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pisa la banda por el centro con la parte delantera de los pies."
     }
    }
   }
  },
  "band-calf-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the ends of the band up at your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta los extremos de la banda a la altura de los hombros."
     }
    }
   }
  },
  "band-calf-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rise up onto your toes as high as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube de puntillas todo lo que puedas."
     }
    }
   }
  },
  "band-calf-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top and squeeze your calves."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba apretando los gemelos."
     }
    }
   }
  },
  "band-calf-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your heels slowly back to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los talones despacio hasta el suelo."
     }
    }
   }
  },
  "LsZkfU6.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Reverse Wrist Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de muñeca inverso con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl inverso dei polsi con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃反向腕弯举"
     }
    }
   }
  },
  "LsZkfU6.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your feet flat on the ground and hold a barbell with an overhand grip, palms facing down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con los pies apoyados en el suelo y sujeta la barra en pronación, con las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con i piedi a terra e tieni un bilanciere con presa prona, palmi in basso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在长凳上，双脚平踏地面，双手正握杠铃（掌心朝下）。"
     }
    }
   }
  },
  "LsZkfU6.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your forearms on your thighs, allowing your wrists to hang off the edge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los antebrazos en los muslos, dejando las muñecas fuera del borde."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia gli avambracci sulle cosce lasciando i polsi fuori dal bordo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将前臂置于大腿上方，手腕悬空于膝盖前沿。"
     }
    }
   }
  },
  "LsZkfU6.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly curl your wrists upward, bringing the barbell towards your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las muñecas despacio, llevando la barra hacia el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fletti lentamente i polsi verso lalto portando il bilanciere verso il corpo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢向上背屈手腕，将杠铃朝身体方向拉近。"
     }
    }
   }
  },
  "LsZkfU6.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il bilanciere fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点顶峰收缩片刻，随后缓慢下放杠铃回到起始拉伸位。"
     }
    }
   }
  },
  "LsZkfU6.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照预定次数重复完成动作。"
     }
    }
   }
  },
  "82LxxkW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Wrist Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de muñeca con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl dei polsi con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃腕弯举"
     }
    }
   }
  },
  "82LxxkW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your feet flat on the ground and your forearms resting on your thighs, holding a barbell with an underhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con los pies apoyados y los antebrazos sobre los muslos, sujetando la barra en supinación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con i piedi a terra e gli avambracci appoggiati sulle cosce, tenendo un bilanciere con presa supina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳上，双脚平踩地面，前臂贴放在大腿上，双手反握杠铃。"
     }
    }
   }
  },
  "82LxxkW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Allow the barbell to roll down to your fingertips, keeping your wrists straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que la barra ruede hasta la punta de los dedos, con las muñecas rectas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia scivolare il bilanciere fino alle dita tenendo i polsi dritti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "允许杠铃缓慢滚落至指尖处，保持手腕稳定。"
     }
    }
   }
  },
  "82LxxkW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly curl the barbell up towards your forearms by flexing your wrists."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra despacio hacia los antebrazos flexionando las muñecas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fletti lentamente il bilanciere verso gli avambracci piegando i polsi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手指并拢收紧，屈腕将杠铃朝前臂方向向上卷起。"
     }
    }
   }
  },
  "82LxxkW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il bilanciere fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点顶峰收缩稍作停顿，随后缓慢将杠铃放回起始位置。"
     }
    }
   }
  },
  "82LxxkW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照目标次数重复完成动作。"
     }
    }
   }
  },
  "Eg98Ft9.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Shrug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimientos en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrollate al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索耸肩"
     }
    }
   }
  },
  "Eg98Ft9.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the cable machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie frente a la polea con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte alla macchina al cavo con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽面向绳索机站立。"
     }
    }
   }
  },
  "Eg98Ft9.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the cable handles with an overhand grip and let your arms hang down in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación y deja los brazos colgando por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie del cavo con presa prona e lascia le braccia tese davanti a te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握绳索把手，让双臂自然垂于身前。"
     }
    }
   }
  },
  "Eg98Ft9.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your arms straight, shrug your shoulders up towards your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos estirados, encoge los hombros hacia las orejas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo le braccia tese, alza le spalle verso le orecchie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手臂伸直，斜方肌发力将双肩向耳朵方向高高耸起。"
     }
    }
   }
  },
  "Eg98Ft9.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contraction for a moment, then slowly lower your shoulders back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento la contracción y baja los hombros despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione un attimo, poi abbassa lentamente le spalle fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩处稍作停顿，随后缓慢下放双肩回到起始位置。"
     }
    }
   }
  },
  "Eg98Ft9.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照目标次数重复完成训练。"
     }
    }
   }
  },
  "7xeukSt.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Scapula Dips"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos escapulares"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip scapolari"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯身肩胛屈伸"
     }
    }
   }
  },
  "7xeukSt.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart and your arms extended in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y los brazos estirados por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in piedi con i piedi alla larghezza delle spalle e le braccia tese davanti a te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双臂在身前向前伸出。"
     }
    }
   }
  },
  "7xeukSt.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees slightly and hinge forward at the hips, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas e inclínate hacia delante desde la cadera, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega leggermente le ginocchia e piegati in avanti sui fianchi tenendo la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "微屈双膝，屈髋向前俯身，保持背部平直。"
     }
    }
   }
  },
  "7xeukSt.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows and retracting your shoulder blades, as if you are trying to squeeze a pencil between them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos y juntando las escápulas, como si quisieras sujetar un lápiz entre ellas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando i gomiti e retraendo le scapole, come per stringere una matita tra di esse"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘并主动后缩下沉肩胛骨，如同在两侧肩胛骨之间夹紧一支铅笔。"
     }
    }
   }
  },
  "7xeukSt.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your hands to extend your elbows and return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con las manos para estirar los codos y volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi spingi sulle mani per estendere i gomiti e tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部稍作停顿，随后双手发力伸展手臂推回起始位置。"
     }
    }
   }
  },
  "7xeukSt.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照目标次数重复完成训练。"
     }
    }
   }
  },
  "uTBt1HV.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Scapular Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas escapulares"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni scapolari"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肩胛引体向上"
     }
    }
   }
  },
  "uTBt1HV.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by hanging from a pull-up bar with your palms facing away from you and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza colgado de la barra en pronación, con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti appeso a una sbarra per trazioni con i palmi lontani da te e le braccia del tutto tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握单杠悬垂起始，掌心朝向前方，双臂完全伸直。"
     }
    }
   }
  },
  "uTBt1HV.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Retract your shoulder blades by pulling them down and back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva las escápulas hacia abajo y atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Retrai le scapole tirandole in basso e indietro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "主动下沉并后缩肩胛骨。"
     }
    }
   }
  },
  "uTBt1HV.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your back muscles and pull your body up towards the bar, focusing on squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la espalda y sube el cuerpo hacia la barra, centrándote en juntar las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva i muscoli della schiena e tira il corpo verso la sbarra stringendo le scapole tra loro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部肌群发力将身体微微向上带起，专注于挤压夹紧两侧肩胛骨。"
     }
    }
   }
  },
  "uTBt1HV.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top of the movement, then slowly lower your body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el cuerpo despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il corpo fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点稍作停顿，随后缓慢下沉身体回到完全悬垂起始位。"
     }
    }
   }
  },
  "uTBt1HV.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照预定次数重复进行。"
     }
    }
   }
  },
  "OUQ0ZyW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Shrug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimientos en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrollate al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯耸肩"
     }
    }
   }
  },
  "OUQ0ZyW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e le ginocchia leggermente piegate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双膝微屈。"
     }
    }
   }
  },
  "OUQ0ZyW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa prona, mani poco più larghe delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正握握住史密斯机杠铃杆，握距略宽于肩宽。"
     }
    }
   }
  },
  "OUQ0ZyW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and your shoulders relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos estirados y los hombros relajados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia tese e le spalle rilassate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双臂伸直，双肩自然放松下垂。"
     }
    }
   }
  },
  "OUQ0ZyW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your shoulders up towards your ears, squeezing your traps at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los hombros hacia las orejas, apretando el trapecio arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le spalle verso le orecchie stringendo i trapezi in alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "斜方肌发力将双肩向耳朵方向向上耸起，在顶点充分挤压。"
     }
    }
   }
  },
  "OUQ0ZyW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for a moment, then slowly lower your shoulders back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y baja los hombros despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un attimo, poi abbassa lentamente le spalle fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持片刻，随后缓慢有控制地下放双肩复原。"
     }
    }
   }
  },
  "FkBIE6a.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Lying Leg Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl femoral tumbado con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg curl da sdraiato con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃俯卧腿弯举"
     }
    }
   }
  },
  "FkBIE6a.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on a flat bench with your knees just off the end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo en un banco plano con las rodillas justo fuera del borde."
     }
    }
   }
  },
  "FkBIE6a.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Have a partner place a dumbbell between your feet and squeeze it tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pide que te pongan una mancuerna entre los pies y apriétala fuerte."
     }
    }
   }
  },
  "FkBIE6a.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl your heels towards your glutes, lifting the dumbbell."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los talones hacia los glúteos levantando la mancuerna."
     }
    }
   }
  },
  "FkBIE6a.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips pressed into the bench at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera pegada al banco arriba."
     }
    }
   }
  },
  "FkBIE6a.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell slowly until your legs are almost straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna despacio hasta casi estirar las piernas."
     }
    }
   }
  },
  "LNE3wfo.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Towel Hamstring Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de isquios con toalla"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allungamento femorali con asciugamano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "毛巾腘绳肌拉伸"
     }
    }
   }
  },
  "LNE3wfo.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back and loop a towel around the sole of one foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba y pasa una toalla por la planta de un pie."
     }
    }
   }
  },
  "LNE3wfo.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold an end of the towel in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo de la toalla con cada mano."
     }
    }
   }
  },
  "LNE3wfo.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten that leg and pull it up towards the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira esa pierna y súbela hacia el techo."
     }
    }
   }
  },
  "LNE3wfo.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel a stretch along the back of the thigh and hold."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en la parte de atrás del muslo y aguanta."
     }
    }
   }
  },
  "LNE3wfo.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the leg slowly and switch sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la pierna despacio y cambia de lado."
     }
    }
   }
  },
  "C5jncD2.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lying Leg Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl femoral tumbado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg curl da sdraiato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧腿弯举"
     }
    }
   }
  },
  "C5jncD2.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on the leg curl machine with the pad just above your heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo en la máquina de femoral con el rodillo justo por encima de los talones."
     }
    }
   }
  },
  "C5jncD2.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Line your knees up with the machine's pivot and hold the handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alinea las rodillas con el eje de la máquina y sujeta las asas."
     }
    }
   }
  },
  "C5jncD2.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl your heels towards your glutes as far as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los talones hacia los glúteos todo lo que puedas."
     }
    }
   }
  },
  "C5jncD2.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your hamstrings at the top without lifting your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los isquiotibiales arriba sin levantar la cadera."
     }
    }
   }
  },
  "C5jncD2.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the pad slowly until your legs are almost straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el rodillo despacio hasta casi estirar las piernas."
     }
    }
   }
  },
  "seated-leg-curl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seated Leg Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl femoral sentado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg curl da seduto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿腿弯举"
     }
    }
   }
  },
  "seated-leg-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit in the machine with the pad resting on your lower shins."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina con el rodillo sobre la parte baja de las espinillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla macchina con il cuscinetto appoggiato alla parte bassa degli stinchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在器械上，将滚轴护垫调节置于小腿后下部（跟腱上方）。"
     }
    }
   }
  },
  "seated-leg-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock the thigh pad down so your legs cannot lift."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el rodillo de los muslos para que las piernas no se levanten."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Blocca il fermo cosce così che le gambe non possano sollevarsi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "压紧并锁定大腿压垫，确保大腿不会向上抬起。"
     }
    }
   }
  },
  "seated-leg-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handles and keep your back against the seat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta las asas y mantén la espalda pegada al respaldo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le maniglie e mantieni la schiena contro il sedile"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握紧两侧把手，背部紧贴靠背。"
     }
    }
   }
  },
  "seated-leg-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl your heels down and back as far as they go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas llevando los talones hacia atrás todo lo que puedas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fletti i talloni in basso e indietro più possibile"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "大腿后侧腘绳肌发力，将小腿向后下方尽力屈卷到底。"
     }
    }
   }
  },
  "seated-leg-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your legs straighten slowly against the resistance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que las piernas se estiren despacio contra la resistencia."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia raddrizzare lentamente le gambe contro la resistenza"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对抗阻力缓慢伸直双腿，受控还原起始位置。"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃罗马尼亚硬拉"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart holding a kettlebell in both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies a la anchura de la cadera y una kettlebell en las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza dei fianchi tenendo una kettlebell con entrambe le mani"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽站立，双手握持一只壶铃。"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a small bend in your knees and your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las rodillas algo flexionadas y la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni una leggera piega nelle ginocchia e la schiena piatta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝保持微屈固定，腰背收紧平直。"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and let the kettlebell slide down your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y deja que la kettlebell baje pegada a las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi indietro e lascia scivolare la kettlebell lungo le gambe"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋主动向后推臀，顺势让壶铃沿大腿贴身下落。"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel a stretch in your hamstrings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en los isquiotibiales."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando senti allungare i femorali"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当大腿后侧腘绳肌感受到充分拉伸张力时停止下放。"
     }
    }
   }
  },
  "kettlebell-romanian-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive your hips forward to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la cadera hacia delante para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi in avanti per tornare in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺髋向前收缩臀大肌，驱动身体重新站直。"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Leg Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano a una pierna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno a una gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿罗马尼亚硬拉"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with a dumbbell in the opposite hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con una mancuerna en la mano contraria."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti su una gamba con un manubrio nella mano opposta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，对侧手持一只哑铃。"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a soft bend in the standing knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la rodilla de apoyo un poco flexionada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni una leggera piega nel ginocchio dappoggio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿膝关节保持微屈稳定。"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward and let the free leg rise behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante dejando que la pierna libre suba por detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti e lascia salire la gamba libera dietro di te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋前倾，同时非支撑腿向后方自然抬起。"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower until your torso and back leg are almost level with the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que el tronco y la pierna queden casi paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati finché busto e gamba posteriore sono quasi paralleli al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯身下落直至躯干与后抬腿接近与地面平行。"
     }
    }
   }
  },
  "single-leg-romanian-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute to come back upright without touching down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo para volver a subir sin apoyar el pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo per tornare dritto senza appoggiare a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑侧臀大肌与腘绳肌发力蹬起拉回直立，后脚不触地即进入下一次。"
     }
    }
   }
  },
  "landmine-romanian-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Landmine Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano landmine"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno landmine"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "地雷管罗马尼亚硬拉"
     }
    }
   }
  },
  "landmine-romanian-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wedge one end of a barbell into a landmine holder and load the other end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encaja un extremo de la barra en el soporte landmine y carga el otro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Incastra un'estremità del bilanciere in un supporto landmine e carica laltra estremità"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃一端插入地雷管固定座中，另一端套上配重片。"
     }
    }
   }
  },
  "landmine-romanian-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the bar and hold the loaded end with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de frente a la barra y sujeta el extremo cargado con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte al bilanciere e tieni l'estremità caricata con entrambe le mani"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面朝杠铃站立，双手共同抱住负重杠铃杆末端。"
     }
    }
   }
  },
  "landmine-romanian-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda plana y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta e le ginocchia leggermente piegate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持腰背平直收紧，双膝微屈固定。"
     }
    }
   }
  },
  "landmine-romanian-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and let the bar travel down your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y deja que la barra baje por los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi indietro e lascia scendere il bilanciere lungo le cosce"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向后推臀，让杠铃沿大腿自然向前下方移动。"
     }
    }
   }
  },
  "landmine-romanian-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive your hips forward to stand up and squeeze your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la cadera hacia delante para subir y aprieta los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi in avanti per alzarti e stringi i glutei"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺髋向前发力站起，顶峰挤压收紧臀大肌。"
     }
    }
   }
  },
  "lying-hamstring-walkout.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lying Hamstring Walkout"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminata de isquios en el suelo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata dei femorali da sdraiato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧腘绳肌漫步延伸"
     }
    }
   }
  },
  "lying-hamstring-walkout.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your knees bent and lift your hips into a bridge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y sube la cadera a puente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le ginocchia piegate e solleva i fianchi in ponte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，双膝弯曲，顶起髋部进入臀桥姿势。"
     }
    }
   }
  },
  "lying-hamstring-walkout.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips up for the whole exercise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera arriba durante todo el ejercicio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi alti per tutto lesercizio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个动作过程中始终保持髋部处于抬起悬空状态。"
     }
    }
   }
  },
  "lying-hamstring-walkout.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your heels out step by step until your legs are almost straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anda con los talones hacia fuera hasta casi estirar las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai camminare i talloni in fuori passo dopo passo finché le gambe sono quasi tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚后跟交替一步步向前迈出，直至双腿接近完全伸直。"
     }
    }
   }
  },
  "lying-hamstring-walkout.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk them back in the same way."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve andando con los talones hacia dentro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riportali indietro allo stesso modo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "随后再以同样的方式，脚后跟交替一步步向内走回臀桥起始位。"
     }
    }
   }
  },
  "lying-hamstring-walkout.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop if your hips start to drop towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para si la cadera empieza a caerse hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati se i fianchi iniziano a scendere verso il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "如果髋部开始下坠触地，则暂停调整并重新顶起臀桥。"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stability Ball Hamstring Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de isquios con fitball"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg curl su fitball"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "瑞士球腘绳肌弯举"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your heels on top of a stability ball."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con los talones encima de un fitball."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con i talloni sopra una palla fitness"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，双脚脚后跟平踩在瑞士健身球顶部。"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your hips so your body forms a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera hasta dejar el cuerpo en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i fianchi così che il corpo formi una linea retta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "顶起髋部，使肩膀、髋部到脚后跟呈一条直线。"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the ball towards your glutes by bending your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca la pelota a los glúteos flexionando las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la palla verso i glutei piegando le ginocchia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝将健身球朝臀部方向用力勾回。"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips high while the ball rolls in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera alta mientras la pelota rueda hacia ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi alti mentre la palla rotola dentro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在球向内滚动的全过程中保持髋部持续高位挺起。"
     }
    }
   }
  },
  "stability-ball-hamstring-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the ball back out slowly until your legs are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira las piernas despacio para devolver la pelota."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la palla di nuovo fuori lentamente finché le gambe sono tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腘绳肌离心控制，缓慢将球蹬出推回双腿伸直状态。"
     }
    }
   }
  },
  "hamstring-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hamstring Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de isquiotibiales"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch femorali"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿单腿腘绳肌拉伸"
     }
    }
   }
  },
  "hamstring-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with one leg straight and the other tucked in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con una pierna estirada y la otra recogida."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con una gamba tesa e laltra piegata dentro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，一条腿向前伸直，另一条腿屈膝脚掌抵在内侧大腿。"
     }
    }
   }
  },
  "hamstring-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back long instead of rounding it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda larga en vez de redondearla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena lunga invece di incurvarla"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺拔延展，避免弯腰弓背。"
     }
    }
   }
  },
  "hamstring-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward over the straight leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante sobre la pierna estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti sopra la gamba tesa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从髋部主动向前折叠俯身，贴向伸直的腿。"
     }
    }
   }
  },
  "hamstring-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach towards your foot until you feel the hamstring pull."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alcanza hacia el pie hasta notar el tirón del isquiotibial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allungati verso il piede finché senti tirare il femorale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手朝脚部方向延伸，直至大腿后侧腘绳肌产生明显拉伸感。"
     }
    }
   }
  },
  "hamstring-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the stretch, then change legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta el estiramiento y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni lallungamento, poi cambia gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "维持静止拉伸一段时间，随后换另一条腿重复。"
     }
    }
   }
  },
  "seated-forward-fold-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seated Forward Fold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión sentado hacia delante"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamento avanti da seduto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿体前屈拉伸"
     }
    }
   }
  },
  "seated-forward-fold-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with both legs straight in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las dos piernas estiradas por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con entrambe le gambe tese davanti a te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，双腿并在身前完全伸直。"
     }
    }
   }
  },
  "seated-forward-fold-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit up tall on your sit bones."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido apoyado en los isquiones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alto sugli ischi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐骨坐实地面，脊柱向上自然挺立。"
     }
    }
   }
  },
  "seated-forward-fold-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge from your hips and reach towards your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate desde la cadera y estira las manos hacia los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati dai fianchi e allungati verso i piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从髋关节处主动向前折叠俯身，双手朝双脚方向延伸。"
     }
    }
   }
  },
  "seated-forward-fold-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your head and neck relax as you fold."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que la cabeza y el cuello se relajen al doblarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia rilassare testa e collo mentre ti pieghi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯身折叠时放松头部和颈部。"
     }
    }
   }
  },
  "seated-forward-fold-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold and breathe into the stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta y respira dentro del estiramiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni e respira nell'allungamento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持拉伸姿势，配合均匀深长地呼吸。"
     }
    }
   }
  },
  "kettlebell-swing.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Swing"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Swing con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Swing con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃摆动"
     }
    }
   }
  },
  "kettlebell-swing.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet a little wider than your hips, kettlebell on the floor in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies algo más abiertos que la cadera y la kettlebell en el suelo delante de ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi poco più larghi dei fianchi e la kettlebell a terra davanti a te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚站距略宽于髋部，壶铃置于身体前方的地面上。"
     }
    }
   }
  },
  "kettlebell-swing.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge at the hips, grab the handle with both hands and hike it back between your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás, agarra el asa con las dos manos y pasa la pesa entre las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati sui fianchi, afferra il manico con entrambe le mani e lanciala indietro tra le gambe"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋后推铰链，双手握住壶铃手柄，将其向后摆引至两腿之间。"
     }
    }
   }
  },
  "kettlebell-swing.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Snap your hips forward hard so the bell swings up to chest height on its own."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la cadera hacia delante con fuerza y deja que la pesa suba sola a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi forte i fianchi in avanti così che la kettlebell salga da sola all'altezza del petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "猛烈向前伸髋发力，依靠爆发力将壶铃自然摆动至胸部高度。"
     }
    }
   }
  },
  "kettlebell-swing.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms relaxed and your back flat the whole way."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos relajados y la espalda plana todo el recorrido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia rilassate e la schiena piatta per tutto il movimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个过程手臂放松不主动上提，始终保持背部平直。"
     }
    }
   }
  },
  "kettlebell-swing.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the bell fall back between your legs and load the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que baje otra vez entre las piernas y encadena la siguiente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia ricadere la kettlebell tra le gambe e carica la ripetizione successiva"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "让壶铃自然下落回两腿之间，顺势蓄力进行下一次动作。"
     }
    }
   }
  },
  "kettlebell-goblet-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Goblet Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla goblet con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Goblet squat con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃高脚杯深蹲"
     }
    }
   }
  },
  "kettlebell-goblet-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the kettlebell by the horns against your chest, elbows tucked in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la kettlebell por los cuernos contra el pecho, con los codos pegados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la kettlebell per i corni contro il petto con i gomiti stretti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住壶铃角柄贴紧胸前，手肘自然下垂内收。"
     }
    }
   }
  },
  "kettlebell-goblet-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your feet shoulder-width apart with your toes turned out slightly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pies a la anchura de los hombros y puntas ligeramente hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia i piedi alla larghezza delle spalle con le punte leggermente in fuori"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "kettlebell-goblet-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit down between your heels, keeping your chest tall and the bell close."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate entre los talones, con el pecho alto y la pesa cerca del cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti tra i talloni tenendo il petto alto e la kettlebell vicina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋下蹲，胸部挺直，壶铃保持贴紧躯干。"
     }
    }
   }
  },
  "kettlebell-goblet-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go as deep as your hips allow without your lower back rounding."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta donde te deje la cadera sin que la lumbar se redondee."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi quanto permettono i fianchi senza arrotondare la zona lombare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在下背部不反弓弯屈的前提下，下蹲至髋部最大舒适深度。"
     }
    }
   }
  },
  "kettlebell-goblet-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through the floor to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja contra el suelo para subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul pavimento per tornare in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全脚掌蹬地发力站起回到起始姿势。"
     }
    }
   }
  },
  "kettlebell-front-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Front Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla frontal con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Front squat con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃前蹲"
     }
    }
   }
  },
  "kettlebell-front-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Clean one kettlebell to the rack position, resting on your forearm and chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una kettlebell a la posición de rack, apoyada en el antebrazo y el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta una kettlebell in posizione di rack, appoggiata su avambraccio e petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将单只壶铃翻至胸前架位（Rack），壶铃贴靠在前臂与胸口处。"
     }
    }
   }
  },
  "kettlebell-front-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the wrist straight and the elbow pointing down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la muñeca recta y el codo apuntando hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il polso dritto e il gomito verso il basso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手腕保持中立挺直，肘尖朝前下方支撑。"
     }
    }
   }
  },
  "kettlebell-front-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat down with your torso upright and the bell locked in place."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja en sentadilla con el torso erguido y la pesa bien fijada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accosciati con il busto dritto e la kettlebell ben ferma"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干挺拔、壶铃锁定在位，屈髋屈膝下蹲。"
     }
    }
   }
  },
  "kettlebell-front-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up without letting the bell drift forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube sin dejar que la pesa se te vaya hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali senza far scivolare in avanti la kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蹬地站起，防止壶铃向前滑动或重心偏移。"
     }
    }
   }
  },
  "kettlebell-front-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do all your reps on one side, then swap."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz todas las repeticiones de un lado y cambia."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai tutte le ripetizioni da un lato, poi cambia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成单侧设定的次数后，换另一侧进行。"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Sumo Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto sumo con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco sumo con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃相扑硬拉"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand over the kettlebell with a wide stance and your toes turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate sobre la kettlebell con los pies muy abiertos y las puntas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sopra la kettlebell con gambe larghe e punte in fuori"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚大幅宽距站立于壶铃两侧，脚尖外展约45度。"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge down and grab the handle with both hands, arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja llevando la cadera atrás y agarra el asa con las dos manos, brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati e afferra il manico con entrambe le mani, braccia tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋屈膝下沉，双手伸直握住壶铃把手。"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your core, then stand up by squeezing your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y sube apretando los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core, poi alzati stringendo i glutei"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，收紧臀大肌发力站起至身体中立。"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the bell travelling in a straight line close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Que la pesa suba en línea recta y pegada al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la kettlebell in linea retta vicina al corpo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "提拉过程中壶铃始终紧贴身体呈垂直轨迹上升。"
     }
    }
   }
  },
  "kettlebell-sumo-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it back to the floor under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájala al suelo controlando el movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassala a terra in modo controllato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制节奏，平稳将壶铃放回地面。"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Single-Leg Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto a una pierna con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco a una gamba con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃单腿硬拉"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a kettlebell in one hand and stand on the opposite leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una kettlebell con una mano y apóyate en la pierna contraria."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni una kettlebell in una mano e stai sulla gamba opposta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单手持壶铃，对侧单腿支撑站立。"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward, letting the free leg extend straight behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante dejando que la pierna libre se estire atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti lasciando la gamba libera tesa dietro di te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿微屈，做髋关节铰链前倾，非支撑腿向后平稳延伸。"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips level and your back flat as the bell lowers."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las caderas niveladas y la espalda plana mientras baja la pesa."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi pari e la schiena piatta mentre la kettlebell scende"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下放壶铃时保持骨盆中立不侧倾，背部平直。"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel the hamstring of the standing leg load up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes cargado el isquiotibial de la pierna de apoyo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando senti caricare il femorale della gamba dappoggio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "降至支撑腿后侧腘绳肌产生充分拉伸感时停止。"
     }
    }
   }
  },
  "kettlebell-single-leg-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute to come back upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo per tornare dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧臀肌发力伸髋，平稳拉回至直立姿态。"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Reverse Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada atrás con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo indietro con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃后退箭步蹲"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the kettlebell against your chest in the goblet position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la kettlebell contra el pecho, en posición goblet."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la kettlebell contro il petto in posizione goblet"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手持壶铃置于胸前高脚杯位置保持稳定。"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and lower until the back knee nearly touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás y baja hasta que la rodilla de detrás casi toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro con un piede e scendi finché il ginocchio posteriore quasi tocca terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单脚向后迈出一大步，顺势下蹲至后膝几乎贴地。"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your front shin vertical and your torso upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espinilla de delante vertical y el torso erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni lo stinco anteriore verticale e il busto dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前腿小腿保持接近垂直地面，躯干挺拔核心收紧。"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front foot to return to standing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el pie de delante para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul piede anteriore per tornare in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚脚跟蹬地发力，收回后腿恢复直立站姿。"
     }
    }
   }
  },
  "kettlebell-reverse-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Alternate legs or finish one side first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna piernas o acaba primero un lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna le gambe oppure finisci prima un lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "可双腿交替进行或先完成单侧全部次数。"
     }
    }
   }
  },
  "kettlebell-single-arm-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Single-Arm Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo a una mano con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore a un braccio con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃单臂划船"
     }
    }
   }
  },
  "kettlebell-single-arm-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward with one hand braced on a bench or your thigh."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante con una mano apoyada en un banco o en el muslo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti con una mano appoggiata a una panca o alla coscia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯身前倾，另一手支撑在平凳或同侧大腿上稳定躯干。"
     }
    }
   }
  },
  "kettlebell-single-arm-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the kettlebell hang at full stretch from the other hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que la kettlebell cuelgue con el brazo estirado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia la kettlebell appesa a braccio teso nell'altra mano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持铃侧手臂完全下垂伸展，充分拉伸背部背阔肌。"
     }
    }
   }
  },
  "kettlebell-single-arm-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the bell to your hip, leading with the elbow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de la pesa hacia la cadera, llevando el codo primero."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la kettlebell verso il fianco guidando con il gomito"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘引领发力向后上方拉动壶铃至髋部侧面。"
     }
    }
   }
  },
  "kettlebell-single-arm-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the shoulder blade at the top without twisting your torso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la escápula arriba sin girar el torso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi la scapola in alto senza ruotare il busto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作顶部收紧背阔肌并夹紧肩胛骨，避免躯干旋转借力。"
     }
    }
   }
  },
  "kettlebell-single-arm-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it slowly and repeat, then swap sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio y repite; luego cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassala lentamente e ripeti, poi cambia lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制离心速度缓缓下放至起始位置，完成后换边。"
     }
    }
   }
  },
  "kettlebell-overhead-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Overhead Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press militar con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spinte sopra la testa con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃过顶推举"
     }
    }
   }
  },
  "kettlebell-overhead-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with the kettlebell racked at shoulder height, wrist straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con la kettlebell en rack a la altura del hombro, muñeca recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti con la kettlebell in rack all'altezza della spalla, polso dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃置于肩部架位，手腕保持中立挺直。"
     }
    }
   }
  },
  "kettlebell-overhead-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your core and squeeze your glutes so your ribs stay down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y los glúteos para que las costillas no se abran."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core e stringi i glutei per tenere basse le costole"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心与臀大肌，下沉肋骨避免腰部反弓。"
     }
    }
   }
  },
  "kettlebell-overhead-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bell straight overhead until your elbow locks out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la pesa recta por encima de la cabeza hasta estirar el codo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la kettlebell dritta sopra la testa finché il gomito è teso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将壶铃垂直向上推举至手臂完全伸直锁定。"
     }
    }
   }
  },
  "kettlebell-overhead-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish with the bell sitting behind your wrist, not in front."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acaba con la pesa detrás de la muñeca, no delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Finisci con la kettlebell dietro il polso, non davanti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "推起至顶部时壶铃应稳定位于手腕后侧上方。"
     }
    }
   }
  },
  "kettlebell-overhead-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it back to the rack position under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájala a la posición de rack controlando."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassala in posizione di rack in modo controllato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平稳控制壶铃沿原轨迹下放回肩部架位。"
     }
    }
   }
  },
  "kettlebell-push-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Push Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press con impulso con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Push press con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃借力推举"
     }
    }
   }
  },
  "kettlebell-push-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rack the kettlebell at shoulder height with your feet under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la kettlebell en rack a la altura del hombro, pies bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la kettlebell in rack all'altezza della spalla con i piedi sotto i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃稳定架于肩前，双脚与髋同宽站立。"
     }
    }
   }
  },
  "kettlebell-push-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip slightly at the knees, keeping your torso vertical."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas manteniendo el torso vertical."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega leggermente le ginocchia tenendo il busto verticale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "膝盖微屈顺势浅蹲下潜，躯干始终保持垂直。"
     }
    }
   }
  },
  "kettlebell-push-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive up with your legs and let that push the bell overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con las piernas y deja que ese impulso suba la pesa."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi con le gambe e lascia che la spinta porti la kettlebell sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿迅速蹬伸爆发发力，将力量顺势传导将壶铃推过头顶。"
     }
    }
   }
  },
  "kettlebell-push-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock the elbow out at the top with the bell over your shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el codo arriba con la pesa sobre el hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Blocca il gomito in alto con la kettlebell sopra la spalla"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶部手臂完全锁定，壶铃稳于肩关节正上方。"
     }
    }
   }
  },
  "kettlebell-push-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring it back to the rack and reset before the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a la posición de rack y recolócate antes de la siguiente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riportala in rack e preparati prima della ripetizione successiva"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓冲接回至肩前架位，调整呼吸准备下一次动作。"
     }
    }
   }
  },
  "kettlebell-high-pull.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell High Pull"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "High pull con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tirata alta con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃高拉"
     }
    }
   }
  },
  "kettlebell-high-pull.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up as if for a swing, kettlebell between your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate como para un swing, con la kettlebell entre los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Posizionati come per uno swing, kettlebell tra i piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起始姿势同壶铃摆动，壶铃置于两脚之间。"
     }
    }
   }
  },
  "kettlebell-high-pull.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge and hike the bell back, then snap your hips forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás, pasa la pesa entre las piernas y empuja la cadera hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati e lancia indietro la kettlebell, poi spingi forte i fianchi in avanti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋摆引壶铃后迅速前顶伸髋爆发发力。"
     }
    }
   }
  },
  "kettlebell-high-pull.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As the bell rises, pull your elbow high and back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando la pesa sube, tira del codo alto y hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre la kettlebell sale, tira il gomito in alto e indietro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在壶铃上升时顺势将手肘向后上方高高拉起。"
     }
    }
   }
  },
  "kettlebell-high-pull.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The bell should end up in front of your shoulder, not overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "La pesa acaba delante del hombro, no por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "La kettlebell deve arrivare davanti alla spalla, non sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点壶铃应处于胸前高度，避免拉至头顶上方。"
     }
    }
   }
  },
  "kettlebell-high-pull.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Guide it back down into the next hinge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acompáñala de vuelta hacia el siguiente movimiento de cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Guidala di nuovo in basso nel piegamento successivo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "顺势下放壶铃进入下一次屈髋铰链缓冲。"
     }
    }
   }
  },
  "kettlebell-shrug.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Shrug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimientos con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrollate con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃耸肩"
     }
    }
   }
  },
  "kettlebell-shrug.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall holding a kettlebell in each hand at your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie y erguido, con una kettlebell en cada mano a los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti dritto in piedi tenendo una kettlebell in ogni mano lungo i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自然站直，双手各持一只壶铃垂于身体两侧。"
     }
    }
   }
  },
  "kettlebell-shrug.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and your chin tucked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos estirados y la barbilla recogida."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia tese e il mento rientrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂自然伸直，下巴微收，颈椎中立。"
     }
    }
   }
  },
  "kettlebell-shrug.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your shoulders straight up towards your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los hombros en línea recta hacia las orejas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le spalle dritte verso le orecchie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双肩垂直向上提起，向耳朵靠拢。"
     }
    }
   }
  },
  "kettlebell-shrug.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top without rolling the shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba sin rotar los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto senza ruotare le spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点挤压斜方肌停留片刻，切忌耸肩时前后打滚旋转。"
     }
    }
   }
  },
  "kettlebell-shrug.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower them slowly all the way down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájalos despacio hasta el final."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassale lentamente fino in basso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平稳缓慢下落至完全拉伸状态。"
     }
    }
   }
  },
  "kettlebell-farmer-carry.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Farmer Carry"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Paseo del granjero con kettlebells"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata del contadino con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃农夫行走"
     }
    }
   }
  },
  "kettlebell-farmer-carry.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick up a heavy kettlebell in each hand and stand tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge una kettlebell pesada en cada mano y ponte erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prendi una pesante kettlebell in ogni mano e stai dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各提一只大重量壶铃，挺胸直立站好。"
     }
    }
   }
  },
  "kettlebell-farmer-carry.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulders back and brace your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los hombros atrás y aprieta el abdomen."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le spalle indietro e contrai il core"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沉肩夹背并收紧核心，保持骨盆稳定中立。"
     }
    }
   }
  },
  "kettlebell-farmer-carry.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk in a straight line with short, controlled steps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina en línea recta con pasos cortos y controlados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina in linea retta con passi corti e controllati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "迈着小而稳健的步伐沿直线向前匀速行走。"
     }
    }
   }
  },
  "kettlebell-farmer-carry.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do not let your torso lean or the bells swing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No dejes que el torso se incline ni que las pesas se balanceen."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non lasciare piegare il busto né oscillare le kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "行走过程中躯干严禁左右摇摆倾斜，避免壶铃晃动碰撞。"
     }
    }
   }
  },
  "kettlebell-farmer-carry.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set them down when your grip starts to give out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Déjalas en el suelo cuando el agarre empiece a fallar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggiale quando la presa inizia a cedere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "握力耗尽前平稳放回地面。"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Overhead Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti sopra la testa con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃颈后臂屈伸"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold one kettlebell by the horns with both hands overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una kettlebell por los cuernos con las dos manos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni una kettlebell per i corni con entrambe le mani sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住壶铃角柄，高举过头顶。"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows pointing forward and close to your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos apuntando al frente y cerca de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti in avanti e vicini alla testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘朝向正前方，大臂贴近头部两侧保持稳定。"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend at the elbows to lower the bell behind your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos para bajar la pesa por detrás de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti per abbassare la kettlebell dietro la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘将壶铃缓慢下放至颈后。"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel the stretch in your triceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en el tríceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando senti allungare i tricipiti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下放至肱三头肌感受到充分拉伸时停顿。"
     }
    }
   }
  },
  "kettlebell-overhead-tricep-extension.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms to press it back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos para volver a subirla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stendi le braccia per spingerla di nuovo in alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩肱三头肌伸直手臂推回过顶起始位。"
     }
    }
   }
  },
  "kettlebell-russian-twist.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Russian Twist"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Giro ruso con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Twist russo con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃俄罗斯转体"
     }
    }
   }
  },
  "kettlebell-russian-twist.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with your knees bent and heels lightly down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las rodillas dobladas y los talones apenas apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con le ginocchia piegate e i talloni leggermente appoggiati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐于瑜伽垫上，屈膝，双脚脚跟轻点地面或悬空。"
     }
    }
   }
  },
  "kettlebell-russian-twist.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the kettlebell by the horns in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la kettlebell por los cuernos delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la kettlebell per i corni davanti al petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手持壶铃角柄置于胸前。"
     }
    }
   }
  },
  "kettlebell-russian-twist.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly and lift your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate un poco hacia atrás y saca pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati leggermente indietro e solleva il petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躯干略微后倾，挺胸收腹收紧核心肌肉群。"
     }
    }
   }
  },
  "kettlebell-russian-twist.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate your torso to take the bell beside one hip, then the other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira el torso para llevar la pesa junto a una cadera y luego a la otra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota il busto per portare la kettlebell a fianco di un fianco, poi dell'altro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "旋转肋骨与躯干，带动壶铃轻转至一侧髋旁，再换至另一侧。"
     }
    }
   }
  },
  "kettlebell-russian-twist.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move from the ribs, not just the arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El giro sale de las costillas, no solo de los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muoviti dalle costole, non solo dalle braccia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "由核心主动发力转动，避免仅用手臂晃动摆弄。"
     }
    }
   }
  },
  "kettlebell-side-bend.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kettlebell Side Bend"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión lateral con kettlebell"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti laterali con kettlebell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "壶铃体侧屈"
     }
    }
   }
  },
  "kettlebell-side-bend.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with a kettlebell hanging in one hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie y erguido, con una kettlebell colgando de una mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti dritto in piedi con una kettlebell appesa in una mano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚开立与髋同宽，单手持壶铃垂直垂于身体一侧。"
     }
    }
   }
  },
  "kettlebell-side-bend.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put your free hand behind your head and keep your hips square."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la mano libre detrás de la cabeza y mantén la cadera fija."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti la mano libera dietro la testa e tieni i fianchi fermi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "另一手抱头或置于腰间，骨盆保持正对前方固定不动。"
     }
    }
   }
  },
  "kettlebell-side-bend.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend sideways towards the loaded side, letting the bell slide down your leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia el lado cargado dejando que la pesa baje por la pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati di lato verso il lato carico lasciando scivolare la kettlebell lungo la gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体向负重侧缓慢侧屈下落，让壶铃沿大腿外侧滑动。"
     }
    }
   }
  },
  "kettlebell-side-bend.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Come back up by pulling with the opposite side of your waist."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube tirando con el costado contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali tirando con il lato opposto della vita"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "依靠对侧腹斜肌主动收缩发力将躯干拉回直立位置。"
     }
    }
   }
  },
  "kettlebell-side-bend.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish the set, then swap hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acaba la serie y cambia de mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Finisci la serie, poi cambia mano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成一组后换手进行另一侧练习。"
     }
    }
   }
  },
  "rNG1dip.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环臂屈伸"
     }
    }
   }
  },
  "rNG1dip.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the rings at hip height and grip them with your palms facing in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las anillas a la altura de la cadera y agárralas con las palmás hacia dentro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至髋部高度，掌心相对握紧吊环。"
     }
    }
   }
  },
  "rNG1dip.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump into support with your arms locked and the rings turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete al apoyo con los brazos bloqueados y las anillas giradas hacia fuera."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跳起进入支撑位，双臂伸直锁死，吊环向外翻转。"
     }
    }
   }
  },
  "rNG1dip.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest between the rings, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho entre las anillas con los codos pegados al cuerpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下沉胸部至两环之间，保持双肘贴近身体。"
     }
    }
   }
  },
  "rNG1dip.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up to lockout and turn the rings out again at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hasta estirar los brazos y vuelve a girar las anillas arriba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "推起至直臂锁死，在最高点再次将吊环向外翻转。"
     }
    }
   }
  },
  "rNG1dip.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your shoulders down and your body still through every rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los hombros abajo y el cuerpo quieto en cada repetición."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程沉肩稳定，每次动作都保持身体平稳。"
     }
    }
   }
  },
  "rNG2pus.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Push-Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环俯卧撑"
     }
    }
   }
  },
  "rNG2pus.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang the rings a few centimetres off the floor and take a plank on them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja las anillas a unos centímetros del suelo y ponte en plancha sobre ellas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环降至离地数厘米处，双手撑环呈平板支撑姿势。"
     }
    }
   }
  },
  "rNG2pus.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes and abs so your body holds one straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta glúteos y abdomen para que el cuerpo quede en línea recta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧臀部和核心，使身体从头到脚呈一条直线。"
     }
    }
   }
  },
  "rNG2pus.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest to ring height, letting the rings drift out slightly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hasta la altura de las anillas dejando que se abran un poco."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将胸部下沉至吊环高度，允许吊环自然向外微展。"
     }
    }
   }
  },
  "rNG2pus.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up and pull the rings back under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para subir y vuelve a meter las anillas bajo los hombros."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上推起，顺势将吊环收回至双肩正下方。"
     }
    }
   }
  },
  "rNG2pus.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The higher the rings, the easier it gets, so set them to suit you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuanto más altas estén las anillas, más fácil es: ponlas a tu nivel."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环高度越高动作越容易，可根据自身水平调节。"
     }
    }
   }
  },
  "rNG3fly.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Chest Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环飞鸟夹胸"
     }
    }
   }
  },
  "rNG3fly.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the rings at chest height and lean forward with arms out in front."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las anillas a la altura del pecho e inclínate hacia delante con los brazos al frente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至胸部高度，双手前伸握环，身体前倾。"
     }
    }
   }
  },
  "rNG3fly.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a soft bend in your elbows and your body in one line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja los codos ligeramente flexionados y el cuerpo en línea."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肘部微屈锁紧，全程保持身体平直。"
     }
    }
   }
  },
  "rNG3fly.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open your arms out to the sides, letting your chest stretch under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los brazos hacia los lados dejando que el pecho se estire, siempre controlado."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂受控向两侧张开，充分感受胸肌的拉伸感。"
     }
    }
   }
  },
  "rNG3fly.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the rings back together by squeezing your chest, not by bending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta las anillas apretando el pecho, no doblando los brazos."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "通过胸肌发力向内夹拢吊环，切忌靠手臂屈伸代偿。"
     }
    }
   }
  },
  "rNG3fly.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet back to make it harder, forward to make it easier."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Echa los pies atrás para que cueste mas, adelante para que cueste menos."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚向后走难度加大，向前走则更轻松。"
     }
    }
   }
  },
  "rNG4tri.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环三头伸展"
     }
    }
   }
  },
  "rNG4tri.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the rings at waist height and lean forward with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las anillas a la altura de la cintura e inclínate con los brazos estirados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至腰部高度，双臂伸直，身体前倾支撑。"
     }
    }
   }
  },
  "rNG4tri.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in one line from head to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo en línea de la cabeza a los talones."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，使身体从头到脚跟呈一条直线。"
     }
    }
   }
  },
  "rNG4tri.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend only at the elbows, letting your hands travel over your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dobla solo los codos y deja que las manos pasen por encima de la cabeza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仅弯曲肘部，让双手移动至头部上方。"
     }
    }
   }
  },
  "rNG4tri.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your forearms reach the rings, then press back to straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando los antebrazos lleguen a las anillas y estira los brazos otra vez."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当前臂贴近吊环时停顿，随后伸直手臂推回起始位置。"
     }
    }
   }
  },
  "rNG4tri.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows pointing forward the whole way."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los codos apuntan hacia delante durante todo el recorrido."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作全程保持双肘朝向正前方，不要向两侧外展。"
     }
    }
   }
  },
  "cable-lying-triceps-extension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Lying Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps tumbado en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensioni tricipiti da sdraiato al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索仰卧臂屈伸"
     }
    }
   }
  },
  "cable-lying-triceps-extension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a flat bench with one end facing a low pulley."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un banco plano con un extremo mirando a la polea baja."
     }
    }
   }
  },
  "cable-lying-triceps-extension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a short straight bar and lie on the bench with your head towards the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una barra corta y túmbate con la cabeza hacia la torre."
     }
    }
   }
  },
  "cable-lying-triceps-extension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the bar with a narrow overhand grip and your arms straight up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra con agarre estrecho y los brazos estirados hacia arriba."
     }
    }
   }
  },
  "cable-lying-triceps-extension.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows to lower the bar behind your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos para bajar la barra por detrás de la cabeza."
     }
    }
   }
  },
  "cable-lying-triceps-extension.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms again without moving your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a estirar los brazos sin mover los codos."
     }
    }
   }
  },
  "single-arm-cable-pushdown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Arm Cable Pushdown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps a una mano en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pushdown a un braccio al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单臂绳索下压"
     }
    }
   }
  },
  "single-arm-cable-pushdown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a pulley at the top and attach a single handle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la polea arriba del todo con un agarre simple."
     }
    }
   }
  },
  "single-arm-cable-pushdown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Face the stack and hold the handle with an underhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de cara a la torre y sujeta el agarre con la palma hacia arriba."
     }
    }
   }
  },
  "single-arm-cable-pushdown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbow pinned to your side and your knees soft."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el codo pegado al costado y las rodillas relajadas."
     }
    }
   }
  },
  "single-arm-cable-pushdown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the handle down until your arm is straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el agarre hacia abajo hasta estirar el brazo."
     }
    }
   }
  },
  "single-arm-cable-pushdown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let it rise slowly and switch arms after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Déjalo subir despacio y cambia de brazo al acabar la serie."
     }
    }
   }
  },
  "barbell-incline-triceps-extension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Incline Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps inclinado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensioni tricipiti su panca inclinata con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜杠铃臂屈伸"
     }
    }
   }
  },
  "barbell-incline-triceps-extension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie back on an incline bench holding a barbell with a close grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco inclinado sujetando la barra con agarre estrecho."
     }
    }
   }
  },
  "barbell-incline-triceps-extension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar up until it sits above your head with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra hasta tenerla sobre la cabeza con los brazos estirados."
     }
    }
   }
  },
  "barbell-incline-triceps-extension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms still and pointing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos quietos y apuntando hacia arriba."
     }
    }
   }
  },
