  "rNGbrol.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your abs and squeeze your glutes so your back stays flat."
     }
    },
    "es": {
