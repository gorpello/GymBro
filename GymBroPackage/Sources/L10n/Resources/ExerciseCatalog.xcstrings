     "stringUnit": {
      "state": "translated",
      "value": "Set the rings at hip height and hang underneath with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las anillas a la altura de la cadera y cuelgate debajo con los brazos estirados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至髋部高度，仰卧于环下直臂悬垂。"
     }
    }
   }
  },
  "rNG7row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet out until your body is one straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina con los pies hacia delante hasta que el cuerpo quede en línea recta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向前迈出，直到身体呈一条倾斜的直线。"
     }
    }
   }
  },
  "rNG7row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the rings to your ribs, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de las anillas hacia las costillas juntando las escápulas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环拉向肋骨两侧，向内收紧夹拢肩胛骨。"
     }
    }
   }
  },
  "rNG7row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Touch the rings to your sides, pause, and lower under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca los costados con las anillas, aguanta un momento y baja controlando."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环触及身体两侧时停顿片刻，然后受控缓慢下放。"
     }
    }
   }
  },
  "rNG7row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The flatter your body, the harder the row."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuanto más horizontal estés, más duro es el remo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体越接近水平，划船的难度越高。"
     }
    }
   }
  },
  "rNG8fac.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Face Pull"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Face pull en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环面拉"
     }
    }
   }
  },
  "rNG8fac.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the rings at head height and lean back with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta las anillas a la altura de la cabeza y échate atrás con los brazos estirados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至头部高度，握住吊环向后倾斜，双臂伸直。"
     }
    }
   }
  },
  "rNG8fac.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in one line from shoulders to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo en línea de los hombros a los talones."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，保持从肩部到脚跟呈一条直线。"
     }
    }
   }
  },
  "rNG8fac.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the rings apart and towards your forehead, elbows high."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira separando las anillas hacia la frente, con los codos altos."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬高双肘，将吊环向两侧拉向额头前方。"
     }
    }
   }
  },
  "rNG8fac.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your rear shoulders for a second at the end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la parte trasera de los hombros un segundo al final."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰停顿一秒，用力收缩三角肌后束。"
     }
    }
   }
  },
  "rNG8fac.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower slowly and keep your neck relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio y con el cuello relajado."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢还原，全程保持颈部放松。"
     }
    }
   }
  },
  "rNG9cur.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Biceps Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环二头弯举"
     }
    }
   }
  },
  "rNG9cur.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the rings with palms up and lean back with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las anillas con las palmás hacia arriba y échate atrás con los brazos estirados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "掌心朝上握住吊环，身体向后倾斜，双臂伸直。"
     }
    }
   }
  },
  "rNG9cur.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock your body in one line and keep your elbows high and still."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bloquea el cuerpo en línea y deja los codos altos y quietos."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体绷成一条直线，保持大臂抬高且静止不动。"
     }
    }
   }
  },
  "rNG9cur.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl yourself up by bending only at the elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete doblando solo los codos."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仅依靠肘部弯曲将身体向上拉起。"
     }
    }
   }
  },
  "rNG9cur.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your hands beside your head, then lower under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva las manos junto a la cabeza y baja controlando."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双手拉至头部两侧，随后受控缓慢下放。"
     }
    }
   }
  },
  "rNG9cur.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step your feet forward to make it harder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Adelanta los pies para que cueste más."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向前迈步可增加动作难度。"
     }
    }
   }
  },
  "cable-preacher-curl.name": {
   "extractionState": "manual",
   "localizations": {
