   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a decline bench with your feet secured under the foot pads."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con los pies sujetos bajo las almohadillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con i piedi bloccati sotto i supporti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，将双脚牢固卡在固定海绵滚轮下方。"
     }
    }
   }
  },
  "EZeDVzO.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands behind your head or across your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las manos detrás de la cabeza o cruzadas sobre el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti le mani dietro la testa o incrociate sul petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手抱在脑后或交叉抱负重物于胸前。"
     }
    }
   }
  },
  "EZeDVzO.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your abs and slowly lift your upper body off the bench, curling forward until your torso is perpendicular to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y despega el tronco del banco despacio, enrollándote hasta quedar perpendicular al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva gli addominali e solleva lentamente il busto dalla panca, piegandoti in avanti finché il torso è perpendicolare al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧腹部肌肉，缓慢将上半身抬离斜凳并向前卷起，直至躯干垂直于地面。"
     }
    }
   }
  },
  "EZeDVzO.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your upper body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el tronco despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il busto per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶峰停顿片刻感受腹肌收缩，然后缓慢控制上半身下放回原位。"
     }
    }
   }
  },
  "EZeDVzO.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "uWpxD4v.name": {
   "extractionState": "manual",
   "localizations": {
