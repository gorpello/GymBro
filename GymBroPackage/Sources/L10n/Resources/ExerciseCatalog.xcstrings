   }
  },
  "flat-bench-cable-fly.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your feet flat and your back against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los pies apoyados y la espalda pegada al banco."
