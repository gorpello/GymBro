   }
  },
  "cable-internal-rotation.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handle with the arm nearest the stack, elbow bent at 90 degrees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el agarre con el brazo más cercano a la torre y el codo a 90 grados."
     }
    }
   }
  },
  "cable-internal-rotation.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbow tucked against your side the whole time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el codo pegado al costado todo el rato."
     }
    }
   }
  },
  "cable-internal-rotation.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate your forearm across your stomach without moving the elbow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira el antebrazo hasta cruzarlo por delante del abdomen sin mover el codo."
     }
    }
   }
  },
  "cable-internal-rotation.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the handle return slowly and switch sides after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja volver el agarre despacio y cambia de lado al acabar la serie."
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Arm Dumbbell Shoulder Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de hombro a una mano con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lento a un braccio con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单臂哑铃肩推"
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your abs tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y el abdomen firme."
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold one dumbbell at shoulder height with your elbow bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna a la altura del hombro con el codo flexionado."
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbell straight up until your arm is fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la mancuerna hacia arriba hasta estirar el brazo del todo."
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your torso upright without leaning to the side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el tronco recto sin inclinarte hacia un lado."
     }
    }
   }
  },
  "single-arm-dumbbell-shoulder-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell back to your shoulder and switch arms after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna al hombro y cambia de brazo al acabar la serie."
     }
    }
   }
  },
  "assisted-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Assisted Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla asistida"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat assistito"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "辅助深蹲"
     }
    }
   }
  },
  "assisted-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a door frame, a pole or a suspension strap at arm length."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a un marco de puerta, a un poste o a unas cinchas con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggrappati a uno stipite, a un palo o a delle cinghie con le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂伸直，抓住门框、立柱或悬挂带。"
     }
    }
   }
  },
  "assisted-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet a little wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca los pies algo más abiertos que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti i piedi poco più larghi delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚站得比肩略宽。"
     }
    }
   }
  },
  "assisted-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit back and down, using your hands only as much as you need."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate hacia atrás y abajo, ayudándote con las manos solo lo justo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti indietro e in basso, aiutandoti con le mani solo quanto serve."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部向后向下坐，双手只用需要的力量辅助。"
     }
    }
   }
  },
  "assisted-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go as deep as you can while keeping your heels on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja todo lo que puedas sin levantar los talones del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi più che puoi tenendo i talloni a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在脚跟不离地的前提下尽量蹲深。"
     }
    }
   }
  },
  "assisted-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your whole foot to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con todo el pie para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi con tutto il piede per tornare in piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个脚掌发力站起来。"
     }
    }
   }
  },
  "bulgarian-split-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bulgarian Split Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla búlgara sin peso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Bulgarian split squat a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重保加利亚分腿蹲"
     }
    }
   }
  },
  "bulgarian-split-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand a stride in front of a bench or a chair."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie a un paso por delante de un banco o una silla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi a un passo davanti a una panca o a una sedia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在长凳或椅子前方一步的位置。"
     }
    }
   }
  },
  "bulgarian-split-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest the top of your back foot on it behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya el empeine del pie de atrás encima del banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il collo del piede posteriore sulla panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把后脚脚背搭在长凳上。"
     }
    }
   }
  },
  "bulgarian-split-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower straight down until your back knee almost touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja en vertical hasta que la rodilla de atrás casi toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi in verticale finché il ginocchio dietro sfiora il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "垂直下蹲，直到后侧膝盖几乎触地。"
     }
    }
   }
  },
  "bulgarian-split-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest tall and your front shin close to vertical."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y la espinilla de delante casi vertical."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e la tibia davanti quasi verticale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸，前侧小腿接近垂直。"
     }
    }
   }
  },
  "bulgarian-split-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front heel to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi con il tallone davanti per risalire."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用前脚脚跟发力站起来。"
     }
    }
   }
  },
  "beginner-shrimp-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Beginner Shrimp Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla shrimp principiante"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shrimp squat principiante"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "初级虾式深蹲"
     }
    }
   }
  },
  "beginner-shrimp-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with the other knee bent and that foot lifted behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con la otra rodilla doblada y ese pie levantado detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi su una gamba con l'altro ginocchio piegato e quel piede sollevato dietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，另一条腿屈膝把脚抬到身后。"
     }
    }
   }
  },
  "beginner-shrimp-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach both arms forward for balance instead of holding the back foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los dos brazos hacia delante en vez de sujetarte el pie de atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta entrambe le braccia in avanti invece di tenere il piede posteriore."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂向前伸出保持平衡，不用手抓后脚。"
     }
    }
   }
  },
  "beginner-shrimp-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until the back knee and the toes of that foot rest on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta apoyar en el suelo la rodilla y los dedos de ese pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finché il ginocchio e le dita di quel piede si appoggiano a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲到后侧膝盖和该脚的脚尖都落地。"
     }
    }
   }
  },
  "beginner-shrimp-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your standing heel down and your chest up throughout."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el talón de apoyo pegado al suelo y el pecho alto todo el rato."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il tallone di appoggio a terra e il petto alto per tutto il movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程保持支撑腿脚跟着地、胸口打开。"
     }
    }
   }
  },
  "beginner-shrimp-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through the standing leg to come back to standing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con la pierna de apoyo para volver a ponerte de pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi con la gamba di appoggio per tornare in piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿发力回到站姿。"
     }
    }
   }
  },
  "intermediate-shrimp-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Intermediate Shrimp Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla shrimp intermedia"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shrimp squat intermedio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "中级虾式深蹲"
     }
    }
   }
  },
  "intermediate-shrimp-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg and hold the other foot behind you with the same-side hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna y sujétate el otro pie por detrás con la mano del mismo lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi su una gamba e tieni l'altro piede dietro con la mano dello stesso lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，用同侧手抓住身后另一只脚。"
     }
    }
   }
  },
  "intermediate-shrimp-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach your free arm forward to help you balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva el brazo libre hacia delante para ayudarte a mantener el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il braccio libero in avanti per aiutarti a stare in equilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "空出的手臂向前伸出帮助保持平衡。"
     }
    }
   }
  },
  "intermediate-shrimp-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until the back knee touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que la rodilla de atrás toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finché il ginocchio dietro tocca il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲到后侧膝盖触地。"
     }
    }
   }
  },
  "intermediate-shrimp-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your chest lean forward as far as you need to stay over the standing foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclina el pecho hacia delante lo que haga falta para quedarte sobre el pie de apoyo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclina il petto in avanti quanto serve per restare sopra il piede di appoggio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上身可以前倾，幅度以重心留在支撑脚上为准。"
     }
    }
   }
  },
  "intermediate-shrimp-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up without letting the back foot touch down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube de nuevo sin dejar que el pie de atrás toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali senza lasciare che il piede dietro tocchi terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起身时不要让后脚落地。"
     }
    }
   }
  },
  "weighted-shrimp-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Shrimp Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla shrimp lastrada"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shrimp squat zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重虾式深蹲"
     }
    }
   }
  },
  "weighted-shrimp-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wear a weighted vest or hold a plate against your chest with your free hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte un chaleco lastrado o sujeta un disco contra el pecho con la mano libre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Indossa un giubbotto zavorrato o tieni un disco contro il petto con la mano libera."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "穿上负重背心，或用空出的手把杠铃片抱在胸前。"
     }
    }
   }
  },
  "weighted-shrimp-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg and hold the other foot behind you with the same-side hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna y sujétate el otro pie por detrás con la mano del mismo lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi su una gamba e tieni l'altro piede dietro con la mano dello stesso lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，用同侧手抓住身后另一只脚。"
     }
    }
   }
  },
  "weighted-shrimp-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself under control until the back knee touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja de forma controlada hasta que la rodilla de atrás toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi in modo controllato finché il ginocchio dietro tocca il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "有控制地下蹲，直到后侧膝盖触地。"
     }
    }
   }
  },
  "weighted-shrimp-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and your standing heel flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y el talón de apoyo plano en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e il tallone di appoggio ben piantato a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸，支撑腿脚掌平贴地面。"
     }
    }
   }
  },
  "weighted-shrimp-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up to standing without letting the back foot touch down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subir sin dejar que el pie de atrás toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali senza lasciare che il piede dietro tocchi terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起身回到站姿，全程不让后脚落地。"
     }
    }
   }
  },
  "barbell-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondi con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃弓步"
     }
    }
   }
  },
  "barbell-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest a barbell across your upper back with a grip wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda con un agarre más ancho que los hombros."
     }
    }
   }
  },
  "barbell-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y el pecho alto."
     }
    }
   }
  },
  "barbell-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a long step forward with one leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso largo hacia delante con una pierna."
     }
    }
   }
  },
  "barbell-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your back knee until it is just above the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla de atrás hasta que casi toque el suelo."
     }
    }
   }
  },
  "barbell-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front heel to step back and switch legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver y cambia de pierna."
     }
    }
   }
  },
  "barbell-reverse-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Reverse Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada atrás con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondi indietro con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃后撤弓步"
     }
    }
   }
  },
  "barbell-reverse-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a barbell from the rack onto your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y apóyala en la parte alta de la espalda."
     }
    }
   }
  },
  "barbell-reverse-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and your abs tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y el abdomen firme."
     }
    }
   }
  },
  "barbell-reverse-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back with one leg and lower your back knee towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás con una pierna y baja la rodilla de atrás hacia el suelo."
     }
    }
   }
  },
  "barbell-reverse-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your front shin upright and your chest tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espinilla de delante vertical y el pecho alto."
     }
    }
   }
  },
  "barbell-reverse-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through the front foot to return and switch legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el pie de delante para volver y cambia de pierna."
     }
    }
   }
  },
  "dumbbell-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃深蹲"
     }
    }
   }
  },
  "dumbbell-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet slightly wider than your shoulders and a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies algo más abiertos que los hombros y una mancuerna en cada mano."
     }
    }
   }
  },
  "dumbbell-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the dumbbells hang at your sides with your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja colgar las mancuernas a los lados con los brazos estirados."
     }
    }
   }
  },
  "dumbbell-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit your hips back and bend your knees as if sitting on a chair."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y flexiona las rodillas como si te sentaras en una silla."
     }
    }
   }
  },
  "dumbbell-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go down as far as you can while keeping your heels on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja todo lo que puedas sin despegar los talones del suelo."
     }
    }
   }
  },
  "dumbbell-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your heels to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para volver a subir."
     }
    }
   }
  },
  "barbell-step-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Step-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Subida al cajón con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Step-up con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃登阶"
     }
    }
   }
  },
  "barbell-step-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a sturdy box or bench in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca un cajón o banco firme delante de ti."
     }
    }
   }
  },
  "barbell-step-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest a barbell across your upper back with a wide grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda con un agarre ancho."
     }
    }
   }
  },
  "barbell-step-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step up with one foot and drive through that heel to stand on the box."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube un pie y empuja con ese talón hasta quedar de pie encima del cajón."
     }
    }
   }
  },
  "barbell-step-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back down with the same leg first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja primero con la misma pierna."
     }
    }
   }
  },
  "barbell-step-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish the set and repeat leading with the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Termina la serie y repite empezando con la otra pierna."
     }
    }
   }
  },
  "hack-squat-machine.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hack Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla hack en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hack squat alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械哈克深蹲"
     }
    }
   }
  },
  "hack-squat-machine.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step into the hack squat machine with your back and shoulders against the pads."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Métete en la máquina de hack con la espalda y los hombros pegados a los apoyos."
     }
    }
   }
  },
  "hack-squat-machine.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your feet shoulder-width apart in the middle of the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon los pies a la anchura de los hombros en el centro de la plataforma."
     }
    }
   }
  },
  "hack-squat-machine.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Release the safety handles and bend your knees to lower yourself."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta los seguros y flexiona las rodillas para bajar."
     }
    }
   }
  },
  "hack-squat-machine.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go down until your thighs are about parallel to the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden más o menos paralelos a la plataforma."
     }
    }
   }
  },
  "hack-squat-machine.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heels to straighten your legs without locking your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para estirar las piernas sin bloquear las rodillas."
     }
    }
   }
  },
  "negative-dip.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Negative Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondo negativo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip negativi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "离心慢放双杠臂屈伸"
     }
    }
   }
  },
  "negative-dip.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump or step up to the top of the dip bars with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete de un salto o con un escalón hasta arriba de las paralelas, con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Saltando o con uno scalino, portati in cima alle parallele con le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跳上或踩台阶到双杠顶端，手臂伸直支撑。"
     }
    }
   }
  },
  "negative-dip.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulders down and keep your chest slightly forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los hombros y deja el pecho ligeramente adelantado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa le spalle e tieni il petto leggermente in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下沉肩膀，胸口略微前倾。"
     }
    }
   }
  },
  "negative-dip.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows and lower yourself as slowly as you can, counting to three."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dobla los codos y baja tan despacio como puedas, contando hasta tres."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti e scendi il più lentamente possibile, contando fino a tre."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘，数三秒尽量缓慢地下放身体。"
     }
    }
   }
  },
  "negative-dip.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your shoulders drop below your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando los hombros queden por debajo de los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando le spalle scendono sotto i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当肩膀降到肘部以下时停住。"
     }
    }
   }
  },
  "negative-dip.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back up to the top and start the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subirte arriba y empieza la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali in cima e inizia la ripetizione successiva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重新撑回顶端，开始下一次。"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bodyweight Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano sin peso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重罗马尼亚硬拉"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with your feet hip-width apart and your hands on your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y las manos sobre los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza dei fianchi e le mani sulle cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽站立，双手放在大腿上。"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a soft bend in your knees and your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja las rodillas ligeramente dobladas y la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le ginocchia appena piegate e la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "膝盖保持微屈，背部挺平。"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and slide your hands down your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera hacia atrás y desliza las manos por las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il bacino indietro e fai scorrere le mani lungo le gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋部向后推，双手沿腿部下滑。"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel a stretch along the back of your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en la parte de atrás del muslo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando senti tirare dietro le cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当大腿后侧有牵拉感时停住。"
     }
    }
   }
  },
  "bodyweight-romanian-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes to bring your hips back under you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos para llevar la cadera de nuevo bajo el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei per riportare il bacino sotto il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "夹紧臀部，把髋部送回身体正下方。"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bodyweight Single-Leg Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto a una pierna sin peso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco a una gamba a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重单腿硬拉"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with a soft bend in that knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con esa rodilla algo doblada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi su una gamba con quel ginocchio appena piegato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，支撑腿膝盖保持微屈。"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward at the hip and let the free leg rise straight behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona la cadera hacia delante y deja que la pierna libre suba estirada por detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fletti l'anca in avanti e lascia salire la gamba libera tesa dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋部前屈，让另一条腿伸直向后抬起。"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach your hands towards the floor and keep your hips level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva las manos hacia el suelo y mantén la cadera nivelada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le mani verso il pavimento e tieni il bacino in linea."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手向地面伸展，保持骨盆不歪斜。"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your torso and back leg are almost parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando el tronco y la pierna de atrás estén casi paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando il busto e la gamba dietro sono quasi paralleli al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当躯干和后腿接近与地面平行时停住。"
     }
    }
   }
  },
  "bodyweight-single-leg-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute to stand back up without touching the free foot down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo para subir sin apoyar el pie libre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo per risalire senza appoggiare il piede libero."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部发力起身，全程不让空出的脚落地。"
     }
    }
   }
  },
  "banded-nordic-curl-negative.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Nordic Curl Negative"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl nórdico negativo con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nordic curl negativo con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带北欧挺离心"
     }
    }
   }
  },
  "banded-nordic-curl-negative.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on a pad with your ankles held down by a partner or a heavy anchor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas sobre una colchoneta con los tobillos sujetos por un compañero o un anclaje pesado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in ginocchio su un tappetino con le caviglie bloccate da un compagno o da un ancoraggio pesante."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪在垫子上，让同伴或重物牢牢压住脚踝。"
     }
    }
   }
  },
  "banded-nordic-curl-negative.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band around your chest and anchor it above and behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa una banda alrededor del pecho y ánclala por encima y por detrás de ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Passa un elastico intorno al petto e fissalo sopra e dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把弹力带绕过胸口，固定在身体后上方。"
     }
    }
   }
  },
  "banded-nordic-curl-negative.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips straight so your body makes one line from knees to shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera estirada para que el cuerpo forme una línea de las rodillas a los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'anca distesa così che il corpo formi una linea dalle ginocchia alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋部保持伸直，让膝盖到肩膀连成一条直线。"
     }
    }
   }
  },
  "banded-nordic-curl-negative.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself forward as slowly as you can and let your hands catch you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hacia delante tan despacio como puedas y deja que las manos te frenen."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi in avanti il più lentamente possibile e lascia che le mani ti fermino."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽量缓慢地向前倒，最后用双手撑住地面。"
     }
    }
   }
  },
  "banded-nordic-curl-negative.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back up with your arms and reset for the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subir empujando con los brazos y prepárate para la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali spingendo con le braccia e preparati alla ripetizione successiva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用手臂把自己推回起始位置，准备下一次。"
     }
    }
   }
  },
