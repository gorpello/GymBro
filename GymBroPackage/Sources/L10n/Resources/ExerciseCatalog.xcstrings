  },
  "captains-chair-knee-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into the captain's chair with your forearms on the pads."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en la silla romana con los antebrazos en las almohadillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sistemati sulla sedia del capitano con gli avambracci sui cuscini"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "步入罗马椅提膝架中，双前臂平稳支撑在臂垫上，双手握紧手柄。"
     }
    }
   }
  },
  "captains-chair-knee-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your legs hang straight with your back against the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja las piernas colgando rectas y la espalda apoyada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia le gambe penzoloni dritte con la schiena contro lo schienale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部紧靠背垫，双腿自然伸直下垂。"
     }
    }
   }
  },
  "captains-chair-knee-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift both knees towards your chest without swinging."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las dos rodillas hacia el pecho sin coger impulso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva entrambe le ginocchia verso il petto senza oscillare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧，平稳将双膝向胸部抬起，避免身体借力晃动。"
     }
    }
   }
  },
  "captains-chair-knee-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl your hips up slightly at the top of the rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Enrolla un poco la cadera hacia arriba al final del recorrido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Arriccia leggermente i fianchi in alto alla fine della ripetizione"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点将骨盆微微向上卷动，进一步挤压下腹。"
     }
    }
   }
  },
  "captains-chair-knee-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your legs slowly until they hang straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las piernas despacio hasta dejarlas colgando otra vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente le gambe finché tornano dritte e penzoloni"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放双腿，直到恢复自然垂直悬垂姿势。"
     }
    }
   }
  },
  "bicycle-crunch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicycle Crunch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicicleta abdominal"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch bicicletta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "空中自行车卷腹"
     }
    }
   }
  },
  "bicycle-crunch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your hands lightly behind your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las manos apoyadas suavemente detrás de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati supino con le mani leggere dietro la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双手轻扶在耳旁或脑后。"
     }
    }
   }
  },
  "bicycle-crunch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your shoulders off the floor and bring your knees up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega los hombros del suelo y sube las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le spalle e porta su le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肩胛骨抬离地面，双腿离地屈膝抬起。"
     }
    }
   }
  },
  "bicycle-crunch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring one elbow towards the opposite knee as you extend the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva un codo hacia la rodilla contraria mientras estiras la otra pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta un gomito verso il ginocchio opposto, stendendo l'altra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躯干扭转向一侧，一侧手肘朝对侧膝盖靠拢，同时另一条腿向前完全蹬伸。"
     }
    }
   }
  },
  "bicycle-crunch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Switch sides in a slow, controlled pedalling motion."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia de lado pedaleando despacio y con control."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna i lati con un movimento lento e controllato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "像蹬自行车一样，缓慢且有控制地交替切换双腿和肘部方向。"
     }
    }
   }
  },
  "bicycle-crunch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your lower back pressed into the floor throughout."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la zona lumbar pegada al suelo todo el rato."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la zona lombare premuta a terra per tutto il tempo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程保持下背部紧贴地面，不要弓腰。"
     }
    }
   }
  },
  "mountain-climber.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Mountain Climber"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escaladores"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mountain climber"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "登山跑"
     }
    }
   }
  },
  "mountain-climber.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a push-up position with your hands under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en posición de flexión con las manos bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in posizione di piegamento, mani sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以俯卧撑姿势起始，双手撑地位于双肩正下方。"
     }
    }
   }
  },
  "mountain-climber.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in a straight line and your core braced."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo en línea recta y el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo in linea e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体从头到脚保持一条直线，核心持续收紧发力。"
     }
    }
   }
  },
  "mountain-climber.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive one knee towards your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva una rodilla hacia el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta un ginocchio verso il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝发力将一侧膝盖提拉冲向胸口方向。"
     }
    }
   }
  },
  "mountain-climber.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swap legs quickly, as if you were running in place."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia de pierna rápido, como si corrieras en el sitio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia gamba in fretta, come correre sul posto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "快速交替双腿，如同在地面进行原地冲刺跑。"
     }
    }
   }
  },
  "mountain-climber.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips low and your shoulders over your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera baja y los hombros sobre las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi bassi e le spalle sopra le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程保持臀部下沉不翘臀，肩膀始终位于手腕正上方。"
     }
    }
   }
  },
  "dead-bug.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dead Bug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicho muerto"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dead bug"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "死虫式"
     }
    }
   }
  },
  "dead-bug.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your arms up and your knees over your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con los brazos arriba y las rodillas sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati supino con le braccia in alto e le ginocchia sopra le anche."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双臂伸直指向天花板，大腿垂直于地面、小腿平行屈膝90度。"
     }
    }
   }
  },
  "dead-bug.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your lower back into the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplasta la zona lumbar contra el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Schiaccia la zona lombare contro il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将下背部完全贴紧地面，骨盆保持中立。"
     }
    }
   }
  },
  "dead-bug.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower one arm overhead and the opposite leg towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja un brazo por encima de la cabeza y la pierna contraria hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa un braccio sopra la testa e la gamba opposta verso terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制核心，一侧手臂向头顶上方缓慢下落，同时对侧腿向地面方向伸展下放。"
     }
    }
   }
  },
  "dead-bug.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop just before your back arches and come back to the start."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para justo antes de que la espalda se arquee y vuelve al inicio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati prima che la schiena si inarchi e torna alla partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在背部即将拱起前及时停止下探，然后平稳还原至起始姿态。"
     }
    }
   }
  },
  "dead-bug.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Alternate sides on every rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna los lados en cada repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna i lati a ogni ripetizione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "每次动作左右交替进行。"
     }
    }
   }
  },
  "bird-dog.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bird Dog"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuadrupedia alterna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Bird dog"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "鸟狗式"
     }
    }
   }
  },
  "bird-dog.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get on all fours with your hands under your shoulders and knees under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con las manos bajo los hombros y las rodillas bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a quattro zampe con le mani sotto le spalle e le ginocchia sotto i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈四足跪姿，双手位于肩部正下方，双膝位于髋部正下方。"
     }
    }
   }
  },
  "bird-dog.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat and your neck in line with your spine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda plana y el cuello en línea con la columna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta e il collo in linea con la colonna"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部平直，颈部与脊柱呈一条直线，不抬头不塌腰。"
     }
    }
   }
  },
  "bird-dog.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach one arm forward and the opposite leg back at the same time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira un brazo hacia delante y la pierna contraria hacia atrás a la vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi in avanti un braccio e contemporaneamente all'indietro la gamba opposta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同时将一侧手臂向前伸直延伸，对侧腿向后蹬直延伸。"
     }
    }
   }
  },
  "bird-dog.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for a second without letting your hips tilt."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un segundo sin que la cadera se incline."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un secondo senza far inclinare i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持骨盆水平不倾斜，在顶峰定住停顿1秒。"
     }
    }
   }
  },
  "bird-dog.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return to all fours and swap sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a cuatro patas y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna a quattro zampe e cambia lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢收回至四足跪姿，然后换另一侧交替进行。"
     }
    }
   }
  },
  "pallof-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pallof Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press Pallof"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pallof press"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "帕洛夫推举"
     }
    }
   }
  },
  "pallof-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a cable at chest height and stand side-on to the machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la polea a la altura del pecho y colócate de lado a la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta un cavo all'altezza del petto e mettiti di lato rispetto alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将绳索滑轮调整至胸部高度，侧对器械站立。"
     }
    }
   }
  },
  "pallof-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handle with both hands against your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el agarre con las dos manos pegado al pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la maniglia con entrambe le mani contro il petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手合握把手，置于胸骨正前方。"
     }
    }
   }
  },
  "pallof-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step away until the cable pulls you towards the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sepárate hasta que el cable tire de ti hacia la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allontanati finché il cavo ti tira verso il pacco pesi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向外侧横移一步，使绳索拉紧并产生将躯干拉向器械的横向旋转力。"
     }
    }
   }
  },
  "pallof-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your hands straight out in front of you without twisting."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira las manos rectas hacia delante sin girar el tronco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le mani dritte davanti a te senza ruotare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心强力抗旋转，双手平直向前推出，身体保持正对前方绝不扭转。"
     }
    }
   }
  },
  "pallof-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the handle back to your chest under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve el agarre al pecho controlando el peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta la maniglia al petto sotto controllo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制肌肉发力，缓慢将把手收回至胸前。"
     }
    }
   }
  },
  "half-kneeling-pallof-press.name": {
   "extractionState": "manual",
   "localizations": {
