      "state": "translated",
      "value": "单臂绳索弯举"
     }
    }
   }
  },
  "single-arm-cable-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a single handle to a low pulley and stand side-on to the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un agarre simple en la polea baja y colócate de lado a la torre."
     }
    }
   }
  },
  "single-arm-cable-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handle with your palm facing up and your arm straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el agarre con la palma hacia arriba y el brazo estirado."
     }
    }
   }
  },
  "single-arm-cable-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbow still at your side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el codo quieto junto al costado."
     }
    }
   }
  },
  "single-arm-cable-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl the handle up towards your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el agarre hacia el pecho."
     }
    }
   }
  },
  "single-arm-cable-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it slowly and switch arms after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájalo despacio y cambia de brazo al acabar la serie."
     }
    }
   }
  },
