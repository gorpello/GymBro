     }
    }
   }
  },
  "61GrD55.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, curl the bar towards your chest by contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, sube la barra hacia el pecho contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, piega la sbarra verso il petto contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂稳定，收缩肱二头肌将直杆向胸口上方弯举拉起。"
     }
    }
   }
  },
  "1V1gj1u.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Seated Close-grip Concentration Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl concentrado sentado con barra y agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl di concentrazione da seduto a presa stretta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃坐姿窄距集中弯举"
     }
    }
   }
  },
  "1V1gj1u.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your feet flat on the floor and hold a barbell with an underhand grip, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con los pies apoyados en el suelo y sujeta la barra en supinación, con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con i piedi piatti a terra e tieni un bilanciere con presa supina, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳上，双脚平踩地面，双手反握杠铃，握距稍窄。"
     }
    }
   }
  },
  "1V1gj1u.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your upper arms against your inner thighs, just above your knees, and let the barbell hang down in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los brazos contra la cara interna de los muslos, justo encima de las rodillas, y deja la barra colgando por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le braccia all'interno delle cosce, appena sopra le ginocchia, e lascia il bilanciere penzolare davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将大臂内侧抵在大腿内侧略高于膝盖的位置，让杠铃垂在身前。"
     }
    }
   }
  },
  "1V1gj1u.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the barbell up towards your shoulders, contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube la barra hacia los hombros contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega il bilanciere verso le spalle, contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定贴实大腿，呼气收缩肱二头肌，将杠铃向上弯举至肩前。"
     }
    }
   }
  },
  "1V1gj1u.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause, then inhale and slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción, coge aire y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per una breve pausa, poi inspira e abbassa lentamente il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点顶峰收缩停顿片刻，然后吸气缓慢将杠铃下放回原位。"
     }
    }
   }
  },
  "1V1gj1u.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "2NImIAG.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Bicep Curl on Exercise Ball with Leg Raised"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps en fitball con pierna elevada"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl su fitball con gamba sollevata"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "瑜伽球单腿悬空哑铃弯举"
     }
    }
   }
  },
  "2NImIAG.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on an exercise ball with your feet flat on the ground and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un fitball con los pies apoyados en el suelo y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una palla fitness con i piedi piatti a terra e la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在健身球上，初始双脚平放地面，背部挺直收紧核心。"
     }
    }
   }
  },
  "2NImIAG.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand with your palms facing forward and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano con las palmas hacia delante y los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in ogni mano con i palmi rivolti in avanti e le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，手臂自然下垂，掌心朝前。"
     }
    }
   }
  },
  "2NImIAG.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly curl the dumbbells towards your shoulders, keeping your elbows close to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas despacio hacia los hombros, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega lentamente i manubri verso le spalle, tenendo i gomiti vicini ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肘部夹紧体侧，缓慢收缩二头肌将哑铃弯举向肩部。"
     }
    }
   }
  },
  "2NImIAG.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top of the movement, then slowly lower the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto nel movimento, poi abbassa lentamente i manubri fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点停顿片刻挤压二头肌，随后缓慢将哑铃下放回原位。"
     }
    }
   }
  },
  "2NImIAG.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "While performing the bicep curl, raise one leg off the ground and hold it in the air for the duration of the exercise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mientras haces el curl, levanta una pierna del suelo y mantenla en el aire durante todo el ejercicio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre fai il curl per i bicipiti, solleva una gamba da terra e tienila in aria per tutta la durata dell'esercizio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在弯举过程中抬起一条腿悬空保持平衡，完成整组后再换另一侧。"
     }
    }
   }
  },
  "4dUn2iv.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Standing Close Grip Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de pie con barra y agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl in piedi a presa stretta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃站姿窄握弯举"
     }
    }
   }
  },
  "4dUn2iv.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with your feet shoulder-width apart and hold a barbell with an underhand grip, hands close together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en supinación, con las manos juntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto con i piedi alla larghezza delle spalle e tieni un bilanciere con presa supina, mani vicine tra loro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立，双脚与肩同宽，双手反握杠铃且两手间距较窄。"
     }
    }
   }
  },
  "4dUn2iv.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your torso and your upper arms stationary throughout the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados al cuerpo y los brazos quietos durante todo el movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti vicini al busto e le braccia ferme per tutto il movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个动作过程中手肘贴紧躯干，大臂保持固定。"
     }
    }
   }
  },
  "4dUn2iv.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Exhale as you curl the weights while contracting your biceps. Continue to raise the bar until your biceps are fully contracted and the bar is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire mientras subes el peso contrayendo el bíceps. Sigue subiendo la barra hasta contraerlo del todo, con la barra a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira mentre pieghi i pesi contraendo i bicipiti. Continua a sollevare la sbarra finché i bicipiti sono completamente contratti e la sbarra è alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气收缩肱二头肌向上弯举，直到二头肌充分收缩且杠铃升至肩部高度。"
     }
    }
   }
  },
  "4dUn2iv.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per una breve pausa mentre stringi i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点停顿片刻，全力挤压收缩肱二头肌。"
     }
    }
   }
  },
  "4dUn2iv.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale as you slowly begin to bring the barbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire mientras devuelves la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira mentre riporti lentamente il bilanciere alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，控制节奏缓慢将杠铃放回起始位置。"
     }
    }
   }
  },
  "incline-dumbbell-curl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Incline Dumbbell Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl inclinado con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl su panca inclinata con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜哑铃弯举"
     }
    }
   }
  },
  "incline-dumbbell-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a bench to about 60 degrees and sit back against it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un banco a unos 60 grados y siéntate apoyando la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclina la panca a circa 60 gradi e siediti appoggiato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将健身凳靠背调节至约60度角，背部贴实靠垫坐好。"
     }
    }
   }
  },
  "incline-dumbbell-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let both arms hang straight down with a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja los dos brazos colgando estirados con una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia le braccia tese lungo i fianchi, un manubrio per mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，双臂自然垂直下垂。"
     }
    }
   }
  },
  "incline-dumbbell-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl the dumbbells up without letting your elbows drift forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas sin dejar que los codos se vayan hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fletti senza far avanzare i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上弯举哑铃，注意保持手肘固定，避免肘部向前移动借力。"
     }
    }
   }
  },
  "incline-dumbbell-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your biceps at the top of the curl."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los bíceps arriba del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i bicipiti in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在弯举顶点顶峰挤压收紧肱二头肌。"
     }
    }
   }
  },
  "incline-dumbbell-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the weights slowly until your arms are fully straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el peso despacio hasta estirar los brazos por completo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa lentamente finche le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢控制下放哑铃，直至双臂完全伸直伸展。"
     }
    }
   }
  },
  "J6Dx1Mu.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Close-grip Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca con barra y agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca stretta con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃窄握卧推"
     }
    }
   }
  },
  "J6Dx1Mu.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your back pressed against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati piatto su una panca con i piedi piatti a terra e la schiena premuta contro la panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在平凳上，双脚踩实地面，背部紧贴凳面。"
     }
    }
   }
  },
  "J6Dx1Mu.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with a close grip, slightly narrower than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra cerrado, algo más estrecho que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa stretta, poco più stretta delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住杠铃，握距略窄于肩宽。"
     }
    }
   }
  },
  "J6Dx1Mu.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the barbell and lower it slowly towards your chest, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y bájala despacio hacia el pecho, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca il bilanciere e abbassalo lentamente verso il petto, tenendo i gomiti vicini al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "出架后缓慢将杠铃下落至胸口，手肘始终内收贴近身体。"
     }
    }
   }
  },
  "J6Dx1Mu.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment when the barbell touches your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento cuando la barra toque el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa quando il bilanciere tocca il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当杠铃轻触胸口时稍作停顿。"
     }
    }
   }
  },
  "J6Dx1Mu.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the barbell back up to the starting position, fully extending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra de vuelta a la posición inicial estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere di nuovo alla posizione iniziale, estendendo del tutto le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肱三头肌发力将杠铃向上推回起始位置，双臂伸直。"
     }
    }
   }
  },
  "7jGOBF3.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Close Grip Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press con mancuernas y agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spinte a presa stretta con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃窄距推胸 (对握卧推)"
     }
    }
   }
  },
  "7jGOBF3.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a flat bench with a dumbbell in each hand, resting on your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco plano con una mancuerna en cada mano, apoyadas en los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca piana con un manubrio in ogni mano, appoggiati alle cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳边缘，双手各握一只哑铃竖放在大腿上。"
     }
    }
   }
  },
  "7jGOBF3.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Using your thighs to help raise the dumbbells, lift the dumbbells one at a time so that you can hold them in front of you at shoulder width."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ayúdate de los muslos para subir las mancuernas de una en una y sujetarlas delante de ti, a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Usando le cosce per aiutarti a sollevare i manubri, sollevali uno alla volta così da tenerli davanti a te alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺下的同时顺势用大腿将哑铃借力顶起，举至胸前与肩同宽。"
     }
    }
   }
  },
  "7jGOBF3.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once at shoulder width, rotate your wrists forward so that the palms of your hands are facing away from you. This will be your starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ya a esa altura, gira las muñecas hacia delante para que las palmas miren hacia fuera. Esa es la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una volta alla larghezza delle spalle, ruota i polsi in avanti così che i palmi guardino lontano da te. Questa sarà la posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整手腕，使掌心朝向前方（或相对并拢），此为起始姿势。"
     }
    }
   }
  },
  "7jGOBF3.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you breathe in, slowly lower the dumbbells to your side until they are about level with your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y baja las mancuernas despacio a los lados, hasta la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre inspiri, abbassa lentamente i manubri di lato finché sono circa al livello del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，缓慢将哑铃下放至身体两侧，与胸部齐平，手肘贴近身体。"
     }
    }
   }
  },
  "7jGOBF3.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you exhale, use your triceps to lift the dumbbells back to the starting position. Make sure to use only your triceps and do not use your forearms or biceps to help lift the dumbbells."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire y sube las mancuernas con el tríceps hasta la posición inicial. Tira solo con el tríceps, sin ayudarte de antebrazos ni bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre espiri, usa i tricipiti per sollevare i manubri alla posizione iniziale. Usa solo i tricipiti e non usare avambracci o bicipiti per aiutarti a sollevare i manubri."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气，主要用肱三头肌发力将哑铃推回起始位置，保持发力感集中于三头肌。"
     }
    }
   }
  },
  "RrLske5.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bench Dip (Knees Bent)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en banco (rodillas flexionadas)"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip alla panca a ginocchia piegate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝长凳臂屈伸"
     }
    }
   }
  },
  "RrLske5.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the edge of a bench or chair with your hands gripping the edge next to your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de un banco o una silla agarrando el borde junto a la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul bordo di una panca o sedia con le mani che afferrano il bordo accanto ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳或椅子边缘，双手撑在臀部两侧凳缘。"
     }
    }
   }
  },
  "RrLske5.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your butt off the bench and straighten your legs in front of you, keeping your heels on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desliza el culo fuera del banco y estira las piernas por delante, con los talones en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai scivolare i glutei fuori dalla panca e raddrizza le gambe davanti a te, tenendo i talloni a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部向前移出凳面悬空，双腿屈膝置于身前，双脚踩实地面。"
     }
    }
   }
  },
  "RrLske5.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows and lower your body towards the ground, keeping your back close to the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos y baja el cuerpo hacia el suelo, con la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti e abbassa il corpo verso il pavimento, tenendo la schiena vicina alla panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲手肘使身体垂直下落，后背紧贴凳缘。"
     }
    }
   }
  },
  "RrLske5.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push yourself back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi spingiti di nuovo alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部下落至大臂接近平行于地面时停顿片刻，然后发力将身体推回原位。"
     }
    }
   }
  },
  "RrLske5.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "MU9HnE7.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Bench Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en banco con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip alla panca zavorrati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重长凳臂屈伸"
     }
    }
   }
  },
  "MU9HnE7.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your hands gripping the edge, fingers pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco agarrando el borde, con los dedos hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con le mani che afferrano il bordo, dita rivolte in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳边缘，双手握紧凳缘，手指朝前，在大腿上方放置负重杠铃片。"
     }
    }
   }
  },
  "MU9HnE7.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your butt off the bench, supporting your weight with your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desliza el culo fuera del banco y aguanta el peso con las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai scivolare i glutei fuori dalla panca, sostenendo il peso con le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部移出凳面，双臂支撑起身体重量。"
     }
    }
   }
  },
  "MU9HnE7.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows until your upper arms are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos hasta que los brazos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando i gomiti finché le braccia sono parallele al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲手肘下沉身体，直到大臂与地面大致平行。"
     }
    }
   }
  },
  "MU9HnE7.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back up to the starting position by straightening your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial estirando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti di nuovo alla posizione iniziale raddrizzando le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肱三头肌发力伸直手臂，将身体推回起始位置。"
     }
    }
   }
  },
  "MU9HnE7.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "LMGXZn8.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Decline Close Grip to Skull Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press declinado a la frente con barra y agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca declinata stretta a skull press"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜杠铃窄握仰卧臂屈伸"
     }
    }
   }
  },
  "LMGXZn8.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your head lower than your feet and hold a barbell with a close grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con la cabeza más baja que los pies y sujeta la barra con agarre cerrado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con la testa più in basso dei piedi e tieni un bilanciere con presa stretta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜凳上（头部低于双脚），双手窄握杠铃。"
     }
    }
   }
  },
  "LMGXZn8.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell towards your forehead by bending your elbows, keeping your upper arms stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra hacia la frente flexionando los codos, con los brazos quietos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere verso la fronte piegando i gomiti, tenendo ferme le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定垂直于躯干，屈肘将杠铃缓慢下放至额头上方。"
     }
    }
   }
  },
  "LMGXZn8.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then extend your arms to press the barbell back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y estira los brazos para devolver la barra a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi estendi le braccia per spingere il bilanciere di nuovo alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "停顿片刻，随后伸展手臂发力推起杠铃回起始位置。"
     }
    }
   }
  },
  "LMGXZn8.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复完成目标训练次数。"
     }
    }
   }
  },
  "Db7eEgw.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Concentration Extension (On Knee)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión concentrada en polea (sobre la rodilla)"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione concentrata al cavo in ginocchio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索跪姿集中臂屈伸"
     }
    }
   }
  },
  "Db7eEgw.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench or chair with your knees bent and feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco o una silla con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca o sedia con le ginocchia piegate e i piedi piatti a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在凳上或单膝跪地，稳定身体姿势。"
     }
    }
   }
  },
  "Db7eEgw.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the cable handle with your right hand and place your elbow on the inside of your right knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el asa con la mano derecha y apoya el codo en la cara interna de la rodilla derecha."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la maniglia del cavo con la mano destra e appoggia il gomito all'interno del ginocchio destro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右手持绳索手柄，将右手肘部固定抵在膝盖内侧作为支点。"
     }
    }
   }
  },
  "Db7eEgw.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arm fully, keeping your elbow stationary and close to your knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo del todo, con el codo quieto y pegado a la rodilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi del tutto il braccio, tenendo il gomito fermo e vicino al ginocchio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肘部保持稳定不动，主要利用三头肌发力伸直前臂。"
     }
    }
   }
  },
  "Db7eEgw.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your arm back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el brazo despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il braccio fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在手臂充分伸直处停顿挤压三头肌，然后缓慢放回起始位置。"
     }
    }
   }
  },
  "Db7eEgw.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成一组后换另一侧手臂重复。"
     }
    }
   }
  },
  "Ser9eQp.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械三头臂屈伸"
     }
    }
   }
  },
  "Ser9eQp.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat so your elbows line up with the machine's pivot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el asiento para que los codos queden alineados con el eje de la máquina."
     }
    }
   }
  },
  "Ser9eQp.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your upper arms on the pad and grab the handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los brazos en la almohadilla y agarra las asas."
     }
    }
   }
  },
  "Ser9eQp.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms pressed into the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos pegados a la almohadilla."
     }
    }
   }
  },
  "Ser9eQp.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the handles down until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las asas hacia abajo hasta estirar los brazos."
     }
    }
   }
  },
  "Ser9eQp.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the handles come back up slowly until your elbows are fully bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que las asas suban despacio hasta flexionar los codos del todo."
     }
    }
   }
  },
  "WcHl7ru.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Close-grip Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca con agarre cerrado en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca stretta al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机窄握卧推"
     }
    }
   }
  },
  "WcHl7ru.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the bench with your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate en el banco con los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e mettiti sulla panca con i piedi piatti a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整平凳位置，仰卧在凳上，双脚踩实地面。"
     }
    }
   }
  },
  "WcHl7ru.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with a close grip, slightly narrower than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra cerrado, algo más estrecho que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa stretta, poco più stretta delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手窄握史密斯杠铃杆，握距略窄于肩宽。"
     }
    }
   }
  },
  "WcHl7ru.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell towards your chest, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra hacia el pecho, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere verso il petto, tenendo i gomiti vicini al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "旋转解开安全锁扣，手肘贴近身体，控制杠铃缓慢下落至胸部。"
     }
    }
   }
  },
  "WcHl7ru.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push the barbell back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja la barra de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi spingi il bilanciere di nuovo alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部停顿片刻，随后手臂发力推回起始位置。"
     }
    }
   }
  },
  "WcHl7ru.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "bZq4bwK.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Tricep Dips"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos de tríceps con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip zavorrati per tricipiti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重三头双杠臂屈伸"
     }
    }
   }
  },
  "bZq4bwK.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the edge of a bench or chair with your hands gripping the edge next to your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de un banco o una silla agarrando el borde junto a la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul bordo di una panca o di una sedia con le mani aggrappate al bordo vicino ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳边缘或支撑架上，双手握紧边缘支撑身体，身上挂负重。"
     }
    }
   }
  },
  "bZq4bwK.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your butt off the front of the bench with your legs extended in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desliza el culo por delante del banco, con las piernas estiradas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai scivolare i glutei oltre il bordo anteriore della panca con le gambe tese davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部移出凳面，双腿向前伸展，双臂支撑住身体与负重。"
     }
    }
   }
  },
  "bZq4bwK.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back close to the bench and your elbows slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda pegada al banco y los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena vicina alla panca e i gomiti leggermente piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持后背紧靠凳缘，肘部保持微屈受控。"
     }
    }
   }
  },
  "bZq4bwK.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows until your upper arms are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos hasta que los brazos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando i gomiti finché la parte alta delle braccia è parallela al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲手肘平稳下落身体，直至大臂与地面大致平行。"
     }
    }
   }
  },
  "bZq4bwK.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back up to the starting position by straightening your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial estirando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti di nuovo verso l'alto raddrizzando le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肱三头肌发力伸直双臂，将身体向上推回起始位置。"
     }
    }
   }
  },
  "OTgkHwR.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Decline Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps declinada con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti declinata con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜哑铃三头臂屈伸"
     }
    }
   }
  },
  "OTgkHwR.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your head lower than your feet and hold a dumbbell in each hand, palms facing each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con la cabeza más baja que los pies y una mancuerna en cada mano, palmas enfrentadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con la testa più in basso dei piedi e tieni un manubrio in ogni mano, palmi uno di fronte all'altro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜凳上（头低脚高），双手各持一只哑铃，掌心相对。"
     }
    }
   }
  },
  "OTgkHwR.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms fully, keeping your elbows close to your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos del todo, con los codos pegados a la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi completamente le braccia, tenendo i gomiti vicini alla testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂在胸上方完全伸直，手肘内收对齐头部。"
     }
    }
   }
  },
  "OTgkHwR.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells slowly behind your head, bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio por detrás de la cabeza flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i manubri dietro la testa, piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘将哑铃缓慢下放至头部后侧，充分拉伸肱三头肌。"
     }
    }
   }
  },
  "OTgkHwR.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then raise the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y sube las mancuernas a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi solleva di nuovo i manubri verso la posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在拉伸顶点停顿片刻，随后伸展手肘将哑铃推回起始位置。"
     }
    }
   }
  },
  "OTgkHwR.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复完成目标次数。"
     }
    }
   }
  },
  "Hx1WC8I.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Incline Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps inclinada en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti inclinata al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索上斜三头臂屈伸"
     }
    }
   }
  },
  "Hx1WC8I.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the cable machine to a low pulley position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la polea en posición baja."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina al cavo su una carrucola bassa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将龙门架绳索滑轮调至低位。"
     }
    }
   }
  },
  "Hx1WC8I.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a straight bar to the cable."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una barra recta al cable."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia una sbarra dritta al cavo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在绳索末端装上直杆或绳把。"
     }
    }
   }
  },
  "Hx1WC8I.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing away from the machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie de espaldas a la máquina con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi dando le spalle alla macchina con i piedi larghi quanto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背向滑轮器械站立，双脚与肩同宽。"
     }
    }
   }
  },
  "Hx1WC8I.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the bar with an overhand grip and extend your arms straight overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación y estira los brazos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra con presa prona e distendi le braccia tese sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握手柄，将双臂高举至头顶上方。"
     }
    }
   }
  },
  "Hx1WC8I.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean forward slightly, keeping your back straight and core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia delante, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati leggermente in avanti, tenendo la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体略微前倾，保持背部平直、核心收紧，屈肘下落再伸展推起。"
     }
    }
   }
  },
  "ZsiqXYa.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "JM Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press JM"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "JM press"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "JM推举"
     }
    }
   }
  },
  "ZsiqXYa.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a flat bench and hold the bar with a grip just narrower than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco plano y sujeta la barra con un agarre algo más estrecho que los hombros."
     }
    }
   }
  },
  "ZsiqXYa.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar up over your chest with your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra sobre el pecho con los brazos estirados."
     }
    }
   }
  },
  "ZsiqXYa.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows and let the bar travel down towards your chin, keeping your elbows pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos y deja que la barra baje hacia la barbilla con los codos apuntando al frente."
     }
    }
   }
  },
  "ZsiqXYa.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop a few centimetres above your throat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para unos centímetros por encima del cuello."
     }
    }
   }
  },
  "ZsiqXYa.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar back up by straightening your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra estirando los brazos."
     }
    }
   }
  },
  "HEJ6DIX.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Triceps Kickback"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Patada de tríceps con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Kickback con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃俯身臂屈伸"
     }
    }
   }
  },
  "HEJ6DIX.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put one knee and the same-side hand on a bench with your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya una rodilla y la mano del mismo lado en un banco con la espalda plana."
     }
    }
   }
  },
  "HEJ6DIX.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in the other hand with your upper arm tucked against your side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna con la otra mano y el brazo pegado al costado."
     }
    }
   }
  },
  "HEJ6DIX.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with your elbow bent to 90 degrees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con el codo flexionado a 90 grados."
     }
    }
   }
  },
  "HEJ6DIX.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arm behind you until it is fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo hacia atrás hasta extenderlo del todo."
     }
    }
   }
  },
  "HEJ6DIX.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend the elbow slowly back to 90 degrees and switch arms after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a flexionar el codo despacio a 90 grados y cambia de brazo al acabar la serie."
     }
    }
   }
  },
  "x6KpKpq.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Close-grip Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones con agarre cerrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti a presa stretta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "窄距俯卧撑"
     }
    }
   }
  },
  "x6KpKpq.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a high plank position with your hands placed close together, directly under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha alta con las manos juntas, justo debajo de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in plank alto con le mani vicine, proprio sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈高位平板支撑起始姿势，双手撑地间距较窄，位于肩膀下方。"
     }
    }
   }
  },
  "x6KpKpq.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lower your body towards the ground, keeping your elbows close to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y baja el cuerpo hacia el suelo, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e scendi, tenendo i gomiti vicini ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧，屈肘下沉身体，手肘紧贴身体两侧。"
     }
    }
   }
  },
  "x6KpKpq.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your palms to extend your arms and return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con las palmas para estirar los brazos y volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui palmi per stendere le braccia e tornare su."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手掌发力推地，充分伸展手臂将身体撑回起始位置。"
     }
    }
   }
  },
  "x6KpKpq.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "yg8Totb.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Lying Back of the Head Tricep Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps tras nuca con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti dietro la testa da sdraiato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃仰卧脑后臂屈伸"
     }
    }
   }
  },
  "yg8Totb.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your head at the end of the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la cabeza al final del banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati disteso su una panca con i piedi piantati a terra e la testa all'estremità della panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在平凳上，双脚踩实地面，头部位于平凳顶端边缘。"
     }
    }
   }
  },
  "yg8Totb.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a barbell with an overhand grip, hands shoulder-width apart, and extend your arms straight up over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con las manos a la anchura de los hombros, y estira los brazos encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna un bilanciere con presa prona, mani larghe quanto le spalle, e distendi le braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距与肩同宽，在胸前向上伸直手臂。"
     }
    }
   }
  },
  "yg8Totb.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, slowly lower the barbell behind your head by bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, baja la barra despacio por detrás de la cabeza flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferma la parte alta delle braccia, abbassa lentamente il bilanciere dietro la testa piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定微倾，屈肘将杠铃缓慢放落至头顶后方。"
     }
    }
   }
  },
  "yg8Totb.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then extend your arms back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y estira los brazos de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi distendi di nuovo le braccia verso la posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "停顿片刻，随后肱三头肌发力伸直双臂推回起始位置。"
     }
    }
   }
  },
  "yg8Totb.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复完成目标训练次数。"
     }
    }
   }
  },
  "rope-tricep-pushdown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rope Tricep Pushdown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps con cuerda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Push-down con corda"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索三头下压"
     }
    }
   }
  },
  "rope-tricep-pushdown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a rope to a high pulley and take an end in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una cuerda en la polea alta y sujeta un extremo con cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia una corda a una carrucola alta e prendi un'estremità in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在高位滑轮上安装绳把，双手各握一端绳头。"
     }
    }
   }
  },
  "rope-tricep-pushdown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with your elbows pinned to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido con los codos pegados a los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto con i gomiti fissi ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立微前倾，手肘紧贴身体两侧固定。"
     }
    }
   }
  },
  "rope-tricep-pushdown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the rope down until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la cuerda hacia abajo hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la corda verso il basso finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肱三头肌发力向下按压绳索，直到双臂伸直。"
     }
    }
   }
  },
  "rope-tricep-pushdown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Spread the ends of the rope apart at the bottom and squeeze your triceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa los extremos de la cuerda abajo y aprieta los tríceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga le estremità della corda in basso e stringi i tricipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部将绳把向两侧分开，用力顶峰挤压肱三头肌。"
     }
    }
   }
  },
  "rope-tricep-pushdown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the rope rise back to chest height without moving your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja subir la cuerda hasta el pecho sin mover los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia risalire la corda ad altezza petto senza muovere i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持肘部固定不动，控制绳索缓慢回弹至胸部高度。"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single Dumbbell Skullcrusher"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press francés con una mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Skullcrusher con singolo manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单只哑铃仰卧臂屈伸"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie back on a bench holding one dumbbell with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco sujetando una mancuerna con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca tenendo un solo manubrio con entrambe le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在平凳上，双手共同托握一只哑铃。"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbell up until your arms are straight over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la mancuerna hasta estirar los brazos sobre el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il manubrio verso lalto finché le braccia sono tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将哑铃推起，双臂在胸口上方伸直。"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms still and bend only at the elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos quietos y flexiona sólo los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni ferma la parte alta delle braccia e piega solo ai gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定不动，仅通过屈肘来进行动作。"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell behind your head until you feel the triceps stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna por detrás de la cabeza hasta notar el estiramiento del tríceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il manubrio dietro la testa finché senti i tricipiti allungarsi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将哑铃缓慢下放至头顶后方，直到感受到肱三头肌充分拉伸。"
     }
    }
   }
  },
  "single-dumbbell-skullcrusher.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms back to the top without flaring your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos otra vez sin abrir los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi di nuovo le braccia verso lalto senza allargare i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘不外展，三头肌发力伸展手臂将哑铃推回顶点。"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single Arm Dumbbell Tricep Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps a una mano"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti a un braccio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单臂哑铃颈后臂屈伸"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in one hand and press it straight overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna con una mano y súbela recta por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in una mano e spingilo dritto sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单手持哑铃，手臂向头顶上方竖直推起。"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arm next to your ear and your elbow pointing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el brazo pegado a la oreja y el codo apuntando arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la parte alta del braccio vicina all'orecchio e il gomito rivolto verso lalto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂贴近耳朵，手肘朝向正上方固定。"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell behind your head by bending the elbow."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna por detrás de la cabeza flexionando el codo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il manubrio dietro la testa piegando il gomito."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘将哑铃缓慢下落至脑后。"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go down until your forearm touches your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que el antebrazo toque el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finché lavambraccio tocca il bicipite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "充分下落，直至前臂贴近大臂肱二头肌。"
     }
    }
   }
  },
  "single-arm-dumbbell-tricep-extension.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arm back overhead and squeeze the triceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo otra vez arriba y aprieta el tríceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi di nuovo il braccio sopra la testa e stringi il tricipite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肱三头肌发力伸直手臂推起回原位，并在顶点顶峰挤压。"
     }
    }
   }
  },
  "chair-dip.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chair Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en silla"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip alla sedia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "椅子臂屈伸"
     }
    }
   }
  },
  "chair-dip.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the edge of a sturdy chair and grip the front with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de una silla firme y agarra el asiento con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul bordo di una sedia robusta e afferra la parte anteriore con entrambe le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在稳固的椅子边缘，双手握紧椅子前沿。"
     }
    }
   }
  },
  "chair-dip.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your hips off the seat with your legs out in front."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la cadera del asiento con las piernas estiradas por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai scivolare i fianchi fuori dal sedile con le gambe davanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部向前移出椅面悬空，双腿置于身前支撑。"
     }
    }
   }
  },
  "chair-dip.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows to lower your hips towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos para bajar la cadera hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti per abbassare i fianchi verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲手肘缓慢下沉髋部，使身体竖直下落。"
     }
    }
   }
  },
  "chair-dip.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your upper arms are level with the seat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando los brazos queden a la altura del asiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando la parte alta delle braccia è al livello del sedile."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当大臂与椅面大约平齐时停住。"
     }
    }
   }
  },
  "chair-dip.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti di nuovo verso lalto finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂发力将身体撑起，直到双臂完全伸直。"
     }
    }
   }
  },
  "crab-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Crab Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marcha del cangrejo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata del granchio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蟹形行走 (Crab Walk)"
     }
    }
   }
  },
  "crab-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with your hands behind you and your knees bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las manos detrás y las rodillas flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con le mani dietro di te e le ginocchia piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地板上，双手撑在身后地面，双膝弯曲。"
     }
    }
   }
  },
  "crab-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your hips so only your hands and feet touch the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera hasta apoyar sólo manos y pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i fianchi così che solo mani e piedi tocchino terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上挺髋抬起臀部，使身体仅靠双手和双脚支撑。"
     }
    }
   }
  },
  "crab-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk forward by moving an opposite hand and foot together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anda hacia delante moviendo a la vez mano y pie contrarios."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina in avanti muovendo insieme mano e piede opposti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对侧手脚协同移动，缓慢向前爬行迈步。"
     }
    }
   }
  },
  "crab-walk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips up the whole time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera arriba todo el rato."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi alti per tutto il tempo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整个爬行过程中保持髋部持续抬高不掉落。"
     }
    }
   }
  },
  "crab-walk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk back the other way to finish the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve andando en sentido contrario para terminar la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina all'indietro per finire la serie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "随后按反向向后爬回，完成整组训练。"
     }
    }
   }
  },
  "mnzcrIB.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Bench Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla al banco con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat alla panca con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃箱式深蹲 (哑铃凳深蹲)"
     }
    }
   }
  },
  "mnzcrIB.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a dumbbell on the ground in front of a bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja una mancuerna en el suelo delante de un banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un manubrio a terra davanti a una panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将平凳置于身后，身前手持哑铃或在身前备好哑铃。"
     }
    }
   }
  },
  "mnzcrIB.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing away from the bench with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de espaldas al banco con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi dando le spalle alla panca con i piedi larghi quanto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背对平凳站立，双脚与肩同宽。"
     }
    }
   }
  },
  "mnzcrIB.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend at the knees and hips to lower yourself down towards the bench, keeping your chest up and back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona rodillas y cadera para bajar hacia el banco, con el pecho alto y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega ginocchia e anche per abbassarti verso la panca, tenendo il petto alto e la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋向后坐下蹲向平凳，保持挺胸抬头、背部挺直。"
     }
    }
   }
  },
  "mnzcrIB.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once your glutes touch the bench, push through your heels to stand back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando los glúteos toquen el banco, empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando i glutei toccano la panca, spingi sui talloni per rialzarti alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部轻触凳面时不要放松，脚后跟发力蹬地站起回原位。"
     }
    }
   }
  },
  "mnzcrIB.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "1bQkKZK.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Good Morning"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Buenos días en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Good morning al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯早安式"
     }
    }
   }
  },
  "1bQkKZK.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart, toes pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y las puntas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in piedi con i piedi larghi quanto le spalle, punte rivolte in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖朝前。"
     }
    }
   }
  },
  "1bQkKZK.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place the barbell across your upper back, resting it on your traps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda, sobre el trapecio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il bilanciere sulla parte alta della schiena, sopra i trapezi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯杠铃杆横架在上背部斜方肌上，双手握稳。"
     }
    }
   }
  },
  "1bQkKZK.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees slightly and hinge forward at the hips, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas e inclínate hacia delante desde la cadera, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega leggermente le ginocchia e inclinati in avanti alle anche, tenendo la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝微屈保持角度固定，髋部向后推折叠俯身，全程保持背部平直。"
     }
    }
   }
  },
  "1bQkKZK.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your torso until it is parallel to the ground, feeling a stretch in your hamstrings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el tronco hasta dejarlo paralelo al suelo, notando el estiramiento en los isquios."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il busto finché è parallelo al pavimento, sentendo lallungamento nei femorali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躯干前倾下落至接近平行于地面，感受大腿后侧腘绳肌的充分拉伸。"
     }
    }
   }
  },
  "1bQkKZK.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your glutes and hamstrings to raise your torso back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta glúteos e isquios para subir el tronco a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva glutei e femorali per rialzare il busto verso la posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀大肌和腘绳肌主动收缩发力伸髋，将躯干带回起始直立姿态。"
     }
    }
   }
  },
  "GWoKnIm.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Cossack Squats"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadillas cosacas con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat cosacco zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重哥萨克深蹲"
     }
    }
   }
  },
  "GWoKnIm.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet wider than shoulder-width apart and toes pointing slightly outward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies más abiertos que los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi più larghi delle spalle e le punte leggermente aperte verso lesterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚大间距开立（明显宽于肩），脚尖微朝外。"
     }
    }
   }
  },
  "GWoKnIm.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a weight in front of your chest with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un peso delante del pecho con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un peso davanti al petto con entrambe le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在胸前抱住重量（哑铃或壶铃）。"
     }
    }
   }
  },
  "GWoKnIm.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shift your weight to one side and lower your body by bending the knee of the side you shifted towards, while keeping the other leg straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa el peso a un lado y baja flexionando esa rodilla, con la otra pierna estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sposta il peso su un lato e abbassa il corpo piegando il ginocchio del lato verso cui ti sei spostato, tenendo laltra gamba tesa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重心移向一侧并屈膝下蹲，另一侧腿保持伸直且脚尖翘起朝天。"
     }
    }
   }
  },
  "GWoKnIm.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go as low as you can while maintaining balance and keeping your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja todo lo que puedas manteniendo el equilibrio y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi il più possibile mantenendo lequilibrio e tenendo il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在保持挺胸与身体平衡的前提下，尽可能深蹲至最低点。"
     }
    }
   }
  },
  "GWoKnIm.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the heel of the bent leg to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de la pierna flexionada para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone della gamba piegata per tornare alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲腿脚后跟发力蹬地推回中立位，再换另一侧交替进行。"
     }
    }
   }
  },
  "Kpajagk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Standing Hip Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de cadera de pie en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione d'anca in piedi al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索站姿后踢腿 (绳索伸髋)"
     }
    }
   }
  },
  "Kpajagk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a cable to a low pulley and stand facing away from the machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha un cable a la polea baja y ponte de espaldas a la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia un cavo a una carrucola bassa e mettiti in piedi dando le spalle alla macchina."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在低位滑轮上固定脚踝绑带，背向或面向龙门架站立。"
     }
    }
   }
  },
  "Kpajagk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place the cable around your ankle and stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pásate el cable por el tobillo y ponte con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il cavo intorno alla caviglia e stai con i piedi larghi quanto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将绑带固定在脚踝上，双脚与肩同宽站立，双手扶住立柱保持平衡。"
     }
    }
   }
  },
  "Kpajagk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your core engaged and your back straight throughout the exercise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el core apretado y la espalda recta durante todo el ejercicio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il core attivo e la schiena dritta per tutto lesercizio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个动作过程中收紧核心，保持脊柱平直中立。"
     }
    }
   }
  },
  "Kpajagk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly extend your leg straight back, squeezing your glutes at the top of the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira la pierna despacio hacia atrás, apretando el glúteo arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi lentamente la gamba tesa all'indietro, stringendo i glutei in alto nel movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部发力将佩戴绑带的腿向后上方平稳蹬伸，在顶点充分挤压臀大肌。"
     }
    }
   }
  },
  "Kpajagk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y vuelve a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi torna alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点停顿收缩片刻，随后受控将腿放回起始位置，换腿重复。"
     }
    }
   }
  },
  "UfePqpx.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯罗马尼亚硬拉"
     }
    }
   }
  },
  "UfePqpx.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the Smith bar at mid-thigh height and grip it just outside your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la barra del multipower a media altura del muslo y agárrala justo por fuera de las piernas."
     }
    }
   }
  },
  "UfePqpx.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unlock the bar and stand tall with a soft bend in your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desbloquea la barra y ponte erguido con las rodillas un poco flexionadas."
     }
    }
   }
  },
  "UfePqpx.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and slide the bar down your thighs with a flat back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y desliza la barra por los muslos con la espalda plana."
     }
    }
   }
  },
  "UfePqpx.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel a stretch in your hamstrings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en los isquiotibiales."
     }
    }
   }
  },
  "UfePqpx.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive your hips forward to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera adelante para volver a ponerte de pie."
     }
    }
   }
  },
  "BbfB8Gb.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Basic Toe Touch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque de puntas básico"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocco base delle punte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "基础站姿体前屈触趾"
     }
    }
   }
  },
  "BbfB8Gb.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your arms by your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y los brazos a los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle e le braccia lungo i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双臂自然垂于身体两侧。"
     }
    }
   }
  },
  "BbfB8Gb.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend forward at the waist, keeping your back straight and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante, con la espalda recta y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti in vita, tenendo la schiena dritta e le ginocchia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向前俯身，保持脊柱延展，双膝微屈不锁死。"
     }
    }
   }
  },
  "BbfB8Gb.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach down towards your toes with your hands, keeping your legs as straight as possible."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las manos hacia las puntas de los pies, con las piernas lo más estiradas posible."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Raggiungi le punte con le mani, tenendo le gambe il più tese possibile."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手向下延伸去触碰脚尖，感受大腿后侧与腰背的温和拉伸。"
     }
    }
   }
  },
  "BbfB8Gb.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi torna lentamente alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部拉伸位置保持停顿片刻，然后缓慢起身回直立姿态。"
     }
    }
   }
  },
  "BbfB8Gb.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "ecl28tP.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Contralateral Forward Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada frontal contralateral con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo avanti controlaterale con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对侧负重前弓步"
     }
    }
   }
  },
  "ecl28tP.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle, tenendo un manubrio in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各握一只哑铃。"
     }
    }
   }
  },
  "ecl28tP.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a step forward with your right foot, keeping your back straight and core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante con el pie derecho, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti con il piede destro, tenendo la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右脚向前迈出一大步，保持背部平直、核心收紧。"
     }
    }
   }
  },
  "ecl28tP.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending both knees until your right thigh is parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja flexionando las dos rodillas hasta que el muslo derecho quede paralelo al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando entrambe le ginocchia finché la coscia destra è parallela al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝弯曲下沉身体，直至右大腿与地面大致平行。"
     }
    }
   }
  },
  "ecl28tP.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your right heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón derecho para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone destro per tornare alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右脚后跟发力蹬地，将身体推回初始站立姿势。"
     }
    }
   }
  },
  "ecl28tP.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat with your left leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite con la pierna izquierda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti con la gamba sinistra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "换左腿向前跨步重复，左右腿交替进行。"
     }
    }
   }
  },
  "u27Kcdz.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bench Hip Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de cadera en banco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione d'anca alla panca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "长凳臀部伸展 (凳上臀桥)"
     }
    }
   }
  },
  "u27Kcdz.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your back against the bench and your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con la espalda apoyada y los pies en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con la schiena contro la panca e i piedi piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在平凳前，上背部靠在平凳边缘，双脚平踩地面。"
     }
    }
   }
  },
  "u27Kcdz.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands on the bench for support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las manos en el banco para sujetarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le mani sulla panca per sostenerti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手自然扶在凳面或胸前以保持平稳。"
     }
    }
   }
  },
  "u27Kcdz.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your glutes and hamstrings, then lift your hips off the bench until your body forms a straight line from your knees to your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta glúteos e isquios y despega la cadera del banco hasta quedar en línea recta de las rodillas a los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva glutei e femorali, poi solleva i fianchi dalla panca finché il corpo forma una linea dritta dalle ginocchia alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀大肌和腘绳肌发力收缩，将髋部向上顶起，使身体从双膝到双肩呈一条直线。"
     }
    }
   }
  },
  "u27Kcdz.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your hips back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la cadera despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i fianchi verso la posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点顶峰收紧臀部停顿片刻，然后缓慢下沉髋部放回。"
     }
    }
   }
  },
  "u27Kcdz.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "vR1vold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Zercher Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla Zercher"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Zercher squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "泽奇深蹲"
     }
    }
   }
  },
  "vR1vold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle e le punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "vR1vold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell in the crooks of your elbows, with your hands gripping the barbell for stability."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en el hueco de los codos, agarrándola con las manos para estabilizarla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il bilanciere nelle pieghe dei gomiti, con le mani aggrappate al bilanciere per stabilità."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃扣在双肘内弯弯折处，双手紧握或抱拳以保持杠铃稳定。"
     }
    }
   }
  },
  "vR1vold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and keep your chest lifted as you lower your hips back and down into a squat position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y mantén el pecho alto mientras bajas la cadera atrás hasta la sentadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e tieni il petto alto mentre abbassi i fianchi indietro e in basso in posizione di squat."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心深度绷紧，保持胸腔挺起，髋部向后下方沉入深蹲。"
     }
    }
   }
  },
  "vR1vold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your knees in line with your toes and your weight in your heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las rodillas en línea con las puntas de los pies y el peso en los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le ginocchia in linea con le punte e il peso sui talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双膝与脚尖朝向一致，重心分布在脚后跟与脚掌中后部。"
     }
    }
   }
  },
  "vR1vold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower until your thighs are parallel to the ground, or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finché le cosce sono parallele al pavimento, o fin dove riesci comodamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蹲至大腿平行于地面或更深位置，随后蹬地发力站直回原位。"
     }
    }
   }
  },
  "nUwVh7b.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃罗马尼亚硬拉"
     }
    }
   }
  },
  "nUwVh7b.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and a dumbbell in each hand in front of your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y una mancuerna en cada mano delante de los muslos."
     }
    }
   }
  },
  "nUwVh7b.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a soft bend in your knees and your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las rodillas un poco flexionadas y la espalda plana."
     }
    }
   }
  },
  "nUwVh7b.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and slide the dumbbells down your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y desliza las mancuernas por las piernas."
     }
    }
   }
  },
  "nUwVh7b.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel a stretch along the back of your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes el estiramiento en la parte de atrás de los muslos."
     }
    }
   }
  },
  "nUwVh7b.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes to bring your hips forward and stand tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos para llevar la cadera adelante y ponerte erguido."
     }
    }
   }
  },
  "NNoHCEA.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Full Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla completa en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat completo al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机深蹲 (全蹲)"
     }
    }
   }
  },
  "NNoHCEA.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up the smith machine with the barbell at shoulder height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la barra del multipower a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prepara il multipower con il bilanciere ad altezza spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节史密斯机杠铃杆至肩膀高度。"
     }
    }
   }
  },
  "NNoHCEA.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle, punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽，脚尖微向外展。"
     }
    }
   }
  },
  "NNoHCEA.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step under the bar and position it across your upper back, resting on your traps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Métete bajo la barra y apóyala en la parte alta de la espalda, sobre el trapecio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Passa sotto la sbarra e appoggiala sulla parte alta della schiena, sopra i trapezi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "钻入杠铃下方，将杠铃架在斜方肌上背部位。"
     }
    }
   }
  },
  "NNoHCEA.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grip the bar with your hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna la sbarra con le mani poco più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握杠，握距略宽于肩宽。"
     }
    }
   }
  },
  "NNoHCEA.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the bar and take a step back, maintaining a stable stance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y da un paso atrás, con los pies bien plantados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca la sbarra e fai un passo indietro, mantenendo una posizione stabile."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "旋转杠铃开锁解架，站稳脚步，屈髋屈膝平稳下蹲至大腿平行或更低后蹬起。"
     }
    }
   }
  },
  "ZuPXtCK.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Hack Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla hack en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hack squat al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机哈克深蹲"
     }
    }
   }
  },
  "ZuPXtCK.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the barbell on the smith machine to an appropriate height for your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la barra del multipower a una altura adecuada para ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola il bilanciere del multipower a un'altezza adatta al tuo corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将史密斯机杠铃杆调节至适宜的肩部高度。"
     }
    }
   }
  },
  "ZuPXtCK.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, toes slightly pointed outwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle, punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚前移站立（脚在杠铃垂直线前方约一两脚长），双脚与肩同宽，脚尖微朝外。"
     }
    }
   }
  },
  "ZuPXtCK.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Position yourself under the barbell, resting it on your upper traps and shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate bajo la barra, apoyándola en la parte alta del trapecio y los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sotto il bilanciere, appoggiandolo su trapezi e spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体后倾靠在杠铃杆上，将杠铃架在上背部斜方肌处。"
     }
    }
   }
  },
  "ZuPXtCK.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩。"
     }
    }
   }
  },
  "ZuPXtCK.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and keep your chest up as you unrack the barbell."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y mantén el pecho alto al sacar la barra del soporte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e tieni il petto alto mentre stacchi il bilanciere."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，保持挺胸，转动开锁出架，屈膝顺着导轨顺畅下蹲后再蹬起站直。"
     }
    }
   }
  },
  "wfotm7S.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bodyweight Drop Jump Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla con salto en caída"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat con salto a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重下落跳深蹲"
     }
    }
   }
  },
  "wfotm7S.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立。"
     }
    }
   }
  },
  "wfotm7S.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body into a squat position by bending your knees and pushing your hips back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja a la sentadilla flexionando las rodillas y llevando la cadera atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo in posizione di squat piegando le ginocchia e spingendo i fianchi indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝并向后推髋，下蹲进入深蹲姿势。"
     }
    }
   }
  },
  "wfotm7S.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump up explosively, extending your hips, knees, and ankles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta de forma explosiva, estirando cadera, rodillas y tobillos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta in alto in modo esplosivo, distendendo anche, ginocchia e caviglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "伸展髋、膝、踝三关节，爆发力向上起跳。"
     }
    }
   }
  },
  "wfotm7S.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "While in mid-air, quickly bring your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En el aire, junta rápido los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre sei in aria, unisci velocemente i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在空中迅速将双脚并拢。"
     }
    }
   }
  },
  "wfotm7S.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Land softly on the balls of your feet and immediately drop back into a squat position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cae suave sobre la punta de los pies y baja enseguida a la sentadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Atterra morbido sulle punte e scendi subito di nuovo in squat."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚掌轻柔落地缓冲，并立即顺势下蹲回到深蹲姿势。"
     }
    }
   }
  },
  "5VCj6iH.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Hack Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla hack con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hack squat con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃哈克深蹲"
     }
    }
   }
  },
  "5VCj6iH.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart and your toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in piedi con i piedi larghi quanto le spalle e le punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "5VCj6iH.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell behind your legs, resting it on your upper thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra por detrás de las piernas, apoyada en la parte alta de los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il bilanciere dietro le gambe, appoggiato sulla parte alta delle cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在身体后方握住杠铃，置于大腿后侧上部。"
     }
    }
   }
  },
  "5VCj6iH.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending at the knees and hips, keeping your back straight and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja flexionando rodillas y cadera, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando ginocchia e anche, tenendo la schiena dritta e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋下蹲，保持背部平直、胸部挺起。"
     }
    }
   }
  },
  "5VCj6iH.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your thighs are parallel to the ground, or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a scendere finché le cosce sono parallele al pavimento, o fin dove riesci comodamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "继续下蹲直至大腿与地面平行，或达到舒适的最大深度。"
     }
    }
   }
  },
  "5VCj6iH.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi spingi sui talloni per tornare alla posizione di partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部稍作停顿，随后脚后跟发力蹬地返回起始站姿。"
     }
    }
   }
  },
  "hip-thrust.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip Thrust"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃臀推"
     }
    }
   }
  },
  "hip-thrust.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with your upper back against a bench and a barbell over your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con la parte alta de la espalda en un banco y la barra sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con la parte alta della schiena contro una panca e il bilanciere sui fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，上背部靠在长凳边缘，将杠铃置于髋部上方。"
     }
    }
   }
  },
  "hip-thrust.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plant your feet flat, about hip-width apart and under your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los pies planos, a la anchura de la cadera y debajo de las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pianta i piedi a terra, larghi quanto le anche e sotto le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚平踩地面，约与髋同宽，位于双膝正下方。"
     }
    }
   }
  },
  "hip-thrust.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tuck your chin and drive through your heels to lift your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mete la barbilla y empuja con los talones para subir la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il mento al petto e spingi sui talloni per sollevare i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "微收下巴，后脚跟蹬地发力将髋部向上顶起。"
     }
    }
   }
  },
  "hip-thrust.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes hard when your body forms a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta fuerte los glúteos cuando el cuerpo forme una línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi forte i glutei quando il corpo forma una linea retta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当身体与大腿成一直线时，顶峰充分挤压收缩臀大肌。"
     }
    }
   }
  },
  "hip-thrust.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips slowly until they nearly touch the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio hasta casi tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa i fianchi lentamente fin quasi a toccare terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制核心，缓慢下放髋部至接近地面。"
     }
    }
   }
  },
  "dumbbell-hip-thrust.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Hip Thrust"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃臀推"
     }
    }
   }
  },
  "dumbbell-hip-thrust.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit with your upper back on a bench and a dumbbell resting on your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate con la parte alta de la espalda en un banco y una mancuerna sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti con la parte alta della schiena su una panca e un manubrio appoggiato sulle anche."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上背部靠在长凳边缘坐好，将一只哑铃平放在髋部上方。"
     }
    }
   }
  },
  "dumbbell-hip-thrust.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the dumbbell in place with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la mancuerna con las dos manos para que no se mueva."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni fermo il manubrio con entrambe le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶稳哑铃以保持平衡。"
     }
    }
   }
  },
  "dumbbell-hip-thrust.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heels and lift your hips until your body is level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones y sube la cadera hasta quedar en línea."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui talloni e solleva i fianchi finché il corpo è in linea."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后脚跟发力蹬地，顶起髋部直至躯干与大腿齐平。"
     }
    }
   }
  },
  "dumbbell-hip-thrust.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes at the top for a second."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos un segundo arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei in alto per un secondo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点充分收缩臀肌1秒钟。"
     }
    }
   }
  },
  "dumbbell-hip-thrust.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips under control without dropping them onto the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera controlando el peso, sin dejarla caer al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa i fianchi in modo controllato senza appoggiarli a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "有控制地下放髋部，避免直接砸向地面。"
     }
    }
   }
  },
  "glute-bridge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Glute Bridge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de glúteos"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte glutei"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀桥"
     }
    }
   }
  },
  "glute-bridge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your knees bent and your feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le ginocchia piegate e i piedi piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，双膝弯曲，双脚平踩地面。"
     }
    }
   }
  },
  "glute-bridge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your arms at your sides with your palms down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja los brazos a los lados con las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le braccia lungo i fianchi con i palmi verso il basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂自然放于体侧，掌心朝下。"
     }
    }
   }
  },
  "glute-bridge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heels to lift your hips off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para despegar la cadera del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui talloni per sollevare i fianchi da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后脚跟发力蹬地，将髋部抬离地面。"
     }
    }
   }
  },
  "glute-bridge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes until your body forms a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos hasta que el cuerpo quede en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei finché il corpo forma una linea dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "充分收紧臀大肌，直至膝盖、髋部与肩部呈一条直线。"
     }
    }
   }
  },
  "glute-bridge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips back down slowly, one vertebra at a time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio, vértebra a vértebra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa di nuovo i fianchi lentamente, una vertebra alla volta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢逐节下放脊柱与髋部，返回起始位置。"
     }
    }
   }
  },
  "single-leg-glute-bridge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Leg Glute Bridge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de glúteos a una pierna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte glutei a una gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
