  "incline-dumbbell-fly.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbells over your chest with your palms facing each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas sobre el pecho con las palmas mirándose entre sí."
     }
    }
   }
  },
  "incline-dumbbell-fly.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a slight bend in your elbows for the whole set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos un poco flexionados durante toda la serie."
     }
