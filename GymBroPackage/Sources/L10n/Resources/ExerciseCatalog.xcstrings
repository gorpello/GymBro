      "value": "Tira il bilanciere verso l'alto dell'addome, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部爆发力收缩，驱动肩胛后收将杠铃快速拉向上腹部。"
     }
    }
   }
  },
  "r0z6xzQ.step.4": {
