  },
  "belt-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your feet to stand back up tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los pies para volver a ponerte de pie."
