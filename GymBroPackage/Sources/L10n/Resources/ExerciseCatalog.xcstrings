     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your chest to bring the handles together over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el pecho para juntar los agarres por encima del pecho."
     }
