  "v-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your legs straight and together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las piernas rectas y juntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le gambe tese e unite"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿并拢且完全伸直。"
     }
