     "stringUnit": {
      "state": "translated",
      "value": "Tieni le mani pronte davanti a te in caso tu ceda."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手放在身前随时准备撑地。"
     }
    }
   }
  },
  "nordic-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull yourself back up to kneeling without bending at the hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube de nuevo hasta la vertical sin doblar la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Risali fino in ginocchio senza piegarti sull'anca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "不屈髋，把身体拉回到跪姿。"
     }
    }
   }
  },
  "vertical-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Vertical Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo vertical en puerta"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore verticale alla porta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "门框垂直划船"
     }
    }
   }
  },
  "vertical-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab a door frame or a sturdy pole with both hands at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra un marco de puerta o un poste firme con las dos manos a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra uno stipite o un palo solido con entrambe le mani all'altezza del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在胸口高度抓住门框或稳固的立柱。"
     }
    }
   }
  },
  "vertical-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand close with your feet under your hands and your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate cerca, con los pies bajo las manos y los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai vicino, con i piedi sotto le mani e le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站近一些，双脚踩在手的正下方，手臂伸直。"
     }
    }
   }
  },
  "vertical-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back only slightly so your body stays nearly upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate atrás solo un poco, dejando el cuerpo casi vertical."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati indietro solo un poco, tenendo il corpo quasi verticale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体只稍微后仰，基本保持直立。"
     }
    }
   }
  },
  "vertical-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest towards your hands and squeeze your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva el pecho hacia las manos y junta las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il petto verso le mani e avvicina le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把胸口拉向双手，同时夹紧肩胛骨。"
     }
    }
   }
  },
  "vertical-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms slowly to return to the start."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos despacio para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi le braccia lentamente per tornare alla partenza."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "慢慢伸直手臂回到起始位置。"
     }
    }
   }
  },
  "incline-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Incline Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo inclinado en barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore inclinato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "斜身划船"
     }
    }
   }
  },
  "incline-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a bar at about waist height, or use the edge of a sturdy table."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca una barra a la altura de la cintura o usa el borde de una mesa firme."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti una sbarra all'altezza della vita oppure usa il bordo di un tavolo solido."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把横杠调到腰部高度，或使用稳固的桌沿。"
     }
    }
   }
  },
  "incline-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take an overhand grip a little wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrala en pronación, un poco más abierto que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugnala in presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正手握杠，握距比肩略宽。"
     }
    }
   }
  },
  "incline-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet forward so your body hangs at an angle, straight from head to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina con los pies hacia delante hasta quedar inclinado y recto de la cabeza a los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina con i piedi in avanti finché il corpo resta inclinato e dritto dalla testa ai talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向前走，让身体呈斜角，从头到脚跟保持一条直线。"
     }
    }
   }
  },
  "incline-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest to the bar and squeeze your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva el pecho hacia la barra y junta las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il petto verso la sbarra e avvicina le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把胸口拉向横杠，同时夹紧肩胛骨。"
     }
    }
   }
  },
  "incline-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself under control until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja de forma controlada hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi in modo controllato fino a distendere le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "有控制地下放，直到手臂伸直。"
     }
    }
   }
  },
  "wide-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wide Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo invertido agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore inverso presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "宽握反向划船"
     }
    }
   }
  },
  "wide-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a bar at about waist height and lie underneath it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca una barra a la altura de la cintura y túmbate debajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti una sbarra all'altezza della vita e sdraiati sotto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把横杠调到腰部高度，仰卧到杠下方。"
     }
    }
   }
  },
  "wide-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take an overhand grip much wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrala en pronación, mucho más abierto que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugnala in presa prona, molto più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正手握杠，握距远宽于肩。"
     }
    }
   }
  },
  "wide-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body straight from head to heels with your heels on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo recto de la cabeza a los talones, con los talones en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo dritto dalla testa ai talloni, con i talloni a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从头到脚跟保持一条直线，脚跟踩在地面上。"
     }
    }
   }
  },
  "wide-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your upper chest to the bar, leading with your elbows out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la parte alta del pecho a la barra, abriendo los codos hacia los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta la parte alta del petto alla sbarra, aprendo i gomiti verso i lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把上胸拉向横杠，肘部向两侧打开。"
     }
    }
   }
  },
  "wide-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly until your arms are straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio hasta volver a tener los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi lentamente fino a distendere di nuovo le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放，直到手臂重新伸直。"
     }
    }
   }
  },
  "weighted-inverted-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Inverted Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo invertido lastrado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore inverso zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重反向划船"
     }
    }
   }
  },
