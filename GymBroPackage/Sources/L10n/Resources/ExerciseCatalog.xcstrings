   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back and lift your hips into a bridge position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba y sube la cadera a la posición de puente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena e solleva i fianchi in posizione di ponte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，向上顶起髋部进入臀桥姿势。"
     }
    }
   }
  },
  "glute-bridge-march.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold your hips level and your ribs down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera nivelada y las costillas bajas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi in linea e le costole basse."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持髋部水平稳定，收紧肋骨与核心。"
     }
    }
   }
  },
  "glute-bridge-march.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring one knee up towards your chest without dropping your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una rodilla hacia el pecho sin que baje la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta un ginocchio verso il petto senza far scendere i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在保持髋部不往下掉的前提下，将一侧膝盖朝胸部方向抬起。"
     }
    }
   }
  },
  "glute-bridge-march.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put that foot back down and repeat with the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a apoyar ese pie y repite con la otra pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riappoggia quel piede e ripeti con laltra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将该脚平放回地面，然后换另一条腿重复。"
     }
    }
   }
  },
  "glute-bridge-march.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep alternating legs while you hold the bridge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue alternando piernas mientras aguantas el puente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad alternare le gambe tenendo il ponte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在持续保持臀桥高度的同时，双腿交替进行。"
     }
    }
   }
  },
  "trap-bar-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Trap Bar Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto con barra hexagonal"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco con trap bar"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "六角杠硬拉"
     }
    }
   }
  },
  "trap-bar-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand inside a trap bar with your feet hip-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte dentro de la barra hexagonal con los pies a la anchura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti dentro una trap bar con i piedi larghi quanto i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在六角杠内侧，双脚与髋同宽。"
     }
    }
   }
  },
  "trap-bar-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and grab both handles with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y agarra las dos asas con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi indietro e afferra entrambe le maniglie con le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向后推送，双臂伸直握住两侧把手。"
     }
    }
   }
  },
  "trap-bar-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your chest and take the slack out of the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca pecho y tensa la barra antes de tirar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il petto e metti in tensione la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸沉肩，拉紧杠铃消除空隙以绷紧全身张力。"
     }
    }
   }
  },
  "trap-bar-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive your feet into the floor and stand up tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el suelo con los pies y ponte de pie del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i piedi a terra e rialzati in piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚用力蹬地站直身体，髋膝完全伸展。"
     }
    }
   }
  },
  "trap-bar-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back to lower the bar to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás para bajar la barra al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi indietro per abbassare la sbarra a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向后将杠铃缓慢下放回地面。"
     }
    }
   }
  },
  "hip-abduction-machine.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip Abduction Machine"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abductores en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abductor machine"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿髋外展机"
     }
    }
   }
  },
  "hip-abduction-machine.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit in the machine with the pads against the outside of your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina con las almohadillas por fuera de las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla macchina con i cuscinetti contro lesterno delle ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在器械上，挡板贴在双膝外侧。"
     }
    }
   }
  },
  "hip-abduction-machine.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat against the seat and hold the handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda pegada al respaldo y sujeta las asas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta contro lo schienale e impugna le maniglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部紧贴靠背，双手握住两侧把手。"
     }
    }
   }
  },
  "hip-abduction-machine.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your knees apart as far as the machine allows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa las rodillas todo lo que te permita la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le ginocchia verso lesterno fin dove la macchina permette."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝发力向两侧推开，达到器械允许的最大幅度。"
     }
    }
   }
  },
  "hip-abduction-machine.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes for a moment at the widest point."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos un momento en el punto más abierto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei per un momento nel punto di massima apertura."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最宽处稍作停顿，顶峰挤压臀大肌及臀中肌。"
     }
    }
   }
  },
  "hip-abduction-machine.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your knees back together slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta las rodillas otra vez despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riavvicina lentamente le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地将双膝并拢复原。"
     }
    }
   }
  },
  "machine-glute-kickback.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Glute Kickback"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Patada de glúteo en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Slanci posteriori alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械臀后踢"
     }
    }
   }
  },
  "machine-glute-kickback.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the machine and put one foot on the lever pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de frente a la máquina y pon un pie en la palanca."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte alla macchina e appoggia un piede sulla leva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面朝器械站立，将一只脚放在踏板护垫上。"
     }
    }
   }
  },
  "machine-glute-kickback.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the chest support and keep your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate al soporte del pecho y mantén la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il supporto per il petto e mantieni la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上身贴紧胸垫支撑，保持背部平直。"
     }
    }
   }
  },
  "machine-glute-kickback.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the pad back and up with your working leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la palanca hacia atrás y arriba con la pierna que trabaja."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la pedana indietro e verso lalto con la gamba che lavora."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "目标腿发力，将阻力垫向后上方蹬出。"
     }
    }
   }
  },
  "machine-glute-kickback.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute at the end of the push."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo al final del empuje."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo alla fine della spinta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在推至终点时充分收缩挤压臀肌。"
     }
    }
   }
  },
  "machine-glute-kickback.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return the pad slowly and do all the reps on that side first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve despacio y haz todas las repeticiones de ese lado antes de cambiar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta indietro la pedana lentamente e fai prima tutte le ripetizioni da quel lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢控制还原，先完成一侧的所有次数再换腿。"
     }
    }
   }
  },
  "cable-standing-hip-abduction.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Standing Hip Abduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción de cadera en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abduzioni d'anca in piedi al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索站姿髋外展"
     }
    }
   }
  },
  "cable-standing-hip-abduction.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Strap a cable cuff around the ankle furthest from the machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte la tobillera del cable en el tobillo más alejado de la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia una cavigliera del cavo alla caviglia più lontana dalla macchina."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将绳索脚踝套固定在远离器械一侧的脚踝上。"
     }
    }
   }
  },
  "cable-standing-hip-abduction.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the frame for balance and stand tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a la estructura para mantener el equilibrio y ponte erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieniti al telaio per lequilibrio e stai dritto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶住器械立柱以保持身体平衡，挺拔站立。"
     }
    }
   }
  },
  "cable-standing-hip-abduction.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the working leg out to the side, keeping it straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la pierna que trabaja hacia el lado, manteniéndola estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva la gamba che lavora lateralmente, tenendola tesa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持发力腿伸直，向外侧方抬起。"
     }
    }
   }
  },
  "cable-standing-hip-abduction.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when you feel the side of your glute working."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando notes trabajar el lateral del glúteo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando senti lavorare lesterno del gluteo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当感受到臀中肌充分发力收紧时停止上升。"
     }
    }
   }
  },
  "cable-standing-hip-abduction.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the leg back down slowly without letting the stack rest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la pierna despacio sin dejar que el peso descanse."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta la gamba in basso lentamente senza far appoggiare il pacco pesi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放腿部，保持配重片不完全相撞触底。"
     }
    }
   }
  },
  "reverse-hyperextension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reverse Hyperextension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hiperextensión inversa"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Iperestensioni inverse"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "反向山羊挺身"
     }
    }
   }
  },
  "reverse-hyperextension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on the machine with your hips at the edge of the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo en la máquina con la cadera al borde del soporte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù sulla macchina con i fianchi al bordo del cuscino."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧在反向挺身机上，髋关节刚好位于垫子边缘。"
     }
    }
   }
  },
  "reverse-hyperextension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handles and let your legs hang down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta las asas y deja las piernas colgando."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna le maniglie e lascia le gambe penzolare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "握住把手，双腿自然向下垂放。"
     }
    }
   }
  },
  "reverse-hyperextension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes to lift your legs until they are level with your back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos para subir las piernas hasta la altura de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei per sollevare le gambe finché sono in linea con la schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀大肌收缩发力将双腿抬起，直至双腿与背部齐平。"
     }
    }
   }
  },
  "reverse-hyperextension.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Avoid arching your lower back at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Evita arquear la zona lumbar arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Evita di inarcare la zona lombare in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点避免下背部过度反弓超伸。"
     }
    }
   }
  },
  "reverse-hyperextension.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your legs slowly and do not let them swing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las piernas despacio y no las dejes coger impulso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente le gambe e non farle oscillare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放双腿，避免依靠惯性前后晃动。"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Sumo Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto sumo con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco sumo con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃相扑硬拉"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet wide and your toes turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies anchos y las puntas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi e le punte aperte verso lesterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "采取宽站距，双脚脚尖朝外打开约45度。"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold one dumbbell with both hands between your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna con las dos manos entre las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio con entrambe le mani tra le gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在双腿之间共同握持一只哑铃。"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and bend your knees to lower the weight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y flexiona las rodillas para bajar el peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi indietro e piega le ginocchia per abbassare il peso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向后推并微屈双膝下放哑铃。"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and the dumbbell close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y la mancuerna pegada al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e il manubrio vicino al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸收腹，哑铃贴近身体重心垂直下落。"
     }
    }
   }
  },
  "dumbbell-sumo-deadlift.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your heels to stand up and squeeze your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para subir y aprieta los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui talloni per rialzarti e stringi i glutei."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚后跟蹬地发力站直并充分收紧臀肌。"
     }
    }
   }
  },
  "dumbbell-sumo-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Sumo Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla sumo con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sumo squat con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃相扑深蹲"
     }
    }
   }
  },
  "dumbbell-sumo-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a wide stance with your toes pointing out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre las piernas con las puntas de los pies hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prendi una posizione larga con le punte rivolte verso lesterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站距宽于肩宽，双脚脚尖自然朝外打开。"
     }
    }
   }
  },
  "dumbbell-sumo-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell hanging between your legs with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna colgando entre las piernas con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio con entrambe le mani penzoloni tra le gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在双腿之间垂直握持一只哑铃垂放。"
     }
    }
   }
  },
  "dumbbell-sumo-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸抬头，保持背部平直。"
     }
    }
   }
  },
  "dumbbell-sumo-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat down until your thighs are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai uno squat finché le cosce sono parallele al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝下蹲，直至大腿与地面平行。"
     }
    }
   }
  },
  "dumbbell-sumo-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heels and squeeze your glutes on the way up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube empujando con los talones y aprieta los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui talloni e stringi i glutei mentre risali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚跟蹬地发力站起，在动作上升过程中挤压臀肌。"
     }
    }
   }
  },
  "deficit-reverse-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Deficit Reverse Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada atrás con déficit"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo indietro in deficit"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "垫高后撤箭步蹲"
     }
    }
   }
  },
  "deficit-reverse-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on a low platform with a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a una plataforma baja con una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti su una pedana bassa con un manubrio in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在低矮的踏板上，双手各持一只哑铃。"
     }
    }
   }
  },
  "deficit-reverse-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and off the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás sacando el pie de la plataforma."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro con un piede fuori dalla pedana."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一只脚向后跨步离开踏板下落。"
     }
    }
   }
  },
  "deficit-reverse-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your back knee towards the floor, below the level of the front foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla de atrás hacia el suelo, por debajo del pie de delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il ginocchio posteriore verso il pavimento, sotto il livello del piede anteriore."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "降低重心使后膝下沉，深度低于前脚踏板平面。"
     }
    }
   }
  },
  "deficit-reverse-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your torso upright and your front heel planted."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el tronco erguido y el talón de delante bien apoyado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il busto dritto e il tallone anteriore piantato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干挺直，前脚脚跟踩实踏板。"
     }
    }
   }
  },
  "deficit-reverse-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive up through the front leg to return onto the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube empujando con la pierna de delante para volver a la plataforma."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sulla gamba anteriore per tornare sulla pedana."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前腿发力蹬起，返回踏板起始站位。"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Curtsy Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada cruzada con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo a riverenza con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃交叉箭步蹲"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies a la anchura de la cadera y una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto i fianchi e un manubrio in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽站立，双手各持一只哑铃垂直于身体两侧。"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and across behind the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva un pie hacia atrás y crúzalo por detrás de la otra pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro e incrociato dietro laltra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一只脚向后并斜向跨到另一条腿的斜后方。"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend both knees to lower into the curtsy position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las dos rodillas para bajar a la posición cruzada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega entrambe le ginocchia per scendere in posizione di affondo incrociato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝同时弯曲下蹲，进入屈膝行礼姿势。"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips facing forward and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera mirando al frente y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi rivolti in avanti e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持髋部正对前方，前膝对准脚尖方向。"
     }
    }
   }
  },
  "dumbbell-curtsy-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front heel to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone anteriore per rialzarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚后跟蹬地发力站起，返回起始位置。"
     }
    }
   }
  },
  "curtsy-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curtsy Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada cruzada"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo a riverenza"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "交叉箭步蹲"
     }
    }
   }
  },
  "curtsy-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and your hands on your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies a la anchura de la cadera y las manos en la cintura."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi larghi quanto i fianchi e le mani sui fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽站立，双手叉腰。"
     }
    }
   }
  },
  "curtsy-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and diagonally behind the other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva un pie atrás y en diagonal por detrás del otro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro e in diagonale dietro laltra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一侧脚向后并斜对角跨出至支撑腿后侧。"
     }
    }
   }
  },
  "curtsy-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend both knees to sink into the lunge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las dos rodillas para bajar a la zancada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega entrambe le ginocchia per scendere in affondo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝弯曲下沉身体进入箭步蹲。"
     }
    }
   }
  },
  "curtsy-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips square and your front knee over your foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera de frente y la rodilla delantera sobre el pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi dritti e il ginocchio anteriore sopra il piede."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持骨盆朝向正前方，前膝稳定对准脚尖。"
     }
    }
   }
  },
  "curtsy-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front heel to return to standing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver a ponerte de pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone anteriore per tornare in piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚脚跟蹬地发力站起，返回直立姿势。"
     }
    }
   }
  },
  "frog-pump.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Frog Pump"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de rana"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Frog pump"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蛙式臀推"
     }
    }
   }
  },
  "frog-pump.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back and put the soles of your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba y junta las plantas de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena e unisci le piante dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，双脚脚底相对并拢合十。"
     }
    }
   }
  },
  "frog-pump.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your knees fall out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja caer las rodillas hacia los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia cadere le ginocchia aperte ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "让双膝自然向两侧外展打开。"
     }
    }
   }
  },
  "frog-pump.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your heels in close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca los talones al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvicina i talloni al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双脚脚跟尽量拉近身体臀部。"
     }
    }
   }
  },
  "frog-pump.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes to lift your hips off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos para despegar la cadera del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei per sollevare i fianchi da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀肌发力挤压，将髋部抬离地面。"
     }
    }
   }
  },
  "frog-pump.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips slowly and repeat without resting."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio y repite sin descansar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i fianchi e ripeti senza pause."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地下放髋部，不触地直接进行下一次重复。"
     }
    }
   }
  },
  "donkey-kick.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey Kick"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Patada de glúteo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey kick"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿驴踢"
     }
    }
   }
  },
  "donkey-kick.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get on all fours with your hands under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con las manos bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a quattro zampe con le mani sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿四足支撑在垫上，双手垂直于双肩正下方。"
     }
    }
   }
  },
  "donkey-kick.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat and your core braced."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda plana y el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部平直，核心紧绷。"
     }
    }
   }
  },
  "donkey-kick.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push one heel up towards the ceiling with the knee still bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja un talón hacia el techo con la rodilla flexionada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi un tallone verso il soffitto con il ginocchio ancora piegato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持膝关节呈90度弯曲，脚跟朝天花板方向向上蹬起。"
     }
    }
   }
  },
  "donkey-kick.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your thigh is level with your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando el muslo quede a la altura del cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando la coscia è in linea con il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬高至大腿与身体平行时停住。"
     }
    }
   }
  },
  "donkey-kick.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the knee back down without touching the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla sin llegar a tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa di nuovo il ginocchio senza toccare terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放膝盖，在膝盖触地前再次蹬起。"
     }
    }
   }
  },
  "fire-hydrant.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Fire Hydrant"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción a cuatro patas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fire hydrant"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "消防栓式外展"
     }
    }
   }
  },
  "fire-hydrant.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start on all fours with your knees under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con las rodillas bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti a quattro zampe con le ginocchia sotto i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "采取四足跪姿起始，双膝位于髋关节正下方。"
     }
    }
   }
  },
  "fire-hydrant.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your knee bent at ninety degrees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la rodilla flexionada a noventa grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il ginocchio piegato a novanta gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持膝关节弯曲呈90度。"
     }
    }
   }
  },
  "fire-hydrant.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift that leg out to the side, away from your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube esa pierna hacia el lado, separándola del cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva quella gamba lateralmente, lontano dal corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干稳定，将单腿向外侧方抬起离开身体。"
     }
    }
   }
  },
  "fire-hydrant.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop before your torso starts to lean over."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para antes de que el tronco empiece a inclinarse."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati prima che il busto inizi a inclinarsi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在躯干开始出现代偿倾斜前停止向上抬高。"
     }
    }
   }
  },
  "fire-hydrant.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the knee back down under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla controlando el movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa di nuovo il ginocchio in modo controllato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "有控制地缓慢将膝盖放回原位。"
     }
    }
   }
  },
  "clamshell.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Clamshell"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Almeja tumbado de lado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Clamshell"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蚌式开合"
     }
    }
   }
  },
  "clamshell.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your side with your knees bent and your feet stacked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate de lado con las rodillas flexionadas y los pies juntos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su un fianco con le ginocchia piegate e i piedi sovrapposti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧卧在垫上，双膝弯曲约90度，双脚并拢叠放。"
     }
    }
   }
  },
  "clamshell.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your head on your bottom arm and keep your hips still."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la cabeza en el brazo de abajo y mantén la cadera quieta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia la testa sul braccio inferiore e tieni fermi i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下侧手臂枕在头下，保持骨盆与髋关节稳定不晃动。"
     }
    }
   }
  },
  "clamshell.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open the top knee towards the ceiling, keeping your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre la rodilla de arriba hacia el techo sin separar los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri il ginocchio superiore verso il soffitto, tenendo i piedi uniti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双脚并拢接触，将上侧膝盖朝天花板方向打开。"
     }
    }
   }
  },
  "clamshell.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop before your hips start to roll back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para antes de que la cadera se vaya hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati prima che i fianchi inizino a ruotare indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在骨盆即将向后翻转前停止上抬。"
     }
    }
   }
  },
  "clamshell.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Close the knee slowly and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cierra la rodilla despacio y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Richiudi lentamente il ginocchio e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢并拢膝盖，重复进行动作。"
     }
    }
   }
  },
