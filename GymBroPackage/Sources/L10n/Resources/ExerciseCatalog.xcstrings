    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le spalle sotto i cuscini e tieniti alle maniglie per stabilità"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双肩置于肩垫下方，双手握紧手把保持躯干稳定。"
