     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar slightly wider than your shoulders and unlock it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra un poco más ancho que los hombros y desbloquéala."
     }
    }
   }
  },
  "smith-incline-bench-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the bar slowly to your upper chest without bouncing it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra despacio hasta la parte alta del pecho sin rebotar."
     }
    }
   }
  },
  "smith-incline-bench-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra hacia arriba hasta estirar los brazos."
     }
    }
   }
  },
