  "decline-chest-press-machine.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat so the handles line up with your lower chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el asiento para que los agarres queden a la altura de la parte baja del pecho."
     }
    }
   }
  },
  "decline-chest-press-machine.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit with your back against the pad and grab both handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate con la espalda pegada al respaldo y agarra las dos asas."
     }
    }
   }
  },
  "decline-chest-press-machine.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the handles forward and down until your arms are almost straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las asas hacia delante y abajo hasta casi estirar los brazos."
     }
    }
   }
  },
  "decline-chest-press-machine.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop just short of locking your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para justo antes de bloquear los codos."
     }
    }
   }
  },
  "decline-chest-press-machine.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the handles come back slowly to your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja volver las asas despacio hasta el pecho."
     }
    }
   }
  },
