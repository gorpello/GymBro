     "stringUnit": {
      "state": "translated",
      "value": "Cable Seated Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo sentado en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore da seduto al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿绳索划船"
     }
    }
   }
  },
  "fUBheHs.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the cable row machine with your feet flat on the footrests and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina de remo con los pies apoyados en los reposapiés y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti al rematore con i piedi sulle pedane e le ginocchia appena piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在绳索划船机上，双脚踩实踏板，双膝微屈不要锁死。"
     }
    }
   }
  },
  "fUBheHs.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip, keeping your back straight and your shoulders relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación, con la espalda recta y los hombros relajados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna le maniglie con presa prona, schiena dritta e spalle rilassate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握或对握拉柄，保持挺胸直背、沉肩放松。"
     }
    }
   }
  },
  "fUBheHs.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handles towards your body, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de las agarraderas hacia el cuerpo juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira le maniglie verso il corpo, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌与菱形肌发力向后拉动把手贴近腹部，同时后夹收紧肩胛骨。"
     }
    }
   }
  },
  "fUBheHs.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the peak of the movement, then slowly release the handles back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento en el punto máximo y suelta las agarraderas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa al picco, poi rilascia lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶峰阶段短暂停顿充分挤压背肌，然后顺畅缓慢地控制把手回放至起始位置。"
     }
    }
   }
  },
  "fUBheHs.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "RVwzP10.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón al pecho en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lat machine"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "高位绳索下拉"
     }
    }
   }
  },
  "RVwzP10.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the cable pulldown machine so that the seat is at a comfortable height and the knee pad is secured."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la máquina de jalón para que el asiento quede a una altura cómoda y la almohadilla te sujete las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la lat machine: sedile comodo e fermaginocchia bloccato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整下拉训练器，确保坐垫高度适宜，大腿挡板牢固压稳腿部。"
     }
    }
   }
  },
  "RVwzP10.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the seat with your back straight and your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate con la espalda recta y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti con la schiena dritta e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "端坐在座椅上，腰背挺直，双脚平踩地面。"
     }
    }
   }
  },
  "RVwzP10.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the cable bar with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra de la polea en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna la barra con presa prona, poco più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握横杆把手，握距略宽于肩宽。"
     }
    }
   }
  },
  "RVwzP10.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly and engage your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate un poco hacia atrás y aprieta el core."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati appena indietro e attiva il core."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躯干略微后倾（约10-15度），核心收紧挺胸。"
     }
    }
   }
  },
  "RVwzP10.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the cable bar down towards your chest, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de la barra hacia el pecho juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la barra verso il petto, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌主导发力，后缩并下沉肩胛骨，将横杆平稳向下拉至上胸锁骨位置。"
     }
    }
   }
  },
  "lBDjFxJ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni alla sbarra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正握引体向上"
     }
    }
   }
  },
  "lBDjFxJ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your palms facing away from you and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra en pronación, con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi alla sbarra con i palmi verso l'esterno e le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握（掌心背向自己）抓住单杠，握距略宽于肩宽，双臂自然完全悬挂伸直。"
     }
    }
   }
  },
  "lBDjFxJ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and squeeze your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y junta las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e stringi le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心肌群，沉肩并主动下压收紧肩胛骨。"
     }
    }
   }
  },
  "lBDjFxJ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your body up towards the bar by bending your elbows and bringing your chest towards the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el cuerpo hacia la barra flexionando los codos y llevando el pecho hacia ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tirati su piegando i gomiti, portando il petto verso la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌发力屈肘向上拉起身体，将胸部尽量贴近单杠横杠。"
     }
    }
   }
  },
  "lBDjFxJ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top of the movement, then slowly lower your body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba y baja el cuerpo despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi scendi lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点顶峰短暂停顿，随后缓慢控制身体平稳下放回起始悬挂姿势。"
     }
    }
   }
  },
  "lBDjFxJ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "T2mxWqc.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chin-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas supinas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni supine"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "反握引体向上"
     }
    }
   }
  },
  "T2mxWqc.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your palms facing towards you and your hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra en supinación, con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi alla sbarra con i palmi verso di te, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握（掌心朝向自己）抓紧单杠，握距约与肩同宽。"
     }
    }
   }
  },
  "T2mxWqc.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and pull your body up towards the bar, leading with your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y sube el cuerpo hacia la barra, llevando el pecho por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e tirati su, guidando con il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧腹部核心，挺胸沉肩，以胸口向上带动的姿势拉起身体。"
     }
    }
   }
  },
  "T2mxWqc.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua finche il mento supera la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续发力向上拉，直至下巴完全超过单杠上方。"
     }
    }
   }
  },
  "T2mxWqc.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el cuerpo despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi scendi lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点稍作停顿充分挤压背阔肌与肱二头肌，然后平稳控制缓慢下放回初始姿势。"
     }
    }
   }
  },
  "T2mxWqc.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "qXTaZnJ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Full Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla completa con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat completo con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃深蹲"
     }
    }
   }
  },
  "qXTaZnJ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, punte appena in fuori."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽或略宽站立，脚尖自然朝外微展约15-30度。"
     }
    }
   }
  },
  "qXTaZnJ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell across your upper back, resting it on your traps or rear delts."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda, sobre el trapecio o el deltoides posterior."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il bilanciere sui trapezi, dietro le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃平稳扛于上背部（斜方肌上侧或三角肌后束上）。"
     }
    }
   }
  },
  "qXTaZnJ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and keep your chest up as you begin to lower your body down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y mantén el pecho alto mientras empiezas a bajar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con core attivo e petto alto, inizia a scendere."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心绷紧收腹挺胸，屈髋屈膝开始下蹲身体。"
     }
    }
   }
  },
  "qXTaZnJ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend at the knees and hips, pushing your hips back and down as if sitting into a chair."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona rodillas y cadera, llevando la cadera atrás y abajo como si fueras a sentarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega ginocchia e anche, spingendo i fianchi indietro come per sederti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀部向后下方坐沉，膝关节顺脚尖方向打开，顺势下蹲至大腿与地面平行或略低于水平面。"
     }
    }
   }
  },
  "qXTaZnJ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until your thighs are parallel to the ground or slightly below."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo o algo por debajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finche le cosce sono parallele al terreno o poco sotto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚跟发力蹬地，双腿伸直挺立推回起始站立姿势。"
     }
    }
   }
  },
  "zG0zs85.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Front Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla frontal con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Front squat con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃前蹲"
     }
    }
   }
  },
  "zG0zs85.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart, toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, punte appena in fuori."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起始时双脚与肩同宽站立，脚尖自然略微朝外。"
     }
    }
   }
  },
  "zG0zs85.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell in front of your shoulders, resting it on your collarbone and shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra delante de los hombros, apoyada en la clavícula y los deltoides."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il bilanciere davanti alle spalle, su clavicole e deltoidi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃架在双肩锁骨与前三角肌位置，高抬手肘使上臂基本平行地面托稳杠铃。"
     }
    }
   }
  },
  "zG0zs85.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and keep your chest up as you lower your body down into a squat position, pushing your hips back and bending your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y mantén el pecho alto mientras bajas a la sentadilla, llevando la cadera atrás y flexionando las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con core attivo e petto alto, scendi in squat spingendo i fianchi indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心挺起胸膛，屈髋屈膝下沉身体进入深蹲姿态。"
     }
    }
   }
  },
  "zG0zs85.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower until your thighs are parallel to the ground, or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi finche le cosce sono parallele al terreno o fin dove riesci comodo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下蹲直到大腿与地面平行，或在自身柔韧性允许的舒适深度。"
     }
    }
   }
  },
  "zG0zs85.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in basso, poi spingi sui talloni per risalire."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部短暂停顿，随后脚后跟蹬地发力伸膝伸髋推回站立起始位置。"
     }
    }
   }
  },
  "yn8yg1r.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Goblet Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla goblet con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Goblet squat con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃高脚杯深蹲"
     }
    }
   }
  },
  "yn8yg1r.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell vertically against your chest with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en vertical contra el pecho, sujeta con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, manubrio verticale contro il petto con entrambe le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽或略宽站立，双手在胸前垂直捧托住一只哑铃的一端铃头。"
     }
    }
   }
  },
  "yn8yg1r.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your chest up and core engaged, lower your body down into a squat position by pushing your hips back and bending your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con el pecho alto y el core apretado, baja a la sentadilla llevando la cadera atrás y flexionando las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con petto alto e core attivo, scendi in squat spingendo i fianchi indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸收腹，核心收紧，屈髋屈膝将臀部向后下方下沉坐进深蹲。"
     }
    }
   }
  },
  "yn8yg1r.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your thighs are parallel to the ground, or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua finche le cosce sono parallele al terreno o fin dove riesci comodo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续稳定下蹲直至大腿平行于地面，或下蹲至个人舒适的最大深度。"
     }
    }
   }
  },
  "yn8yg1r.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in basso, poi spingi sui talloni per risalire."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最低点稍作停顿，随后脚后跟用力蹬地推起身体回到起始姿态。"
     }
    }
   }
  },
  "yn8yg1r.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "7zdxRTl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Prensa de piernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg press"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腿举"
     }
    }
   }
  },
  "7zdxRTl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit in the leg press with your back flat against the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la prensa con la espalda pegada al respaldo."
     }
    }
   }
  },
  "7zdxRTl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your feet shoulder-width apart in the middle of the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon los pies a la anchura de los hombros en el centro de la plataforma."
     }
    }
   }
  },
  "7zdxRTl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Release the safety handles and lower the platform until your knees are bent to about 90 degrees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta los seguros y baja la plataforma hasta que las rodillas queden a unos 90 grados."
     }
    }
   }
  },
  "7zdxRTl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the platform away through your heels until your legs are almost straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la plataforma con los talones hasta casi estirar las piernas."
     }
    }
   }
  },
  "7zdxRTl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop short of locking your knees and lower again under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para antes de bloquear las rodillas y vuelve a bajar controlando."
     }
    }
   }
  },
  "RRWFUcw.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancadas con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondi con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃箭步蹲"
     }
    }
   }
  },
  "RRWFUcw.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, un manubrio per mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽直立站立，双手各握一只哑铃自然垂于体侧。"
     }
    }
   }
  },
  "RRWFUcw.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a step forward with your right foot, lowering your body into a lunge position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante con el pie derecho y baja a la zancada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti con il piede destro e scendi in affondo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右脚向前迈出一大步，下沉躯干进入箭步蹲姿态。"
     }
    }
   }
  },
  "RRWFUcw.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and your chest up as you lower your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y el pecho alto mientras bajas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e il petto alto mentre scendi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体下沉时保持脊柱直立、挺胸收紧核心。"
     }
    }
   }
  },
  "RRWFUcw.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your right heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón derecho para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone destro per tornare alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右脚脚跟发力蹬地推回身体至直立起始位置。"
     }
    }
   }
  },
  "RRWFUcw.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat with your left leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite con la pierna izquierda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti con la gamba sinistra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "换左腿向前迈步重复上述动作，交替进行。"
     }
    }
   }
  },
  "qx4fgX7.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Single Leg Split Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla búlgara a una pierna con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Split squat a gamba singola con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃保加利亚单腿分腿蹲"
     }
    }
   }
  },
  "qx4fgX7.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, un manubrio per mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持一只哑铃，背向训练凳站立，双脚与肩同宽。"
     }
    }
   }
  },
  "qx4fgX7.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a step forward with one foot and position your feet so that your front foot is flat on the ground and your back foot is elevated on a bench or step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante con un pie y colócate de modo que el pie de delante quede plano en el suelo y el de atrás elevado sobre un banco o step."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti e mettiti con il piede davanti a terra e quello dietro su una panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿向前迈出一步，将后侧脚脚背平稳搭在身后的卧推凳或台阶上。"
     }
    }
   }
  },
  "qx4fgX7.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your front knee and hip, keeping your back knee slightly bent and your back heel off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando la rodilla y la cadera de delante, con la rodilla de atrás algo flexionada y el talón despegado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi piegando ginocchio e anca davanti, ginocchio dietro appena piegato e tallone staccato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈曲前腿膝盖和髋关节下沉身体，后腿膝盖自然弯曲下沉，后脚跟保持悬空抬起。"
     }
    }
   }
  },
  "qx4fgX7.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your front thigh is parallel to the ground, then push through your front heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que el muslo de delante quede paralelo al suelo y empuja con ese talón para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua finche la coscia davanti e parallela al terreno, poi spingi sul tallone per risalire."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下蹲直至前侧大腿几乎与地面平行，然后前脚脚跟蹬地发力推回起始站姿。"
     }
    }
   }
  },
  "qx4fgX7.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch legs and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti, poi cambia gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复至建议次数后，换另一侧腿进行同样动作。"
     }
    }
   }
  },
  "XlZ4lAC.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Good Morning"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Buenos días con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Good morning con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃早安式屈体"
     }
    }
   }
  },
  "XlZ4lAC.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart and the barbell resting on your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y la barra apoyada en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia in piedi con i piedi alla larghezza delle spalle e il bilanciere appoggiato sulla parte alta della schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，将杠铃稳定扛于上背部斜方肌位置。"
     }
    }
   }
  },
  "XlZ4lAC.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your back straight and your core engaged, hinge forward at the hips, pushing your buttocks back as if you were trying to touch the wall behind you with your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la espalda recta y el core apretado, inclínate desde la cadera llevando el culo atrás, como si quisieras tocar la pared de detrás con los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la schiena dritta e il core attivo, inclinati in avanti dai fianchi spingendo indietro i glutei come se volessi toccare il muro dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺直紧绷，核心收紧，以髋部为轴向后屈髋俯身，臀部向后顶出。"
     }
    }
   }
  },
  "XlZ4lAC.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your torso until it is parallel to the ground, feeling a stretch in your hamstrings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el tronco hasta dejarlo paralelo al suelo, notando el estiramiento en los isquios."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il busto fino a portarlo parallelo al pavimento sentendo lo stretching nei femorali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下俯上身直至躯干几乎与地面平行，充分感受大腿后侧腘绳肌的强烈拉伸。"
     }
    }
   }
  },
  "XlZ4lAC.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then return to the starting position by squeezing your glutes and pushing your hips forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y vuelve a la posición inicial apretando los glúteos y empujando la cadera hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi torna alla posizione iniziale stringendo i glutei e spingendo i fianchi in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最低点短暂停顿，随后收紧臀部并向前顶髋，将身体挺起恢复至直立起始位置。"
     }
    }
   }
  },
  "XlZ4lAC.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "qKBpF7I.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Glute Bridge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de glúteo con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte glutei con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃臀桥"
     }
    }
   }
  },
  "qKBpF7I.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by lying flat on your back on the ground with your knees bent and feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza tumbado boca arriba en el suelo, con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati supino con le ginocchia piegate e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺于地面，双膝弯曲约90度，双脚脚掌踩实地面。"
     }
    }
   }
  },
  "qKBpF7I.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a barbell across your hips, holding it securely with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca una barra sobre la cadera y sujétala firme con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia un bilanciere sui fianchi, tenendolo fermo con le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃横放于髋骨上方，双手牢固握住杠铃杆防止滑动。"
     }
    }
   }
  },
  "qKBpF7I.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your glutes and core muscles, then lift your hips off the ground until your body forms a straight line from your knees to your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta glúteos y core y despega la cadera del suelo hasta dejar el cuerpo en línea recta de las rodillas a los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai glutei e core, poi solleva i fianchi finche il corpo forma una linea retta da ginocchia a spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绷紧腹部核心并大力收缩臀大肌，双脚蹬地抬起髋部，直至躯干从双膝到双肩呈一条平直直线。"
     }
    }
   }
  },
  "qKBpF7I.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, squeezing your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba apretando los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, stringendo i glutei."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点短暂停顿，全力顶峰收缩挤压臀大肌。"
     }
    }
   }
  },
  "qKBpF7I.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower your hips back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa lentamente i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制速度，缓慢将髋部下落还原回地面起始位置。"
     }
    }
   }
  },
  "OM46QHm.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Pull Through (With Rope)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull through en polea con cuerda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull-through al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索胯下后拉"
     }
    }
   }
  },
  "OM46QHm.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing away from the cable machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie de espaldas a la polea con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi dando le spalle alla macchina al cavo con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背对龙门架低位绳索滑轮站立，双脚宽于肩站稳。"
     }
    }
   }
  },
  "OM46QHm.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the rope attachment with both hands and step forward, creating tension in the cable."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la cuerda con las dos manos y da un paso adelante para tensar el cable."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la corda con entrambe le mani e fai un passo avanti per mettere in tensione il cavo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯腰屈髋双手从两腿之间穿过握住绳索手柄，向前迈出一步拉开缆绳张力。"
     }
    }
   }
  },
  "OM46QHm.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend at the hips and lower your upper body until it is parallel to the ground, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate desde la cadera y baja el tronco hasta dejarlo paralelo al suelo, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i fianchi e abbassa il busto fino a portarlo parallelo al pavimento mantenendo la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋将臀部向后推，上身俯下直至躯干接近平行地面，保持背部全程挺直。"
     }
    }
   }
  },
  "OM46QHm.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your glutes and hamstrings to pull your body back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta glúteos e isquios para subir el cuerpo a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva glutei e femorali per tirare il corpo verso la posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩臀大肌和大腿后侧腘绳肌发力向前顶髋站直，拉紧绳索回到站立起始位置。"
     }
    }
   }
  },
  "OM46QHm.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "8ozhUIZ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Standing Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos de pie con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf in piedi con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿杠铃提踵"
     }
    }
   }
  },
  "8ozhUIZ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and place a barbell across your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y apoya la barra en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e il bilanciere sui trapezi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，将杠铃扛于上背部肩胛骨上方。"
     }
    }
   }
  },
  "8ozhUIZ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your heels off the ground as high as possible, using only your toes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega los talones del suelo todo lo que puedas, apoyándote solo en las puntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i talloni più in alto possibile, solo sulle punte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "依靠前脚掌蹬地，将脚后跟尽可能高地向上抬起提踵。"
     }
    }
   }
  },
  "8ozhUIZ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente i talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点小腿肌群充分收缩时短暂停顿片刻。"
     }
    }
   }
  },
  "8ozhUIZ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢平稳地将脚后跟下放控制回地面起始位置，重复动作至建议次数。"
     }
    }
   }
  },
  "ktsFQAZ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Seated Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos sentado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf da seduto con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿杠铃提踵"
     }
    }
   }
  },
  "ktsFQAZ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your feet flat on the floor and a barbell resting on your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con los pies apoyados en el suelo y una barra sobre los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con i piedi ben appoggiati a terra e un bilanciere sulle cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平坐在训练凳上，双脚平放地面，将杠铃平稳置于大腿靠近膝盖前端。"
     }
    }
   }
  },
  "ktsFQAZ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place the balls of your feet on a raised platform, such as a block or step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la punta de los pies en una plataforma elevada, como un taco o un step."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le punte dei piedi su una superficie rialzata come un blocco o uno step."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双脚的前脚掌垫在垫木或高出的踏板边缘上，后脚跟悬空。"
     }
    }
   }
  },
  "ktsFQAZ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Position the barbell across your thighs and hold it securely with your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la barra sobre los muslos y sujétala firme con las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sistema il bilanciere sulle cosce e tienilo con decisione con le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶稳腿上的杠铃杆，确保安全稳定。"
     }
    }
   }
  },
  "ktsFQAZ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your back straight and your core engaged, lift your heels off the ground by extending your ankles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la espalda recta y el core apretado, despega los talones del suelo estirando los tobillos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la schiena dritta e il core attivo, solleva i talloni da terra distendendo le caviglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部直立与核心收紧，小腿比目鱼肌发力踮起脚尖、高高抬起脚后跟。"
     }
    }
   }
  },
  "ktsFQAZ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i talloni fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩处稍作停顿，随后缓慢控制下沉脚跟回至拉伸最低位。"
     }
    }
   }
  },
  "25GPyDY.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃弯举"
     }
    }
   }
  },
  "25GPyDY.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with your feet shoulder-width apart and hold a barbell with an underhand grip, palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en supinación, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto con i piedi alla larghezza delle spalle, bilanciere con presa supina e palmi in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸直立站立，双脚与肩同宽，双手反握杠铃（掌心向前），双手自然垂于体前。"
     }
    }
   }
  },
  "25GPyDY.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your torso and exhale as you curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados al cuerpo y suelta el aire mientras subes el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con i gomiti vicini al corpo, espira e fletti contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "大臂紧贴身体两侧保持不动，呼气同时二头肌发力弯举起杠铃。"
     }
    }
   }
  },
  "25GPyDY.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the bar until your biceps are fully contracted and the bar is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo la barra hasta contraer el bíceps del todo, con la barra a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali finche i bicipiti sono contratti al massimo e la sbarra e all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续向上弯举杠铃，直至肱二头肌完全收缩紧绷，杠铃升至接近肩部高度。"
     }
    }
   }
  },
  "25GPyDY.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione un attimo, stringendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿，全力顶峰收缩挤压肱二头肌。"
     }
    }
   }
  },
  "25GPyDY.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale as you slowly begin to lower the bar back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire mientras bajas la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气并控制速度，缓慢将杠铃下放还原回起始位置。"
     }
    }
   }
  },
  "NbVPDMW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Biceps Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃二头弯举"
     }
    }
   }
  },
  "NbVPDMW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with a dumbbell in each hand, palms facing forward and arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con una mancuerna en cada mano, las palmas hacia delante y los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto, un manubrio per mano, palmi in avanti e braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立站立，双手各持一只哑铃自然下垂，掌心朝前，双臂完全伸展。"
     }
    }
   }
  },
  "NbVPDMW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con le braccia ferme, espira e fletti contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "大臂夹紧体侧保持静止，呼气并收缩肱二头肌发力向上弯举哑铃。"
     }
    }
   }
  },
  "NbVPDMW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the weights until your biceps are fully contracted and the dumbbells are at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo el peso hasta contraer el bíceps del todo, con las mancuernas a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali finche i bicipiti sono contratti al massimo e i manubri sono all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续举起哑铃，直至肱二头肌完全收缩，哑铃到达肩部高度。"
     }
    }
   }
  },
  "NbVPDMW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione un attimo, stringendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点位置稍作停顿，用力顶峰收缩二头肌。"
     }
    }
   }
  },
  "NbVPDMW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale and slowly begin to lower the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y empieza a bajar las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气同时平稳缓慢地下放哑铃还原回起始位置。"
     }
    }
   }
  },
  "slDvUAU.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Hammer Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl martillo con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl a martello con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃锤式弯举"
     }
    }
   }
  },
  "slDvUAU.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with a dumbbell in each hand, palms facing your torso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con una mancuerna en cada mano y las palmas mirando al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto, un manubrio per mano, palmi verso il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立站立，双手各握一只哑铃自然下垂，掌心相对朝向躯干。"
     }
    }
   }
  },
  "slDvUAU.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your torso and rotate the palms of your hands until they are facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados al cuerpo y gira las palmas hasta que miren hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti vicini al corpo: questa e la posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘紧贴躯干两侧，掌心保持对握姿态。"
     }
    }
   }
  },
  "slDvUAU.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "This will be your starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Esa es la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con le braccia ferme, espira e fletti contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以此作为动作的标准起始姿态。"
     }
    }
   }
  },
  "slDvUAU.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Now, keeping the upper arms stationary, exhale and curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ahora, con los brazos quietos, suelta el aire y sube el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali finche i bicipiti sono contratti al massimo e i manubri sono all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上臂保持固定夹紧，呼气并收缩肱二头肌与肱桡肌向上弯举哑铃。"
     }
    }
   }
  },
  "slDvUAU.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the weights until your biceps are fully contracted and the dumbbells are at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo el peso hasta contraer el bíceps del todo, con las mancuernas a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa lentamente alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续向上弯举，直到手臂肌群完全收缩，哑铃达到肩部高度。"
     }
    }
   }
  },
  "qOgPVf6.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Preacher Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl predicador con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl su panca Scott con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃牧师凳弯举"
     }
    }
   }
  },
  "qOgPVf6.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a preacher bench with your upper arms resting on the pad and your chest against the support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el banco predicador con los brazos apoyados en la almohadilla y el pecho contra el soporte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla panca Scott con la parte alta delle braccia appoggiata al cuscinetto e il petto contro il supporto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在牧师椅上，胸部贴紧靠垫，大臂后侧舒适平整地贴在倾斜垫面上。"
     }
    }
   }
  },
  "qOgPVf6.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an underhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en supinación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa supina leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "qOgPVf6.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the barbell up towards your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube la barra hacia los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e solleva il bilanciere verso le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂完全贴实垫面不动，呼气发力将杠铃向上弯举向肩部方向。"
     }
    }
   }
  },
  "qOgPVf6.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, squeezing your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto stringendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿，强烈收缩挤压二头肌。"
     }
    }
   }
  },
  "qOgPVf6.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale and slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e abbassa lentamente il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气并平稳缓慢地下放杠铃，直至手臂接近伸直但不过度锁死关节。"
     }
    }
   }
  },
  "gvsWLQw.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Concentration Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl concentrado con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl di concentrazione con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃集中弯举"
     }
    }
   }
  },
  "gvsWLQw.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your legs spread apart and a dumbbell in one hand, resting your elbow on the inside of your thigh."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con las piernas abiertas y una mancuerna en una mano, apoyando el codo en la cara interna del muslo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca a gambe divaricate, manubrio in una mano e gomito appoggiato all'interno coscia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在凳子上，双腿自然分开，单手握哑铃，将同侧肘关节抵在同侧大腿内侧。"
     }
    }
   }
  },
  "gvsWLQw.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Fully extend your arm and hold the dumbbell with an underhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo del todo y sujeta la mancuerna en supinación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stendi bene il braccio con presa supina."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂完全伸直自然下垂，掌心朝上反握哑铃。"
     }
    }
   }
  },
  "gvsWLQw.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arm stationary, exhale and curl the weight up towards your shoulder while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con el brazo quieto, suelta el aire y sube el peso hacia el hombro contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con il braccio fermo, espira e fletti verso la spalla contraendo il bicipite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上臂稳定贴住大腿内侧保持静止，呼气并收缩二头肌向上弯举哑铃至胸肩方向。"
     }
    }
   }
  },
  "gvsWLQw.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the dumbbell until your biceps are fully contracted and the dumbbell is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo la mancuerna hasta contraer el bíceps del todo, con la mancuerna a la altura del hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali finche il bicipite e contratto al massimo e il manubrio e all'altezza della spalla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续将哑铃弯起直至二头肌达到最充分收缩，哑铃接近肩部高度。"
     }
    }
   }
  },
  "gvsWLQw.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione un attimo, stringendo il bicipite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩位置短暂停顿，用力挤压二头肌。"
     }
    }
   }
  },
  "3ZflifB.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Pushdown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Push-down al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索下压"
     }
    }
   }
  },
  "3ZflifB.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a straight bar to a high pulley cable machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una barra recta a una polea alta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attacca una barra dritta al cavo alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在龙门架高位滑轮挂上直杆（或横杠把手）。"
     }
    }
   }
  },
  "3ZflifB.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the machine with your feet shoulder-width apart and a slight bend in your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie frente a la máquina con los pies a la anchura de los hombros y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte alla macchina, piedi alla larghezza delle spalle e ginocchia appena piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正对绳索器械站立，双脚与肩同宽，膝盖微屈，上半身略微前倾。"
     }
    }
   }
  },
  "3ZflifB.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the bar with an overhand grip, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna la barra con presa prona, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握横杠，两手与肩同宽。"
     }
    }
   }
  },
  "3ZflifB.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your sides and your upper arms stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados al cuerpo y los brazos quietos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti vicini ai fianchi e le braccia ferme."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘紧贴身体两侧，大臂保持垂直静止锁定。"
     }
    }
   }
  },
  "3ZflifB.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Exhale and push the bar down until your elbows are fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire y empuja la barra hacia abajo hasta estirar los codos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira e spingi la barra in basso finche i gomiti sono tesi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气同时三头肌发力向下推动横杠，直至双肘完全伸直下压锁定。"
     }
    }
   }
  },
  "iZop9xO.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Lying Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press francés tumbado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "French press con bilanciere da sdraiato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧杠铃臂屈伸"
     }
    }
   }
  },
  "iZop9xO.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your head at the end of the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la cabeza al final del banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla panca, piedi a terra e testa al bordo della panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双脚踩实地面，头部靠近平凳一端边缘。"
     }
    }
   }
  },
  "iZop9xO.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with an overhand grip, hands shoulder-width apart, and extend your arms straight up over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con las manos a la anchura de los hombros, y estira los brazos encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, mani alla larghezza delle spalle, braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距与肩同宽，手臂垂直举起使杠铃位于胸部正上方。"
     }
    }
   }
  },
  "iZop9xO.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, slowly lower the barbell towards your forehead by bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, baja la barra despacio hacia la frente flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con le braccia ferme, abbassa il bilanciere verso la fronte piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂垂直固定不动，屈肘将杠铃缓慢下落至前额上方或头顶后侧。"
     }
    }
   }
  },
  "iZop9xO.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then extend your arms back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y estira los brazos de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in basso, poi stendi le braccia per tornare su."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部拉伸处稍作停顿，随后伸展手肘发力将杠铃推回起始位置。"
     }
    }
   }
  },
  "iZop9xO.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "PdmaD0N.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Standing Triceps Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps de pie con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti in piedi con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿哑铃颈后臂屈伸"
     }
    }
   }
  },
  "PdmaD0N.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a dumbbell in one hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en una mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, manubrio in una mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，单手握紧哑铃。"
     }
    }
   }
  },
  "PdmaD0N.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise the dumbbell overhead, keeping your arm straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la mancuerna por encima de la cabeza con el brazo estirado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il manubrio sopra la testa a braccio teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将手臂伸直将哑铃高举过头顶上方。"
     }
    }
   }
  },
  "PdmaD0N.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbow and lower the dumbbell behind your head, keeping your upper arm stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona el codo y baja la mancuerna por detrás de la cabeza, con el brazo quieto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega il gomito e abbassa il manubrio dietro la testa, con il braccio fermo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "大臂紧贴头部保持静止垂直，屈肘缓慢将哑铃下放至脑后颈后位置。"
     }
    }
   }
  },
  "PdmaD0N.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arm back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stendi di nuovo il braccio fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三头肌发力伸直手臂，将哑铃推举回过头起始位置。"
     }
    }
   }
  },
  "PdmaD0N.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议次数后，换另一侧手臂进行。"
     }
    }
   }
  },
  "2IxROQ1.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Overhead Triceps Extension (Rope Attachment)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de tríceps sobre la cabeza en polea con cuerda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estensione tricipiti sopra la testa al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索过头臂屈伸（绳索把手）"
     }
    }
   }
  },
  "2IxROQ1.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a rope to a cable machine at a high position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una cuerda a la polea en posición alta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Collega una corda alla macchina al cavo in posizione alta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将绳索把手（双头绳）连接至龙门架较高位置的滑轮上。"
     }
    }
   }
  },
  "2IxROQ1.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing away from the machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie de espaldas a la máquina con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi dando le spalle alla macchina con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背对绳索架站立，双脚前后或并立站稳以保持稳定。"
     }
    }
   }
  },
  "2IxROQ1.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the rope with both hands, palms facing each other, and bring your hands above your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la cuerda con las dos manos, palmas enfrentadas, y llévalas por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la corda con entrambe le mani con i palmi uno di fronte all'altro e porta le mani sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手抓握绳柄两端，掌心相对，将绳索举至头顶后上方。"
     }
    }
   }
  },
  "2IxROQ1.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms close to your head and your elbows pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos pegados a la cabeza y los codos apuntando hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia vicino alla testa con i gomiti rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "大臂靠近头部两侧并保持手肘朝向前上方固定。"
     }
    }
   }
  },
  "2IxROQ1.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower the rope behind your head by bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cuerda despacio por detrás de la cabeza flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente la corda dietro la testa piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘平稳缓慢地将绳索下放至脑后，随后发力向前上方伸直小臂展开展开绳索。"
     }
    }
   }
  },
  "X6C6i5Y.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Triceps Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos en paralelas para tríceps"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip per tricipiti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "凳上反屈伸"
     }
    }
   }
  },
  "X6C6i5Y.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the edge of a bench or chair with your hands gripping the edge, fingers pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de un banco o una silla agarrando el borde, con los dedos hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul bordo di una panca o sedia, mani sul bordo e dita in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在卧推凳或平椅边缘，双手撑在臀部两侧凳沿，手指朝前。"
     }
    }
   }
  },
  "X6C6i5Y.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your butt off the bench, supporting your weight with your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desliza el culo fuera del banco y aguanta el peso con las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scivola con i glutei fuori dalla panca, reggendoti sulle mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚前移将臀部移出凳面，仅由双手手臂支撑体重。"
     }
    }
   }
  },
  "X6C6i5Y.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows and lower your body towards the ground, keeping your back close to the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos y baja el cuerpo hacia el suelo, con la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti e scendi, tenendo la schiena vicina alla panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘缓慢下沉躯干朝向地面，背部紧贴凳沿下落。"
     }
    }
   }
  },
  "X6C6i5Y.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push yourself back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in basso, poi spingiti su."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最低点（大臂接近平行地面）稍作停顿，随后双手向下推凳发力伸直双臂推回起始姿势。"
     }
    }
   }
  },
  "X6C6i5Y.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "VBAWRPG.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Front Plank"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha frontal con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank frontale zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重平板支撑"
     }
    }
   }
  },
  "VBAWRPG.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by lying face down on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza tumbado boca abajo en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起始时俯卧趴在平整地面上。"
     }
    }
   }
  },
  "VBAWRPG.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your forearms on the ground, with your elbows directly under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los antebrazos en el suelo, con los codos justo debajo de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia gli avambracci a terra, gomiti sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前臂贴地支撑，手肘正位于双肩下方垂直支撑地面。"
     }
    }
   }
  },
  "VBAWRPG.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your legs straight out behind you, with your toes on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira las piernas hacia atrás, apoyando las puntas de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stendi le gambe dietro di te, sulle punte dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿在身后完全伸直，脚尖点地支撑（由搭档在背部放置杠铃片或负重）。"
     }
    }
   }
  },
  "VBAWRPG.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lift your body off the ground, balancing on your forearms and toes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y despega el cuerpo del suelo, apoyado en antebrazos y puntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e solleva il corpo, in appoggio su avambracci e punte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧收腹，将整个身体挺离地面，仅由前臂和脚尖支撑平衡。"
     }
    }
   }
  },
  "VBAWRPG.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in a straight line from your head to your heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo en línea recta de la cabeza a los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo in linea retta dalla testa ai talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从头顶、背部到脚后跟全程保持呈一条平直笔直的直线。"
     }
    }
   }
  },
  "TFqbd8t.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch Floor"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch en el suelo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧卷腹"
     }
    }
   }
  },
  "TFqbd8t.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on your back with your knees bent and feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati supino con le ginocchia piegate e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺于地面，双膝屈曲约90度，双脚踩实地面。"
     }
    }
   }
  },
  "TFqbd8t.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands behind your head with your elbows pointing outwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las manos detrás de la cabeza con los codos abiertos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti le mani dietro la testa, gomiti aperti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手轻放于耳旁或抱头（切勿用力扳颈椎），双肘自然朝外打开。"
     }
    }
   }
  },
  "TFqbd8t.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your abs and lift your shoulders off the ground, curling forward towards your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y despega los hombros del suelo, enrollándote hacia las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai gli addominali e solleva le spalle, incurvandoti verso le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧腹肌卷曲脊柱，将肩胛骨平稳抬离地面，向前上方卷向膝盖方向。"
     }
    }
   }
  },
  "TFqbd8t.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your shoulders back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los hombros despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在卷腹最高点短暂停顿挤压腹直肌，然后缓慢控制将肩胛骨放回地面起始位置。"
     }
    }
   }
  },
  "TFqbd8t.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "QOA0FD0.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hanging Leg Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de piernas colgado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sollevamento gambe alla sbarra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "悬垂举腿"
     }
    }
   }
  },
  "QOA0FD0.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your arms fully extended and your palms facing away from you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra en pronación, con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi alla sbarra con le braccia tese e i palmi verso l'esterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住单杠直臂自然悬挂，掌心朝前，脚踝夹住负重（如哑铃或负重沙袋）。"
     }
    }
   }
  },
  "QOA0FD0.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lift your legs up in front of you, keeping them straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y sube las piernas por delante, manteniéndolas estiradas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e solleva le gambe davanti a te, tenendole tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收腹绷紧，保持双腿并拢伸直向前上方高高抬起。"
     }
    }
   }
  },
  "QOA0FD0.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lifting until your legs are parallel to the ground or slightly higher."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo hasta que las piernas queden paralelas al suelo o algo por encima."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua finche le gambe sono parallele al terreno o poco sopra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续将双腿抬高至大腿平行于地面或更高，并主动向上卷缩骨盆提髋。"
     }
    }
   }
  },
  "QOA0FD0.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your legs back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las piernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点短暂停顿充分挤压下腹肌群，然后控制阻力缓慢将双腿下放回悬挂姿势。"
     }
    }
   }
  },
  "QOA0FD0.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "XVDdcoj.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Russian Twist"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Giro ruso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Twist russo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俄罗斯转体"
     }
    }
   }
  },
  "XVDdcoj.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the ground with your knees bent and feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con le ginocchia piegate e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，屈膝，双脚平踩地面。"
     }
    }
   }
  },
  "XVDdcoj.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly while keeping your back straight and your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate un poco hacia atrás manteniendo la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati un po' indietro, schiena dritta e core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上身略微后倾（约45度），保持脊柱挺直，核心绷紧收腹。"
     }
    }
   }
  },
  "XVDdcoj.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold your hands together in front of your chest or hold a weight if desired."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta las manos delante del pecho, o sujeta un peso si quieres."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Unisci le mani davanti al petto o tieni un peso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在胸前合握，或双手握持杠铃片/哑铃等重物。"
     }
    }
   }
  },
  "XVDdcoj.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your feet off the ground, balancing on your sit bones."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega los pies del suelo, en equilibrio sobre los isquiones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i piedi, in equilibrio sugli ischi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚离地抬起小腿，依靠坐骨保持身体平稳平衡。"
     }
    }
   }
  },
  "XVDdcoj.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Twist your torso to the right, bringing your hands or weight towards the right side of your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira el tronco a la derecha, llevando las manos o el peso hacia ese lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota il busto a destra, portando mani o peso verso il fianco destro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "转动躯干向右侧扭转，将双手或负重带向身体右侧外侧，随后左右交替进行转体。"
     }
    }
   }
  },
  "cA9FuWG.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Bent Arm Pullover"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover con barra y brazos flexionados"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover con bilanciere a braccia flesse"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃屈臂仰卧上拉"
     }
    }
   }
  },
  "cA9FuWG.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your head at one end and your feet on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con la cabeza en un extremo y los pies en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca con la testa a un'estremità e i piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，头部靠近凳端，双脚平踩在地面上。"
     }
    }
   }
  },
  "cA9FuWG.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a barbell with a shoulder-width grip and extend your arms straight above your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una barra con las manos a la anchura de los hombros y estira los brazos encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un bilanciere con presa alla larghezza delle spalle e distendi le braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距与肩同宽，将杠铃推起至胸部正上方。"
     }
    }
   }
  },
  "cA9FuWG.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell behind your head while keeping your arms slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra por detrás de la cabeza con los brazos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere dietro la testa mantenendo le braccia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂保持适度屈肘固定，缓慢将杠铃向头后下方沿弧线放低，充分拉伸背阔肌与胸大肌。"
     }
    }
   }
  },
  "cA9FuWG.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then raise the barbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y sube la barra de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi solleva il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最低拉伸点稍作停顿，然后背阔肌与胸肌发力将杠铃沿弧线拉回起始位置。"
     }
    }
   }
  },
  "cA9FuWG.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "7vG5o25.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Incline Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo inclinado con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore su panca inclinata con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧上斜哑铃划船"
     }
    }
   }
  },
  "7vG5o25.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up an incline bench at a 45-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca un banco inclinado a 45 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta una panca inclinata a 45 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将上斜训练凳调节至约45度角。"
     }
    }
   }
  },
  "7vG5o25.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab a dumbbell in each hand and sit on the bench with your chest against the incline."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge una mancuerna en cada mano y siéntate en el banco con el pecho contra el respaldo inclinado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prendi un manubrio in ogni mano e siediti sulla panca con il petto contro lo schienale inclinato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持一只哑铃，胸腹部贴在斜凳靠背上俯卧趴好。"
     }
    }
   }
  },
  "7vG5o25.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms fully, allowing the dumbbells to hang straight down from your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos del todo, dejando las mancuernas colgando desde los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi completamente le braccia lasciando i manubri appesi sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂自然下垂完全伸展，使哑铃从肩关节垂直向下悬垂。"
     }
    }
   }
  },
  "7vG5o25.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the dumbbells up towards your chest, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas hacia el pecho juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira i manubri verso il petto stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌与肩胛骨主动发力向后上方将哑铃拉向胸部两侧，用力挤压肩胛骨。"
     }
    }
   }
  },
  "7vG5o25.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i manubri fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点稍作停顿，随后平稳缓慢地下放哑铃还原回起始姿势。"
     }
    }
   }
  },
  "72BC5Za.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Archer Pull Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas de arquero"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni dell'arciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弓箭手引体向上"
     }
    }
   }
  },
  "72BC5Za.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by hanging from a pull-up bar with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza colgado de la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia appeso alla sbarra per trazioni con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住单杠直臂悬垂，握距明显宽于肩宽。"
     }
    }
   }
  },
  "72BC5Za.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and pull your shoulder blades down and back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y lleva las escápulas abajo y atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e tira le scapole in basso e indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧腹部核心，双肩下沉并向后收缩肩胛骨。"
     }
    }
   }
  },
  "72BC5Za.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you pull yourself up, bend one arm and bring your elbow towards your side, while keeping the other arm straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al subir, flexiona un brazo llevando el codo al costado mientras mantienes el otro estirado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre ti sollevi, piega un braccio e porta il gomito verso il fianco tenendo l'altro braccio teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上拉起身体时，一侧手臂弯曲手肘拉向体侧，另一侧手臂伸直向外滑展（如拉弓状）。"
     }
    }
   }
  },
  "72BC5Za.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the bar and your bent arm is fully flexed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de la barra con el brazo flexionado del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a tirare finché il mento supera la sbarra e il braccio piegato è completamente flesso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续拉起身体直至下巴高过横杠，屈曲侧手臂完全收缩发力。"
     }
    }
   }
  },
  "72BC5Za.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself back down with control, straightening the bent arm and repeating the movement on the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja controlando, estira el brazo flexionado y repite hacia el otro lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati con controllo distendendo il braccio piegato e ripeti il movimento dall'altro lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平稳控制缓慢下放身体，将屈肘手臂重新伸直，随后换对侧手臂交替重复动作。"
     }
    }
   }
  },
  "Gk1r408.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Chin-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas supinas con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni supine zavorrate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重反握引体向上"
     }
    }
   }
  },
  "Gk1r408.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put on a dip belt with a plate or hold a dumbbell between your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte un cinturón de lastre con un disco o sujeta una mancuerna entre los pies."
     }
    }
   }
  },
  "Gk1r408.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar with your palms facing you, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra con las palmas hacia ti y las manos a la anchura de los hombros."
     }
    }
   }
  },
  "Gk1r408.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang with your arms straight and your shoulders pulled down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate con los brazos estirados y los hombros hacia abajo."
     }
    }
   }
  },
  "Gk1r408.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull yourself up until your chin clears the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube hasta que la barbilla pase la barra."
     }
    }
   }
  },
  "Gk1r408.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio hasta estirar los brazos."
     }
    }
   }
  },
  "PbzNu7c.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Incline Y-raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación en Y inclinada con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate a Y su panca inclinata"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧上斜哑铃Y字抬臂"
     }
    }
   }
  },
  "PbzNu7c.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set an incline bench to a 45-degree angle and sit on it with a dumbbell in each hand, palms facing inwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un banco inclinado a 45 grados y siéntate con una mancuerna en cada mano, palmas hacia dentro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta una panca inclinata a 45 gradi e siediti con un manubrio in ogni mano e i palmi rivolti verso l'interno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将上斜训练凳调节至约45度角，俯卧趴在靠背上，双手各持一只哑铃，掌心朝内。"
     }
    }
   }
  },
  "PbzNu7c.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean forward slightly and let your arms hang straight down, keeping a slight bend in your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia delante y deja los brazos colgando, con los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati leggermente in avanti e lascia le braccia appese tese mantenendo i gomiti leggermente piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上半身贴稳靠背，双臂自然下垂伸直，手肘微屈。"
     }
    }
   }
  },
  "PbzNu7c.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your arms out to the sides and up in a Y shape until they are parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los brazos a los lados formando una Y hasta dejarlos paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le braccia ai lati e in alto a forma di Y fino a portarle parallele al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三角肌后束及斜方肌下束发力，将双臂呈“Y”字型向斜上方抬起，直至手臂平行地面。"
     }
    }
   }
  },
  "PbzNu7c.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your arms back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los brazos despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente le braccia fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点顶峰收缩稍作停顿，随后缓慢平稳地下放手臂回起始位置。"
     }
    }
   }
  },
  "PbzNu7c.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "kiJ4Z2K.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Assisted Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas asistidas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni assistite"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械助力引体向上"
     }
    }
   }
  },
  "kiJ4Z2K.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the machine to your desired weight and height settings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la máquina al peso y la altura que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina al peso e all'altezza che vuoi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "根据自身体能调节助力器械的配重磅数与支撑高度。"
     }
    }
   }
  },
  "kiJ4Z2K.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las agarraderas en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握把手，握距略宽于肩宽。"
     }
    }
   }
  },
  "kiJ4Z2K.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang with your arms fully extended and your feet off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate con los brazos estirados del todo y los pies en el aire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi con le braccia completamente distese e i piedi sollevati da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝跪在（或双脚踩在）辅助托垫上，双臂完全伸展悬吊身体。"
     }
    }
   }
  },
  "kiJ4Z2K.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your back muscles and pull your body up towards the handles, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la espalda y sube el cuerpo hacia las asas, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva i muscoli della schiena e tira il corpo verso le maniglie tenendo i gomiti vicini al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌收缩带动身体向上拉起，保持手肘自然收拢不外翻过度。"
     }
    }
   }
  },
  "kiJ4Z2K.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de las asas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a tirare finché il mento supera le maniglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续发力向上拉，直至下颌完全越过把手上方。"
     }
    }
   }
  },
  "8urJS9b.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Back Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hiperextensiones en banco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Iperestensioni"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "山羊挺身"
     }
    }
   }
  },
  "8urJS9b.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the back extension bench so the pad sits just below your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el banco de hiperextensiones para que el apoyo quede justo por debajo de la cadera."
     }
    }
   }
  },
  "8urJS9b.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hook your ankles under the foot pads and cross your arms over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha los tobillos bajo los rodillos y cruza los brazos sobre el pecho."
     }
    }
   }
  },
  "8urJS9b.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your upper body slowly by bending at the hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el tronco despacio flexionando la cadera."
     }
    }
   }
  },
  "8urJS9b.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your torso back up until your body forms a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el tronco hasta que el cuerpo forme una línea recta."
     }
    }
   }
  },
  "8urJS9b.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes at the top without arching your lower back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos arriba sin arquear la zona lumbar."
     }
    }
   }
  },
  "Hj4FOCd.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Decline Wide-grip Pullover"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover declinado con barra y agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pullover declinato con bilanciere a presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜杠铃宽握仰卧上拉"
     }
    }
   }
  },
  "Hj4FOCd.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your head lower than your hips and your feet secured."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con la cabeza más baja que la cadera y los pies sujetos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con la testa più in basso dei fianchi e i piedi bloccati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，双脚牢牢勾紧固定脚垫，头部低于髋部。"
     }
    }
   }
  },
  "Hj4FOCd.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a barbell with a wide grip and extend your arms straight above your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra con agarre ancho y estira los brazos encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un bilanciere con presa larga e distendi le braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手宽握杠铃杆，伸直双臂将杠铃置于胸部正上方。"
     }
    }
   }
  },
  "Hj4FOCd.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell behind your head in a controlled manner, keeping your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra por detrás de la cabeza de forma controlada, con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere dietro la testa in modo controllato mantenendo le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制速度，保持手臂伸展微屈，将杠铃向头后下方缓慢下放。"
     }
    }
   }
  },
  "Hj4FOCd.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then raise the barbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y sube la barra de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi solleva il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最低拉伸处短暂停顿，随后利用背部与胸部力量将杠铃拉回起始位置。"
     }
    }
   }
  },
  "Hj4FOCd.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "7OeHptV.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Assisted Standing Chin-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas supinas asistidas de pie"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni supine assistite in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿器械助力反握引体向上"
     }
    }
   }
  },
  "7OeHptV.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the machine to your desired assistance level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la máquina al nivel de asistencia que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina al livello di assistenza che vuoi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节助力器械的负重片重量，设置适当的辅助支撑力。"
     }
    }
   }
  },
  "7OeHptV.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on the foot platform and grip the handles with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a la plataforma y agarra las asas en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sulla pedana e afferra le maniglie con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在踏板上，双手反握（掌心朝向自己）抓紧把手，握距约与肩同宽。"
     }
    }
   }
  },
  "7OeHptV.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and shoulders back, engage your core, and slightly bend your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y los hombros atrás, aprieta el core y flexiona un poco las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e le spalle indietro, attiva il core e piega leggermente le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬头挺胸沉肩，核心收紧，双膝微屈准备。"
     }
    }
   }
  },
  "7OeHptV.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your body up by flexing your elbows and driving your elbows down towards your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el cuerpo flexionando los codos y llevándolos hacia los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il corpo verso l'alto piegando i gomiti e spingendoli verso i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背肌与二头肌协同发力，屈肘向下拉动肘部贴近体侧，带动身体向上提起。"
     }
    }
   }
  },
  "7OeHptV.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a tirare finché il mento supera la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续发力拉起，直至下颌完全越过横杠高度。"
     }
    }
   }
  },
  "mExgrF9.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bench Pull-ups"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas en banco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni alla panca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "澳式仰卧斜身引体向上"
     }
    }
   }
  },
  "mExgrF9.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Position yourself under a bar or a sturdy horizontal surface that is at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate debajo de una barra o una superficie horizontal resistente a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sotto una sbarra o una superficie orizzontale solida ad altezza petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺于史密斯杠铃或牢固平杠下方，横杠调节至约胸口高度。"
     }
    }
   }
  },
  "mExgrF9.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar or surface with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra o la superficie en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra o la superficie con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握横杠，握距略宽于肩宽。"
     }
    }
   }
  },
  "mExgrF9.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang with your arms fully extended and your body straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate con los brazos estirados del todo y el cuerpo recto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi con le braccia completamente distese e il corpo dritto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚跟撑地，身体完全挺直悬挂在杠下，双臂完全伸展，全身呈一条斜直线。"
     }
    }
   }
  },
  "mExgrF9.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest towards the bar or surface by squeezing your shoulder blades together and bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva el pecho hacia la barra o la superficie juntando las escápulas y flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il petto verso la sbarra stringendo le scapole e piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部肌群发力后收肩胛骨并屈肘，将胸部尽量拉向横杠。"
     }
    }
   }
  },
  "mExgrF9.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the bar or surface."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de la barra o la superficie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a tirare finché il mento supera la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续拉至胸口贴近或超过杠铃，短暂停顿后缓慢平稳下放身体还原。"
     }
    }
   }
  },
  "7I6LNUG.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Seated Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo sentado en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore da seduto alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿器械划船"
     }
    }
   }
  },
  "7I6LNUG.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and footrests to a comfortable position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y los reposapiés a una posición cómoda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e le pedane in una posizione comoda."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节座椅高度及脚踏板位置，使胸部高度与扶手把手舒适契合对齐。"
     }
    }
   }
  },
  "7I6LNUG.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the machine with your chest against the pad and your feet on the footrests."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina con el pecho contra la almohadilla y los pies en los reposapiés."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sulla macchina con il petto contro il cuscinetto e i piedi sulle pedane."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "端坐在划船机上，胸部舒适贴靠前侧支撑垫，双脚踩实踏板。"
     }
    }
   }
  },
  "7I6LNUG.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip, shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación, a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住把手，握距约与肩同宽。"
     }
    }
   }
  },
  "7I6LNUG.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸直背，收紧腹部核心。"
     }
    }
   }
  },
  "7I6LNUG.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handles towards your body, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de las agarraderas hacia el cuerpo juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira le maniglie verso il corpo stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌及中背肌群发力向后拉动把手贴近躯干，顶峰用力挤压后收双侧肩胛骨。"
     }
    }
   }
  },
  "HMzLjXx.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni zavorrate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重引体向上"
     }
    }
   }
  },
  "HMzLjXx.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the pull-up bar with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra de dominadas en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra per trazioni con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "佩戴好负重装备，双手正握抓紧单杠，握距略宽于肩宽。"
     }
    }
   }
  },
  "HMzLjXx.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from the bar with your arms fully extended and your body straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra con los brazos estirados del todo y el cuerpo recto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi alla sbarra con le braccia completamente distese e il corpo dritto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂完全伸展悬垂，双腿伸直或交叉，身体保持平直不晃动。"
     }
    }
   }
  },
  "HMzLjXx.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your back muscles and pull your body up towards the bar, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la espalda y sube el cuerpo hacia la barra, con los codos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva i muscoli della schiena e tira il corpo verso la sbarra tenendo i gomiti vicini al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩背部肌群发力向上拉动身体，手肘自然下沉并贴近躯干。"
     }
    }
   }
  },
  "HMzLjXx.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue pulling until your chin is above the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue tirando hasta pasar la barbilla por encima de la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a tirare finché il mento supera la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续用力拉起，直至下巴高过单杠横杠。"
     }
    }
   }
  },
  "HMzLjXx.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el cuerpo despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il corpo fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点短暂停顿，随后平稳缓慢控制下放身体还原回起始悬挂姿势。"
     }
    }
   }
  },
  "aaXr7ld.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "T-Bar Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo en T"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore T-bar"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "T杠划船"
     }
    }
   }
  },
  "aaXr7ld.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and footplate position to ensure proper alignment."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y la plataforma para quedar bien alineado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e la posizione della pedana per un allineamento corretto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整器械坐垫高度及脚踏板，确保身体与器械完美对齐贴合。"
     }
    }
   }
  },
  "aaXr7ld.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the machine with your chest against the pad and your feet flat on the footplate."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina con el pecho contra la almohadilla y los pies apoyados en la plataforma."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sulla macchina con il petto contro il cuscinetto e i piedi ben appoggiati sulla pedana."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸腹部紧靠支撑垫端坐，双脚平稳踩实脚踏板。"
     }
    }
   }
  },
  "aaXr7ld.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las agarraderas en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住把手，握距略宽于肩宽。"
     }
    }
   }
  },
  "aaXr7ld.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and engage your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y aprieta el core."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e attiva il core."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸直背，收紧核心肌群稳定躯干。"
     }
    }
   }
  },
  "aaXr7ld.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handles towards your torso, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de las asas hacia el tronco juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira le maniglie verso il busto stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部肌肉发力将把手拉向躯干，充分向内后缩挤压肩胛骨。"
     }
    }
   }
  },
  "face-pull.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Face Pull"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Face pull en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Face pull al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索面拉"
     }
    }
   }
  },
  "face-pull.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a rope attachment on a cable pulley just above head height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca una cuerda en la polea, un poco por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti la corda al cavo poco sopra l'altezza della testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双头绳索配件安装在略高于头部高度的滑轮上。"
     }
    }
   }
  },
  "face-pull.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab an end of the rope in each hand with your thumbs pointing back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo de la cuerda con cada mano, con los pulgares hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prendi un'estremita per mano, con i pollici all'indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手对握抓紧绳索两端，大拇指朝向后方。"
     }
    }
   }
  },
  "face-pull.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back until your arms are straight and the weight is off the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás hasta estirar los brazos y despegar el peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Indietreggia finche le braccia sono tese e il pacco pesi si stacca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后退一步拉开缆绳张力，直至手臂完全伸直，重量块轻微脱离片堆。"
     }
    }
   }
  },
  "face-pull.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the rope towards your forehead, splitting your hands apart as you go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de la cuerda hacia la frente separando las manos durante el recorrido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la corda verso la fronte, aprendo le mani mentre tiri."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部后束及外旋肌群发力将绳索向面部前额方向拉动，拉动过程中双手向两侧打开分开。"
     }
    }
   }
  },
  "face-pull.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the squeeze between your shoulder blades and return under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta apretando los omóplatos y vuelve controlando el peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi tra le scapole e torna indietro con controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶点用力收紧肩胛骨并外旋肩膀短暂停顿，随后平稳受控放回。"
     }
    }
   }
  },
  "one-arm-dumbbell-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "One-Arm Dumbbell Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo a una mano con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore con manubrio a un braccio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单臂哑铃划船"
     }
    }
   }
  },
  "one-arm-dumbbell-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put one knee and the same-side hand on a bench, with your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya una rodilla y la mano del mismo lado en un banco, con la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia un ginocchio e la mano dello stesso lato su una panca con la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将同侧膝盖和手掌平稳支撑在平凳上，背部保持平直中立与地面平行。"
     }
    }
   }
  },
  "one-arm-dumbbell-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in the free hand with your arm hanging straight down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna con la mano libre y el brazo colgando estirado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio nella mano libera con il braccio appeso teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "悬空侧的手持一只哑铃，手臂垂直自然下垂。"
     }
    }
   }
  },
  "one-arm-dumbbell-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the dumbbell up to your hip, driving your elbow past your ribs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la mancuerna hasta la cadera llevando el codo por detrás de las costillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il manubrio verso il fianco spingendo il gomito oltre le costole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘引领发力向后上方驱动拉起哑铃，肘部越过肋骨拉向髋部。"
     }
    }
   }
  },
  "one-arm-dumbbell-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your back at the top without twisting your torso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta la espalda arriba sin girar el tronco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi la schiena in alto senza ruotare il busto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点顶峰收缩挤压单侧背肌，避免躯干发生扭转。"
     }
    }
   }
  },
  "one-arm-dumbbell-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell slowly until your arm is straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna despacio hasta estirar el brazo del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente il manubrio finché il braccio è di nuovo teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制离心，缓慢下放哑铃直至手臂完全自然伸展拉伸。"
     }
    }
   }
  },
  "close-grip-lat-pulldown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Close-Grip Lat Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón al pecho con agarre estrecho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lat machine a presa stretta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "窄握高位下拉"
     }
    }
   }
  },
  "close-grip-lat-pulldown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a close-grip handle to the lat pulldown and sit with your thighs under the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon el triángulo en el jalón y siéntate con los muslos bajo la almohadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Collega una maniglia stretta alla lat machine e siediti con le cosce sotto i rulli."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将窄握V柄把手安装在高位下拉器械上，坐稳并用大腿垫牢固固定双腿。"
     }
    }
   }
  },
  "close-grip-lat-pulldown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take the handle with both palms facing each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge el agarre con las dos palmas mirándose entre sí."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna la maniglia con i palmi uno di fronte all'altro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手对握（掌心相对）抓握V柄两端。"
     }
    }
   }
  },
  "close-grip-lat-pulldown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly and keep your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia atrás y saca pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati leggermente indietro e tieni il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上半身略微后倾（约10-15度），保持挺胸抬头。"
     }
    }
   }
  },
  "close-grip-lat-pulldown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handle down to your upper chest, driving your elbows to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del agarre hasta la parte alta del pecho llevando los codos a los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la maniglia verso la parte alta del petto spingendo i gomiti verso i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌主导发力，手肘内收向下拉动把手至上胸部位置。"
     }
    }
   }
  },
  "close-grip-lat-pulldown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the handle rise slowly until your arms are fully stretched."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja subir el agarre despacio hasta estirar los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia risalire lentamente la maniglia finché le braccia sono completamente distese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制配重缓慢上升放回，直至双臂与背阔肌完全充分拉伸展开。"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wide-Grip Lat Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón al pecho con agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lat machine a presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "宽握高位下拉"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit at the lat pulldown with your thighs locked under the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el jalón con los muslos sujetos bajo la almohadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla lat machine con le cosce bloccate sotto i rulli."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "端坐在高位下拉器械上，调整挡腿垫牢固卡稳大腿。"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar wider than your shoulders with your palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra más ancho que los hombros, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la barra più larga delle spalle con i palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握横杠，握距明显宽于双肩，掌心朝前。"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulder blades down before you bend your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja primero los omóplatos y sólo después flexiona los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa le scapole prima di piegare le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂弯曲前先主动下沉并后收肩胛骨（沉肩启动）。"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the bar down to your collarbone, opening your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la barra hasta las clavículas abriendo el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta la barra alla clavicola aprendo il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸开肩，将横杠平稳向下拉至锁骨上方位置。"
     }
    }
   }
  },
  "wide-grip-lat-pulldown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the bar travel back up slowly until your lats are stretched."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que la barra suba despacio hasta estirar los dorsales."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia risalire lentamente la barra finché i dorsali sono allungati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地让横杠回升，直到背阔肌完全被拉伸伸展。"
     }
    }
   }
  },
  "single-arm-cable-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Arm Cable Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo a una mano en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore a un braccio al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单臂绳索划船"
     }
    }
   }
  },
  "single-arm-cable-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit at a low pulley and hold a single handle in one hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la polea baja y sujeta un agarre con una mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a una puleggia bassa e tieni una maniglia singola in una mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在低位划船机前，单手抓住单手拉柄。"
     }
    }
   }
  },
  "single-arm-cable-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y las rodillas un poco flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e le ginocchia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺直腰背，双膝微屈，双脚踩实脚蹬。"
     }
    }
   }
  },
  "single-arm-cable-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handle to your waist, taking your elbow past your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del agarre hasta la cintura llevando el codo por detrás del cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la maniglia verso la vita portando il gomito oltre il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌发力将把手拉向腰际，肘关节顺贴躯干向后拉出。"
     }
    }
   }
  },
  "single-arm-cable-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your shoulder rotate back at the end of the pull."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que el hombro rote hacia atrás al final del tirón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia ruotare la spalla indietro alla fine della tirata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作收缩末端允许肩部有控制地略微后展，充分挤压背阔肌。"
     }
    }
   }
  },
  "single-arm-cable-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return the handle forward slowly and let your shoulder stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve el agarre despacio y deja que el hombro se estire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta lentamente la maniglia in avanti e lascia allungare la spalla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢前送放回把手，充分感受单侧背阔肌的拉伸展宽。"
     }
    }
   }
  },
  "meadows-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Meadows Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo Meadows"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore Meadows"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "梅多斯划船"
     }
    }
   }
  },
  "meadows-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wedge one end of a barbell into a corner and load the other end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encaja un extremo de la barra en una esquina y carga el otro extremo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Incastra un capo del bilanciere in un angolo e carica l'altro capo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃一端卡入墙角或地雷管底座中，并在另一端加挂杠铃片。"
     }
    }
   }
  },
  "meadows-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand side-on to the bar and hinge forward with a flat back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de lado a la barra y flexiona la cadera con la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di lato al bilanciere e inclinati in avanti con la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧对杠铃杆站立，屈髋俯身，保持背部平直中立。"
     }
    }
   }
  },
  "meadows-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the end of the bar with the hand furthest from it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la punta de la barra con la mano más alejada de ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la fine del bilanciere con la mano più lontana."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用距离杠铃杆远端的手正握抓住杠铃杆粗端边缘。"
     }
    }
   }
  },
  "meadows-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Row the bar up to your hip, keeping your elbow high and wide."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rema la barra hasta la cadera manteniendo el codo alto y abierto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il bilanciere verso il fianco tenendo il gomito alto e largo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌发力将杠铃向上划船拉向髋部，手肘高抬并适度外展。"
     }
    }
   }
  },
  "meadows-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it slowly until your arm hangs fully stretched."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájala despacio hasta que el brazo cuelgue estirado del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassalo lentamente finché il braccio è completamente disteso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢控制下放杠铃，直至手臂完全下垂伸展拉长背阔肌。"
     }
    }
   }
  },
  "neutral-grip-pull-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Neutral-Grip Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas con agarre neutro"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni a presa neutra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对握引体向上"
     }
    }
   }
  },
  "neutral-grip-pull-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab a pair of parallel handles with your palms facing each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra dos asas paralelas con las palmas mirándose entre sí."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra una coppia di maniglie parallele con i palmi uno di fronte all'altro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手对握抓住平行的引体把手，双手掌心相对。"
     }
    }
   }
  },
  "neutral-grip-pull-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang with your arms straight and your shoulders pulled down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate con los brazos estirados y los hombros hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi con le braccia tese e le spalle abbassate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂完全伸直自然悬吊，肩胛骨下沉锁紧，身体保持稳定静止。"
     }
    }
   }
  },
  "neutral-grip-pull-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest up towards the handles, leading with your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el pecho hacia las asas llevando los codos hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il petto verso le maniglie guidando con i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘引领发力屈肘向上拉起身体，挺胸朝向把手靠近。"
     }
    }
   }
  },
  "neutral-grip-pull-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your chin level with your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube hasta poner la barbilla a la altura de las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta il mento al livello delle mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续发力拉至下巴平齐或超过把手水平线。"
     }
    }
   }
  },
  "neutral-grip-pull-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself all the way down under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja del todo controlando el descenso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati completamente con controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程高度控制离心，平稳平顺地下放身体至完全悬垂。"
     }
    }
   }
  },
  "active-hang.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Active Hang"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suspensión activa en barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sospensione attiva"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "悬垂主动锁肩"
     }
    }
   }
  },
  "active-hang.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab a pull-up bar with your hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra una barra de dominadas con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra per trazioni con le mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住单杠，握距与肩同宽。"
     }
    }
   }
  },
  "active-hang.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang with your arms straight and your feet off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate con los brazos estirados y los pies sin tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi con le braccia tese e i piedi sollevati da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂直立伸展，双脚离地悬垂在杠下。"
     }
    }
   }
  },
  "active-hang.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulders down and away from your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los hombros alejándolos de las orejas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa le spalle lontano dalle orecchie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背阔肌及斜方肌下束发力，主动将肩膀向下沉、远离双耳（锁死沉肩）。"
     }
    }
   }
  },
  "active-hang.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your ribs down and your body still."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las costillas bajas y el cuerpo quieto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le costole basse e il corpo fermo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持肋骨下沉内收，绷紧核心，躯干保持完全静止不摇晃。"
     }
    }
   }
  },
  "active-hang.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the position for as long as your grip lets you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la posición lo que te permita el agarre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione finché la presa te lo permette."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在主动锁肩悬垂姿势下静止保持，直至握力耗尽。"
     }
    }
   }
  },
  "negative-pull-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Negative Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominada negativa"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni negative"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "离心慢放引体向上"
     }
    }
   }
  },
  "negative-pull-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto a box so your chin already clears the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a un cajón hasta que la barbilla pase la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali su un box in modo che il mento superi già la sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踩在跳箱或踏板上起跳，使下巴直接越过单杠到达引体向上的最高点。"
     }
    }
   }
  },
  "negative-pull-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar with your palms facing away from you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra con las palmas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra con i palmi rivolti lontano da te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握抓住单杠，掌心朝前。"
     }
    }
   }
  },
  "negative-pull-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take your feet off the box and hold the top position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Quita los pies del cajón y aguanta arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca i piedi dal box e tieni la posizione alta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚脱离箱子悬空，在最高点顶峰紧绷稳定身体。"
     }
    }
   }
  },
  "negative-pull-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself as slowly as you can, counting to three."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja lo más despacio que puedas contando hasta tres."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati il più lentamente possibile contando fino a tre."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽可能慢地控制身体平稳下落，心里默数至少3至5秒缓慢放低身体。"
     }
    }
   }
  },
  "negative-pull-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back up to the top and start the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subirte al cajón y empieza la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna in alto e inizia la ripetizione successiva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体完全下放伸直后，重新踩上踏板恢复到最高点进行下一次重复。"
     }
    }
   }
  },
  "commando-pull-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Commando Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominada comando"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni commando"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "突击队引体向上"
     }
    }
   }
  },
  "commando-pull-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand under the bar so it runs front to back over your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate debajo de la barra de forma que quede de frente a atrás sobre tu cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sotto la sbarra in modo che passi sopra la testa da davanti a dietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在单杠下方，使单杠从头顶自前向后延伸。"
     }
    }
   }
  },
  "commando-pull-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar with one hand in front of the other, palms facing in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra con una mano delante de la otra y las palmas hacia dentro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra con una mano davanti all'altra e i palmi rivolti verso l'interno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手前后对握抓杠，掌心相对。"
     }
    }
   }
  },
  "commando-pull-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull yourself up so your head passes to one side of the bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube hasta que la cabeza pase por un lado de la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tirati su in modo che la testa passi da un lato della sbarra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上拉起身体，使头部偏向单杠的一侧。"
     }
    }
   }
  },
  "commando-pull-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower down and pull up again to the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja y vuelve a subir pasando por el otro lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati e tirati di nuovo su passando dall'altro lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放还原，再次拉起时头部转向另一侧。"
     }
    }
   }
  },
  "commando-pull-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips still and alternate sides each rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera quieta y alterna el lado en cada repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni fermi i fianchi e alterna il lato a ogni ripetizione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持髋部稳定不晃动，每次重复交替两侧。"
     }
    }
   }
  },
  "l-sit-pull-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "L-Sit Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominada en L"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni in L-sit"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "L字引体向上"
     }
    }
   }
  },
  "l-sit-pull-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your palms facing away."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra con las palmas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi alla sbarra con i palmi rivolti lontano da te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握悬垂于单杠上，掌心朝前。"
     }
    }
   }
  },
  "l-sit-pull-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your straight legs until they form an L with your torso."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las piernas estiradas hasta formar una L con el tronco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le gambe tese finché formano una L con il busto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿伸直抬起，直到与躯干呈90度L字形。"
     }
    }
   }
  },
  "l-sit-pull-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the legs there for the whole set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta las piernas ahí durante toda la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le gambe in posizione per tutta la serie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整组动作中始终保持双腿前平举姿态。"
     }
    }
   }
  },
  "l-sit-pull-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest to the bar without dropping your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el pecho a la barra sin bajar los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il petto alla sbarra senza abbassare i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部发力将胸口拉向单杠，注意双脚不要下落。"
     }
    }
   }
  },
  "l-sit-pull-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly and keep the L shape."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio manteniendo la forma de L."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati lentamente mantenendo la forma a L."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制身体缓慢下放，全程保持L字形态。"
     }
    }
   }
  },
  "towel-pull-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Towel Pull-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas con toalla"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Trazioni con asciugamano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "毛巾引体向上"
     }
    }
   }
  },
  "towel-pull-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang two towels over a pull-up bar, shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa dos toallas por la barra, separadas a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appendi due asciugamani alla sbarra alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将两条毛巾搭在单杠上，间距与肩同宽。"
     }
    }
   }
  },
  "towel-pull-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grip one towel in each hand and hang with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra una toalla con cada mano y cuélgate con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna un asciugamano per mano e appenditi con le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各抓紧一条毛巾，双臂伸直自然悬垂。"
     }
    }
   }
  },
  "towel-pull-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the towels hard and pull your chest up between them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta fuerte las toallas y sube el pecho entre ellas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi forte gli asciugamani e tira il petto in alto tra di loro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用力握紧毛巾，背部发力将胸口向上拉至两毛巾之间。"
     }
    }
   }
  },
  "towel-pull-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your hands level with your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube hasta poner las manos a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le mani al livello del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续拉起直到双手与胸部平齐。"
     }
    }
   }
  },
  "towel-pull-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly without letting the towels slip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio sin dejar que se te escapen las toallas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati lentamente senza far scivolare gli asciugamani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制身体缓慢下放，抓牢毛巾防止滑脱。"
     }
    }
   }
  },
  "towel-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Towel Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo con toalla"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore con asciugamano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "毛巾划船"
     }
    }
   }
  },
  "towel-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a towel around a sturdy post at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa una toalla alrededor de un poste firme a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvolgi un asciugamano attorno a un palo solido ad altezza petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将毛巾绕在胸口高度的牢固立柱或支架上。"
     }
    }
   }
  },
  "towel-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold one end in each hand and walk your feet forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo con cada mano y adelanta los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un capo in ogni mano e cammina in avanti con i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握毛巾一端，双脚向前迈步。"
     }
    }
   }
  },
  "towel-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back with straight arms until the towel takes your weight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate hacia atrás con los brazos estirados hasta que la toalla aguante tu peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati indietro con le braccia tese finché l'asciugamano sostiene il tuo peso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂伸直身体后仰，直到毛巾完全承受身体重量。"
     }
    }
   }
  },
  "towel-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest towards the post, driving your elbows back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del pecho hacia el poste llevando los codos atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il petto verso il palo spingendo i gomiti indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘向后带动身体，将胸部拉向立柱。"
     }
    }
   }
  },
  "towel-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms slowly to return to the leaning position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos despacio para volver a la posición inclinada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi lentamente le braccia per tornare alla posizione inclinata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢伸直双臂，平稳回到后仰倾斜位置。"
     }
    }
   }
  },
  "scapular-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Scapular Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión escapular"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti scapolari"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肩胛俯卧撑"
     }
    }
   }
  },
  "scapular-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a push-up position with your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en posición de flexión con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in posizione di piegamento con le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈俯卧撑起始姿势，双臂伸直支撑。"
     }
    }
   }
  },
  "scapular-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows locked for the whole movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos bloqueados durante todo el movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti bloccati per tutto il movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整个动作过程中保持双肘伸直不弯曲。"
     }
    }
   }
  },
  "scapular-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your chest sink as your shoulder blades squeeze together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja caer el pecho juntando los omóplatos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia scendere il petto mentre le scapole si stringono."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沉下胸部，使两侧肩胛骨向中间靠拢夹紧。"
     }
    }
   }
  },
  "scapular-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the floor away to spread your shoulder blades apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el suelo para separar los omóplatos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il pavimento per allontanare le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手用力推地，主动将两侧肩胛骨向外展分开。"
     }
    }
   }
  },
  "scapular-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move slowly and only travel a few centimetres each way."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muévete despacio, recorriendo sólo unos centímetros en cada sentido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muoviti lentamente e spostati solo di pochi centimetri in ogni direzione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作缓慢受控，每次只移动数厘米幅度。"
     }
    }
   }
  },
  "prone-t-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Prone T Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación en T boca abajo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate a T da prono"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧T字平举"
     }
    }
   }
  },
  "prone-t-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on the floor with your arms out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo con los brazos abiertos en cruz."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù a terra con le braccia aperte ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧于地面，双臂向两侧展开呈T字形。"
     }
    }
   }
  },
  "prone-t-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your forehead lightly on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la frente suavemente en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia leggermente la fronte a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "额头轻触地面，颈部保持放松。"
     }
    }
   }
  },
  "prone-t-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your shoulder blades and lift both arms off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los omóplatos y despega los dos brazos del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi le scapole e solleva entrambe le braccia da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩两侧肩胛骨，将双臂向上抬离地面。"
     }
    }
   }
  },
  "prone-t-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your thumbs pointing up and your neck relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los pulgares hacia arriba y el cuello relajado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i pollici rivolti in alto e il collo rilassato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大拇指朝上，颈部保持自然放松。"
     }
    }
   }
  },
  "prone-t-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your arms slowly back down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los brazos despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制双臂缓慢下放回地面。"
     }
    }
   }
  },
  "superman.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman en el suelo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "超人式"
     }
    }
   }
  },
  "superman.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down with your arms stretched out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo con los brazos estirados por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù con le braccia distese davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧于地面，双臂向前完全伸展。"
     }
    }
   }
  },
  "superman.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your neck in line with your spine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuello en línea con la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il collo in linea con la colonna."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持颈部与脊柱在同一直线上。"
     }
    }
   }
  },
  "superman.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your arms, chest and legs off the floor at the same time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega a la vez brazos, pecho y piernas del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva braccia, petto e gambe da terra allo stesso tempo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂、胸部和双腿同时用力抬离地面。"
     }
    }
   }
  },
  "superman.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes and lower back at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos y la zona lumbar arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei e la zona lombare in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点充分收紧臀大肌与下背部。"
     }
    }
   }
  },
  "superman.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower everything back down slowly and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja todo despacio y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa tutto lentamente e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放身体恢复起始姿势，然后重复动作。"
     }
    }
   }
  },
  "superman-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman isométrico"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Superman statico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "超人式静止保持"
     }
    }
   }
  },
  "superman-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down with your arms reaching forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo con los brazos estirados hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù con le braccia distese in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧于地面，双臂向前完全伸展。"
     }
    }
   }
  },
  "superman-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your arms, chest and legs off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega brazos, pecho y piernas del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva braccia, petto e gambe da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双臂、胸部和双腿同时抬离地面。"
     }
    }
   }
  },
  "superman-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold that position and breathe normally."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta esa posición respirando con normalidad."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione e respira normalmente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在悬空姿态下静止保持，维持均匀自然呼吸。"
     }
    }
   }
  },
  "superman-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your gaze down so your neck stays neutral."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mira hacia el suelo para mantener el cuello neutro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni lo sguardo in basso in modo che il collo resti neutro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "目视地面，确保颈椎处于自然中立位。"
     }
    }
   }
  },
  "superman-hold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Come back down once you cannot hold the shape."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja cuando ya no puedas sostener la postura."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna giù quando non riesci più a mantenere la posizione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当无法继续维持正确形态时，平稳下落放松。"
     }
    }
   }
  },
  "reverse-snow-angel.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reverse Snow Angel"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ángel invertido"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Angeli di neve inversi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "反向雪天使"
     }
    }
   }
  },
  "reverse-snow-angel.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down with your arms by your sides and your palms down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo con los brazos a los costados y las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù con le braccia lungo i fianchi e i palmi in basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧于地面，双臂置于身体两侧，掌心向下。"
     }
    }
   }
  },
  "reverse-snow-angel.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your hands a few centimetres off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega las manos unos centímetros del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le mani di pochi centimetri da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双手抬离地面数厘米。"
     }
    }
   }
  },
  "reverse-snow-angel.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sweep your arms out and overhead, keeping them off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los brazos hacia fuera y por encima de la cabeza sin tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le braccia in fuori e sopra la testa tenendole sollevate da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双手悬空，沿两侧弧形划向头顶上方。"
     }
    }
   }
  },
  "reverse-snow-angel.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring them back down the same path to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuélvelos por el mismo camino hasta los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riportale lungo i fianchi seguendo lo stesso percorso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿相同弧线路径缓慢收回至身体两侧。"
     }
    }
   }
  },
  "reverse-snow-angel.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move slowly and keep your chest lightly lifted."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muévete despacio y mantén el pecho algo elevado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muoviti lentamente e tieni il petto leggermente sollevato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作平稳缓慢，胸部保持微抬离地。"
     }
    }
   }
  },
  "band-pull-apart.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Band Pull-Apart"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperture con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带水平拉开"
     }
    }
   }
  },
  "band-pull-apart.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a band with both hands at shoulder width in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una banda con las dos manos a la anchura de los hombros, delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un elastico con entrambe le mani alla larghezza delle spalle davanti al petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住弹力带置于胸前，双手间距与肩同宽。"
     }
    }
   }
  },
  "band-pull-apart.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and your shoulders down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos estirados y los hombros bajos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia tese e le spalle basse."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双臂伸直，沉肩不耸肩。"
     }
    }
   }
  },
  "band-pull-apart.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the band apart until your arms are out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa la banda hasta abrir los brazos en cruz."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga l'elastico finché le braccia sono aperte ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向两侧水平拉开弹力带，直至双臂展开至身体两侧。"
     }
    }
   }
  },
  "band-pull-apart.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your shoulder blades together at the end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta los omóplatos al final del recorrido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi le scapole alla fine del movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在终点用力向后夹紧两侧肩胛骨。"
     }
    }
   }
  },
  "band-pull-apart.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your hands back together slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a juntar las manos despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riavvicina lentamente le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢受控地收回双手至起始位置。"
     }
    }
   }
  },
  "banded-face-pull.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Face Pull"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Face pull con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Face pull con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带面拉"
     }
    }
   }
  },
  "banded-face-pull.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band at head height and hold an end in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda a la altura de la cabeza y sujeta un extremo con cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico ad altezza testa e tieni un capo in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带固定在头部高度，双手各握一端。"
     }
    }
   }
  },
  "banded-face-pull.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back until the band is under tension."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás hasta tensar la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro finché l'elastico è in tensione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向后退步，直至弹力带产生初始拉力张紧。"
     }
    }
   }
  },
  "banded-face-pull.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your hands towards your face, splitting them apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de las manos hacia la cara separándolas entre sí."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira le mani verso il viso aprendole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手向面部方向拉动，同时向两侧分开。"
     }
    }
   }
  },
  "banded-face-pull.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows high and squeeze your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos altos y aprieta la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti alti e stringi la parte alta della schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘高位抬起，充分收紧上背部肌群。"
     }
    }
   }
  },
  "banded-face-pull.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return your arms forward under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve los brazos hacia delante con control."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta le braccia in avanti con controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制手臂缓慢前伸还原。"
     }
    }
   }
  },
  "banded-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带坐姿划船"
     }
    }
   }
  },
  "banded-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with your legs straight and a band around your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las piernas estiradas y una banda en los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con le gambe tese e un elastico attorno ai piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上双腿伸直，将弹力带绕过双脚脚底。"
     }
    }
   }
  },
  "banded-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold an end of the band in each hand with your arms out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo de la banda con cada mano y los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un capo dell'elastico in ogni mano con le braccia distese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握弹力带一端，手臂向前自然伸出。"
     }
    }
   }
  },
  "banded-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit tall with your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate erguido con el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto con il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸直背，保持躯干挺拔。"
     }
    }
   }
  },
  "banded-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your elbows back until your hands reach your ribs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de los codos hacia atrás hasta llevar las manos a las costillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira i gomiti indietro finché le mani arrivano alle costole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘向后拉，直至双手拉至肋骨两侧。"
     }
    }
   }
  },
  "banded-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms slowly against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos despacio venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Distendi lentamente le braccia contro la resistenza dell'elastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对抗弹力带张力，缓慢伸直双臂还原。"
     }
    }
   }
  },
  "banded-lat-pulldown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Lat Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón al pecho con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lat machine con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带高位下拉"
     }
    }
   }
  },
  "banded-lat-pulldown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band above your head and kneel underneath it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda por encima de la cabeza y ponte de rodillas debajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico sopra la testa e mettiti in ginocchio sotto di esso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带固定在头顶上方，跪坐在弹力带正下方。"
     }
    }
   }
  },
  "banded-lat-pulldown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold an end of the band in each hand with your arms overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo con cada mano y los brazos estirados arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un capo dell'elastico in ogni mano con le braccia sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手举过头顶，各握弹力带一端。"
     }
    }
   }
  },
  "banded-lat-pulldown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulder blades down first."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja primero los omóplatos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa prima le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "首先主动下沉肩胛骨，启动背阔肌。"
     }
    }
   }
  },
  "banded-lat-pulldown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your hands down to shoulder level, opening your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva las manos a la altura de los hombros abriendo el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le mani ad altezza spalle aprendo il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘将双手下拉至肩部高度，同时挺胸展背。"
     }
    }
   }
  },
  "banded-lat-pulldown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your arms rise back up slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que los brazos suban despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia risalire lentamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制手臂缓慢上举还原。"
     }
    }
   }
  },
  "cat-cow-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cat-Cow Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento gato-camello"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gatto-mucca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "猫牛式拉伸"
     }
    }
   }
  },
  "cat-cow-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get on all fours with your hands under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con las manos bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a quattro zampe con le mani sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "四足跪姿着地，双手置于双肩正下方，双膝位于髋部下方。"
     }
    }
   }
  },
  "cat-cow-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe out and round your back, tucking your chin and hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire y redondea la espalda metiendo barbilla y cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira e arrotonda la schiena portando mento e fianchi in dentro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气向上拱起背部，低头收下巴，内卷骨盆（猫式）。"
     }
    }
   }
  },
  "cat-cow-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe in and drop your belly, lifting your chest and tailbone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y deja caer la barriga subiendo pecho y coxis."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e abbassa la pancia sollevando petto e coccige."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气腹部下沉，抬头挺胸，尾骨向上翘起（牛式）。"
     }
    }
   }
  },
  "cat-cow-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move slowly between the two positions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia despacio de una posición a otra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Passa lentamente da una posizione all'altra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在两个姿势之间流畅、缓慢地交替切换。"
     }
    }
   }
  },
  "cat-cow-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your breathing set the pace."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que la respiración marque el ritmo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia che la respirazione detti il ritmo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "配合深长呼吸引导动作节奏。"
     }
    }
   }
  },
  "worlds-greatest-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "World's Greatest Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "El mejor estiramiento del mundo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch completo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "最伟大拉伸"
     }
    }
   }
  },
  "worlds-greatest-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot forward into a deep lunge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso largo hacia delante hasta una zancada profunda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti con un piede in un affondo profondo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一脚向前迈出一大步，顺势下沉进入深弓步。"
     }
    }
   }
  },
  "worlds-greatest-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put both hands on the floor inside the front foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las dos manos en el suelo por dentro del pie de delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti entrambe le mani a terra all'interno del piede davanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手撑在地面，置于前脚内侧。"
     }
    }
   }
  },
  "worlds-greatest-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drop your back hip towards the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja caer la cadera de atrás hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa l'anca posteriore verso terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后侧髋部向下沉，充分延展髋屈肌。"
     }
    }
   }
  },
  "worlds-greatest-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open your chest and reach the inside arm up to the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre el pecho y lleva el brazo de dentro hacia el techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri il petto e porta il braccio interno verso il soffitto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸并向同侧扭转躯干，内侧手臂向上伸展指向天花板。"
     }
    }
   }
  },
  "worlds-greatest-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Come back down, swap legs and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a bajar, cambia de pierna y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna giù, cambia gamba e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂放回地面，换另一侧腿重复动作。"
     }
    }
   }
  },
  "leg-swings-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg Swings"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Balanceo de piernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Oscillazioni delle gambe"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿前后摆腿"
     }
    }
   }
  },
  "leg-swings-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand next to a wall and hold it with one hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte junto a una pared y apóyate con una mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti accanto a un muro e reggiti con una mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在墙边，单手扶墙保持身体平衡。"
     }
    }
   }
  },
  "leg-swings-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your torso upright and your standing leg steady."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el tronco erguido y la pierna de apoyo firme."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il busto dritto e la gamba di appoggio ferma."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干挺直，支撑腿稳定站立。"
     }
    }
   }
  },
  "leg-swings-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swing the free leg forward and back in a relaxed arc."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Balancea la pierna libre adelante y atrás de forma relajada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai oscillare la gamba libera avanti e indietro con un movimento rilassato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "悬空腿前后自然放松地划弧摆动。"
     }
    }
   }
  },
  "leg-swings-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the range grow a little with each swing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que el recorrido crezca poco a poco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aumenta poco alla volta l'ampiezza a ogni oscillazione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "随着摆动逐步适度加大动作幅度。"
     }
    }
   }
  },
  "leg-swings-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish the reps and swap to the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Termina las repeticiones y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Finisci le ripetizioni e passa all'altra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成预定次数后，换另一侧腿进行。"
     }
    }
   }
  },
  "childs-pose.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Child's Pose"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Postura del niño"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Posizione del bambino"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "婴儿式拉伸"
     }
    }
   }
  },
  "childs-pose.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on the floor and sit back onto your heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas y siéntate sobre los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in ginocchio a terra e siediti sui talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝跪地，臀部向后坐于脚后跟上。"
     }
    }
   }
  },
  "childs-pose.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open your knees a little wider than your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre las rodillas algo más que la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri le ginocchia un po' più larghe dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝向两侧分开，略宽于髋部。"
     }
    }
   }
  },
  "childs-pose.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your hands forward and rest your forehead on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira las manos hacia delante y apoya la frente en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina in avanti con le mani e appoggia la fronte a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手向前伸展爬行，额头轻贴地面。"
     }
    }
   }
  },
  "childs-pose.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your chest sink towards the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que el pecho se hunda hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia scendere il petto verso terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "放松胸部与肩背，让身体自然下沉贴向地面。"
     }
    }
   }
  },
  "childs-pose.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe slowly and hold the position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira despacio y aguanta la postura."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira lentamente e tieni la posizione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持缓慢深长的呼吸，静止维持此姿势。"
     }
    }
   }
  },
  "rowing.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rowing Machine"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Vogatore"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "划船机"
     }
    }
   }
  },
  "rowing.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the rower, strap in your feet and grab the handle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el remo, sujeta los pies con las cinchas y coge el agarre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul vogatore, fissa i piedi con le cinghie e impugna la maniglia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在划船机座垫上，扣紧脚踏绑带，双手握住手柄。"
     }
    }
   }
  },
  "rowing.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with your shins vertical and your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con las espinillas verticales y los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia con le tibie verticali e le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起始时小腿垂直于滑轨，双臂向前自然伸直。"
     }
    }
   }
  },
  "rowing.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive with your legs first, then lean back and pull the handle to your ribs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja primero con las piernas, luego échate atrás y tira hasta las costillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi prima con le gambe, poi inclinati indietro e tira la maniglia alle costole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "率先用双腿蹬踏发力，随后躯干微后倾，顺势将手柄拉至下肋处。"
     }
    }
   }
  },
  "rowing.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return in reverse order: arms, then torso, then legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve en orden inverso: brazos, tronco y por último piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna indietro in ordine inverso: braccia, poi busto, poi gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "还原顺序与发力相反：手臂先伸直，躯干前倾，最后屈膝收回双腿。"
     }
    }
   }
  },
  "rowing.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the stroke long and let the rhythm settle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz la palada larga y deja que el ritmo se asiente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la remata lunga e trova il ritmo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持划桨动作完整顺畅，维持稳定节奏。"
     }
    }
   }
  },
  "skierg.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ski Erg"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ski erg"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ski erg"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "滑雪机"
     }
    }
   }
  },
  "skierg.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand in front of the ski erg and take a handle in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate frente al ski erg y coge una empuñadura con cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti davanti allo ski erg e prendi una maniglia in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面对滑雪机站立，双手各握一个手柄。"
     }
    }
   }
  },
  "skierg.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach up so your arms are almost straight overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos casi del todo por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allungati verso l'alto in modo che le braccia siano quasi tese sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上伸展手臂，置于头顶上方且双臂微屈。"
     }
    }
   }
  },
  "skierg.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge at the hips and pull both handles down past your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona la cadera y tira de las dos empuñaduras hasta pasar los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati dai fianchi e tira entrambe le maniglie oltre le cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋俯身，带动双手下拉手柄经大腿两侧向下向后延伸。"
     }
    }
   }
  },
  "skierg.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Use your core and lats, not just your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa el abdomen y los dorsales, no sólo los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa il core e i dorsali, non solo le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "充分调动核心肌群与背阔肌发力，切勿只靠手臂力量。"
     }
    }
   }
  },
  "skierg.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand back up and reach overhead for the next pull."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subir y estira arriba para la siguiente palada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna in piedi e allungati in alto per la tirata successiva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站直身体并将双手重新举过头顶，准备下一次下拉。"
     }
    }
   }
  },
  "swimming.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swim Bench"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Banco de nado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca per nuoto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "游泳训练凳"
     }
    }
   }
  },
  "swimming.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on the swim bench with your chest on the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo en el banco de nado con el pecho en la almohadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù sulla panca da nuoto con il petto sul cuscinetto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧在游泳训练凳上，胸部贴紧垫面。"
     }
    }
   }
  },
  "swimming.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a handle in each hand with your arms reaching forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge una empuñadura con cada mano y estira los brazos hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prendi una maniglia in ogni mano con le braccia distese in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只拉力手柄，手臂向前伸直。"
     }
    }
   }
  },
  "swimming.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull one arm down and back as if you were swimming front crawl."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de un brazo hacia atrás como si nadaras a crol."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira un braccio in basso e indietro come se nuotassi a stile libero."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "模拟自由泳划水动作，单臂向后下方用力划拉。"
     }
    }
   }
  },
  "swimming.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let that arm return forward as the other one pulls."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que ese brazo vuelva adelante mientras el otro tira."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia tornare avanti quel braccio mentre l'altro tira."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "该手臂前伸还原的同时，另一侧手臂向后划水。"
     }
    }
   }
  },
  "swimming.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the strokes long and alternate without pausing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz las brazadas largas y alterna sin parar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le bracciate lunghe e alternale senza pause."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持划水幅度充分舒展，双臂交替连贯无停顿。"
     }
    }
   }
  },
  "PAgTVaK.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Assisted Chest Dip (Kneeling)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fondos de pecho asistidos (de rodillas)"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip assistiti in ginocchio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿助力双杠臂屈伸"
     }
    }
   }
  },
  "PAgTVaK.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the machine to your desired height and secure your knees on the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la máquina a la altura que quieras y apoya bien las rodillas en la almohadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina all'altezza desiderata e blocca le ginocchia sul cuscinetto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整助力器械至合适配重，双膝稳固跪在助力垫板上。"
     }
    }
   }
  },
  "PAgTVaK.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with your palms facing down and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas con las palmas hacia abajo y los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con i palmi rivolti in basso e le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握紧把手，双臂伸直支撑住身体。"
     }
    }
   }
  },
  "PAgTVaK.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows until your upper arms are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos hasta que los brazos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando i gomiti finché la parte alta delle braccia è parallela al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘缓慢下放身体，上身略微前倾，直至大臂与地面平行。"
     }
    }
   }
  },
  "PAgTVaK.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push yourself back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi spingiti di nuovo su fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部停顿片刻，然后胸部与肱三头肌发力推起身体回到起始位置。"
     }
    }
   }
  },
  "PAgTVaK.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "A9qxk2F.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Archer Push Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones de arquero"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti dell'arciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弓箭手俯卧撑"
     }
    }
   }
  },
  "A9qxk2F.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a push-up position with your hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en posición de flexión con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in posizione di piegamento con le mani leggermente più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈俯卧撑起始姿势，双手间距明显宽于双肩。"
     }
    }
   }
  },
  "A9qxk2F.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend one arm straight out to the side, parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira un brazo hacia el lado, paralelo al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi un braccio teso di lato, parallelo al suolo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈身时将重心移向一侧，另一侧手臂向外侧完全伸直。"
     }
    }
   }
  },
  "A9qxk2F.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your elbows, keeping your back straight and core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo flexionando los codos, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando i gomiti, tenendo la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈曲支撑侧手肘下沉身体，保持背部平直且核心收紧。"
     }
    }
   }
  },
  "A9qxk2F.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑侧手臂推地发力，将身体推回中间起始位置。"
     }
    }
   }
  },
  "A9qxk2F.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat on the other side, extending the opposite arm out to the side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite con el otro lado, estirando el brazo contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti dall'altro lato, estendendo il braccio opposto di lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "换另一侧重复动作，伸直对侧手臂。"
     }
    }
   }
  },
  "PSlvNMs.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti zavorrati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重俯卧撑"
     }
    }
   }
  },
  "PSlvNMs.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a push-up position and have a partner place a weight plate on your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en posición de flexión y pide que te coloquen un disco en la parte alta de la espalda."
     }
    }
   }
  },
  "PSlvNMs.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in a straight line from head to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo en línea recta de la cabeza a los talones."
     }
    }
   }
  },
  "PSlvNMs.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest to just above the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hasta casi tocar el suelo."
     }
    }
   }
  },
  "PSlvNMs.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hasta estirar los brazos."
     }
    }
   }
  },
  "PSlvNMs.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the plate steady without letting your hips sag."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el disco estable sin dejar caer la cadera."
     }
    }
   }
  },
  "hl8DUh8.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Decline Wide-grip Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press declinado con barra y agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca declinata a presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜宽握杠铃卧推"
     }
    }
   }
  },
  "hl8DUh8.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your feet secured and your head lower than your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con los pies sujetos y la cabeza más baja que la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con i piedi bloccati e la testa più in basso dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，双脚固定在挡腿垫下，头部低于髋部。"
     }
    }
   }
  },
  "hl8DUh8.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with a wide grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra abierto, algo más ancho que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa larga, leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手采用较宽握距抓握杠铃，明显宽于肩宽。"
     }
    }
   }
  },
  "hl8DUh8.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell to your chest, keeping your elbows out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra al pecho, con los codos abiertos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere al petto, tenendo i gomiti aperti ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将杠铃下放至下胸部位置，手肘向两侧适度展开。"
     }
    }
   }
  },
  "hl8DUh8.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the barbell back up to the starting position, fully extending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra de vuelta a la posición inicial estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere di nuovo su fino alla posizione iniziale, estendendo completamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸肌发力将杠铃向上推回起始位置，双臂自然伸直。"
     }
    }
   }
  },
  "hl8DUh8.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "0CXGHya.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Crossover"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cruces en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Croci ai cavi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索夹胸"
     }
    }
   }
  },
  "0CXGHya.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the cable pulleys to chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta las poleas a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola le pulegge dei cavi all'altezza del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将龙门架滑轮调节至胸部高度。"
     }
    }
   }
  },
  "0CXGHya.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand in the center of the cable machine with one foot in front of the other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en el centro de la máquina con un pie por delante del otro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti al centro della macchina a cavi con un piede davanti all'altro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在器械中央，双脚呈前后弓步站立以维持平衡。"
     }
    }
   }
  },
  "0CXGHya.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with your palms facing down and your arms extended out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas con las palmas hacia abajo y los brazos abiertos a los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con i palmi rivolti in basso e le braccia tese ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手抓握把手，掌心朝前下方，双臂向两侧展开。"
     }
    }
   }
  },
  "0CXGHya.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a step forward, keeping your arms slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante, con los brazos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti, mantenendo le braccia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体微向前倾迈进一步，双肘保持微屈。"
     }
    }
   }
  },
  "0CXGHya.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With a slight bend in your elbows, bring your hands together in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los codos algo flexionados, junta las manos delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con una leggera piegatura nei gomiti, porta le mani unite davanti al petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持肘角稳定，胸肌发力向内收拢双手至胸前相聚夹紧。"
     }
    }
   }
  },
  "33AzZeV.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Front Raise and Pullover"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación frontal y pullover con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate frontali + pullover con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃前平举结合仰卧拉臂"
     }
    }
   }
  },
  "33AzZeV.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a barbell with an overhand grip, palms facing down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en pronación, con las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e impugna un bilanciere con presa prona, palmi rivolti in basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手正握杠铃，掌心向下。"
     }
    }
   }
  },
  "33AzZeV.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and raise the barbell in front of you until it reaches shoulder height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos estirados, sube la barra por delante hasta la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia tese e solleva il bilanciere davanti a te finché arriva all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双臂伸直，将杠铃向前上方平举至肩部高度。"
     }
    }
   }
  },
  "33AzZeV.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶端稍作停顿，然后控制速度缓慢下放回起始位置。"
     }
    }
   }
  },
  "33AzZeV.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Next, lower the barbell behind your head, keeping your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Después baja la barra por detrás de la cabeza, con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Poi abbassa il bilanciere dietro la testa, tenendo le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "接着将杠铃沿弧线上举并经头顶向后延展，保持手臂伸直。"
     }
    }
   }
  },
  "33AzZeV.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then raise the barbell back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y sube la barra a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi solleva di nuovo il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在充分延展处停顿片刻，然后发力将杠铃拉回起始位置。"
     }
    }
   }
  },
  "DwhEmmE.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Decline Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press declinado con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca declinata con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜哑铃卧推"
     }
    }
   }
  },
  "DwhEmmE.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie down on a decline bench with your feet secured and your head lower than your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con los pies sujetos y la cabeza más baja que la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con i piedi bloccati e la testa più in basso dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，双脚勾紧固定垫，头部低于臀部。"
     }
    }
   }
  },
  "DwhEmmE.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand and extend your arms straight up above your chest, palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano y estira los brazos encima del pecho, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in ogni mano ed estendi le braccia tese sopra il petto, palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持一只哑铃推起至胸部上方，双臂伸直，掌心朝前。"
     }
    }
   }
  },
  "DwhEmmE.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells slowly to the sides of your chest, keeping your elbows at a 90-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio a los lados del pecho, con los codos a 90 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i manubri ai lati del petto, mantenendo i gomiti a un angolo di 90 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制哑铃缓慢下放至下胸部两侧，屈肘约呈90度。"
     }
    }
   }
  },
  "DwhEmmE.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the dumbbells back up to the starting position, fully extending your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las mancuernas de vuelta a la posición inicial estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i manubri di nuovo su fino alla posizione iniziale, estendendo completamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸肌收缩发力将哑铃推回起始位置，双臂完全伸展。"
     }
    }
   }
  },
  "DwhEmmE.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "WbNq5Xu.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Chest Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de pecho en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Chest press alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械推胸"
     }
    }
   }
  },
  "WbNq5Xu.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the machine with your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate en la máquina con los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e siediti alla macchina con i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节器械握把高度，双脚平稳踩在地面，站姿端正。"
     }
    }
   }
  },
  "WbNq5Xu.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip and position your hands at chest level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación y colócalas a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona e porta le mani all'altezza del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正手握紧把手，使双手位于胸口高度。"
     }
    }
   }
  },
  "WbNq5Xu.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the handles forward until your arms are fully extended, keeping your elbows slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las asas hacia delante hasta estirar los brazos, con los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le maniglie in avanti finché le braccia sono completamente tese, mantenendo i gomiti leggermente piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "发力向前推起手柄直至手臂充分伸展，手肘保持微屈不锁死。"
     }
    }
   }
  },
  "WbNq5Xu.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then slowly bring the handles back towards your chest, maintaining control throughout the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y vuelve a llevar las asas al pecho despacio, controlando el movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi riporta lentamente le maniglie verso il petto, mantenendo il controllo per tutto il movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰停顿片刻，随后缓慢让手柄回移向胸部，全程维持肌肉对抗张力。"
     }
    }
   }
  },
  "WbNq5Xu.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "xXm4nYq.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Decline Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas declinadas con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Croci declinate con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜哑铃飞鸟"
     }
    }
   }
  },
  "xXm4nYq.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a decline bench with your feet secured and your head lower than your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco declinado con los pies sujetos y la cabeza más baja que la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca declinata con i piedi bloccati e la testa più in basso dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躺在下斜卧推凳上，双脚固定在卡位垫后，头部低于髋部。"
     }
    }
   }
  },
  "xXm4nYq.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand with your palms facing each other and your arms extended above your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano con las palmas enfrentadas y los brazos estirados encima del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in ogni mano con i palmi uno di fronte all'altro e le braccia tese sopra il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持哑铃置于胸部上方，掌心相对，双肘微屈。"
     }
    }
   }
  },
  "xXm4nYq.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells out to the sides in a wide arc until you feel a stretch in your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas a los lados en un arco amplio hasta notar el estiramiento en el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa i manubri ai lati con un ampio arco finché senti un allungamento nel petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿宽弧线向两侧平缓下放哑铃，直到下胸部获得充分拉伸感。"
     }
    }
   }
  },
  "xXm4nYq.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then squeeze your chest muscles to bring the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y aprieta el pecho para devolver las mancuernas a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi stringi i muscoli del petto per riportare i manubri alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部停顿片刻，然后收缩胸大肌发力沿弧线夹回起始位置。"
     }
    }
   }
  },
  "xXm4nYq.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "7E06s6d.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Chest Tap Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones con toque al pecho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti con tocco al petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "拍胸俯卧撑"
     }
    }
   }
  },
  "7E06s6d.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a high plank position with your hands slightly wider than shoulder-width apart and your body in a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha alta con las manos algo más abiertas que los hombros y el cuerpo en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in posizione di plank alto con le mani leggermente più larghe delle spalle e il corpo in linea retta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈高位平板支撑姿势，双手略宽于肩，身体保持一条直线。"
     }
    }
   }
  },
  "7E06s6d.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body towards the ground by bending your elbows, keeping them close to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo hacia el suelo flexionando los codos, manteniéndolos pegados al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo verso terra piegando i gomiti, tenendoli vicini ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉身体接近地面，手肘适度夹紧躯干。"
     }
    }
   }
  },
  "7E06s6d.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you lower yourself, tap your chest with your right hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al bajar, tócate el pecho con la mano derecha."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre scendi, tocca il petto con la mano destra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在推起或下落过程中，迅速用右手轻拍胸部。"
     }
    }
   }
  },
  "7E06s6d.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti di nuovo su fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推地发力，撑起身体回到起始高位平板姿势。"
     }
    }
   }
  },
  "7E06s6d.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat the movement, this time tapping your chest with your left hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite el movimiento, esta vez tocándote el pecho con la mano izquierda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti il movimento, questa volta toccando il petto con la mano sinistra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作，换用左手轻拍胸部，左右交替进行。"
     }
    }
   }
  },
  "trqKQv2.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca piana al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯平板卧推"
     }
    }
   }
  },
  "trqKQv2.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the height of the smith machine bar to chest level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la barra del multipower a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del bilanciere del multipower all'altezza del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整史密斯机卧推凳及杠铃高度，使杠铃下落轨迹对准中胸部。"
     }
    }
   }
  },
  "trqKQv2.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on the bench with your feet firmly planted on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies bien plantados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati disteso sulla panca con i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双脚踩实地面，下沉收紧肩胛骨。"
     }
    }
   }
  },
  "trqKQv2.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grip the bar with an overhand grip slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "trqKQv2.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the bar and lower it towards your chest, keeping your elbows tucked in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y bájala hacia el pecho, con los codos recogidos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sgancia il bilanciere e abbassalo verso il petto, tenendo i gomiti stretti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "转腕出杠，控制杠铃平稳下放至胸前，手肘自然内收。"
     }
    }
   }
  },
  "trqKQv2.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment when the bar touches your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento cuando la barra toque el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento quando il bilanciere tocca il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃轻触胸部时稍作停顿，随后胸肌发力推回原位。"
     }
    }
   }
  },
  "wigSg76.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Clap Push Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones con palmada"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti con battito di mani"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "击掌俯卧撑"
     }
    }
   }
  },
  "wigSg76.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a high plank position with your hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha alta con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in posizione di plank alto con le mani leggermente più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈高位平板支撑姿势，双手间距略宽于肩。"
     }
    }
   }
  },
  "wigSg76.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body towards the ground by bending your elbows, keeping your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el cuerpo hacia el suelo flexionando los codos, con el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo verso terra piegando i gomiti, tenendo il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘平稳下沉身体，全程收紧核心肌群。"
     }
    }
   }
  },
  "wigSg76.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your palms explosively to propel your body off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con las palmas de forma explosiva para despegar el cuerpo del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui palmi con esplosività per staccare il corpo da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手手掌爆发力推地，使上半身腾空弹起。"
     }
    }
   }
  },
  "wigSg76.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "While in mid-air, clap your hands together before landing back in the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "En el aire, da una palmada antes de caer en la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre sei in aria, batti le mani davanti a te prima di atterrare nella posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在身体腾空的瞬间迅速双手击掌一次，随后迅速分开放平平稳缓冲着地。"
     }
    }
   }
  },
  "wigSg76.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "JsKq9so.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Wide Bench Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de banca con barra y agarre ancho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Panca piana a presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "宽握杠铃卧推"
     }
    }
   }
  },
  "JsKq9so.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on a bench with your feet flat on the ground and your back pressed against the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en el banco con los pies apoyados en el suelo y la espalda pegada al banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati disteso su una panca con i piedi ben piantati a terra e la schiena premuta contro la panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平躺在卧推凳上，双脚实踩地面，肩胛收缩贴紧凳面。"
     }
    }
   }
  },
  "JsKq9so.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with a wide grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra abierto, algo más ancho que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa larga, leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "采用较宽的握距正握杠铃，握距明显宽于双肩。"
     }
    }
   }
  },
  "JsKq9so.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the barbell off the rack and hold it directly above your chest with your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y sujétala justo encima del pecho con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il bilanciere dal rack e tienilo sopra il petto con le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃推离出杠架，停在胸部正上方，双臂完全伸展。"
     }
    }
   }
  },
  "JsKq9so.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell slowly towards your chest, keeping your elbows slightly flared out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra despacio hacia el pecho, con los codos algo abiertos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente il bilanciere verso il petto, tenendo i gomiti leggermente aperti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制杠铃平缓下落至胸口，手肘向两侧自然外展。"
     }
    }
   }
  },
  "JsKq9so.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment when the barbell touches your chest, then push it back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento cuando la barra toque el pecho y empújala de vuelta a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento quando il bilanciere tocca il petto, poi spingilo di nuovo su fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当杠铃轻触胸口时停顿片刻，随后胸大肌爆发力推回至起始高位。"
     }
    }
   }
  },
  "tBWXbIT.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Incline Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas inclinadas en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Croci inclinate al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜绳索飞鸟"
     }
    }
   }
  },
  "tBWXbIT.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the cable machine to a low position and attach the handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la polea en posición baja y engancha las asas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina a cavi in posizione bassa e aggancia le maniglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将龙门架滑轮调至低位，并扣上单手把手。"
     }
    }
   }
  },
  "tBWXbIT.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on an incline bench with your back against the pad and feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco inclinado con la espalda contra el respaldo y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca inclinata con la schiena contro lo schienale e i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在上斜凳上，背部靠实椅背，双脚平踩地面。"
     }
    }
   }
  },
  "tBWXbIT.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip and extend your arms straight out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación y estira los brazos por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona ed estendi le braccia tese davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手持握把手，双臂微屈向前上方展开。"
     }
    }
   }
  },
  "tBWXbIT.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping a slight bend in your elbows, open your arms out to the sides in a controlled motion."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los codos algo flexionados, abre los brazos a los lados de forma controlada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantenendo una leggera piegatura nei gomiti, apri le braccia ai lati con un movimento controllato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘微屈角度固定，平稳受控地向两侧斜下方张开双臂。"
     }
    }
   }
  },
  "tBWXbIT.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the fully extended position, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento con todo estirado y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in massima apertura, poi torna lentamente alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在充分拉伸位稍作停顿，上胸发力向内上方夹聚恢复起始位置。"
     }
    }
   }
  },
  "pec-deck.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pec Deck"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Contractora de pecho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pec deck"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蝴蝶机夹胸"
     }
    }
   }
  },
  "pec-deck.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the pec deck with your back flat against the pad and your feet planted."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la contractora con la espalda pegada al respaldo y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti al pec deck con la schiena contro lo schienale e i piedi piantati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在蝴蝶机上，背部紧贴靠背，双脚平稳踩实地面。"
     }
    }
   }
  },
  "pec-deck.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the handles so your upper arms sit level with your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta las agarraderas para que los brazos queden a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola le maniglie così le braccia stanno all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整座椅或手柄高度，使大臂与肩部保持同一水平。"
     }
    }
   }
  },
  "pec-deck.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab both handles with a light bend in your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta las dos agarraderas con los codos ligeramente flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con i gomiti appena piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住把手，手肘保持微屈。"
     }
    }
   }
  },
  "pec-deck.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your chest to bring the handles together in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el pecho para juntar las agarraderas por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il petto per unire le maniglie davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩胸肌，发力将两侧把手向胸前中心合拢挤压。"
     }
    }
   }
  },
  "pec-deck.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open your arms back slowly until you feel a stretch across your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los brazos despacio hasta notar el estiramiento en el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riapri lentamente finche senti allungare il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制速度缓慢张开双臂，直至胸大肌完全拉伸。"
     }
    }
   }
  },
  "incline-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Incline Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones inclinadas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti inclinati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上斜俯卧撑"
     }
    }
   }
  },
  "incline-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put your hands on a bench or a sturdy box, slightly wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las manos en un banco o un cajón firme, algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le mani su una panca o su una scatola robusta, a larghezza leggermente superiore alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双手支撑在健身凳或稳固箱体上，间距略宽于肩。"
     }
    }
   }
  },
  "incline-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet back until your body is in a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anda con los pies hacia atrás hasta dejar el cuerpo en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta i piedi indietro finché il corpo è in linea retta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向后退，直至身体从头到脚呈一条直线。"
     }
    }
   }
  },
  "incline-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest to the edge of the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hasta el borde del banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il petto verso il bordo della panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉身体，使胸部接近凳子边缘。"
     }
    }
   }
  },
  "incline-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows at about forty-five degrees from your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos a unos cuarenta y cinco grados del cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti a circa quarantacinque gradi dal corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘与身体躯干呈约45度夹角。"
     }
    }
   }
  },
  "incline-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推凳发力，直至手臂完全伸直回到起始位置。"
     }
    }
   }
  },
  "knee-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Knee Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones de rodillas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti sulle ginocchia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿俯卧撑"
     }
    }
   }
  },
  "knee-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on the floor and put your hands under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas y coloca las manos debajo de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in ginocchio a terra e appoggia le mani sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝跪在地面上，双手撑地位于双肩正下方。"
     }
    }
   }
  },
  "knee-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your hands forward until your body forms a straight line from head to knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anda con las manos hacia delante hasta dejar el cuerpo recto de la cabeza a las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avanza con le mani finché il corpo forma una linea retta dalla testa alle ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手向前微移，使身体从头部到膝盖形成一条直线。"
     }
    }
   }
  },
  "knee-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest towards the floor with your elbows tucked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hacia el suelo con los codos recogidos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il petto verso il pavimento con i gomiti stretti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉胸部朝向地面，手肘适度内收。"
     }
    }
   }
  },
  "knee-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your chest is a fist away from the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando el pecho quede a un puño del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando il petto è a un pugno da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当胸部距离地面约一拳高度时停止下落。"
     }
    }
   }
  },
  "knee-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up without letting your hips sag."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba sin dejar caer la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su senza lasciare che i fianchi cedano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手发力推起身体，注意保持核心收紧、臀部不塌陷。"
     }
    }
   }
  },
  "wide-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wide Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones con manos anchas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti a presa larga"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "宽距俯卧撑"
     }
    }
   }
  },
  "wide-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a push-up position with your hands well outside your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en posición de flexión con las manos bastante por fuera de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in posizione di piegamento con le mani ben oltre le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈俯卧撑姿势，双手撑地间距明显宽于双肩。"
     }
    }
   }
  },
  "wide-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body in a straight line from head to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo recto de la cabeza a los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo in linea retta dalla testa ai talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持身体从头部至脚后跟笔直呈一条直线。"
     }
    }
   }
  },
  "wide-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest until it is just above the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hasta justo por encima del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il petto finché è appena sopra il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉胸部，直至胸口接近地面。"
     }
    }
   }
  },
  "wide-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your elbows flare out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que los codos se abran hacia los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia che i gomiti si aprano ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "允许手肘向身体两侧自然展开。"
     }
    }
   }
  },
  "wide-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the floor away to return to the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el suelo para volver arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il pavimento via per tornare in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推地发力，撑回至起始高位。"
     }
    }
   }
  },
  "decline-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Decline Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones declinadas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti declinati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下斜俯卧撑"
     }
    }
   }
  },
  "decline-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put your feet on a bench and your hands on the floor under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon los pies en un banco y las manos en el suelo bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia i piedi su una panca e le mani a terra sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双脚架在健身凳上，双手撑于地面双肩正下方。"
     }
    }
   }
  },
  "decline-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body straight and your core tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo recto y el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo dritto e il core stretto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干笔直，核心全程收紧。"
     }
    }
   }
  },
  "decline-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il petto verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘平稳下沉身体，将胸口压向地面。"
     }
    }
   }
  },
  "decline-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your upper arms are level with your back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando los brazos queden a la altura de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando la parte alta delle braccia è in linea con la schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当大臂与背部齐平或略低于背部时停止。"
     }
    }
   }
  },
  "decline-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up until your arms lock out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hasta estirar los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su finché le braccia sono bloccate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸肌发力推回原位，双臂自然伸直。"
     }
    }
   }
  },
  "typewriter-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Typewriter Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones máquina de escribir"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti typewriter"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "打字机俯卧撑"
     }
    }
   }
  },
  "typewriter-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up in a push-up position with your hands very wide."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en posición de flexión con las manos muy abiertas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in posizione di piegamento con le mani molto larghe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈超宽距俯卧撑姿势准备。"
     }
    }
   }
  },
  "typewriter-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself towards one hand, bending that elbow and keeping the other arm straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hacia una mano flexionando ese codo y dejando el otro brazo estirado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati verso una mano, piegando quel gomito e tenendo l'altro braccio teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体下沉移向一侧手掌，弯曲该侧手肘，同时保持另一臂完全伸直。"
     }
    }
   }
  },
  "typewriter-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide your chest across to the other hand, staying low."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desplaza el pecho hasta la otra mano sin subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai scivolare il petto verso l'altra mano, restando basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "贴近地面保持超低姿态，将胸部水平滑移至另一侧手掌处。"
     }
    }
   }
  },
  "typewriter-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up on the far side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba desde el lado contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su dal lato opposto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在该侧单臂推地支撑将身体推起。"
     }
    }
   }
  },
  "typewriter-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Alternate the side you lower to on every rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna el lado al que bajas en cada repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna il lato verso cui scendi a ogni ripetizione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "每一组重复交替向不同方向滑移下沉。"
     }
    }
   }
  },
  "hindu-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hindu Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones hindúes"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti indu"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "印度俯卧撑"
     }
    }
   }
  },
  "hindu-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with your hips high and your hands and feet on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con la cadera alta y las manos y los pies en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti con i fianchi alti e mani e piedi a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手双脚撑地，臀部高高翘起成倒V字形姿态。"
     }
    }
   }
  },
  "hindu-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dive your chest down between your hands as you bend your arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho entre las manos flexionando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tuffa il petto tra le mani piegando le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈臂俯冲，使胸部贴近两手之间的地面向下向前滑移。"
     }
    }
   }
  },
  "hindu-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sweep forward and push your chest up towards the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desplázate hacia delante y sube el pecho hacia el techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scivola in avanti e spingi il petto su verso il soffitto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体顺势向前向上穿梭推起，昂首挺胸朝向天花板。"
     }
    }
   }
  },
  "hindu-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your arms with your hips low and your back arched."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos con la cadera baja y la espalda arqueada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Raddrizza le braccia con i fianchi bassi e la schiena inarcata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "伸直双臂，臀部下沉接近地面，背部呈自然反弓伸展。"
     }
    }
   }
  },
  "hindu-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back up to the start and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subir la cadera a la posición inicial y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi di nuovo su alla partenza e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心发力将臀部重新向后上方推起，恢复起始倒V字形姿态。"
     }
    }
   }
  },
  "wall-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wall Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones en pared"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "墙壁俯卧撑"
     }
    }
   }
  },
  "wall-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand an arm's length from a wall and place your palms on it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a un brazo de distancia de la pared y apoya las palmas en ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a una distanza di un braccio dal muro e appoggia i palmi su di esso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面对墙壁站立，保持约一臂距离，双掌贴于墙面。"
     }
    }
   }
  },
  "wall-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your hands slightly wider than your shoulders at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca las manos algo más anchas que los hombros, a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti le mani leggermente più larghe delle spalle all'altezza del petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手置于胸口高度，间距略宽于肩。"
     }
    }
   }
  },
  "wall-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body straight and lean in by bending your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo recto e inclínate flexionando los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo dritto e piegati in avanti piegando i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干挺直成一条直线，屈肘使身体前倾。"
     }
    }
   }
  },
  "wall-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your chest close to the wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca el pecho a la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvicina il petto al muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下压至胸部贴近墙面。"
     }
    }
   }
  },
  "wall-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push yourself back until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti indietro finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推墙发力，还原至双臂伸直状态。"
     }
    }
   }
  },
  "seal-jack.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seal Jack"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saltos con palmada frontal"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Seal jack"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "海豹开合跳"
     }
    }
   }
  },
  "seal-jack.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet together and your arms straight out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies juntos y los brazos abiertos en cruz."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi uniti e le braccia tese ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚并拢站立，双臂向身体两侧水平伸直展开。"
     }
    }
   }
  },
  "seal-jack.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump your feet apart while you clap your hands in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los pies de un salto mientras juntas las manos delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta divaricando i piedi mentre batti le mani davanti al petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跳起分腿落地的同时，双臂在胸前击掌相碰。"
     }
    }
   }
  },
  "seal-jack.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open your arms wide again as you jump your feet back together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a abrir los brazos mientras juntas los pies de un salto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riapri le braccia mentre salti riunendo i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再次起跳双脚并拢的同时，双臂重新向两侧张开。"
     }
    }
   }
  },
  "seal-jack.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms at shoulder height the whole time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos a la altura de los hombros todo el rato."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia all'altezza delle spalle per tutto il tempo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整个过程中手臂始终保持在肩部高度水平。"
     }
    }
   }
  },
  "seal-jack.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat at a steady pace."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite a un ritmo constante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti a un ritmo costante."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持平稳节奏连续重复跳跃。"
     }
    }
   }
  },
  "doorway-chest-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Doorway Chest Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de pecho en el marco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch petto alla porta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "门框胸肌拉伸"
     }
    }
   }
  },
  "doorway-chest-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand in a doorway and put a forearm on the frame."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en el marco de una puerta y apoya un antebrazo en él."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sulla porta e appoggia un avambraccio allo stipite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在门框处，将一侧前臂平贴在门框垂直立面上。"
     }
    }
   }
  },
  "doorway-chest-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your elbow at about shoulder height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon el codo más o menos a la altura del hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il gomito circa all'altezza della spalla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将手肘高度置于约与肩齐平的位置。"
     }
    }
   }
  },
  "doorway-chest-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step forward with the same-side foot until you feel the stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Adelanta el pie del mismo lado hasta notar el estiramiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo avanti con il piede dello stesso lato finché senti lallungamento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同侧腿向前迈出一小步，身体前倾，直到胸大肌产生舒适拉伸感。"
     }
    }
   }
  },
  "doorway-chest-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest open and your shoulder down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho abierto y el hombro bajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto aperto e la spalla bassa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸并沉下肩膀，避免耸肩。"
     }
    }
   }
  },
  "doorway-chest-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold, then swap arms and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta, cambia de brazo y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione, poi cambia braccio e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持拉伸数秒，换另一侧手臂重复。"
     }
    }
   }
  },
  "myfUsKf.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Reverse Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pájaros en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperture posteriori alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械反向飞鸟"
     }
    }
   }
  },
  "myfUsKf.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the machine with your chest against the pad and your feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate con el pecho contra la almohadilla y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e siediti alla macchina con il petto contro il cuscinetto e i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节座椅高度，胸部紧贴靠垫面向器械坐好，双脚平放地面。"
     }
    }
   }
  },
  "myfUsKf.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip and keep your arms slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación y mantén los brazos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona e tieni le braccia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握把手，手肘保持微屈。"
     }
    }
   }
  },
  "myfUsKf.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Exhale and squeeze your shoulder blades together as you pull the handles back and outward, away from your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire y junta las escápulas mientras llevas las asas atrás y hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira e stringi le scapole mentre tiri le maniglie indietro e verso l'esterno, lontano dal corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气，后束与肩胛骨收紧发力，将把手向后外侧水平拉开。"
     }
    }
   }
  },
  "myfUsKf.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the peak contraction, then inhale and slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento en la máxima contracción, coge aire y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in massima contrazione, poi inspira e torna lentamente alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩处稍作停顿，吸气并控制把手平缓回移至起始位置。"
     }
    }
   }
  },
  "myfUsKf.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "e4aFmFY.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plate Front Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación frontal con disco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate frontali con disco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃片前平举"
     }
    }
   }
  },
  "e4aFmFY.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall holding a weight plate by its sides in front of your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sujetando un disco por los lados delante de los muslos."
     }
    }
   }
  },
  "e4aFmFY.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight with a slight bend in the elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos estirados con los codos un poco flexionados."
     }
    }
   }
  },
  "e4aFmFY.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise the plate in front of you until it reaches eye level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el disco por delante hasta la altura de los ojos."
     }
    }
   }
  },
  "e4aFmFY.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top without leaning back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba sin echarte hacia atrás."
     }
    }
   }
  },
  "e4aFmFY.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the plate slowly back to your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el disco despacio hasta los muslos."
     }
    }
   }
  },
  "xHKN2s8.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell One Arm Snatch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arrancada a un brazo con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Strappo a un braccio con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃单臂抓举"
     }
    }
   }
  },
  "xHKN2s8.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, toes pointing slightly outwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle, punte leggermente aperte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "xHKN2s8.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, mani leggermente più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单手正手抓握杠铃正中央平衡点。"
     }
    }
   }
  },
  "xHKN2s8.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees and lower your hips into a squat position, keeping your back straight and chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas y baja la cadera a la sentadilla, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega le ginocchia e abbassa i fianchi in posizione di squat, tenendo la schiena dritta e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋下沉至深蹲位，保持背部平直挺胸。"
     }
    }
   }
  },
  "xHKN2s8.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Explosively extend your hips, knees, and ankles, driving the barbell upwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira cadera, rodillas y tobillos de forma explosiva, impulsando la barra hacia arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi con esplosività fianchi, ginocchia e caviglie, spingendo il bilanciere verso lalto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋、膝、踝三关节爆发力强力伸展，驱动杠铃直线向上加速。"
     }
    }
   }
  },
  "xHKN2s8.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As the barbell reaches chest level, pull it upwards with your arm, keeping it close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuando la barra llegue a la altura del pecho, tira de ella con el brazo manteniéndola pegada al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Quando il bilanciere arriva all'altezza del petto, tiralo verso lalto con il braccio, tenendolo vicino al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当杠铃上升至胸口高度时，顺势单臂上拉并翻肘锁定在头顶上方。"
     }
    }
   }
  },
  "aqvSOQE.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Reverse Fly"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperturas inversas en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aperture inverse al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索反向飞鸟"
     }
    }
   }
  },
  "aqvSOQE.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set both pulleys at shoulder height and stand in the middle of the station."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las dos poleas a la altura de los hombros y colócate en el centro."
     }
    }
   }
  },
  "aqvSOQE.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take the left handle in your right hand and the right handle in your left, so the cables cross."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge el agarre izquierdo con la mano derecha y el derecho con la izquierda, cruzando los cables."
     }
    }
   }
  },
  "aqvSOQE.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold your arms out in front of you with a slight bend in the elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta los brazos por delante con los codos un poco flexionados."
     }
    }
   }
  },
  "aqvSOQE.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your arms out and back until they line up with your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los brazos hacia fuera y atrás hasta alinearlos con los hombros."
     }
    }
   }
  },
  "aqvSOQE.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your arms come back together in front of you slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que los brazos vuelvan a juntarse por delante despacio."
     }
    }
   }
  },
  "67n3r98.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lever Shoulder Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de hombro en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shoulder press alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿器械推肩"
     }
    }
   }
  },
  "67n3r98.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the machine with your back against the backrest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate con la espalda contra el respaldo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e siediti alla macchina con la schiena contro lo schienale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节座椅高度，端坐于器械上，背部贴稳靠背。"
     }
    }
   }
  },
  "67n3r98.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip and position your hands at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las asas en pronación y colócalas a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona e porta le mani all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正握手柄，使双手起始位于肩部高度。"
     }
    }
   }
  },
  "67n3r98.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the handles upward until your arms are fully extended, but do not lock your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las asas hacia arriba hasta estirar los brazos, sin bloquear los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le maniglie verso lalto finché le braccia sono completamente tese, ma senza bloccare i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三角肌发力向上推举手柄直至双臂充分伸展，手肘微屈不锁死。"
     }
    }
   }
  },
  "67n3r98.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the handles back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las asas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente le maniglie fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶端稍作停顿，随后控制速度缓慢下放手柄回起始位置。"
     }
    }
   }
  },
  "67n3r98.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "3d7wHyd.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seated Dumbbell Shoulder Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de hombros sentado con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lento avanti da seduto con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿哑铃推肩"
     }
    }
   }
  },
  "3d7wHyd.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with back support and a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con respaldo y una mancuerna en cada mano."
     }
    }
   }
  },
  "3d7wHyd.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the dumbbells up to shoulder height with your palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas a la altura de los hombros con las palmas hacia delante."
     }
    }
   }
  },
  "3d7wHyd.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the dumbbells overhead until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las mancuernas por encima de la cabeza hasta estirar los brazos."
     }
    }
   }
  },
  "3d7wHyd.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back against the pad throughout."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda pegada al respaldo todo el rato."
     }
    }
   }
  },
  "3d7wHyd.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbells slowly back to your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las mancuernas despacio hasta los hombros."
     }
    }
   }
  },
  "VLYXo8S.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Arm Circles"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Círculos de brazos con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Circonduzioni zavorrate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重手臂绕环"
     }
    }
   }
  },
  "VLYXo8S.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall holding a light weight plate or dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con un disco ligero o una mancuerna en cada mano."
     }
    }
   }
  },
  "VLYXo8S.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your arms out to the sides until they are level with your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los brazos hacia los lados hasta la altura de los hombros."
     }
    }
   }
  },
  "VLYXo8S.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows straight and your shoulders down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos estirados y los hombros bajos."
     }
    }
   }
  },
  "VLYXo8S.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Draw small circles with your hands, slowly making them bigger."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dibuja círculos pequeños con las manos y hazlos más grandes poco a poco."
     }
    }
   }
  },
  "VLYXo8S.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Switch direction halfway through the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia de sentido a mitad de la serie."
     }
    }
   }
  },
  "S9zHIvU.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Rear Delt Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo al cuello posterior con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore per deltoidi posteriori con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃三角肌后束划船"
     }
    }
   }
  },
  "S9zHIvU.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e le ginocchia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双膝微屈。"
     }
    }
   }
  },
  "S9zHIvU.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna un bilanciere con presa prona, mani leggermente più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "S9zHIvU.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend forward at the hips, keeping your back straight and chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate desde la cadera, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati in avanti con i fianchi, tenendo la schiena dritta e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋俯身，保持背部平直，胸部微挺。"
     }
    }
   }
  },
  "S9zHIvU.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the barbell towards your chest, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de la barra hacia el pecho juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il bilanciere verso il petto, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双肘向外展向后拉动杠铃至上胸处，顶峰夹紧肩胛骨与三角肌后束。"
     }
    }
   }
  },
  "S9zHIvU.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰停顿片刻，随后缓慢平稳下放杠铃回起始位置。"
     }
    }
   }
  },
  "u2X71Np.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Front Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación frontal en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate frontali al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索前平举"
     }
    }
   }
  },
  "u2X71Np.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and grasp the cable handle with an overhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y agarra el asa de la polea en pronación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e afferra la maniglia del cavo con presa prona."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手正握低位滑轮绳索把手。"
     }
    }
   }
  },
  "u2X71Np.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺直，核心收紧。"
     }
    }
   }
  },
  "u2X71Np.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise the cable handle in front of you, keeping your arms straight and your palms facing down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el asa de la polea por delante, con los brazos estirados y las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva la maniglia del cavo davanti a te, tenendo le braccia tese e i palmi rivolti in basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手臂微屈，掌心朝下，将绳索把手向前上方平稳抬起。"
     }
    }
   }
  },
  "u2X71Np.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lifting until your arms are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo hasta que los brazos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a sollevare finché le braccia sono parallele al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续举高，直至手臂与地面平行（达到肩部高度）。"
     }
    }
   }
  },
  "u2X71Np.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the cable handle back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el agarre de la polea despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente la maniglia del cavo fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰水平位置稍作停顿，随后控制速度缓慢下放回起始位置。"
     }
    }
   }
  },
  "nFUwqG6.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Rear Delt Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo posterior en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore per deltoidi posteriori al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯三角肌后束划船"
     }
    }
   }
  },
  "nFUwqG6.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the machine with your chest against the pad and your feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate con el pecho contra la almohadilla y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e siediti alla macchina con il petto contro il cuscinetto e i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整座椅高度并端坐于器械前，胸部贴垫，双脚平放地面（或站姿俯身调整高度）。"
     }
    }
   }
  },
  "nFUwqG6.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the handles with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las agarraderas en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie con presa prona, a larghezza leggermente superiore alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手采用正握握距抓紧把手，略宽于双肩。"
     }
    }
   }
  },
  "nFUwqG6.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and your core engaged as you pull the handles towards your chest, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la espalda recta y el core apretado, tira de las asas hacia el pecho juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena dritta e il core attivo mentre tiri le maniglie verso il petto, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺直，核心收紧，屈肘后拉将把手拉向胸口，夹紧肩胛骨。"
     }
    }
   }
  },
  "nFUwqG6.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top of the movement, then slowly release the handles back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y suelta las asas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi rilascia lentamente le maniglie fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点停顿片刻，随后缓慢释放把手回到起始位置。"
     }
    }
   }
  },
  "nFUwqG6.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至所需训练次数。"
     }
    }
   }
  },
  "903mzG8.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Shoulder Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press de hombro en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shoulder press al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯推肩"
     }
    }
   }
  },
  "903mzG8.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat height and position yourself on the smith machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la altura del asiento y colócate en el multipower con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola l'altezza del sedile e mettiti al multipower con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整史密斯机座椅高度，双脚与肩同宽踩地端正坐好。"
     }
    }
   }
  },
  "903mzG8.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the bar with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃杆，握距略宽于双肩。"
     }
    }
   }
  },
  "903mzG8.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the bar off the rack and position it at shoulder level, with your elbows bent and palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y colócala a la altura de los hombros, con los codos flexionados y las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il bilanciere dal rack e portalo all'altezza delle spalle, con i gomiti piegati e i palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "出杠并置于肩部水平，手肘屈曲，掌心朝前。"
     }
    }
   }
  },
  "903mzG8.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar upward until your arms are fully extended overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra hacia arriba hasta estirar los brazos del todo sobre la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere verso lalto finché le braccia sono completamente tese sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三角肌发力将杠铃向上推举过头顶，直至双臂完全伸展。"
     }
    }
   }
  },
  "903mzG8.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the bar back down to shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il bilanciere fino all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶端停顿片刻，然后缓慢平稳下放杠铃回到肩高位置。"
     }
    }
   }
  },
  "kTbSH9h.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Seated Overhead Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press militar sentado con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spinte sopra la testa da seduto con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃坐姿过顶推举"
     }
    }
   }
  },
  "kTbSH9h.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with your back straight and feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con la espalda recta y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con la schiena dritta e i piedi ben piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "端坐在训练凳上，背部挺直，双脚平踩地面。"
     }
    }
   }
  },
  "kTbSH9h.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, leggermente più larga delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于双肩。"
     }
    }
   }
  },
  "kTbSH9h.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the barbell off the rack and bring it to shoulder level, with your elbows bent and palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y llévala a la altura de los hombros, con los codos flexionados y las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il bilanciere dal rack e portalo all'altezza delle spalle, con i gomiti piegati e i palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "出杠并将杠铃置于肩高位置，手肘朝前，掌心向前。"
     }
    }
   }
  },
  "kTbSH9h.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the barbell overhead by extending your arms fully."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra por encima de la cabeza estirando los brazos del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere sopra la testa estendendo completamente le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三角肌发力将杠铃过顶推起，双臂完全伸展。"
     }
    }
   }
  },
  "kTbSH9h.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back to shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il bilanciere fino all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰稍作停顿，随后控制杠铃缓慢平稳下放回肩高位置。"
     }
    }
   }
  },
  "upright-row.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Upright Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo al mentón con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tirate al mento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "直立划船"
     }
    }
   }
  },
  "upright-row.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up with a barbell in front of your thighs, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con la barra delante de los muslos y las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con un bilanciere davanti alle cosce, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚开立站直，双手正握杠铃置于大腿前侧，握距与肩同宽。"
     }
    }
   }
  },
  "upright-row.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest tall and your shoulders pulled back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y los hombros hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e le spalle indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸抬头，肩部微向后收。"
     }
    }
   }
  },
  "upright-row.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the bar straight up along your body, leading with your elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra pegada al cuerpo llevando los codos por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira la sbarra su lungo il corpo, guidando con i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘领跑贴紧躯干，将杠铃垂直向上拉起。"
     }
    }
   }
  },
  "upright-row.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when your elbows reach shoulder height, no higher."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando los codos lleguen a la altura de los hombros, no más arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando i gomiti arrivano all'altezza delle spalle, non oltre."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当手肘提升至肩部高度时停止，切勿过度拉高。"
     }
    }
   }
  },
  "upright-row.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the bar slowly back down to your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra despacio hasta los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa lentamente verso le cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制杠铃缓慢贴着躯干下放回大腿前侧。"
     }
    }
   }
  },
  "machine-lateral-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Machine Lateral Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevaciones laterales en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate laterali alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿器械侧平举"
     }
    }
   }
  },
  "machine-lateral-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit in the lateral raise machine with the pads against your outer arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina de laterales con las almohadillas en la parte externa de los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla macchina per alzate laterali con i cuscinetti contro l'esterno delle braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在侧平举器械上，手臂外侧紧靠护肘垫。"
     }
    }
   }
  },
  "machine-lateral-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the seat so the pivot lines up with your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el asiento para que el eje quede a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola il sedile così che il perno sia in linea con le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节座椅高度，使器械转轴与双肩处于同一水平线。"
     }
    }
   }
  },
  "machine-lateral-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your arms out and up until they reach shoulder height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja los brazos hacia fuera y arriba hasta la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le braccia fuori e su finché arrivano all'altezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "三角肌中束发力将手臂向外向上推起，直至达到肩部高度。"
     }
    }
   }
  },
  "machine-lateral-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your neck relaxed and your traps out of the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuello relajado y los trapecios fuera del movimiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il collo rilassato e i trapezi fuori dal movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持颈部放松，避免斜方肌耸肩代偿。"
     }
    }
   }
  },
  "machine-lateral-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the pads slowly back to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las almohadillas despacio hasta los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i cuscinetti ai lati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制速度缓慢将靠垫放回身体两侧起始位置。"
     }
    }
   }
  },
  "landmine-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Landmine Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press landmine"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spinte landmine"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "地雷管推举"
     }
    }
   }
  },
  "landmine-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wedge one end of a barbell into a landmine holder or a corner."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encaja un extremo de la barra en el soporte landmine o en una esquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Incastra un'estremità di un bilanciere in un supporto landmine o in un angolo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃一端插入地雷管接口或固定在墙角。"
     }
    }
   }
  },
  "landmine-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the loaded end at your shoulder with one hand, standing in a split stance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el extremo cargado a la altura del hombro con una mano y un pie adelantado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'estremità caricata alla spalla con una mano, in piedi in posizione divaricata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单手托住负重端杠铃置于同侧肩前，呈前后弓步站立。"
     }
    }
   }
  },
  "landmine-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your core and keep your ribs down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y mantén las costillas bajas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core e tieni le costole basse."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心肌群，肋骨下沉不反弓。"
     }
    }
   }
  },
  "landmine-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the bar up and forward until your arm is straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la barra hacia arriba y adelante hasta estirar el brazo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il bilanciere su e in avanti finché il braccio è teso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肩部发力沿着斜上方将杠铃推起，直至手臂完全伸直。"
     }
    }
   }
  },
  "landmine-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the bar back to your shoulder under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve la barra al hombro controlando el peso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta il bilanciere alla spalla sotto controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制速度将杠铃平缓降回肩部起始位置。"
     }
    }
   }
  },
  "pike-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pike Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones pike"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti a luccio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "派克俯卧撑"
     }
    }
   }
  },
  "pike-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start on your hands and feet with your hips pushed up high."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con manos y pies en el suelo y la cadera bien alta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti su mani e piedi con i fianchi spinti in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手双脚撑地，将髋部高高推起成倒V字形姿势。"
     }
    }
   }
  },
  "pike-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet in so your body makes an upside-down V."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca los pies hasta formar una V invertida con el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvicina i piedi così che il corpo formi una V rovesciata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向前小步移动，使身体呈现紧凑的倒V字形态。"
     }
    }
   }
  },
  "pike-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows to lower the top of your head towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos para bajar la coronilla hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti per abbassare la sommità della testa verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉身体，将头顶朝两手前方的地面方向慢慢降落。"
     }
    }
   }
  },
  "pike-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips high all the way down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera alta durante toda la bajada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi alti per tutta la discesa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整个下落过程中始终保持髋部高耸。"
     }
    }
   }
  },
  "pike-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手用力推地伸直手臂，将身体推回倒V字形起始姿势。"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Feet-Elevated Pike Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones pike con pies elevados"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti a luccio con piedi sollevati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "垫高脚派克俯卧撑"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put your feet on a bench and walk your hands back towards it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon los pies en un banco y acerca las manos hacia él."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia i piedi su una panca e porta le mani indietro verso di essa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将双脚置于健身凳上，双手手掌向后倒退靠近凳子。"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips up so your torso is almost vertical."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera hasta dejar el tronco casi vertical."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi in alto così che il busto sia quasi verticale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上推高髋部，使躯干几乎与地面垂直。"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the top of your head towards the floor between your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la coronilla hacia el suelo entre las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa la sommità della testa verso il pavimento tra le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘将头顶缓缓下放至双掌之间的地面方向。"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows pointing back and slightly out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos apuntando atrás y un poco hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti puntati indietro e leggermente aperti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持手肘向后并略微向外展开。"
     }
    }
   }
  },
  "feet-elevated-pike-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press up until your arms are locked out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hasta bloquear los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi su finché le braccia sono bloccate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手发力推起身体，直至手臂完全伸展回到原位。"
     }
    }
   }
  },
  "handstand-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Handstand Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones en pino"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti in verticale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "倒立俯卧撑"
     }
    }
   }
  },
  "handstand-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kick up into a handstand with your hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube al pino con las manos a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dai uno slancio per andare in verticale con le mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蹬地起跳进入倒立状态，双手撑地与肩同宽。"
     }
    }
   }
  },
  "handstand-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes and keep your body in a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos y mantén el cuerpo en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei e tieni il corpo in linea retta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧臀肌与核心，使全身从脚尖到手掌呈笔直一线。"
     }
    }
   }
  },
  "handstand-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows to lower your head towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos para bajar la cabeza hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti per abbassare la testa verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈曲手肘受控下沉身体，让头顶缓慢接近地面。"
     }
    }
   }
  },
  "handstand-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop when the top of your head is just above the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para cuando la coronilla quede justo encima del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati quando la sommità della testa è appena sopra il suolo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "当头顶悬停于地面上方微距处时停止下落。"
     }
    }
   }
  },
  "handstand-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba hasta estirar los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare su finché le braccia sono tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂发力推起全身，直至双臂重新完全伸直。"
     }
    }
   }
  },
  "wall-handstand-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wall Handstand Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiones en pino contra la pared"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti in verticale al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "靠墙倒立俯卧撑"
     }
    }
   }
  },
  "wall-handstand-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet up a wall until you are upside down with your chest facing it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los pies por la pared hasta quedar boca abajo con el pecho hacia ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina con i piedi sul muro finché sei a testa in giù con il petto rivolto verso di esso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚踏墙面向上攀爬至倒立姿势，胸腹面向墙面。"
     }
    }
   }
  },
  "wall-handstand-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your hands a bit wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca las manos algo más anchas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti le mani un po' più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手撑地间距略宽于双肩。"
     }
    }
   }
  },
  "wall-handstand-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your elbows and lower your head towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona los codos y baja la cabeza hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega i gomiti e abbassa la testa verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘下沉身体，控制头顶平稳移向地面。"
     }
    }
   }
  },
  "wall-handstand-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body tight against the wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo firme y pegado a la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo stretto contro il muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持全身紧绷，维持身体紧凑贴近墙面。"
     }
    }
   }
  },
  "wall-handstand-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per tornare alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手发力将身体推起，恢复完全倒立伸展的起始位置。"
     }
    }
   }
  },
  "wall-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wall Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Subida por la pared"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "爬墙倒立"
     }
    }
   }
  },
  "wall-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down with your feet against the base of a wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo con los pies apoyados en la base de la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a pancia in giù con i piedi contro la base del muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯卧于地面，双脚脚后跟紧贴墙根。"
     }
    }
   }
  },
  "wall-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push up and start walking your feet up the wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba y empieza a subir los pies por la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi e inizia a camminare con i piedi su per il muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手撑地推起成俯卧撑姿势，双脚开始顺着墙面向上倒踩攀爬。"
     }
    }
   }
  },
  "wall-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your hands in towards the wall at the same time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al mismo tiempo, acerca las manos hacia la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina con le mani verso il muro allo stesso tempo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手同步向后方墙面小步倒退移动。"
     }
    }
   }
  },
  "wall-walk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go up until your chest is close to the wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube hasta que el pecho quede cerca de la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali finché il petto è vicino al muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续攀爬倒退，直到身体完全竖直且胸部贴近墙面。"
     }
    }
   }
  },
  "wall-walk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reverse the walk back down under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deshaz el recorrido bajando de forma controlada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Percorri la camminata al contrario scendendo sotto controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照原路径受控反向走下，安全回到俯卧起始位置。"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cross-Body Shoulder Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de hombro cruzado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch spalle incrociato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂交叉肩部拉伸"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand or sit up tall with your shoulders relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie o sentado, ponte erguido con los hombros relajados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi o siediti ben dritto con le spalle rilassate"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺直站立或端坐，双肩保持自然下沉放松。"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring one straight arm across your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cruza un brazo estirado por delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta un braccio teso davanti al petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将一侧手臂水平横跨在胸前。"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hook the other forearm under it and pull it closer."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha el otro antebrazo por debajo y tira hacia ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia l'altro avambraccio sotto di esso e tiralo più vicino a te"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用另一侧前臂从下方托扣住该臂，平稳向胸口拉近。"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the shoulder down instead of shrugging it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el hombro bajo en lugar de encogerlo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la spalla bassa senza alzarla verso le orecchie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "注意沉肩，切勿耸起被拉伸侧肩膀。"
     }
    }
   }
  },
  "cross-body-shoulder-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the stretch, then change arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta el estiramiento y cambia de brazo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'allungamento, poi cambia braccio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "维持拉伸感深呼吸数秒，换另一侧手臂重复。"
     }
    }
   }
  },
  "battle-ropes.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Battle Ropes"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuerdas de batalla"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Corde da battaglia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "战绳"
     }
    }
   }
  },
  "battle-ropes.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor the ropes and take an end in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ancla las cuerdas y coge un extremo con cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa le funi e prendi un'estremità in ogni mano"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将战绳牢固锚定在支点上，双手各握一端绳索手柄。"
     }
    }
   }
  },
  "battle-ropes.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step back until the ropes are almost tight and bend your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sepárate hasta dejarlas casi tensas y flexiona las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro finché le funi sono quasi tese e piega le ginocchia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向后稍退至战绳留有少许松弛度，双膝微屈。"
     }
    }
   }
  },
  "battle-ropes.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit into a quarter squat with your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja a una media sentadilla con el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti in un quarto di squat con il petto alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲呈四分之一半蹲姿势，挺胸抬头收紧核心。"
     }
    }
   }
  },
  "battle-ropes.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slam the ropes up and down alternately to make waves."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Golpea las cuerdas arriba y abajo de forma alterna para hacer olas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sbatti le funi su e giù in modo alternato per creare onde"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手交替上下爆发力甩动战绳，使绳身形成连绵波浪。"
     }
    }
   }
  },
  "battle-ropes.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your core braced and the waves going for the whole set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el abdomen apretado y las olas durante toda la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il core attivo e continua a fare le onde per tutta la serie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在整组训练中始终保持核心收紧，维持波浪连续传导。"
     }
    }
   }
  },
  "MvQPqVW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Woodchop"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Leñador en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Woodchop al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索伐木式"
     }
    }
   }
  },
  "MvQPqVW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set a pulley high and stand side-on to it with your feet wide."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la polea alta y colócate de lado a ella con los pies separados."
     }
    }
   }
  },
  "MvQPqVW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the handle with both hands above the shoulder nearest the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra el asa con las dos manos por encima del hombro más cercano a la torre."
     }
    }
   }
  },
  "MvQPqVW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms long and your core braced."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos largos y el abdomen firme."
     }
    }
   }
  },
  "MvQPqVW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the handle down and across your body towards the opposite knee, turning your hips and back foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del asa hacia abajo cruzando el cuerpo hasta la rodilla contraria, girando la cadera y el pie de atrás."
     }
    }
   }
  },
  "MvQPqVW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return the handle slowly to the top and switch sides after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve el asa despacio arriba y cambia de lado al acabar la serie."
     }
    }
   }
  },
  "CqhoytW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Hip Thrust"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯臀推"
     }
    }
   }
  },
  "CqhoytW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor with your upper back against a bench inside the Smith machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con la parte alta de la espalda apoyada en un banco dentro del multipower."
     }
    }
   }
  },
  "CqhoytW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Roll the bar over your hips and place a pad under it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la barra sobre la cadera con una almohadilla debajo."
     }
    }
   }
  },
  "CqhoytW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plant your feet flat, about hip-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los pies en el suelo a la anchura de la cadera."
     }
    }
   }
  },
  "CqhoytW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your heels to lift your hips until your body is straight from knees to shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para subir la cadera hasta alinear rodillas y hombros."
     }
    }
   }
  },
  "CqhoytW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes at the top and lower your hips slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos arriba y baja la cadera despacio."
     }
    }
   }
  },
  "IpONWYv.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Side Bend"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión lateral con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti laterali con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃体侧屈"
     }
    }
   }
  },
  "IpONWYv.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with your feet shoulder-width apart and hold a dumbbell in one hand, letting it hang down by your side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en una mano, colgando al costado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi ben dritto con i piedi alla larghezza delle spalle e tieni un manubrio in una mano, lasciandolo pendere lungo il fianco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽直立站立，单手持一只哑铃，手臂自然下垂于体侧。"
     }
    }
   }
  },
  "IpONWYv.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your back straight and your core engaged, slowly bend sideways at the waist towards the opposite side of the dumbbell, lowering the weight as far as you comfortably can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la espalda recta y el core apretado, inclínate despacio hacia el lado contrario a la mancuerna, bajando el peso hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo la schiena dritta e il core attivo, piegati lentamente di lato all'altezza della vita verso il lato opposto al manubrio, abbassando il peso finché riesci comodamente"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺直、核心收紧，腰部向持哑铃一侧缓慢侧屈下放重量至舒适范围。"
     }
    }
   }
  },
  "IpONWYv.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi torna lentamente alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部稍作停顿，然后依靠对侧腹斜肌发力缓慢还原至起始站姿。"
     }
    }
   }
  },
  "IpONWYv.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch sides and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia lato e ripeti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成目标次数后换另一侧重复。"
     }
    }
   }
  },
  "WW95auq.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Kneeling Crunch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch de rodillas en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch in ginocchio al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索跪姿卷腹"
     }
    }
   }
  },
  "WW95auq.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a rope handle to a high pulley and kneel down facing away from the machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Engancha una cuerda a la polea alta y ponte de rodillas de espaldas a la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attacca una corda a una carrucola alta e inginocchiati dando le spalle alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将绳索手把连接在高位滑轮上，背对龙门架双膝跪地。"
     }
    }
   }
  },
  "WW95auq.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the rope handle with both hands and place it behind your head, keeping your elbows out to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la cuerda con las dos manos y colócala detrás de la cabeza, con los codos abiertos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna la corda con entrambe le mani e mettila dietro la testa, tenendo i gomiti aperti ai lati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住绳索把手置于脑后或耳侧，双肘自然朝外。"
     }
    }
   }
  },
  "WW95auq.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your hips stationary, flex your waist and crunch your torso down towards your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la cadera quieta, flexiona el tronco llevándolo hacia los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo i fianchi fermi, fletti la vita e piega il busto verso le cosce"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "固定髋部不动，腹部发力弯屈腰椎，将躯干向下卷缩朝向大腿。"
     }
    }
   }
  },
  "WW95auq.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi torna lentamente alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部充分挤压腹肌停顿片刻，然后控制核心缓慢回落至起始位置。"
     }
    }
   }
  },
  "WW95auq.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "s8nrDXF.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Crunch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重卷腹"
     }
    }
   }
  },
  "s8nrDXF.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on your back with your knees bent and feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le ginocchia piegate e i piedi ben piantati a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双膝弯曲，双脚平踩在地面上。"
     }
    }
   }
  },
  "s8nrDXF.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a weight plate or dumbbell on your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un disco o una mancuerna sobre el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un disco o un manubrio sul petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手持杠铃片或哑铃置于胸前。"
     }
    }
   }
  },
  "s8nrDXF.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your abs and lift your upper body off the ground, curling forward until your shoulder blades are off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y despega el tronco del suelo, enrollándote hasta levantar las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva gli addominali e solleva il busto da terra, piegandoti in avanti finché le scapole si staccano da terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收缩腹肌发力抬起上半身，向前卷腹直至肩胛骨完全离开地面。"
     }
    }
   }
  },
  "s8nrDXF.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your upper body back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el tronco despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente il busto per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰充分收缩腹肌停顿片刻，然后缓慢下放上半身回到起始位置。"
     }
    }
   }
  },
  "s8nrDXF.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "7M66AVi.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Rollerout"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rueda abdominal con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rollout con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃跪姿健腹推"
     }
    }
   }
  },
  "7M66AVi.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on the floor and hold a barbell with both hands, shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas en el suelo y sujeta la barra con las dos manos, a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inginocchiati sul pavimento e impugna un bilanciere con entrambe le mani alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝跪在地面上，双手与肩同宽正握装有杠铃片的杠铃杆。"
     }
    }
   }
  },
  "7M66AVi.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Roll the barbell forward, extending your arms and keeping your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rueda la barra hacia delante estirando los brazos, con el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai rotolare il bilanciere in avanti, estendendo le braccia e tenendo il core attivo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心绷紧，手臂向前推动杠铃滚动，身体随之向前延展。"
     }
    }
   }
  },
  "7M66AVi.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue rolling forward until your body is fully extended and your arms are overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue rodando hasta quedar estirado del todo, con los brazos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a rotolare in avanti finché il corpo è completamente esteso e le braccia sono sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续向前滚动，直至身体充分伸展、手臂完全伸过头顶。"
     }
    }
   }
  },
  "7M66AVi.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then slowly roll the barbell back towards your knees, maintaining control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y rueda la barra de vuelta hacia las rodillas, controlando."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi fai rotolare lentamente il bilanciere verso le ginocchia, mantenendo il controllo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，利用腹肌收缩控制节奏，平稳将杠铃拉回双膝前方。"
     }
    }
   }
  },
  "7M66AVi.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "RqOtqD7.name": {
