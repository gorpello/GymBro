     }
    }
   }
  },
  "J74XlNf.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on an exercise ball with your feet flat on the ground and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un fitball con los pies apoyados en el suelo y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una palla fitness con i piedi piatti a terra e la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "端坐在健身球上，双脚平踩地面保持平衡，背部挺直。"
     }
    }
   }
  },
  "J74XlNf.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand with your palms facing forward and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en cada mano con las palmas hacia delante y los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in ogni mano con i palmi rivolti in avanti e le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各持一只哑铃垂于体侧，掌心朝前，手臂充分伸直。"
     }
    }
   }
  },
  "J74XlNf.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl one dumbbell while rotating your forearm until your palm is facing your shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube una mancuerna girando el antebrazo hasta que la palma mire al hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega un manubrio ruotando l'avambraccio finché il palmo guarda la spalla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂不动，呼气弯举单侧哑铃，旋转前臂使掌心朝向肩部。"
     }
    }
   }
  },
  "J74XlNf.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale and slowly lower the dumbbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y baja la mancuerna despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e abbassa lentamente il manubrio fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，控制节奏缓慢将该侧哑铃下放回初始位置。"
     }
    }
   }
  },
  "J74XlNf.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat the curl with the other arm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite el curl con el otro brazo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti il piegamento con l'altro braccio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "换另一侧手臂进行弯举，交替重复。"
     }
    }
   }
  },
