     }
    }
   }
  },
  "bJYHBIN.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bodyweight Standing Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos de pie sin peso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf in piedi a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重站姿提踵"
     }
    }
   }
  },
  "bJYHBIN.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, toes pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e le punte in avanti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖正对前方。"
     }
    }
   }
  },
  "bJYHBIN.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands on a wall or stable surface for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las manos en una pared o superficie estable para el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le mani a un muro o a una superficie stabile per equilibrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手轻扶墙壁或稳固表面以保持身体平衡。"
     }
    }
   }
  },
  "bJYHBIN.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly raise your heels off the ground, lifting your body weight onto the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los talones despacio, quedándote sobre la punta de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva lentamente i talloni da terra portando il peso del corpo sugli avampiedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "小腿发力将脚后跟缓慢抬离地面，将体重支撑在前脚掌上。"
     }
    }
   }
  },
  "bJYHBIN.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i talloni fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点稍作停顿挤压小腿，随后缓慢将脚后跟下放回地面。"
     }
    }
   }
  },
  "bJYHBIN.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照目标次数重复完成动作。"
     }
    }
   }
  },
  "6HiHHe0.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Standing Rocking Leg Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos balanceada con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
