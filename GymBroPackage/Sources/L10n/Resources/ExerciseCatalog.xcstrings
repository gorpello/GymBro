     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋俯身，躯干与地面基本保持平行，脊柱挺直、挺胸收腹。"
     }
    }
   }
  },
  "r0z6xzQ.step.2": {
