  "r0z6xzQ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the barbell towards your upper abdomen, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
