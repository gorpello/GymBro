   }
  },
  "v-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your arms and legs at the same time to meet over your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube brazos y piernas a la vez para juntarlos sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva braccia e gambe contemporaneamente per farle incontrare sopra i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心爆发收紧，上半身与双腿同时向上抬起，在髋部上方交汇。"
     }
    }
   }
  },
  "v-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Touch your hands to your feet at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca los pies con las manos arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tocca i piedi con le mani in alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶峰处用双手触碰脚尖，身体呈“V”字形。"
     }
    }
   }
  },
  "v-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower back down slowly without touching the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio sin llegar a tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati lentamente senza toccare il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地下放还原，身体落地前保持张力并开始下一次动作。"
     }
    }
   }
  },
  "flutter-kick.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Flutter Kick"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tijeras verticales"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calci a forbice"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧剪刀腿打水"
     }
    }
   }
  },
  "flutter-kick.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your hands under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las manos debajo de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le mani sotto i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双手垫在臀部下方以辅助保护下背部。"
     }
    }
   }
  },
  "flutter-kick.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift both legs a few centimetres off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las dos piernas unos centímetros del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva entrambe le gambe di pochi centimetri dal pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿伸直，抬离地面数厘米。"
     }
    }
   }
  },
  "flutter-kick.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your lower back down into the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplasta la zona lumbar contra el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Schiaccia la zona lombare contro il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将下背部完全贴紧地面。"
     }
    }
   }
  },
  "flutter-kick.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kick your legs up and down in small alternating movements."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube y baja las piernas alternando en recorridos cortos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muovi le gambe su e giù in piccoli movimenti alternati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿以小幅度、快节奏交替上下摆动打水。"
     }
    }
   }
  },
  "flutter-kick.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your legs straight and your core tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las piernas rectas y el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le gambe tese e il core contratto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双腿伸直、膝盖不弯曲，核心全程绷紧。"
     }
    }
   }
  },
  "lying-leg-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lying Leg Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de piernas en el suelo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sollevamento gambe da sdraiato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧举腿"
     }
    }
   }
  },
  "lying-leg-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your legs straight and your hands by your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las piernas rectas y las manos junto a la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati supino con le gambe tese e le mani ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双腿伸直并拢，双手置于臀部两侧地面。"
     }
    }
   }
  },
  "lying-leg-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your lower back into the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplasta la zona lumbar contra el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Schiaccia la zona lombare contro il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腹肌收缩，将下背部死死贴在地面上。"
     }
    }
   }
  },
  "lying-leg-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift both legs until they point at the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las dos piernas hasta apuntar al techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva entrambe le gambe finche puntano al soffitto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下腹发力抬起双腿，直至双腿指向天花板垂直于地面。"
     }
    }
   }
  },
  "lying-leg-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower them slowly without touching the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájalas despacio sin llegar a tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassale lentamente senza toccare terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制核心缓慢下放双腿，保持悬空不触碰地面。"
     }
    }
   }
  },
  "lying-leg-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop the descent as soon as your back starts to arch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Detén la bajada en cuanto la espalda empiece a arquearse."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati appena la schiena inizia ad inarcarsi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一旦下背部有离开地面拱起的趋势，即停止下探并向上拉起。"
     }
    }
   }
  },
  "plank-shoulder-tap.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank Shoulder Tap"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha con toque de hombro"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank con tocchi alle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平板支撑交替摸肩"
     }
    }
   }
  },
  "plank-shoulder-tap.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a high plank with your hands under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en plancha alta con las manos bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in plank alto con le mani sotto le spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "进入高位俯卧撑平板支撑姿态，双手置于双肩正下方。"
     }
    }
   }
  },
  "plank-shoulder-tap.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your feet a little wider than your hips for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa los pies algo más que la cadera para tener equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga i piedi poco oltre i fianchi per l'equilibrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚开立略宽于髋部，以增加下肢稳定性。"
     }
    }
   }
  },
  "plank-shoulder-tap.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift one hand and tap the opposite shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levanta una mano y toca el hombro contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva una mano e tocca la spalla opposta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬起一只手，平稳轻触对侧肩膀。"
     }
    }
   }
  },
  "plank-shoulder-tap.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips still, without rocking side to side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera quieta, sin balancearte de lado a lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi fermi, senza oscillare da un lato all'altro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心紧锁，骨盆与髋部保持平稳不动，避免左右大幅摇晃。"
     }
    }
   }
  },
  "plank-shoulder-tap.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put the hand down and repeat with the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la mano y repite con el otro lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia la mano a terra e ripeti con l'altro lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手掌放回原处支撑，换另一侧手交替摸肩。"
     }
    }
   }
  },
  "plank-jack.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank Jack"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha con salto de piernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank jack"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平板支撑开合跳"
     }
    }
   }
  },
  "plank-jack.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a high plank with your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha alta con los pies juntos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia in plank alto con i piedi uniti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以双手撑地的高位平板支撑起始，双脚并拢。"
     }
    }
   }
  },
  "plank-jack.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your core and keep your hips level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen y mantén la cadera nivelada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core e tieni i fianchi allineati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绷紧核心，保持躯干和臀部处于同一水平线上。"
     }
    }
   }
  },
  "plank-jack.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump both feet out wide."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta abriendo los dos pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta con entrambi i piedi aprendoli larghi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚同时起跳向两侧跳开。"
     }
    }
   }
  },
  "plank-jack.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump them straight back together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a juntarlos de un salto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Saltando riportali subito uniti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再次轻盈跳起，将双脚并拢还原。"
     }
    }
   }
  },
  "plank-jack.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a steady rhythm without letting your hips bounce."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén un ritmo constante sin que la cadera rebote."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni un ritmo costante senza far rimbalzare i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持稳定均匀的节奏，注意动作中不要让臀部上下大幅晃荡。"
     }
    }
   }
  },
  "bear-plank.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bear Plank"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha del oso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank orso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "熊式平板支撑"
     }
    }
   }
  },
  "bear-plank.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get on all fours with your hands under your shoulders and knees under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con las manos bajo los hombros y las rodillas bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a quattro zampe con le mani sotto le spalle e le ginocchia sotto i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呈四足跪姿，双手在肩部正下方，双膝在髋部正下方。"
     }
    }
   }
  },
  "bear-plank.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tuck your toes and lift your knees a couple of centimetres off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las puntas de los pies y despega las rodillas un par de centímetros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le punte dei piedi e solleva le ginocchia di un paio di centimetri dal pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚尖蹬地，将双膝抬离地面仅数厘米保持悬空。"
     }
    }
   }
  },
  "bear-plank.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat and your shoulders over your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda plana y los hombros sobre las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta e le spalle sopra le mani"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部平直如桌面，肩膀保持在手腕上方。"
     }
    }
   }
  },
  "bear-plank.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the floor away and hold the position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el suelo y aguanta la posición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il pavimento lontano da te e tieni la posizione"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手主动推地分散压力，全身核心绷紧定住。"
     }
    }
   }
  },
  "bear-plank.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe steadily and do not let your hips rise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira de forma constante y no dejes que suba la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira in modo regolare e non lasciare che i fianchi si alzino"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "均匀呼吸，保持臀部低位不翘臀。"
     }
    }
   }
  },
  "bear-crawl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bear Crawl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Marcha del oso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata dell'orso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "熊爬"
     }
    }
   }
  },
  "bear-crawl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in a bear plank with your knees hovering off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza en plancha del oso con las rodillas despegadas del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti da un bear plank con le ginocchia sospese sopra il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以双膝微离地悬空的熊式平板支撑姿态起始。"
     }
    }
   }
  },
  "bear-crawl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move an opposite hand and foot forward at the same time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Avanza a la vez una mano y el pie contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muovi in avanti contemporaneamente una mano e il piede opposto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "协调对侧手脚同时向前迈出一步。"
     }
    }
   }
  },
  "bear-crawl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips low and your back flat as you crawl."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera baja y la espalda plana mientras avanzas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi bassi e la schiena piatta mentre gattoni"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "爬行过程中保持背部平直、臀部低平，避免左右晃动。"
     }
    }
   }
  },
  "bear-crawl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take short steps and stay under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da pasos cortos y con control."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai passi corti e resta sotto controllo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "步幅保持短小紧凑，动作全程受控稳定。"
     }
    }
   }
  },
  "bear-crawl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Crawl back to where you started."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve gateando hasta el punto de partida."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Gattona per tornare al punto di partenza"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "爬行至目标距离后，可倒退爬行回起始点。"
     }
    }
   }
  },
  "inchworm.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inchworm"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gusano"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Bruco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "毛毛虫爬行"
     }
    }
   }
  },
  "inchworm.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall and bend forward to put your hands on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, inclínate hacia delante y apoya las manos en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi ben dritto e piegati in avanti per mettere le mani a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "直立站立，向前俯身，双手手掌撑在双脚前方的地面上。"
     }
    }
   }
  },
  "inchworm.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your hands out until you reach a push-up position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina con las manos hasta llegar a la posición de flexión."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina con le mani in avanti finché raggiungi una posizione di piegamento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手交替向前爬行爬出，直至身体形成标准俯卧撑平板支撑姿态。"
     }
    }
   }
  },
  "inchworm.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold there for a moment with your core tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta ahí un momento con el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un momento con il core contratto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧在平板支撑姿势停顿1秒。"
     }
    }
   }
  },
  "inchworm.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk your feet up towards your hands with your legs as straight as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca los pies a las manos con las piernas lo más rectas posible."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina con i piedi verso le mani tenendo le gambe più tese possibile"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽量保持双腿伸直，双脚交替向前小步走向双手。"
     }
    }
   }
  },
  "inchworm.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand back up and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie otra vez y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rialzati in piedi e ripeti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起身恢复站立直立姿势，开始下一次循环。"
     }
    }
   }
  },
  "l-sit-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "L-Sit Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "L-sit"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenuta in L-sit"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "L字静力支撑"
     }
    }
   }
  },
  "l-sit-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor or between two parallettes with your hands beside your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo o entre dos paralelas con las manos junto a la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sul pavimento o tra due paralleline con le mani accanto ai fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面或双杠/推手架之间，双手平撑在髋部两侧。"
     }
    }
   }
  },
  "l-sit-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push down hard and lift your hips off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja fuerte hacia abajo y despega la cadera del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi forte verso il basso e solleva i fianchi da terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂发力强力向下推地，使臀部完全抬离地面。"
     }
    }
   }
  },
  "l-sit-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your straight legs until they are level with your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las piernas estiradas hasta la altura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le gambe tese finché sono all'altezza dei fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心与股四头肌发力抬起伸直的双腿，直至双腿与髋部齐平。"
     }
    }
   }
  },
  "l-sit-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your shoulders pushed down and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los hombros hundidos y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le spalle basse e il petto alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双肩沉肩下压，挺胸收腹，避免耸肩。"
     }
    }
   }
  },
  "l-sit-hold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the L shape for as long as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la forma de L todo lo que puedas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione a L più a lungo possibile"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽可能长时间保持这一清晰的“L”形悬空支撑姿态。"
     }
    }
   }
  },
  "side-plank-hip-dip.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Side Plank Hip Dip"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha lateral con caída de cadera"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank laterale con affondi d'anca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧平板挺髋"
     }
    }
   }
  },
  "side-plank-hip-dip.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a side plank on your forearm with your feet stacked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en plancha lateral sobre el antebrazo con los pies apilados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in plank laterale sull'avambraccio con i piedi sovrapposti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单侧前臂撑地呈侧平板支撑，双脚上下并拢叠放。"
     }
    }
   }
  },
  "side-plank-hip-dip.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Line up your elbow under your shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca el codo justo debajo del hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allinea il gomito sotto la spalla"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑手肘垂直对齐于肩膀正下方。"
     }
    }
   }
  },
  "side-plank-hip-dip.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hip towards the floor without touching it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera hacia el suelo sin llegar a tocarlo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il fianco verso il pavimento senza toccarlo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制骨盆向地面方向缓慢下沉下落，但不要完全触地。"
     }
    }
   }
  },
  "side-plank-hip-dip.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive your hip back up until your body is straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera hasta dejar el cuerpo recto otra vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il fianco di nuovo in alto finché il corpo è di nuovo dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧腹外斜肌强力收缩发力，将髋部向上顶起至身体重回一条直线。"
     }
    }
   }
  },
  "side-plank-hip-dip.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish the reps on one side before swapping."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Termina las repeticiones de un lado antes de cambiar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Completa le ripetizioni su un lato prima di cambiare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成该侧所有目标次数后，再换至另一侧操作。"
     }
    }
   }
  },
  "dragon-flag.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dragon Flag"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bandera del dragón"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dragon flag"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "龙旗"
     }
    }
   }
  },
  "dragon-flag.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a bench and grab it behind your head with both hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco y agárralo por detrás de la cabeza con las dos manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su una panca e afferrala dietro la testa con entrambe le mani"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在卧推凳上，双手牢牢抓住头后方的凳面边缘。"
     }
    }
   }
  },
  "dragon-flag.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your whole body up so you rest only on your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube todo el cuerpo hasta apoyarte sólo en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva tutto il corpo in modo da appoggiare solo sulla parte alta della schiena"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心爆发收紧，将下半身及躯干完全抬起，仅以上背部和肩胛骨支撑在凳上。"
     }
    }
   }
  },
  "dragon-flag.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body rigid in one straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo rígido y en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo rigido in un'unica linea retta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全身紧绷锁死，从脚尖到胸口保持一条刚性笔直的直线。"
     }
    }
   }
  },
  "dragon-flag.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly without bending at the hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio sin doblar la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati lentamente senza piegarti sui fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋关节绝不屈曲折叠，依靠核心离心力量缓慢将身体整体向下平放。"
     }
    }
   }
  },
  "dragon-flag.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stop just above the bench and pull back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Para justo encima del banco y vuelve a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fermati appena sopra la panca e risali"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在身体即将贴近凳面时悬停，然后核心再次发力向上拉起。"
     }
    }
   }
  },
  "half-burpee.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Half Burpee"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Medio burpee"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mezzo burpee"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "半程波比跳"
     }
    }
   }
  },
  "half-burpee.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start standing with your feet hip-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in piedi con i piedi alla larghezza dei fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与髋同宽自然站立。"
     }
    }
   }
  },
  "half-burpee.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drop into a squat and place both hands on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agáchate y apoya las dos manos en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi in squat e metti entrambe le mani a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲并将双手平稳撑在地面上。"
     }
    }
   }
  },
  "half-burpee.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump your feet back into a plank position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los pies atrás de un salto hasta la posición de plancha."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta con i piedi all'indietro in posizione di plank"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿蹬地同时向后跳出，进入俯卧撑平板支撑姿态。"
     }
    }
   }
  },
  "half-burpee.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump them straight back in towards your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a meterlos de un salto hacia las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riportali subito in avanti verso le mani con un salto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚立刻有力向前跃回双手后侧。"
     }
    }
   }
  },
  "half-burpee.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up tall and go into the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie y encadena la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rialzati ben dritto e passa alla ripetizione successiva"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸站直恢复直立，随后连贯进入下一次动作。"
     }
    }
   }
  },
  "squat-thrust.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat Thrust"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de piernas a plancha"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat thrust"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蹲伏跳推"
     }
    }
   }
  },
  "squat-thrust.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your arms by your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies a la anchura de los hombros y los brazos a los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le braccia lungo i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双臂自然垂于体侧。"
     }
    }
   }
  },
  "squat-thrust.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat down and plant both hands on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agáchate y apoya las dos manos en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accovacciati e pianta entrambe le mani a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "迅速下蹲，双手扎实按在地面上。"
     }
    }
   }
  },
  "squat-thrust.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Thrust both feet back until you are in a plank."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lanza los dos pies hacia atrás hasta quedar en plancha."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi entrambi i piedi all'indietro finché sei in plank"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚猛力向后蹬出，使身体瞬间呈平板支撑姿态。"
     }
    }
   }
  },
  "squat-thrust.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the plank for a beat with your core tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la plancha un instante con el abdomen apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il plank un momento con il core contratto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧在平板支撑处稳住定格一拍。"
     }
    }
   }
  },
  "squat-thrust.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your feet back in and stand up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a meter los pies y ponte de pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta i piedi dentro e rialzati in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚迅速收回并立刻挺身站立。"
     }
    }
   }
  },
  "banded-pallof-press.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Pallof Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Press Pallof con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pallof press con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带帕洛夫推举"
     }
    }
   }
  },
  "banded-pallof-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band at chest height and stand side-on to it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda a la altura del pecho y colócate de lado a ella."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico all'altezza del petto e mettiti di lato rispetto ad esso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带固定在胸部高度的立柱上，侧对锚点站立。"
     }
    }
   }
  },
  "banded-pallof-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the band with both hands against your sternum."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la banda con las dos manos pegada al esternón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'elastico con entrambe le mani contro lo sterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住弹力带贴在胸骨正中。"
     }
    }
   }
  },
  "banded-pallof-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step away until the band pulls hard to the side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sepárate hasta que la banda tire fuerte hacia el lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allontanati finché l'elastico tira forte di lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向外侧跨步，直至弹力带产生强烈的侧向拉力。"
     }
    }
   }
  },
  "banded-pallof-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your hands straight forward without rotating."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira las manos hacia delante sin girar el tronco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le mani dritte in avanti senza ruotare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心抗旋收缩，将双手平直向前推出，身体保持完全朝前不转动。"
     }
    }
   }
  },
  "banded-pallof-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring them back to your chest and keep your hips still."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuélvelas al pecho manteniendo la cadera quieta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riportale al petto e tieni i fianchi fermi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢收回胸前，全程固定骨盆不晃动。"
     }
    }
   }
  },
  "banded-woodchop.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Woodchop"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Leñador con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Taglialegna con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带伐木式转体"
     }
    }
   }
  },
  "banded-woodchop.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band high and stand side-on with your feet apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda en alto y colócate de lado con los pies separados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico in alto e mettiti di lato con i piedi divaricati"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带固定在高位，侧对锚点双脚开立站立。"
     }
    }
   }
  },
  "banded-woodchop.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the band with both hands above the far shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la banda con las dos manos por encima del hombro más alejado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'elastico con entrambe le mani sopra la spalla più lontana"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手合握弹力带，举在外侧肩膀斜上方。"
     }
    }
   }
  },
  "banded-woodchop.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull it down and across your body towards the opposite hip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira en diagonal hacia la cadera contraria."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tiralo giù e attraverso il corpo verso il fianco opposto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心发力带动双臂，将弹力带斜向下拉过躯干朝向对侧髋部。"
     }
    }
   }
  },
  "banded-woodchop.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate through your torso and let your back foot pivot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira el tronco y deja que el pie de atrás pivote."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota con il busto e lascia che il piede posteriore faccia perno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "旋转躯干，同时允许后侧脚脚尖自然转动以保护膝关节。"
     }
    }
   }
  },
  "banded-woodchop.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return along the same path under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve por el mismo camino con control."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna lungo lo stesso percorso sotto controllo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿相同运动轨迹平稳有控地回到高位起始姿态。"
     }
    }
   }
  },
  "banded-dead-bug.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Dead Bug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicho muerto con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dead bug con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带死虫式"
     }
    }
   }
  },
  "banded-dead-bug.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band behind your head and lie on your back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda por detrás de la cabeza y túmbate boca arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico dietro la testa e sdraiati sulla schiena"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带固定在头顶后方低位，仰卧平躺在地面上。"
     }
    }
   }
  },
  "banded-dead-bug.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the band with straight arms over your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la banda con los brazos estirados sobre el pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'elastico con le braccia tese sopra il petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂伸直将弹力带向前拉至胸部上方保持张力。"
     }
    }
   }
  },
  "banded-dead-bug.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your knees to ninety degrees over your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las rodillas a noventa grados sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le ginocchia a novanta gradi sopra i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿屈膝90度抬起，膝盖位于髋关节正上方。"
     }
    }
   }
  },
  "banded-dead-bug.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower one leg towards the floor while your arms hold the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja una pierna hacia el suelo mientras los brazos aguantan la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa una gamba verso il pavimento mentre le braccia tengono l'elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂保持拉力不动，单腿向地面方向伸展下放。"
     }
    }
   }
  },
  "banded-dead-bug.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swap legs and keep your lower back flat throughout."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia de pierna y mantén la lumbar pegada al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alterna le gambe e tieni la zona lombare piatta per tutto il tempo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "换腿交替进行，全程保持下背部紧贴地面不弓腰。"
     }
    }
   }
  },
  "Y7YcmIJ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Bench Front Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla frontal en banco con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Front squat alla panca con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃箱式前蹲"
     }
    }
   }
  },
  "Y7YcmIJ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start by standing with your feet shoulder-width apart and the barbell resting on your upper chest, just below your collarbone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros y la barra apoyada en la parte alta del pecho, justo bajo la clavícula."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia in piedi con i piedi alla larghezza delle spalle e il bilanciere appoggiato sulla parte alta del petto, appena sotto la clavicola"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，杠铃架在三角肌前束锁骨上方。"
     }
    }
   }
  },
  "Y7YcmIJ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with an overhand grip, keeping your elbows up and your upper arms parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con los codos altos y los brazos paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, tenendo i gomiti alti e le braccia parallele al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬高双肘，使大臂平行于地面，双手稳固托住杠铃。"
     }
    }
   }
  },
  "Y7YcmIJ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body down into a squat position by bending at the knees and hips, keeping your back straight and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja a la sentadilla flexionando rodillas y cadera, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo in posizione di squat piegando ginocchia e fianchi, tenendo la schiena dritta e il petto alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋向下蹲，下沉至轻轻触碰身后平凳，全程保持挺胸收腹、脊柱中立。"
     }
    }
   }
  },
  "Y7YcmIJ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom of the squat, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso nello squat, poi spingi attraverso i talloni per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在蹲底接触凳面处稍作停顿，随后脚跟蹬地发力站起恢复起始站姿。"
     }
    }
   }
  },
  "Y7YcmIJ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "gFyFj9z.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Step-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Subida al cajón con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Step-up con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃登阶"
     }
    }
   }
  },
  "gFyFj9z.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand in front of a step or platform with a dumbbell in each hand, palms facing your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte delante de un step o plataforma con una mancuerna en cada mano, palmas hacia el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi davanti a uno step o una piattaforma con un manubrio in ogni mano, palmi rivolti verso i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在体侧各握一只哑铃，掌心相对，面朝踏板或跳箱站立。"
     }
    }
   }
  },
  "gFyFj9z.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your right foot on the step, ensuring your entire foot is on the surface."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya el pie derecho en el step, con toda la planta sobre la superficie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il piede destro sullo step, assicurandoti che tutto il piede sia sulla superficie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将右脚全脚掌稳固踏在踏板上。"
     }
    }
   }
  },
  "gFyFj9z.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your right heel and lift your body up onto the step, bringing your left foot up as well."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón derecho y sube al step, llevando también el pie izquierdo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi attraverso il tallone destro e sollevati sullo step, portando su anche il piede sinistro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "右脚脚跟发力蹬地，将身体向上推起迈上踏板，左脚顺势跟上。"
     }
    }
   }
  },
  "gFyFj9z.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once both feet are on the step, lower your left foot back down to the starting position, keeping your right foot on the step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los dos pies arriba, baja el izquierdo a la posición inicial manteniendo el derecho en el step."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una volta che entrambi i piedi sono sullo step, abbassa il piede sinistro per tornare alla posizione iniziale, tenendo il piede destro sullo step"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚上台阶后，保持右脚在踏板上，左脚平稳向后下迈回到起始地面。"
     }
    }
   }
  },
  "gFyFj9z.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat the movement, alternating which foot you step up with each time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite el movimiento alternando el pie con el que subes."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti il movimento, alternando il piede con cui sali ogni volta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复该动作，每次交替更换上台阶的先导腿。"
     }
    }
   }
  },
  "hBGWILP.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Hip Adduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aducción de cadera en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Adduzioni d'anca al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索髋内收"
     }
    }
   }
  },
  "hBGWILP.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach the ankle cuff to your ankle and stand facing the cable machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte la tobillera y colócate de pie frente a la polea."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attacca la cavigliera alla caviglia e mettiti di fronte alla macchina al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将脚踝绑带扣在脚踝上，站立面向或侧向绳索滑轮。"
     }
    }
   }
  },
  "hBGWILP.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Position yourself far enough away from the machine so that there is tension on the cable."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sepárate lo suficiente de la máquina para que el cable quede tenso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Posizionati abbastanza lontano dalla macchina in modo che ci sia tensione sul cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向外跨出合适距离，使绳索保持适当张力。"
     }
    }
   }
  },
  "hBGWILP.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands on the machine for support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las manos en la máquina para sujetarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti le mani sulla macchina per sostenerti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶住器械立柱以维持身体平衡。"
     }
    }
   }
  },
  "hBGWILP.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your leg straight, slowly move your leg across your body towards the midline."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con la pierna estirada, llévala despacio cruzando el cuerpo hacia el centro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo la gamba tesa, muovila lentamente attraverso il corpo verso la linea mediana"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持训练腿伸直，内收肌群发力将腿向身体中线内侧夹紧拉动。"
     }
    }
   }
  },
  "hBGWILP.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the end of the movement, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento al final y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento alla fine del movimento, poi torna lentamente alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作终点顶峰收缩停顿片刻，然后控制阻力缓慢将腿放回起始位置。"
     }
    }
   }
  },
  "0lQnxMZ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Sissy Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla sissy con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sissy squat zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重西斯深蹲"
     }
    }
   }
  },
  "0lQnxMZ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your toes pointing slightly outward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le punte leggermente rivolte verso l'esterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "0lQnxMZ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a weight in front of your chest with both hands, or place a barbell across your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un peso delante del pecho con las dos manos, o apoya una barra en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un peso davanti al petto con entrambe le mani, oppure appoggia un bilanciere sulla parte alta della schiena"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手抱负重物于胸前，或将轻量杠铃抗在肩上。"
     }
    }
   }
  },
  "0lQnxMZ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your chest up and your core engaged, slowly lower your body down by bending at the knees and hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con el pecho alto y el core apretado, baja despacio flexionando rodillas y cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo il petto alto e il core attivo, abbassa lentamente il corpo piegando ginocchia e fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸收腹，核心收紧，膝盖向前推进同时躯干后倾，缓慢下蹲。"
     }
    }
   }
  },
  "0lQnxMZ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your thighs are parallel to the ground or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad abbassarti finché le cosce sono parallele al pavimento o finché riesci comodamente"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下蹲直至大腿后侧充分折叠、股四头肌完全拉伸。"
     }
    }
   }
  },
  "0lQnxMZ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi spingi attraverso i talloni per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部停顿片刻，然后股四头肌强力发力推起身体回到起始站姿。"
     }
    }
   }
  },
  "W9pFVv1.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Bench Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla al banco con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat alla panca con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃箱式深蹲"
     }
    }
   }
  },
  "W9pFVv1.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up a barbell on a squat rack at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la barra en el rack a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prepara un bilanciere su un rack per squat all'altezza del petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在深蹲架上将杠铃调节至胸部高度，身后放置合适高度的长凳。"
     }
    }
   }
  },
  "W9pFVv1.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing away from the rack, with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de espaldas al rack, con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti dando le spalle al rack, con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背对深蹲架站立，双脚与肩同宽开立。"
     }
    }
   }
  },
  "W9pFVv1.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees and lower your body down into a squat position, keeping your back straight and chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas y baja a la sentadilla, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega le ginocchia e abbassa il corpo in posizione di squat, tenendo la schiena dritta e il petto alto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋下蹲，挺胸收腹，保持背部挺直。"
     }
    }
   }
  },
  "W9pFVv1.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip, slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, algo más abierto que la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra il bilanciere con presa prona, leggermente più larga delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "W9pFVv1.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the barbell off the rack and step back, ensuring your feet are still shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del rack y da un paso atrás, con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il bilanciere dal rack e fai un passo indietro, assicurandoti che i piedi siano ancora alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃扛离架子并后退调整站姿，平稳完成下蹲与起立动作。"
     }
    }
   }
  },
  "wWFspEi.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Single Leg Split Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla búlgara a una pierna en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Split squat a gamba singola al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机单腿分腿蹲"
     }
    }
   }
  },
  "wWFspEi.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand in front of the smith machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte delante del multipower con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte al multipower con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站在史密斯机下方，双脚与肩同宽站立。"
     }
    }
   }
  },
  "wWFspEi.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place one foot behind you on a bench or step, with your toes pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya un pie por detrás en un banco o step, con la punta hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un piede dietro di te su una panca o uno step, con le punte rivolte in avanti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将后侧脚向后搭在身后的长凳或踏板上，脚趾朝前。"
     }
    }
   }
  },
  "wWFspEi.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold onto the smith machine bar for stability."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a la barra del multipower para estabilizarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieniti alla sbarra del multipower per la stabilità"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握稳史密斯机杠铃杆以保持平衡。"
     }
    }
   }
  },
  "wWFspEi.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your front knee and lower your body down into a lunge position, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona la rodilla de delante y baja a la zancada, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega il ginocchio anteriore e abbassa il corpo in posizione di affondo, tenendo la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弯曲前膝下蹲呈弓步姿势，保持背部挺直。"
     }
    }
   }
  },
  "wWFspEi.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your front heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con el talón de delante para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi spingi attraverso il tallone anteriore per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作底部稍作停顿，随后前脚脚跟发力蹬地推起身体恢复原位。"
     }
    }
   }
  },
  "SGY8Zui.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Push Press"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Push press con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Push press con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃借力推举"
     }
    }
   }
  },
  "SGY8Zui.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest a barbell on the front of your shoulders with your hands just outside them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte delantera de los hombros con las manos justo por fuera."
     }
    }
   }
  },
  "SGY8Zui.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet hip-width apart and your core braced."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de la cadera y el abdomen firme."
     }
    }
   }
  },
  "SGY8Zui.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dip a few centimetres by bending your knees, keeping your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas unos centímetros manteniendo el pecho alto."
     }
    }
   }
  },
  "SGY8Zui.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive up through your legs and use that push to press the bar overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con las piernas y aprovecha ese impulso para subir la barra por encima de la cabeza."
     }
    }
   }
  },
  "SGY8Zui.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the bar back to your shoulders and reset before the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra a los hombros y colócate antes de la siguiente repetición."
     }
    }
   }
  },
  "6YUfHPL.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bodyweight Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla sin peso"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat a corpo libero"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "徒手深蹲"
     }
    }
   }
  },
  "6YUfHPL.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立。"
     }
    }
   }
  },
  "6YUfHPL.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your knees and pushing your hips back as if sitting on a chair."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja flexionando las rodillas y llevando la cadera atrás, como si fueras a sentarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando le ginocchia e spingendo i fianchi all'indietro come per sederti su una sedia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向后坐、屈膝下蹲，如同身后坐椅子一般。"
     }
    }
   }
  },
  "6YUfHPL.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全程保持挺胸收腹，背部平直不弓背。"
     }
    }
   }
  },
  "6YUfHPL.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until your thighs are parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati finché le cosce sono parallele al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲直至大腿与地面平行。"
     }
    }
   }
  },
  "6YUfHPL.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi attraverso i talloni per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚跟用力蹬地，平稳站立恢复起始位置。"
     }
    }
   }
  },
  "uKyN64F.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell One Leg Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla a una pierna con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat a una gamba con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃单腿深蹲"
     }
    }
   }
  },
  "uKyN64F.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a barbell across your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y la barra apoyada en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e tieni un bilanciere sulla parte alta della schiena"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚开立站立，将杠铃稳固抗在后肩斜方肌上。"
     }
    }
   }
  },
  "uKyN64F.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift one foot off the ground and extend it forward, keeping it parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega un pie del suelo y estíralo hacia delante, paralelo al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva un piede da terra ed estendilo in avanti, tenendolo parallelo al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬起一侧脚向前伸展悬空，尽量与地面保持平行。"
     }
    }
   }
  },
  "uKyN64F.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your standing leg and lower your body down as if sitting back into a chair, keeping your chest up and your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona la pierna de apoyo y baja como si fueras a sentarte, con el pecho alto y la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega la gamba di appoggio e abbassa il corpo come per sederti all'indietro, tenendo il petto alto e la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿屈髋屈膝缓慢下蹲，挺胸收腹，保持躯干直立平衡。"
     }
    }
   }
  },
  "uKyN64F.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until your thigh is parallel to the ground, then push through your heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que el muslo quede paralelo al suelo y empuja con el talón para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati finché la coscia è parallela al pavimento, poi spingi attraverso il tallone per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲至支撑腿大腿与地面平行，随后脚跟蹬地发力推起身体站直。"
     }
    }
   }
  },
  "uKyN64F.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch legs and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia gamba e ripeti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成规定次数后，换另一侧腿重复。"
     }
    }
   }
  },
  "mweqJin.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Quick Feet"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pies rápidos"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piedi veloci"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "原地快速碎步"
     }
    }
   }
  },
  "mweqJin.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your arms by your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y los brazos a los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le braccia lungo i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双臂自然屈肘置于体侧。"
     }
    }
   }
  },
  "mweqJin.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Begin by rapidly moving your feet up and down, as if you were running in place."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza moviendo los pies rápido arriba y abajo, como si corrieras en el sitio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia muovendo rapidamente i piedi su e giù, come se corressi sul posto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚掌着地，开始极快速地原地上下碎步倒脚，如同原地极速踩步。"
     }
    }
   }
  },
  "mweqJin.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your movements quick and light, focusing on staying on the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el movimiento rápido y ligero, apoyándote en la punta de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i movimenti rapidi e leggeri, concentrandoti a restare sulle punte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作保持轻盈敏捷，全程重心保持在前脚掌上。"
     }
    }
   }
  },
  "mweqJin.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue for the desired duration or number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue el tiempo o las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua per la durata o il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续进行至目标时间或规定次数。"
     }
    }
   }
  },
  "gfk9kD4.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Overhead Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla overhead con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Overhead squat con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃过顶深蹲"
     }
    }
   }
  },
  "gfk9kD4.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le punte leggermente rivolte verso l'esterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "gfk9kD4.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with a wide grip, positioning it overhead with your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra con agarre ancho, por encima de la cabeza y con los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il bilanciere con una presa larga, posizionandolo sopra la testa con le braccia completamente tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手采用宽握距，双臂伸直将杠铃稳稳锁死在头顶正上方。"
     }
    }
   }
  },
  "gfk9kD4.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lower your body down into a squat position, keeping your chest up and knees tracking over your toes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y baja a la sentadilla, con el pecho alto y las rodillas siguiendo la línea de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e abbassa il corpo in posizione di squat, tenendo il petto alto e le ginocchia allineate sopra le punte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心强力收紧，保持挺胸，屈膝屈髋缓慢下蹲，膝盖始终沿着脚尖方向展开。"
     }
    }
   }
  },
  "gfk9kD4.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi spingi attraverso i talloni per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在深蹲底部停顿片刻，保持杠铃平衡稳定。"
     }
    }
   }
  },
  "gfk9kD4.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚脚跟蹬地发力，平稳站立回至起始直立姿态。"
     }
    }
   }
  },
  "c8f5cSY.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Side Lying Hip Abduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción de cadera tumbado de lado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abduzioni d'anca da sdraiato sul fianco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧卧髋外展"
     }
    }
   }
  },
  "c8f5cSY.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your side with your legs straight and stacked on top of each other."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate de lado con las piernas estiradas y una encima de la otra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sul fianco con le gambe tese e sovrapposte una sull'altra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧躺，双腿伸直并上下叠放。"
     }
    }
   }
  },
  "c8f5cSY.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your bottom arm under your head for support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon el brazo de abajo bajo la cabeza para apoyarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il braccio inferiore sotto la testa per sostenerti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下方手臂垫在头下作为支撑。"
     }
    }
   }
  },
  "c8f5cSY.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the side of your glutes and lift your top leg as high as you can without rotating your hips or leaning backward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el lateral del glúteo y sube la pierna de arriba todo lo que puedas sin girar la cadera ni echarte atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il lato del gluteo e solleva la gamba superiore più in alto possibile senza ruotare i fianchi o inclinarti all'indietro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧臀部外侧，把上方腿尽量抬高，髋部不要转动，身体不要后仰。"
     }
    }
   }
  },
  "c8f5cSY.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your leg back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la pierna despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in alto, poi abbassa lentamente la gamba per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点稍停，然后慢慢把腿放回起始位置。"
     }
    }
   }
  },
  "c8f5cSY.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成目标次数后换边。"
     }
    }
   }
  },
  "W31mMjd.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lateral Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada lateral"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo laterale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧弓步"
     }
    }
   }
  },
  "W31mMjd.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet wide apart and your hands together in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies muy separados y las manos juntas delante del pecho."
     }
    }
   }
  },
  "W31mMjd.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shift your weight onto one leg and bend that knee, pushing your hips back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa el peso a una pierna y flexiona esa rodilla llevando la cadera atrás."
     }
    }
   }
  },
  "W31mMjd.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the other leg straight with the foot flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la otra pierna estirada con el pie apoyado en el suelo."
     }
    }
   }
  },
  "W31mMjd.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go down until your thigh is close to parallel with the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que el muslo quede casi paralelo al suelo."
     }
    }
   }
  },
  "W31mMjd.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back to the middle and repeat on the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve al centro y repite hacia el otro lado."
     }
    }
   }
  },
  "VO2qeJg.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Side Plank Hip Adduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aducción de cadera en plancha lateral"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Adduzioni d'anca in plank laterale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧平板髋内收抬腿"
     }
    }
   }
  },
  "VO2qeJg.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your side next to a bench, propped on your forearm with your elbow directly under your shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate de lado junto a un banco, apoyado en el antebrazo con el codo justo debajo del hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sul fianco accanto a una panca, in appoggio sull’avambraccio con il gomito sotto la spalla"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧躺在凳子旁，用前臂撑地，手肘位于肩膀正下方。"
     }
    }
   }
  },
  "VO2qeJg.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest the inside of your top leg on the bench, at the knee to make it easier or at the ankle to make it harder, with your bottom leg on the floor under it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la cara interna de la pierna de arriba en el banco, a la altura de la rodilla para hacerlo más fácil o del tobillo para hacerlo más difícil, con la pierna de abajo en el suelo, debajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia l’interno della gamba superiore sulla panca, al ginocchio per renderlo più facile o alla caviglia per renderlo più difficile, con la gamba inferiore a terra sotto di essa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把上方腿的内侧搭在凳子上：搭在膝盖处更容易，搭在脚踝处更难；下方腿放在凳子下方的地面上。"
     }
    }
   }
  },
  "VO2qeJg.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Brace your core and lift your hips until your body forms a straight line from head to feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y sube la cadera hasta que el cuerpo quede en línea recta de la cabeza a los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Contrai il core e solleva i fianchi finché il corpo forma una linea retta dalla testa ai piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，抬起髋部，让身体从头到脚成一条直线。"
     }
    }
   }
  },
  "VO2qeJg.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your top leg down into the bench and raise your bottom leg until it touches the underside of the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la pierna de arriba contra el banco y sube la de abajo hasta tocar la parte de abajo del banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la gamba superiore contro la panca e solleva quella inferiore fino a toccare il sotto della panca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上方腿向下压住凳子，同时抬起下方腿，直到碰到凳子底面。"
     }
    }
   }
  },
  "VO2qeJg.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the bottom leg towards the floor with control, keeping your hips up, and switch sides after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la pierna de abajo hacia el suelo con control, sin dejar caer la cadera, y cambia de lado al acabar la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa la gamba inferiore verso terra con controllo, tenendo su i fianchi, e cambia lato a fine serie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "有控制地把下方腿放回地面方向，髋部保持不下沉，一组结束后换边。"
     }
    }
   }
  },
  "gGNQmVt.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Single Leg Split Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla búlgara a una pierna con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Split squat a gamba singola con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃单腿分腿蹲"
     }
    }
   }
  },
  "gGNQmVt.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a barbell across your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y la barra apoyada en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, tenendo un bilanciere sulla parte alta della schiena"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，将杠铃平稳扛于上背部。"
     }
    }
   }
  },
  "gGNQmVt.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a large step forward with one leg, keeping your torso upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso largo adelante con una pierna, con el tronco erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un grande passo in avanti con una gamba, tenendo il busto dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿向前迈出一大步，躯干保持正直。"
     }
    }
   }
  },
  "gGNQmVt.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your front knee and hip, while keeping your back leg straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja flexionando la rodilla y la cadera de delante, con la pierna de atrás estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando il ginocchio e il fianco anteriori, tenendo la gamba posteriore tesa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈前膝屈髋下蹲，身体垂直下沉，后腿保持伸展伸直。"
     }
    }
   }
  },
  "gGNQmVt.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your front thigh is parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que el muslo de delante quede paralelo al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad abbassarti finché la coscia anteriore è parallela al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下蹲直至前侧大腿与地面平行。"
     }
    }
   }
  },
  "gGNQmVt.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push through your front heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja con el talón adelantado para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi spingi attraverso il tallone anteriore per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，由前脚跟主导发力蹬起身体，回到起始直立站姿。"
     }
    }
   }
  },
  "xdYPUtE.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sissy Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla sissy"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sissy squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重西斯深蹲"
     }
    }
   }
  },
  "xdYPUtE.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your toes pointing slightly outward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le punte leggermente rivolte verso l'esterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "xdYPUtE.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold onto a stable object for balance if needed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a algo estable si necesitas equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieniti a un oggetto stabile per l'equilibrio se necessario"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "如有需要可单手扶住固定支架以辅助平衡。"
     }
    }
   }
  },
  "xdYPUtE.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower your body by bending your knees and leaning back, keeping your torso upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio flexionando las rodillas y echándote atrás, con el tronco erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente il corpo piegando le ginocchia e inclinando il busto all'indietro, tenendo il torso dritto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝向前推进、躯干与大腿成直线向后倾斜，缓慢下蹲。"
     }
    }
   }
  },
  "xdYPUtE.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your thighs are parallel to the ground or as far as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad abbassarti finché le cosce sono parallele al pavimento o finché riesci comodamente"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下沉直至大腿与地面平行或达到舒适的最大幅度。"
     }
    }
   }
  },
  "xdYPUtE.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi spingi attraverso i talloni per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部停顿片刻，随后前脚掌用力蹬伸，平稳推回站立起始姿势。"
     }
    }
   }
  },
  "9E25EOx.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Split Squats"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadillas búlgaras"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Split squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "自重分腿蹲"
     }
    }
   }
  },
  "9E25EOx.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽自然直立站立。"
     }
    }
   }
  },
  "9E25EOx.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a step forward with one foot and place it about two feet in front of the other foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante con un pie y déjalo a unos sesenta centímetros del otro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo in avanti con un piede e mettilo circa sessanta centimetri davanti all'altro piede"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一脚向前迈出约两脚距离，呈前后分腿姿态。"
     }
    }
   }
  },
  "9E25EOx.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body by bending your knees and hips, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja flexionando rodillas y cadera, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo piegando ginocchia e fianchi, tenendo la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部挺直，屈膝屈髋下沉身体。"
     }
    }
   }
  },
  "9E25EOx.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue lowering until your front thigh is parallel to the ground, and your back knee is hovering just above the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue bajando hasta que el muslo de delante quede paralelo al suelo y la rodilla de atrás justo encima de él."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad abbassarti finché la coscia anteriore è parallela al pavimento e il ginocchio posteriore sfiora il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下沉直至前大腿与地面平行，后膝悬空微离地面。"
     }
    }
   }
  },
  "9E25EOx.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then push through your front heel to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y empuja con el talón adelantado para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi spingi attraverso il tallone anteriore per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "底部停顿片刻，前侧脚跟发力推起身体回到起始分腿姿势。"
     }
    }
   }
  },
  "QChZi3x.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat to Overhead Reach"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla con extensión sobre la cabeza"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat con allungo sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "深蹲接高举过顶"
     }
    }
   }
  },
  "QChZi3x.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and toes slightly turned out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le punte leggermente rivolte verso l'esterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖微向外展。"
     }
    }
   }
  },
  "QChZi3x.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your body down into a squat position by bending your knees and pushing your hips back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja a la sentadilla flexionando las rodillas y llevando la cadera atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il corpo in posizione di squat piegando le ginocchia e spingendo i fianchi all'indietro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋屈膝向后下蹲，身体下沉进入深蹲姿态。"
     }
    }
   }
  },
  "QChZi3x.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you come up from the squat, extend your arms overhead, reaching towards the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al subir de la sentadilla, estira los brazos por encima de la cabeza hacia el techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre risali dallo squat, estendi le braccia sopra la testa, allungandoti verso il soffitto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "从深蹲起立起身的同时，双臂向上完全伸展高举过头顶直指天花板。"
     }
    }
   }
  },
  "QChZi3x.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return to the starting position by lowering your arms and bending your knees to squat down again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a la posición inicial bajando los brazos y flexionando las rodillas para volver a la sentadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna alla posizione iniziale abbassando le braccia e piegando le ginocchia per scendere di nuovo in squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下放双臂并顺势再次屈膝屈髋下蹲，连贯进入下一次动作。"
     }
    }
   }
  },
  "QChZi3x.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复规定次数。"
     }
    }
   }
  },
  "s7HX1BY.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Wide Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla con barra y piernas abiertas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat a gambe larghe con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃宽距深蹲"
     }
    }
   }
  },
  "s7HX1BY.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet wider than shoulder-width apart, toes pointing slightly outward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies más abiertos que los hombros y las puntas algo hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi più larghi delle spalle, punte leggermente rivolte verso l'esterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚站距明显宽于双肩，脚尖向外微展。"
     }
    }
   }
  },
  "s7HX1BY.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell across your upper back, resting it on your traps or rear delts."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda, sobre el trapecio o el deltoides posterior."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il bilanciere sulla parte alta della schiena, appoggiato sui trapezi o sui deltoidi posteriori."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃平稳扛于上背部斜方肌或三角肌后束。"
     }
    }
   }
  },
  "s7HX1BY.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and keep your chest up as you lower your body down into a squat, pushing your hips back and bending your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y mantén el pecho alto mientras bajas a la sentadilla, llevando la cadera atrás y flexionando las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e tieni il petto alto mentre abbassi il corpo in squat, spingendo indietro i fianchi e piegando le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺胸收腹，核心收紧，屈髋向后坐并屈膝下蹲。"
     }
    }
   }
  },
  "s7HX1BY.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower until your thighs are parallel to the ground, or as low as you can comfortably go."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que los muslos queden paralelos al suelo, o hasta donde llegues cómodo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati finché le cosce sono parallele al pavimento, o più in basso finché riesci comodamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲至大腿与地面平行，或达到舒适的最大幅度。"
     }
    }
   }
  },
  "s7HX1BY.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then push through your heels to return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y empuja con los talones para volver a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in basso, poi spingi sui talloni per tornare alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在底部稍作停顿，随后脚跟用力蹬地站起恢复直立起始姿态。"
     }
    }
   }
  },
  "dG5Smob.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rack Pull"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto desde soportes"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rack pull"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "架上硬拉"
     }
    }
   }
  },
  "dG5Smob.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the safety pins or blocks so the bar rests just below your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca los seguros o unos bloques para que la barra quede justo por debajo de las rodillas."
     }
    }
   }
  },
  "dG5Smob.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand close to the bar and grip it just outside your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte cerca de la barra y agárrala justo por fuera de las piernas."
     }
    }
