      "state": "translated",
      "value": "弹力带胸部飞鸟"
     }
    }
   }
  },
  "band-chest-fly.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band to a post at chest height and face away from it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ata la banda a un poste a la altura del pecho y ponte de espaldas a él."
     }
    }
   }
  },
  "band-chest-fly.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold one end in each hand with your arms open to the sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un extremo con cada mano con los brazos abiertos hacia los lados."
     }
    }
   }
  },
  "band-chest-fly.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step forward until the band is tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante hasta tensar la banda."
     }
    }
   }
  },
  "band-chest-fly.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring your hands together in front of your chest with a slight bend in the elbows."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta las manos delante del pecho con los codos un poco flexionados."
     }
    }
   }
  },
  "band-chest-fly.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for a moment and open your arms back out slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y vuelve a abrir los brazos despacio."
     }
    }
   }
  },
  "flat-bench-cable-fly.name": {
