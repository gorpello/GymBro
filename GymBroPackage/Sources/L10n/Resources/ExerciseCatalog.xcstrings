     }
    }
   }
  },
  "cross-body-hammer-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with a dumbbell in each hand, palms facing your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con una mancuerna en cada mano y las palmas hacia el cuerpo."
     }
    }
   }
  },
  "cross-body-hammer-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados a los costados."
     }
    }
   }
  },
  "cross-body-hammer-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl one dumbbell up and across towards the opposite shoulder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una mancuerna cruzándola hacia el hombro contrario."
     }
    }
   }
  },
  "cross-body-hammer-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your palm facing in without twisting the wrist."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la palma hacia dentro sin girar la muñeca."
     }
    }
   }
  },
  "cross-body-hammer-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it slowly and repeat with the other arm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájala despacio y repite con el otro brazo."
     }
    }
   }
  },
  "seated-dumbbell-curl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seated Dumbbell Curl"
