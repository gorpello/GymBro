  "ywaNfuh.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the Smith bar at shoulder height and step under it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la barra del multipower a la altura de los hombros y colócate debajo."
     }
    }
   }
  },
  "ywaNfuh.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest the bar across your upper back and stand with the balls of your feet on a low step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra en la parte alta de la espalda y pisa un escalón bajo con la parte delantera de los pies."
     }
    }
   }
  },
  "ywaNfuh.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unlock the bar and let your heels hang off the edge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desbloquea la barra y deja los talones en el aire."
     }
    }
   }
  },
  "ywaNfuh.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rise up onto your toes as high as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube de puntillas todo lo que puedas."
     }
    }
   }
  },
  "ywaNfuh.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your heels slowly below the step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los talones despacio por debajo del escalón."
     }
    }
   }
  },
  "u5ESqzH.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos tipo burro"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey calf raise"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "驴式提踵"
     }
    }
   }
  },
  "u5ESqzH.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your toes on an elevated surface, such as a step or block."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte con las puntas de los pies en una superficie elevada, como un step o un taco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti con le punte su una superficie rialzata come uno step o un blocco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚前脚掌站在垫高台阶或垫木上，脚后跟悬空。"
     }
    }
   }
  },
  "u5ESqzH.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands on a stable support, such as a wall or railing, for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya las manos en algo estable, como una pared o una barandilla, para el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le mani a un sostegno stabile come un muro o una ringhiera per equilibrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋俯身，双手支撑在稳固的墙壁或栏杆上以保持平衡。"
     }
    }
   }
  },
  "u5ESqzH.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your heels as high as possible, lifting your body weight onto the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los talones todo lo que puedas, quedándote sobre la punta de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i talloni più in alto possibile portando il peso del corpo sugli avampiedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "小腿发力尽可能抬高脚后跟，将身体重心推至前脚掌上。"
     }
    }
   }
  },
  "u5ESqzH.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i talloni fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点顶峰收缩片刻，随后缓慢下放脚后跟充分拉伸。"
     }
    }
   }
  },
  "u5ESqzH.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照预定次数重复完成动作。"
     }
    }
   }
  },
  "1kB3Wmk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Single Leg Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos a una pierna con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf a una gamba con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃单腿提踵"
     }
    }
   }
  },
  "1kB3Wmk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on the edge of a step or platform with your heels hanging off and your toes on the step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en el borde de un step o plataforma con los talones al aire y las puntas apoyadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti sul bordo di uno step o pedana con i talloni fuori e le punte sullo step"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单脚前脚掌站在台阶或踏板边缘，脚后跟完全悬空。"
     }
    }
   }
  },
  "1kB3Wmk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in one hand and place your other hand on a wall or railing for support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una mancuerna en una mano y apoya la otra en una pared o barandilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un manubrio in una mano e appoggia laltra mano a un muro o ringhiera per supporto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同侧手持哑铃，另一只手扶住墙面或扶手以保持身体稳定。"
     }
    }
   }
  },
  "1kB3Wmk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your heel as high as possible, lifting your body up onto your toes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube el talón todo lo que puedas, quedándote de puntillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il tallone più in alto possibile portando il corpo sulle punte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "小腿发力将脚后跟尽可能抬高，蹬起身体。"
     }
    }
   }
  },
  "1kB3Wmk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heel back down below the step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja el talón despacio por debajo del step."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il tallone sotto il livello dello step"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿，随后缓慢下放脚后跟至踏板水平面以下进行充分拉伸。"
     }
    }
   }
  },
  "1kB3Wmk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch to the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia gamba"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照目标次数完成该侧动作，然后换另一条腿重复。"
     }
    }
   }
  },
  "0jp9Rlz.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
