  },
  "flat-bench-cable-fly.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hands back to bench height slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las manos despacio hasta la altura del banco."
     }
    }
   }
  },
