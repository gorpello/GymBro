  },
  "single-leg-glute-bridge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with one knee bent and that foot flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con una rodilla flexionada y ese pie apoyado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con un ginocchio piegato e quel piede piantato a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，一侧膝盖弯曲且脚掌平踩地面。"
     }
    }
   }
  },
  "single-leg-glute-bridge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the other leg and hold it straight in the air."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levanta la otra pierna y mantenla estirada en el aire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva laltra gamba e tienila tesa in aria."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "另一条腿抬起并在空中伸直。"
     }
    }
   }
  },
  "single-leg-glute-bridge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the planted heel to raise your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón apoyado para subir la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone dappoggio per sollevare i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿脚后跟蹬地，将髋部向上顶起。"
     }
    }
   }
  },
  "single-leg-glute-bridge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips level, without letting one side drop."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera nivelada, sin dejar caer un lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi in linea, senza far scendere un lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持骨盆水平稳定，避免身体向任一侧倾斜。"
     }
    }
   }
  },
  "single-leg-glute-bridge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself slowly and finish all the reps before swapping legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio y termina todas las repeticiones antes de cambiar de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati lentamente e finisci tutte le ripetizioni prima di cambiare gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放身体，完成单侧目标次数后再换另一侧。"
     }
    }
   }
  },
