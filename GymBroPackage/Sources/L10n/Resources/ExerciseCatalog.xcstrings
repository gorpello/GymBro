     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃站姿摇摆提踵"
     }
    }
   }
  },
  "6HiHHe0.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a barbell across your upper back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y la barra apoyada en la parte alta de la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e tieni un bilanciere sulle spalle alte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，将杠铃置于上背部斜方肌上。"
     }
    }
   }
  },
  "6HiHHe0.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your heels off the ground as high as possible, balancing on the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega los talones todo lo que puedas, en equilibrio sobre la punta de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i talloni da terra più in alto possibile restando in equilibrio sugli avampiedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "小腿发力将脚后跟尽可能向上抬起，在前脚掌上保持平衡。"
     }
    }
   }
  },
  "6HiHHe0.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i talloni fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地将脚后跟下放回地面。"
     }
    }
   }
  },
  "6HiHHe0.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照预定次数重复完成训练动作。"
     }
    }
   }
  },
  "iPm26QU.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step-down"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bajada controlada del cajón"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Step-down"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿下台阶"
     }
    }
   }
  },
  "iPm26QU.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on a low box or step on one leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a un cajón bajo o un escalón sobre una pierna."
     }
    }
   }
  },
  "iPm26QU.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the other leg hang just off the edge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja la otra pierna colgando justo fuera del borde."
     }
    }
   }
  },
  "iPm26QU.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your standing knee slowly to lower the free heel towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona despacio la rodilla de apoyo para bajar el talón libre hacia el suelo."
     }
    }
   }
  },
  "iPm26QU.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tap the floor lightly without shifting your weight onto it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toca el suelo suavemente sin apoyar el peso en él."
     }
    }
   }
  },
  "iPm26QU.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straighten your standing leg to rise back up and switch legs after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira la pierna de apoyo para volver a subir y cambia de pierna al acabar la serie."
     }
    }
   }
  },
  "VW88JNd.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Seated One Leg Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos sentado a una pierna con mancuerna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf da seduto a una gamba con manubrio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃坐姿单腿提踵"
     }
    }
   }
  },
  "VW88JNd.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with the ball of one foot on a low step and your heel hanging off."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con la parte delantera de un pie sobre un escalón bajo y el talón en el aire."
     }
    }
   }
  },
  "VW88JNd.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest a dumbbell on top of that knee and hold it in place."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya una mancuerna encima de esa rodilla y sujétala."
     }
    }
   }
  },
  "VW88JNd.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the ball of your foot to raise your heel as high as you can."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con la punta del pie para subir el talón todo lo que puedas."
     }
    }
   }
  },
  "VW88JNd.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top and squeeze your calf."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba apretando el gemelo."
     }
    }
   }
  },
  "VW88JNd.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your heel slowly below the step and switch legs after the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el talón despacio por debajo del escalón y cambia de pierna al acabar la serie."
     }
    }
   }
  },
  "ywaNfuh.name": {
   "extractionState": "manual",
   "localizations": {
