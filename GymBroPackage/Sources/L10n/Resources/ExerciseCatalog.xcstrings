    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla de atrás hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il ginocchio dietro verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "后膝向地面方向缓慢下沉靠近。"
     }
    }
   }
  },
  "front-foot-elevated-split-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front foot to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el pie de delante para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul piede davanti per rialzarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚脚跟发力蹬地推起身体，站直恢复分腿位置。"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Machine Bulgarian Split Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla búlgara en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Bulgarian split squat al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机保加利亚分腿蹲"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the smith machine bar on your upper back and rest one foot on a bench behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la barra del multipower en la parte alta de la espalda y un pie sobre un banco detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il bilanciere del multipower sulla parte alta della schiena e appoggia un piede su una panca dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将史密斯机杠铃架在上背部，单脚向后搭在身后的长凳上。"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place the front foot far enough forward to keep the knee stacked over the ankle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Adelanta bastante el pie de delante para que la rodilla quede sobre el tobillo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il piede davanti abbastanza avanti da tenere il ginocchio sopra la caviglia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚向前跨步至适宜距离，使下蹲时膝盖垂直位于脚踝上方。"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Unrack the bar and brace your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barra del soporte y aprieta el abdomen."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca il bilanciere e attiva il core."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "旋转杠铃解除锁扣，紧绷核心肌群。"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower straight down until your back knee is close to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja recto hasta que la rodilla de atrás casi toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi dritto finché il ginocchio dietro è vicino al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体垂直向下深蹲，直至后膝接近地面。"
     }
    }
   }
  },
  "smith-machine-bulgarian-split-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through the front heel to return to the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone davanti per tornare in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚脚跟蹬地发力，推回顶峰起始位置。"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Smith Machine Reverse Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada hacia atrás en multipower"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo indietro al multipower"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "史密斯机后退箭步蹲"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest the smith machine bar across your upper back and unrack it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la barra del multipower en la parte alta de la espalda y sácala del soporte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia il bilanciere del multipower sulla parte alta della schiena e staccalo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将史密斯机杠铃横架在上背部，起杠旋转解锁。"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet under the bar and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca los pies debajo de la barra y saca pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi sotto il bilanciere e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚在杠铃下方站立，挺胸抬头收腹。"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot back and lower that knee towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso atrás con un pie y baja esa rodilla hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo indietro con un piede e abbassa quel ginocchio verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单脚向后撤出一步，屈膝下沉至后膝接近地面。"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep most of your weight on the front leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén casi todo el peso en la pierna de delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la maggior parte del peso sulla gamba davanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将大部分体重保持承载在前侧腿上。"
     }
    }
   }
  },
  "smith-machine-reverse-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push off the front foot to bring your legs back together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el pie de delante para juntar las piernas otra vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul piede davanti per riunire le gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚用力蹬地，将后腿收回恢复双脚并拢站立。"
     }
    }
   }
  },
  "reverse-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reverse Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada hacia atrás con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo indietro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃后退箭步蹲"
     }
    }
   }
  },
  "reverse-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with a dumbbell in each hand at your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con una mancuerna en cada mano a los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con un manubrio in ogni mano lungo i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "直立站立，双手在身体两侧各握一只哑铃。"
     }
    }
   }
  },
  "reverse-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step one foot straight back, landing on the ball of the foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso recto hacia atrás apoyando la punta del pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo dritto indietro con un piede, atterrando sulla pianta del piede."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单脚笔直向后迈出一大步，前脚掌轻柔着地。"
     }
    }
   }
  },
  "reverse-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your back knee until it almost touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla de atrás hasta casi tocar el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il ginocchio dietro fin quasi a toccare il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下沉后膝，直至膝盖几乎触及地面。"
     }
    }
   }
  },
  "reverse-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your front shin vertical and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espinilla de delante vertical y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la tibia davanti verticale e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持前侧小腿接近垂直地面，挺胸收腹。"
     }
    }
   }
  },
  "reverse-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the front heel to step back together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón de delante para volver a juntar los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone davanti per tornare con i piedi uniti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚脚跟发力蹬地，后腿向前收拢站直。"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Lateral Lunge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Zancada lateral con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Affondo laterale con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃侧向箭步蹲"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall holding a dumbbell in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie y erguido, con una mancuerna en cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con un manubrio in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，保持挺胸直立站姿。"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take a wide step out to one side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso amplio hacia un lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un ampio passo laterale da un lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向身体一侧迈出一大步。"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips back and bend that knee while the other leg stays straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la cadera atrás y flexiona esa rodilla mientras la otra pierna sigue estirada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi indietro i fianchi e piega quel ginocchio mentre l'altra gamba resta tesa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跨出侧屈髋向后坐并屈膝下蹲，另一侧腿保持伸直伸展。"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep both feet flat and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los dos pies planos y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni entrambi i piedi piatti a terra e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚全脚掌贴地，挺胸抬头。"
     }
    }
   }
  },
  "dumbbell-lateral-lunge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push off the bent leg to return to the middle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con la pierna flexionada para volver al centro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sulla gamba piegata per tornare al centro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝腿强力蹬地发力，推回中间起始站立姿态。"
     }
    }
   }
  },
  "wall-sit.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wall Sit"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla isométrica en pared"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sedia al muro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "靠墙静蹲"
     }
    }
   }
  },
  "wall-sit.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your back flat against a wall and your feet a step forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la espalda plana contra la pared con los pies un paso por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai con la schiena piatta contro il muro e i piedi un passo avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部平整贴紧墙壁站立，双脚向前迈出一步距离。"
     }
    }
   }
  },
  "wall-sit.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slide down until your knees are bent at ninety degrees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja deslizándote hasta que las rodillas queden a noventa grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scivola verso il basso finché le ginocchia sono piegate a novanta gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿墙面下滑，直至膝盖弯曲成90度角。"
     }
    }
   }
  },
  "wall-sit.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your knees over your ankles and your back on the wall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las rodillas sobre los tobillos y la espalda pegada a la pared."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le ginocchia sopra le caviglie e la schiena al muro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "确保膝盖在脚踝正上方，整个背部贴紧墙壁。"
     }
    }
   }
  },
  "wall-sit.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your hands on your thighs or hold them out in front."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja las manos en los muslos o estíralas por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le mani sulle cosce o tienile tese davanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手搭在大腿上或向前平举。"
     }
    }
   }
  },
  "wall-sit.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the position until your legs give in."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la posición hasta que las piernas digan basta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione finché le gambe cedono."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持这一静力支撑姿态，直到腿部力竭或达到目标时长。"
     }
    }
   }
  },
  "burpee.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Burpee"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Burpee con flexión y salto"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Burpee"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "波比跳"
     }
    }
   }
  },
  "burpee.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽自然站立。"
     }
    }
   }
  },
  "burpee.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat down and put your hands on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agáchate y apoya las manos en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accosciati e metti le mani a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝下蹲，双手平撑在地面上。"
     }
    }
   }
  },
  "burpee.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump your feet back into a push-up position and lower your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los pies atrás de un salto y baja el pecho al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta indietro in posizione di piegamento e abbassa il petto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿同时向后蹬跳进入俯卧撑姿势，顺势下沉俯卧胸部贴地。"
     }
    }
   }
  },
  "burpee.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push up and jump your feet back under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja y vuelve a meter los pies bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingiti su e riporta i piedi sotto i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推起胸部，双脚快速向前跳回髋部下方。"
     }
    }
   }
  },
  "burpee.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump straight up with your arms overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta hacia arriba con los brazos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta in alto con le braccia sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿爆发向上垂直跃起，双手高举过头顶。"
     }
    }
   }
  },
  "high-knees.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "High Knees"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rodillas al pecho"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ginocchia alte"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "原地高抬腿"
     }
    }
   }
  },
  "high-knees.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with your feet hip-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie y erguido, con los pies a la anchura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "直立站立，双脚与髋同宽。"
     }
    }
   }
  },
  "high-knees.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Run on the spot, driving one knee up at a time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Corre en el sitio subiendo una rodilla cada vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Corri sul posto, portando in alto un ginocchio alla volta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "原地快速奔跑，交替将一侧膝盖向上提拉。"
     }
    }
   }
  },
  "high-knees.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring each knee up to hip height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube cada rodilla hasta la altura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta ogni ginocchio all'altezza dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "确保每次提膝时大腿抬起至髋部高度。"
     }
    }
   }
  },
  "high-knees.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Land softly on the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cae suave sobre la parte delantera del pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Atterra morbidamente sulle piante dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前脚掌轻柔缓冲着地。"
     }
    }
   }
  },
  "high-knees.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pump your arms in time with your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acompaña el movimiento con los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muovi le braccia a tempo con le gambe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂积极前后摆臂，与腿部动作保持协调节奏。"
     }
    }
   }
  },
  "jumping-jack.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jumping Jack"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saltos de tijera"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Jumping jack"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "开合跳"
     }
    }
   }
  },
  "jumping-jack.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet together and your arms at your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "De pie, con los pies juntos y los brazos a los costados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi uniti e le braccia lungo i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚并拢站立，双手自然垂于身体两侧。"
     }
    }
   }
  },
  "jumping-jack.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump your feet out wide while you raise your arms overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los pies de un salto mientras subes los brazos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta aprendo i piedi mentre sollevi le braccia sopra la testa."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向两侧跳开的同时，双臂自两侧挥举过头顶。"
     }
    }
   }
  },
  "jumping-jack.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Land softly with your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cae suave con las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Atterra morbidamente con le ginocchia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "膝盖微屈轻柔着地缓冲冲击。"
     }
    }
   }
  },
  "jumping-jack.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump back to bring your feet together and your arms down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a juntar los pies y baja los brazos de un salto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta indietro per riunire i piedi e abbassare le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再次跳起，双脚并拢，双臂下放回到体侧。"
     }
    }
   }
  },
  "jumping-jack.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a steady rhythm for the whole set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el ritmo constante durante toda la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni un ritmo costante per tutta la serie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整组动作保持稳定匀速的跳跃节奏。"
     }
    }
   }
  },
  "skater-hop.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Skater Hop"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salto de patinador"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salto del pattinatore"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "滑冰者跳"
     }
    }
   }
  },
  "skater-hop.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with a slight bend in your knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con la rodilla algo flexionada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba con il ginocchio leggermente piegato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿微屈膝站立，保持身体平衡。"
     }
    }
   }
  },
  "skater-hop.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump sideways and land on the other foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta de lado y cae sobre el otro pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta di lato e atterra sull'altro piede."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧向爆发性起跳，用对侧脚落地承重。"
     }
    }
   }
  },
  "skater-hop.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swing the free leg behind you as you land."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la pierna libre por detrás al aterrizar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta la gamba libera dietro di te mentre atterri."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "落地时腾空的腿顺势摆向身后以协助平衡。"
     }
    }
   }
  },
  "skater-hop.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Absorb the landing softly and stay balanced."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Amortigua la caída y mantén el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ammortizza morbidamente l'atterraggio e resta in equilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝轻柔吸收落地冲击，保持身体稳定。"
     }
    }
   }
  },
  "skater-hop.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Jump back to the other side and keep alternating."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta al otro lado y sigue alternando."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Salta di nuovo dall'altro lato e continua ad alternare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再次蹬地跳回另一侧，双侧连贯交替进行。"
     }
    }
   }
  },
  "lateral-shuffle.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lateral Shuffle"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desplazamiento lateral"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spostamento laterale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧向滑步"
     }
    }
   }
  },
  "lateral-shuffle.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into an athletic stance with your knees bent and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en posición atlética con las rodillas flexionadas y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in posizione atletica con le ginocchia piegate e il petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "进入运动准备姿态，双膝弯曲，挺胸抬头收腹。"
     }
    }
   }
  },
  "lateral-shuffle.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push off one foot to slide sideways."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con un pie para desplazarte de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi su un piede per scivolare di lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单脚蹬地发力，身体向侧方滑移。"
     }
    }
   }
  },
  "lateral-shuffle.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take quick steps without crossing your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da pasos rápidos sin cruzar los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai passi rapidi senza incrociare i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "快速倒步移动，双脚移动过程中切勿交叉绊倒。"
     }
    }
   }
  },
  "lateral-shuffle.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stay low and keep your weight on the balls of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantente bajo y con el peso en la parte delantera del pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resta basso e tieni il peso sulle piante dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重心保持低位，身体重量集中在前脚掌上。"
     }
    }
   }
  },
  "lateral-shuffle.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shuffle back in the other direction."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desplázate de vuelta en el sentido contrario."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna indietro con passi laterali nella direzione opposta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按原路线朝相反方向滑步返回。"
     }
    }
   }
  },
  "sprawl.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sprawl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sprawl de lucha"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sprawl"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "防摔下潜 (Sprawl)"
     }
    }
   }
  },
  "sprawl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start standing with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza de pie con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti in piedi con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，挺胸收腹。"
     }
    }
   }
  },
  "sprawl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drop your hands to the floor and kick your legs back hard."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las manos al suelo y lanza las piernas atrás con fuerza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le mani al pavimento e calcia forte le gambe indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手迅速撑地，双腿用力向后踢出。"
     }
    }
   }
  },
  "sprawl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your hips sink towards the ground as you land."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja caer la cadera hacia el suelo al aterrizar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia affondare i fianchi verso il pavimento mentre atterri."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "落地时让髋部主动下沉靠近地面。"
     }
    }
   }
  },
  "sprawl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up and pull your feet under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja hacia arriba y mete los pies bajo la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi di nuovo su e riporta i piedi sotto i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手推地，迅速收腿将双脚拉回髋部下方。"
     }
    }
   }
  },
  "sprawl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up and go straight into the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie y encadena la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzati e passa subito alla ripetizione successiva."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起身站直，随后立即进入下一次动作。"
     }
    }
   }
  },
  "pistol-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pistol Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla a una pierna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pistol squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手枪深蹲 (单腿深蹲)"
     }
    }
   }
  },
  "pistol-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with the other leg held out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con la otra estirada por delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba con l'altra gamba tesa davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，另一条腿向前伸直抬起悬空。"
     }
    }
   }
  },
  "pistol-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch your arms forward for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos hacia delante para equilibrarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allunga le braccia in avanti per equilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂向前平举以保持身体平衡。"
     }
    }
   }
  },
  "pistol-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit down slowly on the standing leg, keeping the free leg off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio sobre la pierna de apoyo sin que la otra toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti lentamente sulla gamba di appoggio, tenendo la gamba libera staccata dal pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿缓慢屈膝下蹲，悬空腿始终保持离地。"
     }
    }
   }
  },
  "pistol-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go all the way down until your hamstring meets your calf."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja del todo hasta juntar el muslo con el gemelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi del tutto finché il femorale tocca il polpaccio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续下蹲至最低点，使大腿后侧贴近小腿。"
     }
    }
   }
  },
  "pistol-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through the whole foot to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con todo el pie para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi su tutto il piede per rialzarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全脚掌发力蹬地，站起恢复至起始站姿。"
     }
    }
   }
  },
  "assisted-pistol-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Assisted Pistol Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla a una pierna asistida"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pistol squat assistito"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "辅助手枪深蹲"
     }
    }
   }
  },
  "assisted-pistol-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold onto a post or a suspension strap in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a un poste o a unas cintas de suspensión delante de ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggrappati a un palo o a una cinghia in sospensione davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住身前的立柱或悬吊训练带（TRX）。"
     }
    }
   }
  },
  "assisted-pistol-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg and lift the other leg forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna y estira la otra hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba e solleva l'altra gamba in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，另一条腿向前抬起悬空。"
     }
    }
   }
  },
  "assisted-pistol-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Use your hands to control the descent as you squat down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa las manos para controlar la bajada mientras te agachas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Usa le mani per controllare la discesa mentre ti accosci."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下蹲过程中双手辅助借力，控制平稳下落。"
     }
    }
   }
  },
  "assisted-pistol-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Go as low as you can while keeping the free leg up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja todo lo que puedas sin apoyar la pierna libre."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scendi più che puoi tenendo la gamba libera sollevata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在悬空腿不触地的前提下，尽可能下蹲至更低位置。"
     }
    }
   }
  },
  "assisted-pistol-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull lightly on the support and push through your foot to stand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira un poco del apoyo y empuja con el pie para subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira leggermente il supporto e spingi sul piede per alzarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手轻微拉住支撑物，支撑脚发力蹬地起立。"
     }
    }
   }
  },
  "shrimp-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shrimp Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla shrimp"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Shrimp squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "虾式深蹲"
     }
    }
   }
  },
  "shrimp-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg and bend the other knee so the foot points back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna y flexiona la otra rodilla llevando el pie atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba e piega l'altro ginocchio con il piede rivolto indietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，另一侧膝盖弯曲，脚向后抬起。"
     }
    }
   }
  },
  "shrimp-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold that foot behind you with the same-side hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta ese pie por detrás con la mano del mismo lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni quel piede dietro di te con la mano dello stesso lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "同侧手在身后握住弯曲脚的脚背或脚踝。"
     }
    }
   }
  },
  "shrimp-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower yourself until the back knee touches the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja hasta que la rodilla de atrás toque el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati finché il ginocchio dietro tocca il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿缓慢下蹲，直至后膝轻触地面。"
     }
    }
   }
  },
  "shrimp-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and your standing heel down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y el talón de apoyo pegado al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e il tallone di appoggio a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸收腹，支撑脚脚后跟紧贴地面。"
     }
    }
   }
  },
  "shrimp-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push back up without letting the back foot touch down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube sin que el pie de atrás llegue a apoyarse."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per rialzarti senza far toccare a terra il piede dietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑腿发力蹬起恢复站姿，后脚全程不着地。"
     }
    }
   }
  },
  "skater-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Skater Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla de patinador"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Skater squat"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "滑冰者深蹲"
     }
    }
   }
  },
  "skater-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg with the other leg bent behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna con la otra flexionada por detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba con l'altra gamba piegata dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，另一条腿在身后屈膝悬空。"
     }
    }
   }
  },
  "skater-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach your arms forward as a counterweight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos hacia delante como contrapeso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le braccia in avanti come contrappeso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂向前伸出作为平衡配重。"
     }
    }
   }
  },
  "skater-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge and squat down until the back knee taps the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate y baja hasta que la rodilla de atrás roce el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegati e accosciati finché il ginocchio dietro sfiora il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋并屈膝下蹲，直至后膝轻点地面。"
     }
    }
   }
  },
  "skater-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back flat and your standing foot planted."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda plana y el pie de apoyo bien fijo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la schiena piatta e il piede di appoggio ben piantato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持背部平直，支撑脚稳固踩实地面。"
     }
    }
   }
  },
  "skater-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand back up by driving through your heel."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a subir empujando con el talón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rialzati spingendo sul tallone."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚后跟发力蹬地起立，恢复起始姿势。"
     }
    }
   }
  },
  "single-leg-box-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Single-Leg Box Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla a una pierna al cajón"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat a una gamba su box"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿箱式深蹲"
     }
    }
   }
  },
  "single-leg-box-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg in front of a box or a bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie sobre una pierna delante de un cajón o un banco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai su una gamba davanti a una panca o a un box."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背对跳箱或健身凳单腿站立。"
     }
    }
   }
  },
  "single-leg-box-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the free leg out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la pierna libre estirada hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la gamba libera tesa davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "悬空腿向前平举伸直。"
     }
    }
   }
  },
  "single-leg-box-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit back slowly until your glutes touch the box."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate despacio hasta que los glúteos rocen el cajón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti indietro lentamente finché i glutei toccano la panca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋屈膝缓慢向后坐，直至臀部轻触跳箱。"
     }
    }
   }
  },
  "single-leg-box-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do not drop or bounce off the surface."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No te dejes caer ni rebotes en la superficie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non cadere di peso né rimbalzare sulla superficie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持身体受控，切勿猛烈下坠或利用反弹借力。"
     }
    }
   }
  },
  "single-leg-box-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the standing foot to come back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el pie de apoyo para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul piede di appoggio per tornare su."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "支撑脚发力蹬地，站立恢复至起始位置。"
     }
    }
   }
  },
  "banded-squat.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Squat"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sentadilla con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Squat con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带深蹲"
     }
    }
   }
  },
  "banded-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band above your knees and stand shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda por encima de las rodillas y ponte a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico sopra le ginocchia e stai in piedi con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在膝盖上方，双脚与肩同宽站立。"
     }
    }
   }
  },
  "banded-squat.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your knees out so the band stays tight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las rodillas hacia fuera para mantener la banda tensa."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le ginocchia verso l'esterno per tenere l'elastico in tensione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝主动向外顶，保持弹力带紧绷。"
     }
    }
   }
  },
  "banded-squat.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit back and down into a squat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja llevando la cadera hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti indietro e in basso in posizione di squat."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋屈膝，向后下方蹲下。"
     }
    }
   }
  },
  "banded-squat.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest up and your knees tracking over your toes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y las rodillas en línea con los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e le ginocchia in linea con le punte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持挺胸，膝盖朝向与脚尖方向一致。"
     }
    }
   }
  },
  "banded-squat.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your feet to stand back up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con los pies para volver a subir."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui piedi per rialzarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚蹬地发力起身，恢复站直姿势。"
     }
    }
   }
  },
  "standing-quad-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Standing Quad Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de cuádriceps de pie"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch quadricipiti in piedi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站姿股四头肌拉伸"
     }
    }
   }
  },
  "standing-quad-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall and hold a wall with one hand if you need balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido y apóyate en una pared si necesitas equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi e tieniti a un muro con una mano se ti serve equilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立站稳，必要时可单手扶墙保持平衡。"
     }
    }
   }
  },
  "standing-quad-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend one knee and grab that ankle behind you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona una rodilla y agarra ese tobillo por detrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega un ginocchio e afferra quella caviglia dietro di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一侧膝盖弯曲，同侧手在身后抓住脚踝。"
     }
    }
   }
  },
  "standing-quad-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your heel towards your glute."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del talón hacia el glúteo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il tallone verso il gluteo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将脚后跟轻轻拉向臀部，感受大腿前侧拉伸。"
     }
    }
   }
  },
  "standing-quad-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your knees together and your hips tucked under."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las rodillas juntas y la cadera metida."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le ginocchia unite e il bacino raccolto sotto di te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持双膝靠拢，骨盆保持中立微收。"
     }
    }
   }
  },
  "standing-quad-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold, then swap to the other leg."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta y cambia de pierna."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione, poi passa all'altra gamba."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持拉伸数秒，然后换另一侧腿重复。"
     }
    }
   }
  },
  "running.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Treadmill Run"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Carrera en cinta"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Corsa sul tapis roulant"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跑步机跑步"
     }
    }
   }
  },
  "running.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto the treadmill and clip the safety key to your clothes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a la cinta y engancha la llave de seguridad a la ropa."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sul tapis roulant e aggancia la chiave di sicurezza ai vestiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站上跑步机，将安全磁锁夹在衣服上。"
     }
    }
   }
  },
  "running.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start the belt slowly and find your footing before speeding up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Arranca la cinta despacio y coge el paso antes de subir la velocidad."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvia il nastro lentamente e trova l'appoggio prima di aumentare la velocità."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "慢速启动跑步机跑带，稳住脚步后再逐渐提速。"
     }
    }
   }
  },
  "running.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise the speed until you are running at a pace you can hold."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la velocidad hasta un ritmo de carrera que puedas mantener."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alza la velocità finché corri a un ritmo che riesci a tenere."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整至适宜且可平稳维持的跑步配速。"
     }
    }
   }
  },
  "running.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your torso tall and let your arms swing at your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el tronco erguido y deja que los brazos vayan sueltos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il busto eretto e lascia oscillare le braccia lungo i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持上身挺直，双臂在身体两侧自然摆动。"
     }
    }
   }
  },
  "running.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slow the belt down for a few minutes before you step off."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la velocidad unos minutos antes de bajarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rallenta il nastro per qualche minuto prima di scendere."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "结束前逐步降低跑带速度慢走放松，然后走下跑步机。"
     }
    }
   }
  },
  "walking.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Treadmill Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminata en cinta"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata sul tapis roulant"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跑步机健走"
     }
    }
   }
  },
  "walking.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto the treadmill and set a comfortable walking speed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a la cinta y pon una velocidad de paseo cómoda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sul tapis roulant e imposta una velocità di camminata comoda."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "走上跑步机，设定舒适适中的步行速度。"
     }
    }
   }
  },
  "walking.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall and look ahead instead of down at your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido y mira al frente en vez de a los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai eretto e guarda avanti invece di guardare i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体挺拔，目视前方，避免低头看脚下。"
     }
    }
   }
  },
  "walking.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your arms swing naturally rather than gripping the handrails."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que los brazos vayan sueltos en lugar de agarrarte a las barras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia oscillare le braccia in modo naturale invece di aggrapparti ai corrimano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手自然前后摆臂，尽量不要紧抓扶手。"
     }
    }
   }
  },
  "walking.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Roll through each step from heel to toe."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rueda cada paso del talón a la punta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia ogni passo dal tallone alla punta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "迈步时脚跟先着地，顺畅过渡到脚尖蹬出。"
     }
    }
   }
  },
  "walking.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slow the belt down before stepping off the machine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la velocidad antes de bajarte de la máquina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rallenta il nastro prima di scendere dalla macchina."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "离开跑步机前先降速缓冲，安全停步走下。"
     }
    }
   }
  },
  "treadmill-incline-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Treadmill Incline Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminata en cinta con inclinación"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata in pendenza"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跑步机坡度健走"
     }
    }
   }
  },
  "treadmill-incline-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the treadmill to a brisk walking speed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon la cinta a una velocidad de paseo rápido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Imposta il tapis roulant a una velocità di camminata sostenuta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将跑步机调整到快走配速。"
     }
    }
   }
  },
  "treadmill-incline-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise the incline until your legs feel the climb."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la inclinación hasta que notes la subida en las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alza la pendenza finché senti le gambe lavorare in salita."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "逐步调高坡度，直到腿部感受到明显的爬坡阻力。"
     }
    }
   }
  },
  "treadmill-incline-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall and avoid leaning on the handrails."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido y evita apoyarte en las barras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai eretto ed evita di appoggiarti ai corrimano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体保持直立微前倾，避免身体瘫靠在扶手上借力。"
     }
    }
   }
  },
  "treadmill-incline-walk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through the whole foot on every step."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con todo el pie en cada paso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi su tutto il piede a ogni passo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "迈出的每一步都要用全脚掌充分蹬地发力。"
     }
    }
   }
  },
  "treadmill-incline-walk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drop the incline and the speed to cool down at the end."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la inclinación y la velocidad para terminar suave."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa pendenza e velocità per defaticarti alla fine."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "训练结束时降低坡度与速度，慢走放松整理。"
     }
    }
   }
  },
  "hiking.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Vertical Climber"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escalador vertical"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Climber verticale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "攀爬机训练"
     }
    }
   }
  },
  "hiking.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto the climber and take a handle in each hand."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete al escalador y coge una empuñadura con cada mano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sul vertical climber e prendi una maniglia in ogni mano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踏上攀爬机踏板，双手分别握住两侧手柄。"
     }
    }
   }
  },
  "hiking.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put one foot on each pedal with your body upright."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un pie en cada pedal con el cuerpo erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un piede su ogni pedale con il corpo eretto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚踩稳踏板，躯干保持直立核心收紧。"
     }
    }
   }
  },
  "hiking.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive one knee up as the other leg extends down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una rodilla mientras la otra pierna se estira hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi un ginocchio in alto mentre l'altra gamba si estende verso il basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一侧膝盖向上提拉的同时，另一侧腿用力向下蹬伸。"
     }
    }
   }
  },
  "hiking.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the movement steady instead of bouncing."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el movimiento constante en lugar de dar tirones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni il movimento costante invece di rimbalzare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持节奏平稳顺畅，避免身体剧烈晃动或弹震借力。"
     }
    }
   }
  },
  "hiking.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slow the pace down for the last minute of the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el ritmo durante el último minuto de la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rallenta il ritmo per l'ultimo minuto della serie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在该组训练的最后一分钟放慢节奏，平稳收尾。"
     }
    }
   }
  },
  "cycling.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stationary Bike"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicicleta estática"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cyclette"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "健身车骑行"
     }
    }
   }
  },
  "cycling.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the saddle so your knee stays slightly bent at the bottom."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el sillín para que la rodilla quede algo flexionada abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la sella così che il ginocchio resti leggermente piegato in basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调节坐垫高度，使踏板踩到底时膝盖仍微屈。"
     }
    }
   }
  },
  "cycling.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit down and put the balls of your feet on the pedals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate y apoya la parte delantera del pie en los pedales."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti e appoggia le piante dei piedi sui pedali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐上坐垫，将前脚掌踩在踏板中央。"
     }
    }
   }
  },
  "cycling.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the bars with relaxed arms and a flat back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el manillar con los brazos relajados y la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il manubrio con le braccia rilassate e la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手轻握车把，双臂自然放松，保持背部平直。"
     }
    }
   }
  },
  "cycling.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pedal at a steady cadence and adjust the resistance to taste."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pedalea a una cadencia constante y ajusta la resistencia a tu gusto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pedala a un ritmo costante e regola la resistenza a piacere."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持均匀踏频平稳蹬踏，根据需要调节阻力档位。"
     }
    }
   }
  },
  "cycling.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Spin easy for a couple of minutes to finish."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pedalea suave un par de minutos para terminar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pedala piano per un paio di minuti per finire."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "训练结束前慢踩放松两分钟以平复心率。"
     }
    }
   }
  },
  "assault-bike.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Air Bike"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bicicleta de aire"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Air bike"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "风阻单车 (风扇车)"
     }
    }
   }
  },
  "assault-bike.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the air bike and set the saddle to hip height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la bici de aire y pon el sillín a la altura de la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti sulla air bike e regola la sella all'altezza dei fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐上风阻单车，将车座调节至约髋部高度。"
     }
    }
   }
  },
  "assault-bike.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the moving handles and put your feet on the pedals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las empuñaduras móviles y coloca los pies en los pedales."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra le maniglie mobili e metti i piedi sui pedali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住活动推拉把手，双脚踩紧踏板。"
     }
    }
   }
  },
  "assault-bike.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push and pull with your arms while your legs drive the pedals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja y tira con los brazos mientras las piernas pedalean."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi e tira con le braccia mentre le gambe spingono i pedali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手交替推拉把手，双腿同步发力全力蹬踏。"
     }
    }
   }
  },
  "assault-bike.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your breathing under control as the fan gets louder."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Controla la respiración según el ventilador coge ruido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il respiro sotto controllo mentre la ventola fa più rumore."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "随着风阻叶轮转速加快，保持深长受控的呼吸节奏。"
     }
    }
   }
  },
  "assault-bike.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ease off gradually instead of stopping dead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el ritmo poco a poco en vez de parar en seco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rallenta gradualmente invece di fermarti di colpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "冲刺完成后逐渐放慢速度放松，不要骤然完全停顿。"
     }
    }
   }
  },
  "elliptical.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Elliptical Trainer"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elíptica"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ellittica"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "椭圆机训练"
     }
    }
   }
  },
  "elliptical.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto the pedals and take hold of the moving handles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a los pedales y agarra las empuñaduras móviles."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sui pedali e afferra le maniglie mobili."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踏上踏板，双手握住活动把手。"
     }
    }
   }
  },
  "elliptical.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand tall with your weight through the middle of your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido con el peso repartido en el centro de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai eretto con il peso al centro dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上身挺直，将身体重心落在脚掌中部。"
     }
    }
   }
  },
  "elliptical.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the pedals around in a smooth oval path."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mueve los pedales describiendo un óvalo suave."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i pedali in un percorso ovale fluido."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踩动踏板，沿着椭圆形轨迹平稳顺畅运转。"
     }
    }
   }
  },
  "elliptical.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Work the arms and legs together instead of just coasting."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Trabaja brazos y piernas a la vez en lugar de dejarte llevar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lavora insieme con braccia e gambe invece di lasciarti trascinare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂推拉与双腿蹬踏协同发力，避免仅靠惯性滑动。"
     }
    }
   }
  },
  "elliptical.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the resistance for the final minutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la resistencia en los últimos minutos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa la resistenza per gli ultimi minuti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最后几分钟调低阻力慢速踩踏，充分放松整理。"
     }
    }
   }
  },
  "fy7Tgy4.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Alternate Hammer Preacher Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl predicador martillo alterno con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl a martello alternato su panca Scott"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃交替锤式牧师凳弯举"
     }
    }
   }
  },
  "fy7Tgy4.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a preacher bench with a dumbbell in each hand, palms facing your torso and arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el banco predicador con una mancuerna en cada mano, palmas hacia el cuerpo y brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a una panca scott con un manubrio in ogni mano, palmi rivolti verso il busto e braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在牧师凳上，双手各持一只哑铃，掌心相对，手臂完全伸展贴在托板上。"
     }
    }
   }
  },
  "fy7Tgy4.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms stationary and exhale as you curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos quietos y suelta el aire mientras subes el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni ferme le braccia ed espira mentre pieghi i pesi contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定贴板，呼气收缩二头肌向上弯举哑铃。"
     }
    }
   }
  },
  "fy7Tgy4.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the dumbbells until your biceps are fully contracted and the dumbbells are at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo las mancuernas hasta contraer el bíceps del todo, con las mancuernas a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a sollevare i manubri finché i bicipiti sono completamente contratti e i manubri sono alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "继续弯举哑铃直至肱二头肌充分收缩、哑铃升至肩部高度。"
     }
    }
   }
  },
  "fy7Tgy4.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per una breve pausa mentre stringi i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在收缩顶点停顿片刻，挤压肱二头肌。"
     }
    }
   }
  },
  "fy7Tgy4.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale and slowly begin to lower the dumbbells back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire y empieza a bajar las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira e inizia ad abbassare lentamente i manubri fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，缓慢将哑铃下放恢复至起始姿势。"
     }
    }
   }
  },
  "IENzBdA.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Drag Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl drag con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Drag curl con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃拖曳弯举 (Drag Curl)"
     }
    }
   }
  },
  "IENzBdA.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a barbell with an underhand grip, palms facing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en supinación, con las palmas hacia arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e tieni un bilanciere con presa supina, palmi rivolti in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手反握杠铃，掌心朝上。"
     }
    }
   }
  },
  "IENzBdA.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the barbell hang at arm's length in front of your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja la barra colgando con los brazos estirados delante de los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia il bilanciere appeso a braccia tese davanti alle cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "让手臂自然伸直，杠铃垂于大腿前方。"
     }
    }
   }
  },
  "IENzBdA.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, curl the barbell up towards your chest by contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, sube la barra hacia el pecho contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, piega il bilanciere verso il petto contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肘部顺势向后拉，收缩肱二头肌将杠铃沿着躯干贴身向上拖曳抬起。"
     }
    }
   }
  },
  "IENzBdA.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente il bilanciere fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点顶峰收缩停顿片刻，然后缓慢将杠铃沿原路径贴身下放回起始位置。"
     }
    }
   }
  },
  "IENzBdA.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复进行直至达到目标次数。"
     }
    }
   }
  },
  "NlfIbzq.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Alternate Preacher Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl predicador alterno con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl alternato su panca Scott con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃交替牧师凳弯举"
     }
    }
   }
  },
  "NlfIbzq.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a preacher bench with a dumbbell in each hand, palms facing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el banco predicador con una mancuerna en cada mano, palmas hacia arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a una panca scott con un manubrio in ogni mano, palmi rivolti in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在牧师凳上，双手各握一只哑铃，掌心朝上。"
     }
    }
   }
  },
  "NlfIbzq.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your upper arms on the pad of the preacher bench, allowing your arms to fully extend."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los brazos en la almohadilla del banco predicador, dejándolos estirarse del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le braccia sul cuscinetto della panca scott, lasciando le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将大臂后侧贴在牧师凳斜托板上，双臂充分伸展。"
     }
    }
   }
  },
  "NlfIbzq.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the dumbbell in your right hand as you contract your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube la mancuerna de la mano derecha contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega il manubrio della mano destra contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定贴板，呼气收缩二头肌，将右手哑铃向上弯举。"
     }
    }
   }
  },
  "NlfIbzq.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to curl the dumbbell until your biceps are fully contracted and the dumbbell is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo la mancuerna hasta contraer el bíceps del todo, con la mancuerna a la altura del hombro."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a piegare il manubrio finché i bicipiti sono completamente contratti e il manubrio è alla spalla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续弯举直至右侧肱二头肌完全收缩、哑铃抬至肩部高度。"
     }
    }
   }
  },
  "NlfIbzq.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then inhale and slowly lower the dumbbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento, coge aire y baja la mancuerna despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa, poi inspira e abbassa lentamente il manubrio fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，吸气并缓慢下放哑铃回起始位置，随后换另一侧交替进行。"
     }
    }
   }
  },
  "G08RZcQ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps en polea"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl al cavo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索弯举"
     }
    }
   }
  },
  "G08RZcQ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the cable machine with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie frente a la polea con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi di fronte alla macchina a cavo con i piedi alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面向龙门架绳索器械站立，双脚与肩同宽。"
     }
    }
   }
  },
  "G08RZcQ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the cable attachment with an underhand grip, palms facing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra el accesorio de la polea en supinación, con las palmas hacia arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra l'attacco del cavo con presa supina, palmi rivolti in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握绳索手柄，掌心向上。"
     }
    }
   }
  },
  "G08RZcQ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your elbows close to your sides and your upper arms stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los codos pegados al cuerpo y los brazos quietos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i gomiti vicini ai fianchi e le braccia ferme."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肘部紧贴身体两侧，大臂保持固定不晃动。"
     }
    }
   }
  },
  "G08RZcQ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Exhale and curl the cable attachment towards your shoulders, contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire y sube el accesorio hacia los hombros contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira e piega l'attacco del cavo verso le spalle, contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气收缩肱二头肌，将绳索配件向上弯举拉向肩部。"
     }
    }
   }
  },
  "G08RZcQ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top of the movement, squeezing your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto nel movimento, stringendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点停顿片刻，顶峰挤压肱二头肌，然后缓慢还原。"
     }
    }
   }
  },
  "WLvTAv5.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Prone Incline Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl inclinado boca abajo con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl prono su panca inclinata"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃俯卧上斜弯举 (蜘蛛弯举)"
     }
    }
   }
  },
  "WLvTAv5.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up an incline bench at a 45-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca un banco inclinado a 45 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Prepara una panca inclinata a 45 gradi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将上斜凳调节至约45度角。"
     }
    }
   }
  },
  "WLvTAv5.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie face down on the bench with your chest and stomach resting against it."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca abajo en el banco, con el pecho y el abdomen apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati a faccia in giù sulla panca con petto e pancia appoggiati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "趴在上斜凳上，胸腹部贴稳凳面。"
     }
    }
   }
  },
  "WLvTAv5.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a barbell with an underhand grip, shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en supinación, a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un bilanciere con presa supina, alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握杠铃，握距与肩同宽。"
     }
    }
   }
  },
  "WLvTAv5.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms fully, allowing the barbell to hang down towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos del todo, dejando la barra colgando hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi del tutto le braccia, lasciando il bilanciere penzolare verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂垂直向下自然伸直，让杠铃垂向地面。"
     }
    }
   }
  },
  "WLvTAv5.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega i pesi contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂垂直固定，呼气收缩肱二头肌将杠铃向上弯举。"
     }
    }
   }
  },
  "Zwiw7XR.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Alternating Bicep Curl with Leg Raised on Exercise Ball"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps alterno con pierna elevada en fitball"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl alternato con gamba sollevata su fitball"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "瑜伽球抬腿哑铃交替弯举"
     }
    }
   }
  },
  "Zwiw7XR.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a dumbbell in each hand, palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano, con las palmas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e tieni un manubrio in ogni mano con i palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手各握一只哑铃，掌心朝前，双脚与肩同宽站立。"
     }
    }
   }
  },
  "Zwiw7XR.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place an exercise ball behind you and position one foot on top of it, keeping your balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un fitball detrás de ti y apoya un pie encima, manteniendo el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti una palla fitness dietro di te e appoggia un piede sopra, tenendo l'equilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将健身瑜伽球置于身后，一只脚脚背搭在球上，收紧核心保持身体平衡。"
     }
    }
   }
  },
  "Zwiw7XR.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "With your arms fully extended and elbows close to your sides, curl one dumbbell towards your shoulder while keeping your upper arm stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos estirados del todo y los codos pegados al cuerpo, sube una mancuerna hacia el hombro manteniendo el brazo quieto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con le braccia completamente tese e i gomiti vicini ai fianchi, piega un manubrio verso la spalla tenendo fermo il braccio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂下垂微屈，大臂固定贴身，单手将哑铃弯举向肩部。"
     }
    }
   }
  },
  "Zwiw7XR.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the dumbbell back down to the starting position and repeat with the other arm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la mancuerna a la posición inicial y repite con el otro brazo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il manubrio fino alla posizione iniziale e ripeti con l'altro braccio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将哑铃下放回原位，然后换另一侧手臂重复。"
     }
    }
   }
  },
  "Zwiw7XR.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue alternating arms for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue alternando brazos durante las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad alternare le braccia per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "左右手臂交替进行，直至完成目标次数。"
     }
    }
   }
  },
  "HPlPoQA.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Hammer Curl (With Rope)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl martillo en polea con cuerda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl a martello al cavo con corda"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "绳索绳把锤式弯举"
     }
    }
   }
  },
  "HPlPoQA.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand upright with your feet shoulder-width apart and a slight bend in your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le ginocchia leggermente piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立站稳，双脚与肩同宽，双膝微屈。"
     }
    }
   }
  },
  "HPlPoQA.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the cable rope attachment with an underhand grip, palms facing each other, and your arms fully extended."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la cuerda de la polea con las palmas enfrentadas y los brazos estirados del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la corda del cavo con i palmi uno di fronte all'altro e le braccia completamente tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手对握绳索绳把（掌心相对），双臂充分向下伸直。"
     }
    }
   }
  },
  "HPlPoQA.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your upper arms stationary, exhale and curl the weights while contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos quietos, suelta el aire y sube el peso contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenendo ferme le braccia, espira e piega i pesi contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定在身体两侧，呼气收缩肱二头肌和肱肌向上弯举。"
     }
    }
   }
  },
  "HPlPoQA.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the cable rope attachment until your biceps are fully contracted and the rope is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo la cuerda hasta contraer el bíceps del todo, con la cuerda a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a sollevare la corda del cavo finché i bicipiti sono completamente contratti e la corda è alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "继续弯举直至肱二头肌充分收缩、绳把达到肩部高度。"
     }
    }
   }
  },
  "HPlPoQA.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per una breve pausa mentre stringi i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿，顶峰挤压二头肌，随后受控下放。"
     }
    }
   }
  },
  "xNrS20v.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Reverse Curl"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl inverso con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl inverso con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃反向弯举 (正握弯举)"
     }
    }
   }
  },
  "xNrS20v.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand up straight with your feet shoulder-width apart and hold a barbell with an overhand grip, palms facing down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra en pronación, con las palmas hacia abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto con i piedi alla larghezza delle spalle e tieni un bilanciere con presa prona, palmi rivolti in basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体直立，双脚与肩同宽，双手正握杠铃（掌心朝下）。"
     }
    }
   }
  },
  "xNrS20v.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your upper arms stationary and exhale as you curl the barbell upward, contracting your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos quietos y suelta el aire mientras subes la barra contrayendo el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni ferme le braccia ed espira mentre pieghi il bilanciere verso l'alto, contraendo i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持大臂固定贴身，呼气发力将杠铃向上弯举。"
     }
    }
   }
  },
  "xNrS20v.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue to raise the barbell until your biceps are fully contracted and the barbell is at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue subiendo la barra hasta contraer el bíceps del todo, con la barra a la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua a sollevare il bilanciere finché i bicipiti sono completamente contratti e il bilanciere è alle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "持续弯举直至手臂屈曲、二头肌及前臂肌群充分收缩，杠铃达到肩部高度。"
     }
    }
   }
  },
  "xNrS20v.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contracted position for a brief pause as you squeeze your biceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un instante en la contracción apretando el bíceps."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per una breve pausa mentre stringi i bicipiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩位置停顿片刻，用力收紧手臂肌肉。"
     }
    }
   }
  },
  "xNrS20v.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale as you slowly lower the barbell back to the starting position, keeping your upper arms stationary."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire mientras bajas la barra despacio a la posición inicial, con los brazos quietos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira mentre abbassi lentamente il bilanciere fino alla posizione iniziale, tenendo ferme le braccia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，保持大臂稳定，缓慢控制将杠铃下放回初始位置。"
     }
    }
   }
  },
  "J74XlNf.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Alternating Seated Bicep Curl on Exercise Ball"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl de bíceps sentado alterno en fitball"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl alternato da seduto su fitball"
     }
    },
    "zh": {
