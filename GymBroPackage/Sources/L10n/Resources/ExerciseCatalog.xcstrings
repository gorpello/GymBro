     }
    }
   }
  },
  "RqOtqD7.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your arms at your sides and your knees bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con los brazos a los lados y las rodillas flexionadas."
     }
    }
   }
  },
  "RqOtqD7.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your feet off the floor until your thighs are vertical."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levanta los pies del suelo hasta que los muslos queden verticales."
     }
    }
   }
  },
  "RqOtqD7.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl your hips up off the floor, bringing your knees towards your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega la cadera del suelo llevando las rodillas hacia el pecho."
     }
    }
   }
  },
  "RqOtqD7.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause at the top and squeeze your abs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta arriba apretando el abdomen."
     }
    }
   }
  },
  "RqOtqD7.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips slowly back to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio hasta el suelo."
     }
    }
   }
  },
  "qaZVsGk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Alternate Heel Touches"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Toque de talones alterno"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Toccate alternate ai talloni"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "交替触踵卷腹"
     }
    }
   }
  },
  "qaZVsGk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie flat on your back with your knees bent and feet flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le ginocchia piegate e i piedi ben piantati a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，屈膝，双脚平踩在地面上。"
     }
    }
   }
  },
  "qaZVsGk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your arms straight out to the sides, parallel to the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos a los lados, paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Estendi le braccia dritte ai lati, parallele al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂平放在身体两侧，略微悬空且与地面平行。"
     }
    }
   }
  },
  "qaZVsGk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engaging your abs, lift your shoulders off the ground and reach your right hand towards your right heel."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen, despega los hombros del suelo y lleva la mano derecha hacia el talón derecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attivando gli addominali, solleva le spalle da terra e porta la mano destra verso il tallone destro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧腹肌，将肩胛骨抬离地面，右手向右侧延伸去触摸右脚后跟。"
     }
    }
   }
  },
  "qaZVsGk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return to the starting position and repeat on the left side, reaching your left hand towards your left heel."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a la posición inicial y repite hacia la izquierda, llevando la mano izquierda al talón izquierdo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna alla posizione iniziale e ripeti sul lato sinistro, portando la mano sinistra verso il tallone sinistro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "还原至中间起始位置，接着向左侧伸出左手去触摸左脚后跟。"
     }
    }
   }
  },
  "qaZVsGk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Continue alternating sides for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sigue alternando lados durante las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Continua ad alternare i lati per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "左右两侧交替进行，保持节奏完成规定次数。"
     }
    }
   }
  },
