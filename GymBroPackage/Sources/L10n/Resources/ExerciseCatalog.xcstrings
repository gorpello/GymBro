      "state": "translated",
      "value": "绳索帕洛夫静力支撑"
     }
    }
   }
  },
  "cable-pallof-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand side-on to a cable machine set at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de lado a la polea puesta a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di lato rispetto a una macchina al cavo impostata all'altezza del petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧对绳索器械站立，滑轮高度调整至与胸同高。"
     }
    }
   }
  },
  "cable-pallof-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handle with both hands and press it straight out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el agarre con las dos manos y estíralo hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la maniglia con entrambe le mani e spingila dritta in fuori"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手合握把手，平直向前推出伸直手臂。"
     }
    }
   }
  },
  "cable-pallof-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock your arms and keep them level with your sternum."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bloquea los brazos y mantenlos a la altura del esternón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Blocca le braccia e tienile all'altezza dello sterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "锁住手臂，使其保持与胸骨平行的高度。"
     }
    }
   }
  },
  "cable-pallof-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Resist the cable pulling your torso around."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta sin dejar que el cable te gire el tronco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resisti al cavo che cerca di ruotare il tuo busto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧对抗横向旋转拉力，稳定身体姿势。"
     }
    }
   }
  },
  "cable-pallof-hold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the position, then swap sides and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la posición, cambia de lado y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione, poi cambia lato e ripeti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持该等长静力支撑姿态至规定时间，随后换侧重复。"
     }
    }
   }
  },
  "hollow-body-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hollow Body Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hollow hold"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenuta hollow body"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "静态空心支撑"
     }
    }
   }
  },
  "hollow-body-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your arms overhead and your legs straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con los brazos por encima de la cabeza y las piernas estiradas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le braccia sopra la testa e le gambe tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧平躺，双臂伸过头顶，双腿并拢伸直。"
     }
    }
   }
  },
  "hollow-body-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your lower back flat into the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aplasta la zona lumbar contra el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Schiaccia la zona lombare ben piatta contro il pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腹肌收缩，将下背部完全压平在地面上，消灭背部空隙。"
     }
    }
   }
  },
  "hollow-body-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your shoulders and legs a few centimetres off the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Despega hombros y piernas unos centímetros del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva spalle e gambe di pochi centimetri da terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将肩胛骨和双腿抬离地面数厘米。"
     }
    }
   }
  },
  "hollow-body-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your ribs down and your body in a shallow banana shape."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las costillas bajas y el cuerpo con forma de plátano."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le costole basse e il corpo a forma di banana poco accentuata"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肋骨下沉，身体形成形似浅香蕉的弧线（空心体位）。"
     }
    }
   }
  },
  "hollow-body-hold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the position and breathe steadily."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la posición respirando de forma constante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione e respira in modo regolare"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持该静力支撑姿态，平稳均匀呼吸。"
     }
    }
   }
  },
  "hollow-rock.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hollow Rock"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Balanceo hollow"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dondolo hollow"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "空心摇摆"
     }
    }
   }
  },
  "hollow-rock.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get into a hollow body position with your arms overhead."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en posición hollow con los brazos por encima de la cabeza."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Assumi una posizione di corpo cavo con le braccia sopra la testa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂过顶伸直，进入空心体位（香蕉形躯干）。"
     }
    }
   }
  },
  "hollow-rock.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your lower back glued to the floor and your body tense."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la lumbar pegada al suelo y el cuerpo en tensión."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la zona lombare incollata al pavimento e il corpo teso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下背部紧贴地面，全身肌群紧绷形成刚体。"
     }
    }
   }
  },
  "hollow-rock.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rock backwards and forwards using your shoulders, not your legs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Balancéate adelante y atrás desde los hombros, no con las piernas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dondola avanti e indietro usando le spalle, non le gambe"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "依靠核心与肩膀带动作前后摇摆，而不是依靠腿部甩动晃动。"
     }
    }
   }
  },
  "hollow-rock.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do not let your feet or hands touch the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No dejes que manos ni pies toquen el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non lasciare che piedi o mani tocchino terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "摇摆过程中手和脚始终保持悬空，不触碰地面。"
     }
    }
   }
  },
  "hollow-rock.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep the rocking small and steady."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz el balanceo corto y constante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni un dondolio piccolo e costante"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持小幅度且稳定匀速的摇摆节奏。"
     }
    }
   }
  },
