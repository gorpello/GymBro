  "flat-bench-cable-fly.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a handle in each hand with your arms open and palms facing up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un agarre con cada mano con los brazos abiertos y las palmas hacia arriba."
