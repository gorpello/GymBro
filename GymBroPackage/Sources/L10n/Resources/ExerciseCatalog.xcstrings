  },
  "cable-preacher-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a preacher bench in front of a low pulley with a short bar."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon un banco Scott delante de la polea baja con una barra corta."
     }
    }
   }
  },
  "cable-preacher-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rest your upper arms on the pad and hold the bar with your palms up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los brazos en la almohadilla y sujeta la barra con las palmas hacia arriba."
     }
    }
   }
  },
  "cable-preacher-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with your arms fully straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con los brazos estirados del todo."
     }
    }
   }
  },
  "cable-preacher-curl.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl the bar up towards your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la barra hacia la cabeza."
     }
    }
   }
  },
  "cable-preacher-curl.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower it slowly until your arms are straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájala despacio hasta volver a estirar los brazos."
     }
    }
   }
  },
  "cross-body-hammer-curl.name": {
   "extractionState": "manual",
   "localizations": {
