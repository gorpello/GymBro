     }
    }
   }
  },
  "reverse-grip-lat-pulldown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reverse-Grip Lat Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón al pecho con agarre supino"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lat machine presa inversa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "反握高位下拉"
     }
    }
   }
  },
  "reverse-grip-lat-pulldown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit at the pulldown with your thighs under the pad."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el jalón con los muslos bajo la almohadilla."
     }
    }
   }
  },
  "reverse-grip-lat-pulldown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab the bar with an underhand grip, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra con las palmas hacia ti y las manos a la anchura de los hombros."
     }
    }
   }
  },
  "reverse-grip-lat-pulldown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit tall with your abs tight and your chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate erguido con el abdomen firme y el pecho alto."
     }
    }
   }
  },
  "reverse-grip-lat-pulldown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the bar down to your upper chest, keeping your elbows close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra hasta la parte alta del pecho con los codos pegados al cuerpo."
     }
    }
   }
  },
  "reverse-grip-lat-pulldown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the bar rise slowly until your arms are straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja subir la barra despacio hasta estirar los brazos."
     }
    }
   }
  },
  "straight-arm-pulldown.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Straight-Arm Pulldown"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Jalón con brazos rectos"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pulldown a braccia tese"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "直臂下压"
     }
    }
   }
  },
  "straight-arm-pulldown.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Attach a straight bar or rope to a high pulley and step back from the stack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una barra recta o una cuerda en la polea alta y separa un paso de la torre."
     }
    }
   }
  },
  "straight-arm-pulldown.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the bar with straight arms at about eye level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra con los brazos estirados a la altura de los ojos."
     }
    }
   }
  },
  "straight-arm-pulldown.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hinge forward slightly at the hips and brace your core."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia delante desde la cadera y aprieta el abdomen."
     }
    }
   }
  },
  "straight-arm-pulldown.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sweep the bar down to your thighs, keeping your arms straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra en arco hasta los muslos sin doblar los brazos."
     }
    }
   }
  },
  "straight-arm-pulldown.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let the bar rise slowly back to eye level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja subir la barra despacio hasta la altura de los ojos."
     }
    }
   }
  },
  "pseudo-planche-push-up.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pseudo Planche Push-up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión pseudo plancha"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti pseudo planche"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "伪俄式挺身俯卧撑"
     }
    }
   }
  },
  "pseudo-planche-push-up.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set up in a push-up position with your hands beside your waist."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate en posición de flexión con las manos a la altura de la cintura."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in posizione di piegamento con le mani accanto alla vita."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "进入俯卧撑姿势，双手放在腰部两侧。"
     }
    }
   }
  },
  "pseudo-planche-push-up.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn your fingers out or back so your wrists stay comfortable."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira los dedos hacia fuera o hacia atrás para que las muñecas vayan cómodas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota le dita verso fuori o indietro per tenere i polsi comodi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手指朝外或朝后，让手腕更舒服。"
     }
    }
   }
  },
  "pseudo-planche-push-up.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean your shoulders forward past your hands and hold that lean."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Adelanta los hombros por delante de las manos y mantén esa inclinación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta le spalle in avanti oltre le mani e mantieni questa inclinazione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肩膀前移超过双手，并保持这个前倾角度。"
     }
    }
   }
  },
  "pseudo-planche-push-up.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your chest to the floor without letting your hips drop."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja el pecho al suelo sin dejar que caiga la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il petto a terra senza lasciare cadere il bacino."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "胸口下降贴近地面，髋部不要塌。"
     }
    }
   }
  },
  "pseudo-planche-push-up.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press back up while keeping the same forward lean."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para subir manteniendo la misma inclinación hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi per risalire mantenendo la stessa inclinazione in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持同样的前倾角度撑起身体。"
     }
    }
   }
  },
  "band-chest-fly.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Band Chest Fly"
