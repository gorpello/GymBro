     "stringUnit": {
      "state": "translated",
      "value": "L-sit en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环L型支撑"
     }
    }
   }
  },
  "rNGclsi.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the rings a little above the floor and jump into support with locked arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon las anillas un poco por encima del suelo y súbete al apoyo con los brazos bloqueados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将吊环调至离地微高处，双手撑环跳起，双臂伸直锁死。"
     }
    }
   }
  },
  "rNGclsi.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push down hard on the rings and lock your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja fuerte hacia abajo y bloquea los hombros."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "用力向下推压吊环，沉肩并锁紧肩部肌群。"
     }
    }
   }
  },
  "rNGclsi.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your legs until they are straight out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las piernas hasta dejarlas estiradas al frente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬高双腿，直至双腿在身体前方水平伸直。"
     }
    }
   }
  },
  "rNGclsi.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the position, breathing steadily, with your toes pointed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la posición respirando tranquilo y con las puntas estiradas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚尖绷直，保持平稳呼吸，维持该姿势。"
     }
    }
   }
  },
  "rNGclsi.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees to come out of it before your form breaks."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dobla las rodillas para salir antes de perder la postura."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作变形前，弯曲膝盖平稳退出支撑。"
     }
    }
   }
  },
  "rNGdsup.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Support Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sostén en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环静止支撑"
     }
    }
   }
  },
  "rNGdsup.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grip the rings and jump into support with your arms locked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las anillas y súbete al apoyo con los brazos bloqueados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "握紧吊环跳起进入支撑位，双臂伸直锁死。"
     }
    }
   }
  },
  "rNGdsup.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn the rings out so your palms face forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira las anillas hacia fuera para que las palmás miren al frente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向外翻转吊环，使掌心朝向正前方。"
     }
    }
   }
  },
  "rNGdsup.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulders down and squeeze your glutes and abs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los hombros y aprieta glúteos y abdomen."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下沉双肩，收紧臀部和腹部肌群。"
     }
    }
   }
  },
  "rNGdsup.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold still, without letting the rings wobble or drift."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta quieto, sin dejar que las anillas bailen."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体保持静止，对抗吊环的晃动与外移。"
     }
    }
   }
  },
  "rNGdsup.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step down before the shake gets the better of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájate antes de que el temblor pueda contigo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在力竭严重颤抖之前稳步落地。"
     }
    }
   }
  },
  "rNGemus.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Muscle-Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muscle-up en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环双力臂"
     }
    }
   }
  },
  "rNGemus.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from the rings with a false grip, wrists over the rings."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de las anillas con agarre falso, las muñecas por encima de las anillas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "采用深握（手腕搭在吊环上方）悬垂于环下。"
     }
    }
   }
  },
  "rNGemus.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull explosively, bringing the rings to your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira con fuerza llevando las anillas al pecho."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "爆发力发力向上拉起，将吊环拉向胸口部位。"
     }
    }
   }
  },
  "rNGemus.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean forward and roll your shoulders over the rings as you pass them."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante y pasa los hombros por encima de las anillas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "迅速前倾身体，将胸口推到吊环上方完成过渡翻转。"
     }
    }
   }
  },
  "rNGemus.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press out of the dip until your arms are locked in support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja para salir del fondo hasta bloquear los brazos en el apoyo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂发力向下推撑，直至手臂完全伸直锁死。"
     }
    }
   }
  },
  "rNGemus.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Come down the same way, under control, one step at a time."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja por el mismo camino, controlando cada paso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "受控缓慢下落还原，准备下一次动作。"
     }
    }
   }
  },
  "plank-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平板支撑"
     }
    }
   }
  },
  "plank-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your forearms on the floor, elbows under your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los antebrazos en el suelo con los codos bajo los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia gli avambracci a terra con i gomiti sotto le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前臂撑地，手肘位于肩膀正下方。"
     }
    }
   }
  },
  "plank-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step your feet back until your body is one straight line from head to heels."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva los pies atrás hasta que el cuerpo forme una línea recta de la cabeza a los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Porta i piedi indietro finché il corpo forma una linea dritta dalla testa ai talloni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚向后伸，让身体从头到脚跟成一条直线。"
     }
    }
   }
  },
  "plank-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes and brace your abs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos y el abdomen."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi glutei e addominali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧臀部和腹部。"
     }
    }
   }
  },
  "plank-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips level, neither sagging nor piked up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera nivelada, sin hundirla ni subirla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il bacino in linea, senza farlo cedere né alzarlo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持髋部水平，不要塌腰也不要撅起。"
     }
    }
   }
  },
  "plank-hold.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe steadily and hold for the time you set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira con calma y aguanta el tiempo que hayas puesto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira con calma e resisti per il tempo impostato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平稳呼吸，坚持设定的时间。"
     }
    }
   }
  },
  "bench-leg-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bench Leg Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de piernas en banco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sollevamento gambe su panca"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平凳举腿"
     }
    }
   }
  },
  "bench-leg-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on a flat bench with your legs hanging off the end from the knees down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate en un banco plano con las piernas fuera desde las rodillas."
     }
    }
   }
  },
  "bench-leg-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the sides of the bench behind your head or tuck your hands under your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra el banco por detrás de la cabeza o mete las manos bajo la cadera."
     }
    }
   }
  },
  "bench-leg-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your legs a few centimetres off the bench with your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levanta las piernas unos centímetros del banco con los pies juntos."
     }
    }
   }
  },
  "bench-leg-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your straight legs until they are almost vertical."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las piernas estiradas hasta dejarlas casi verticales."
     }
    }
   }
  },
  "bench-leg-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower them slowly without letting them touch the bench."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bájalas despacio sin que lleguen a tocar el banco."
     }
    }
   }
  },
  "side-plank-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Side Plank"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Plancha lateral"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Plank laterale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧平板支撑"
     }
    }
   }
  },
  "side-plank-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your side with your elbow under your shoulder and your legs stacked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate de lado con el codo bajo el hombro y las piernas juntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su un fianco con il gomito sotto la spalla e le gambe sovrapposte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧躺，手肘位于肩膀下方，双腿并拢。"
     }
    }
   }
  },
  "side-plank-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your hips until your body forms a straight line."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera hasta que el cuerpo quede en línea recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva il bacino finché il corpo forma una linea dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "抬起髋部，让身体成一条直线。"
     }
    }
   }
  },
  "side-plank-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your top hip stacked over the bottom one without rolling forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera de arriba encima de la de abajo, sin girarte hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'anca di sopra allineata a quella di sotto, senza ruotare in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上侧髋部保持在下侧正上方，不要向前翻。"
     }
    }
   }
  },
  "side-plank-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold, breathing steadily, then switch sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta respirando con calma y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resisti respirando con calma, poi cambia lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "平稳呼吸坚持，然后换边。"
     }
    }
   }
  },
  "cross-body-crunch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cross-Body Crunch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch cruzado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Crunch incrociato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "交叉卷腹"
     }
    }
   }
  },
  "cross-body-crunch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your knees bent and your feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies en el suelo."
     }
    }
   }
  },
  "cross-body-crunch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your hands lightly beside your head."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca las manos suavemente a los lados de la cabeza."
     }
    }
   }
  },
  "cross-body-crunch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Curl up and twist to bring one elbow towards the opposite knee."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube y gira para acercar un codo a la rodilla contraria."
     }
    }
   }
  },
  "cross-body-crunch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your abs as the elbow and knee meet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen cuando se junten el codo y la rodilla."
     }
    }
   }
  },
  "cross-body-crunch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower back down and repeat on the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja otra vez y repite hacia el otro lado."
     }
    }
   }
  },
  "dead-hang-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dead Hang"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colgarse de la barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Dead hang"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单杠悬垂"
     }
    }
   }
  },
  "dead-hang-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grab a pull-up bar with an overhand grip, hands shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra de dominadas en prono, con las manos al ancho de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra la sbarra con presa prona, mani alla larghezza delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正握单杠，双手与肩同宽。"
     }
    }
   }
  },
  "dead-hang-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your feet and hang with straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Levanta los pies y cuélgate con los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacca i piedi e resta appeso a braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚离地，手臂伸直悬挂。"
     }
    }
   }
  },
  "dead-hang-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your shoulders stretch while keeping a light brace in your abs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que los hombros se estiren manteniendo el abdomen algo firme."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia allungare le spalle tenendo l'addome leggermente contratto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "让肩部自然拉伸，腹部轻微收紧。"
     }
    }
   }
  },
  "dead-hang-hold.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for the time you set, then step down under control."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta el tiempo que hayas puesto y baja con control."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Resisti per il tempo impostato, poi scendi con controllo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坚持设定的时间，然后有控制地落地。"
     }
    }
   }
  },
  "outdoor-run.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Outdoor Run"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Correr"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Corsa"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "户外跑步"
     }
    }
   }
  },
  "outdoor-run.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start with five minutes of easy jogging to warm up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con cinco minutos de trote suave para calentar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inizia con cinque minuti di corsa leggera per scaldarti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "先慢跑五分钟热身。"
     }
    }
   }
  },
  "outdoor-run.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Run tall, with relaxed shoulders and a slight forward lean."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Corre erguido, con los hombros sueltos y el cuerpo algo inclinado hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Corri dritto, con le spalle rilassate e il busto appena in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体挺直，肩膀放松，身体略微前倾。"
     }
    }
   }
  },
  "outdoor-run.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Land under your hips with short, quick steps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya bajo la cadera, con zancadas cortas y rápidas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia sotto il bacino con passi corti e rapidi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "脚落在髋部下方，步子短而快。"
     }
    }
   }
  },
  "outdoor-run.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a pace you could hold a conversation at, unless it is an interval day."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva un ritmo al que puedas hablar, salvo que toque series."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un ritmo a cui riusciresti a parlare, tranne nei giorni di ripetute."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持能边跑边说话的配速，间歇训练日除外。"
     }
    }
   }
  },
  "outdoor-run.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish with a few minutes of walking."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acaba con unos minutos andando."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Chiudi con qualche minuto di camminata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "最后步行几分钟放松。"
     }
    }
   }
  },
  "outdoor-cycling.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Outdoor Cycling"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bici"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Bici"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "户外骑行"
     }
    }
   }
  },
  "outdoor-cycling.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the saddle so your knee stays slightly bent at the bottom of each pedal stroke."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el sillín para que la rodilla quede algo flexionada abajo del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la sella in modo che il ginocchio resti un po’ piegato in fondo alla pedalata."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整坐垫高度，让踏板踩到最低点时膝盖仍微屈。"
     }
    }
   }
  },
  "outdoor-cycling.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Start in an easy gear for the first few minutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empieza con un desarrollo suave los primeros minutos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Parti con un rapporto leggero per i primi minuti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "前几分钟用轻松的档位。"
     }
    }
   }
  },
  "outdoor-cycling.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep a smooth cadence instead of mashing the pedals."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén una cadencia fluida en vez de aplastar los pedales."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni una cadenza fluida invece di schiacciare i pedali."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持平稳的踏频，不要猛踩。"
     }
    }
   }
  },
  "outdoor-cycling.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shift early on climbs to keep the effort steady."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia de marcha antes de las subidas para que el esfuerzo sea constante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cambia rapporto prima delle salite per tenere lo sforzo costante."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上坡前提前换挡，让用力保持稳定。"
     }
    }
   }
  },
  "outdoor-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Caminar"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "步行"
     }
    }
   }
  },
  "outdoor-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk tall with your shoulders relaxed and your arms swinging."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Camina erguido, con los hombros sueltos y balanceando los brazos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina dritto, con le spalle rilassate e le braccia che oscillano."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体挺直，肩膀放松，手臂自然摆动。"
     }
    }
   }
  },
  "outdoor-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Roll through each step from heel to toe."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pisa de talón a punta en cada paso."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rulla ogni passo dal tallone alla punta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "每一步从脚跟滚动到脚尖。"
     }
    }
   }
  },
  "outdoor-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pick a pace that raises your breathing without leaving you out of breath."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elige un ritmo que te acelere la respiración sin dejarte sin aire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scegli un ritmo che acceleri il respiro senza lasciarti senza fiato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "选择能让呼吸加快但不会喘不过气的速度。"
     }
    }
   }
  },
  "outdoor-hike.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hiking"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Senderismo"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Escursionismo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "徒步"
     }
    }
   }
  },
  "outdoor-hike.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wear shoes with good grip and bring water."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva calzado con buen agarre y agua."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Indossa scarpe con buona presa e porta acqua."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "穿防滑的鞋子，带上水。"
     }
    }
   }
  },
  "outdoor-hike.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Shorten your stride on steep climbs and keep a steady rhythm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acorta el paso en las subidas fuertes y mantén un ritmo constante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Accorcia il passo nelle salite ripide e tieni un ritmo costante."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "陡坡时缩短步幅，保持稳定节奏。"
     }
    }
   }
  },
  "outdoor-hike.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean slightly into the slope going up and bend your knees going down."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia la pendiente al subir y flexiona las rodillas al bajar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "In salita inclinati un po’ verso il pendio, in discesa piega le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "上坡时身体略向坡面前倾，下坡时弯曲膝盖。"
     }
    }
   }
  },
  "outdoor-hike.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take short breaks before you are exhausted, not after."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz pausas cortas antes de estar agotado, no después."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai brevi pause prima di essere sfinito, non dopo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在筋疲力尽之前短暂休息，而不是之后。"
     }
    }
   }
  },
  "swim.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Swimming"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Natación"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Nuoto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "游泳"
     }
    }
   }
  },
  "swim.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Warm up with a few easy lengths."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Calienta con unos largos suaves."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scaldati con qualche vasca tranquilla."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "先轻松游几个来回热身。"
     }
    }
   }
  },
  "swim.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body long and flat, with your head in line with your spine."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo alargado y plano, con la cabeza alineada con la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il corpo lungo e piatto, con la testa in linea con la schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体伸展放平，头部与脊柱保持一条线。"
     }
    }
   }
  },
  "swim.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach forward on each stroke and pull the water back past your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira el brazo en cada brazada y empuja el agua hacia atrás hasta la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allunga il braccio a ogni bracciata e spingi l'acqua indietro oltre il bacino."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "每一划尽量向前伸，把水向后推过髋部。"
     }
    }
   }
  },
  "swim.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Breathe to the side in rhythm with your strokes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira de lado al ritmo de las brazadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Respira di lato a ritmo con le bracciate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "配合划水节奏侧身换气。"
     }
    }
   }
  },
  "swim.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Log the total distance and the time you spent swimming."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apunta la distancia total y el tiempo que has nadado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Segna la distanza totale e il tempo passato a nuotare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "记录总距离和游泳时长。"
     }
    }
   }
  },
  "leg-extension.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg Extension"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Extensión de cuádriceps en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg extension alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械腿屈伸"
     }
    }
   }
  },
  "leg-extension.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the backrest and ensure the machine axis of rotation aligns directly with the lateral side of your knee joint."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el respaldo para que el eje de la máquina quede a la altura del lateral de la rodilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola lo schienale in modo che l'asse della macchina sia allineato con il lato del ginocchio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整靠背，使器械的转轴与膝关节外侧对齐。"
     }
    }
   }
  },
  "leg-extension.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the side handles firmly, pull yourself down into the seat, and engage your core to lock your hips and pelvis in place."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra fuerte las asas laterales, pégate al asiento y aprieta el core para fijar la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Afferra bene le maniglie laterali, siediti a fondo e attiva il core per bloccare il bacino."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手紧握两侧把手，坐稳座椅，收紧核心固定髋部和骨盆。"
     }
    }
   }
  },
  "leg-extension.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Exhale as you extend your legs upward in a smooth, controlled motion by contracting your quadriceps."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suelta el aire mientras estiras las piernas hacia arriba en un movimiento suave y controlado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Espira mentre distendi le gambe verso l'alto con un movimento fluido e controllato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气，股四头肌发力，平稳可控地向上伸直双腿。"
     }
    }
   }
  },
  "leg-extension.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the fully extended position for 1–2 seconds at the top of the movement."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la extensión completa 1-2 segundos arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni la posizione di massima estensione per 1-2 secondi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在完全伸直的顶峰位置停留1-2秒。"
     }
    }
   }
  },
  "leg-extension.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Inhale as you slowly lower the weight back to the starting position over a 2- to 3-second cadence."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coge aire mientras bajas el peso despacio a la posición inicial, en 2-3 segundos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inspira mentre riporti lentamente il peso alla posizione iniziale in 2-3 secondi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吸气，用2-3秒缓慢将重量放回起始位置。"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Yuri's Shoulder Band Warmup"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Calentamiento de hombro con banda de Yuri"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riscaldamento spalle con elastico di Yuri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尤里肩部弹力带热身"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a light band overhead with your arms straight and your hands wider than your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta una banda ligera por encima de la cabeza con los brazos estirados y las manos más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna un elastico leggero sopra la testa con le braccia tese e le mani più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手比肩宽握住一条轻弹力带，手臂伸直举过头顶。"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the band apart and take your arms back and down behind you until they reach your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa la banda y lleva los brazos atrás y abajo hasta que lleguen a la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga l'elastico e porta le braccia indietro e in basso fino ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "拉开弹力带，让双臂向后向下绕到髋部位置。"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the band back overhead along the same path, keeping your elbows locked."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve la banda por el mismo camino hasta arriba, sin doblar los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta le braccia sopra la testa lungo lo stesso percorso, senza piegare i gomiti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿同样的路径把弹力带绕回头顶，全程保持肘部伸直。"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Widen your grip if your shoulders pinch, and narrow it as the movement gets easier."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre más el agarre si te pinza el hombro, y ciérralo a medida que el gesto te salga mejor."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga la presa se le spalle danno fastidio, e stringila man mano che il movimento diventa facile."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "如果肩膀有挤压感就握得更宽，动作变轻松后再逐渐收窄。"
     }
    }
   }
  },
  "yuris-shoulder-band-warmup.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Work through the whole sequence before you start the session."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Completa toda la secuencia antes de empezar la sesión."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Completa tutta la sequenza prima di iniziare l'allenamento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "训练开始前完整做完整套动作。"
     }
    }
   }
  },
  "wrist-prep.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Wrist Prep"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Preparación de muñecas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Preparazione dei polsi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手腕热身准备"
     }
    }
   }
  },
  "wrist-prep.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel with your palms flat on the floor and your fingers pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas con las palmas apoyadas en el suelo y los dedos hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in ginocchio con i palmi a terra e le dita rivolte in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿，双手掌心撑地，手指朝前。"
     }
    }
   }
  },
  "wrist-prep.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rock your weight gently forward and back to open the front of your wrists."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Balancea el peso adelante y atrás con suavidad para abrir la cara anterior de la muñeca."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sposta il peso avanti e indietro con delicatezza per aprire la parte anteriore dei polsi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "轻柔地前后移动重心，打开手腕前侧。"
     }
    }
   }
  },
  "wrist-prep.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Turn your hands so the fingers point back towards your knees and rock again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira las manos hasta que los dedos apunten a las rodillas y vuelve a balancear."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota le mani finché le dita puntano verso le ginocchia e ripeti il movimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "把手转到手指朝向膝盖的方向，再次前后移动重心。"
     }
    }
   }
  },
  "wrist-prep.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Flip onto the backs of your hands and press down lightly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dale la vuelta y apoya el dorso de las manos, presionando muy poco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Girati sul dorso delle mani e premi leggermente verso il basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "翻转手背贴地，轻轻向下施压。"
     }
    }
   }
  },
  "wrist-prep.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish with slow fist circles in both directions to warm the joint."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Termina con círculos lentos de puño en los dos sentidos para calentar la articulación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Chiudi con lente rotazioni dei pugni nei due sensi per scaldare le articolazioni."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "最后双手握拳，朝两个方向缓慢绕环热身关节。"
     }
    }
   }
  },
  "arch-hang.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Arch Hang"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Suspensión en arco"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sospensione in arco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "反弓悬垂"
     }
    }
   }
  },
  "arch-hang.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your palms facing away from you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de una barra con las palmas mirando hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi a una sbarra con i palmi rivolti in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "正手握住单杠悬垂，掌心朝前。"
     }
    }
   }
  },
  "arch-hang.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your shoulders down and away from your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los hombros y aléjalos de las orejas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa le spalle e allontanale dalle orecchie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下沉肩胛，让肩膀远离耳朵。"
     }
    }
   }
  },
  "arch-hang.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes and push your chest through so your body forms an arch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos y saca el pecho para que el cuerpo forme un arco."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei e spingi il petto in avanti così che il corpo formi un arco."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "夹紧臀部并把胸口顶出去，使身体形成一个反弓。"
     }
    }
   }
  },
  "arch-hang.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Look forward and keep your legs straight and together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mira al frente y mantén las piernas estiradas y juntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Guarda davanti a te e tieni le gambe tese e unite."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "目视前方，双腿伸直并拢。"
     }
    }
   }
  },
  "arch-hang.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the arch for as long as the routine asks for."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta el arco el tiempo que pida la rutina."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantieni l'arco per il tempo previsto dalla scheda."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按计划要求的时间保持这个反弓姿势。"
     }
    }
   }
  },
  "parallel-bar-support-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Parallel Bar Support Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sostén en paralelas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tenuta in appoggio alle parallele"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双杠支撑静止"
     }
    }
   }
  },
  "parallel-bar-support-hold.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grip the parallel bars and press yourself up to straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra las barras paralelas y súbete hasta tener los brazos estirados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna le parallele e spingiti su fino ad avere le braccia tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住双杠，把身体撑起到手臂伸直。"
     }
    }
   }
  },
  "parallel-bar-support-hold.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lock your elbows and push the bars down to lift your shoulders away from your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Bloquea los codos y empuja las barras hacia abajo para separar los hombros de las orejas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Blocca i gomiti e spingi le barre verso il basso per allontanare le spalle dalle orecchie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "锁定肘关节，向下压杠，让肩膀远离耳朵。"
     }
    }
   }
  },
  "parallel-bar-support-hold.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your body upright with your legs straight and together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el cuerpo recto con las piernas estiradas y juntas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
