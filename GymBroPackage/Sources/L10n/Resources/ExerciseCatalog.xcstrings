  "3eGE2JC.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Front Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevaciones frontales con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate frontali con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
