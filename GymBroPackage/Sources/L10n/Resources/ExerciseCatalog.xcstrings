  "rNG5pul.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Pull-Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环引体向上"
     }
    }
   }
  },
  "rNG5pul.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from the rings with your arms straight and palms facing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de las anillas con los brazos estirados y las palmás hacia delante."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "垂悬于吊环下方，双臂伸直，掌心朝前。"
     }
    }
   }
  },
  "rNG5pul.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set your shoulders down and away from your ears."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja los hombros y sepáralos de las orejas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下沉双肩，远离耳朵，收紧背部肌群。"
     }
    }
   }
  },
  "rNG5pul.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your chest towards the rings, turning your palms in as you rise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira del pecho hacia las anillas girando las palmás hacia dentro al subir."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向上拉起将胸部引向吊环，上升过程中自然外旋翻掌至掌心相对。"
     }
    }
   }
  },
  "rNG5pul.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Finish with the rings by your chest and your elbows tight to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Termina con las anillas junto al pecho y los codos pegados al cuerpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "拉至最高点时吊环贴近胸部，双肘紧贴身体两侧。"
     }
    }
   }
  },
  "rNG5pul.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower under control until your arms are straight again."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja controlando hasta estirar los brazos del todo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "受控平稳下落，直到双臂完全伸直。"
     }
    }
   }
  },
  "rNG6chi.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Ring Chin-Up"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Dominadas supinas en anillas"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "吊环反手引体向上"
     }
    }
   }
  },
  "rNG6chi.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from the rings with your palms turned towards you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de las anillas con las palmás mirándote."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手反握吊环悬垂，掌心朝向自己。"
     }
    }
   }
  },
  "rNG6chi.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your ribs down and your legs still."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén las costillas abajo y las piernas quietas."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "肋骨下沉，收紧核心，双腿保持静止不晃动。"
     }
    }
   }
  },
  "rNG6chi.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull yourself up by driving your elbows down to your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete llevando los codos hacia los costados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈肘向下向后发力，将身体向上拉起。"
     }
    }
   }
  },
  "rNG6chi.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get your chin over the rings without swinging."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Saca la barbilla por encima de las anillas sin balancearte."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将下巴拉至高过吊环，切忌摆荡借力。"
     }
    }
   }
  },
  "rNG6chi.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower slowly all the way to straight arms."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja despacio hasta dejar los brazos estirados."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢离心下落，直至双臂完全伸直。"
     }
    }
   }
  },
