  "belt-squat.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Strap the belt around your hips and stand on the platform."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte el cinturón en la cadera y súbete a la plataforma."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Aggancia la cintura ai fianchi e sali sulla pedana."
     }
    },
