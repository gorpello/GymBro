  "fZFZ704.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Russian Twist"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Giro ruso con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Twist russo zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重俄罗斯转体"
     }
    }
   }
  },
  "fZFZ704.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the ground with your knees bent and your feet flat on the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra con le ginocchia piegate e i piedi ben piantati al pavimento"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，屈膝，双脚平踩在地面（或微离地）。"
     }
    }
   }
  },
  "fZFZ704.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a weight or medicine ball with both hands in front of your chest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un peso o un balón medicinal con las dos manos delante del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un peso o una palla medica con entrambe le mani davanti al petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在胸前握住杠铃片或药球。"
     }
    }
   }
  },
  "fZFZ704.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly, keeping your back straight and your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate un poco hacia atrás, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati leggermente all'indietro, tenendo la schiena dritta e il core attivo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "躯干微微后倾，保持背部平直、核心收紧。"
     }
    }
   }
  },
  "fZFZ704.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly twist your torso to the right, bringing the weight or medicine ball towards the floor on your right side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira el tronco despacio a la derecha, llevando el peso hacia el suelo por ese lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota lentamente il busto verso destra, portando il peso o la palla medica verso il pavimento sul lato destro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腹斜肌发力缓慢将躯干向右转动，把重物或药球带到身体右侧地面旁。"
     }
    }
   }
  },
  "fZFZ704.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment, then twist your torso to the left, bringing the weight or medicine ball towards the floor on your left side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y gira el tronco a la izquierda, llevando el peso hacia el suelo por ese lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento, poi ruota il busto verso sinistra, portando il peso o la palla medica verso il pavimento sul lato sinistro"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，随后平稳向左侧旋转，将重物带至身体左侧地面旁。"
     }
    }
   }
  },
  "G7xoEzr.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Seated Knee Tuck"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimiento de rodillas sentado"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Knee tuck da seduto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐姿收腹举腿"
     }
    }
   }
  },
  "G7xoEzr.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the edge of a bench and hold the sides behind your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el borde de un banco y agárrate a los lados por detrás de la cadera."
     }
    }
   }
  },
  "G7xoEzr.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean back slightly and stretch your legs out in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Échate un poco hacia atrás y estira las piernas por delante."
     }
    }
   }
  },
  "G7xoEzr.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your knees towards your chest while bringing your torso forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva las rodillas hacia el pecho a la vez que acercas el tronco."
     }
    }
   }
  },
  "G7xoEzr.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your abs when your knees and chest meet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el abdomen cuando se junten las rodillas y el pecho."
     }
    }
   }
  },
  "G7xoEzr.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Extend your legs back out slowly without touching the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve a estirar las piernas despacio sin tocar el suelo."
     }
    }
   }
  },
  "6bOA1Oi.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Side Bend (On Stability Ball)"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexión lateral con lastre en fitball"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piegamenti laterali zavorrati su fitball"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "瑜伽球负重侧屈"
     }
    }
   }
  },
  "6bOA1Oi.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a stability ball with your feet shoulder-width apart and flat on the ground."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un fitball con los pies a la anchura de los hombros y apoyados en el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una palla fitness con i piedi alla larghezza delle spalle e ben piantati a terra"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在健身球上，双脚与肩同宽平踩地面以维持平衡。"
     }
    }
   }
  },
  "6bOA1Oi.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a weight in one hand and place your other hand on your hip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta un peso en una mano y pon la otra en la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un peso in una mano e metti l'altra mano sul fianco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单手持重物（哑铃或杠铃片），另一只手叉腰。"
     }
    }
   }
  },
  "6bOA1Oi.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and slowly bend sideways towards the weighted side, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core e inclínate despacio hacia el lado del peso, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e piegati lentamente di lato verso il lato con il peso, tenendo la schiena dritta"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心，背部平直，缓慢向持重物一侧倾斜侧屈。"
     }
    }
   }
  },
  "6bOA1Oi.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the bottom, then slowly return to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento abajo y vuelve despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa un momento in basso, poi torna lentamente alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在侧屈最低点停顿片刻，然后依靠对侧腹斜肌发力缓慢拉回直立姿态。"
     }
    }
   }
  },
  "6bOA1Oi.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions, then switch sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto, poi cambia lato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "完成目标次数后换另一侧进行。"
     }
    }
   }
  },
  "captains-chair-knee-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Captain's Chair Knee Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de rodillas en paralelas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sollevamento ginocchia alla sedia romana"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
