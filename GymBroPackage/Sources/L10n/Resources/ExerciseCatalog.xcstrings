  "v1qBec9.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Rear Lateral Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pájaros con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate posteriori con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃俯身侧平举"
     }
    }
   }
  },
  "v1qBec9.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a dumbbell in each hand, palms facing your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano, con las palmas hacia ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e tieni un manubrio in ogni mano con i palmi rivolti verso il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各持一只哑铃，掌心相对。"
     }
    }
   }
  },
  "v1qBec9.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees slightly and hinge forward at the hips, keeping your back straight and core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas e inclínate desde la cadera, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega leggermente le ginocchia e inclinati in avanti dai fianchi mantenendo la schiena dritta e il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "膝盖微屈，髋部向后屈曲俯身，保持背部平直，收紧核心。"
     }
    }
   }
  },
  "v1qBec9.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your arms out to the sides, keeping a slight bend in your elbows, until they are parallel to the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los brazos a los lados, con los codos algo flexionados, hasta dejarlos paralelos al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le braccia ai lati mantenendo i gomiti leggermente piegati fino a portarle parallele al pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手肘保持微屈，向身体两侧展臂抬起，直至上臂平行于地面。"
     }
    }
   }
  },
  "v1qBec9.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your arms back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los brazos despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente le braccia fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点挤压肩胛与后束并短暂停顿，然后缓慢控制下放哑铃回起始位置。"
     }
    }
   }
  },
  "v1qBec9.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "NJzBsGJ.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Shrug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimientos con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrollate con manubri"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃耸肩"
     }
    }
   }
  },
  "NJzBsGJ.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a dumbbell in each hand with your palms facing your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano, con las palmas hacia el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle e tieni un manubrio in ogni mano con i palmi rivolti verso il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各持一只哑铃垂于身体两侧，掌心朝向身体。"
     }
    }
   }
  },
  "NJzBsGJ.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and let the dumbbells hang by your sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos estirados y deja las mancuernas colgando a los lados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le braccia tese e lascia i manubri lungo i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂自然下垂伸直，哑铃悬于身体两侧。"
     }
    }
   }
  },
  "NJzBsGJ.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your shoulders as high as possible, as if you are trying to touch your ears with your shoulders."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los hombros todo lo que puedas, como si quisieras tocarte las orejas con ellos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva le spalle il più in alto possibile come se volessi toccare le orecchie con le spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽可能高地向上抬起双肩，仿佛要用肩膀去贴近耳朵。"
     }
    }
   }
  },
  "NJzBsGJ.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the contraction for a second, then slowly lower your shoulders back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta la contracción un segundo y baja los hombros despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la contrazione per un secondo, poi abbassa lentamente le spalle fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在顶峰收缩状态保持1秒，然后缓慢下沉肩膀回起始位置。"
     }
    }
   }
  },
  "NJzBsGJ.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "dG7tG5y.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Shrug"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encogimientos con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Scrollate con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃耸肩"
     }
    }
   }
  },
  "dG7tG5y.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and hold a barbell in front of you with an overhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y sujeta la barra delante de ti en pronación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, bilanciere davanti con presa prona."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手正握将杠铃置于身前。"
     }
    }
   }
  },
  "dG7tG5y.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your arms straight and your back straight throughout the exercise."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén los brazos y la espalda rectos durante todo el ejercicio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni braccia tese e schiena dritta per tutto l'esercizio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "整个动作过程中保持双臂自然伸直，背部保持挺直。"
     }
    }
   }
  },
  "dG7tG5y.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift your shoulders up towards your ears as high as possible, squeezing your traps at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los hombros hacia las orejas todo lo que puedas, apretando el trapecio arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alza le spalle verso le orecchie più in alto possibile, stringendo i trapezi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "尽力将双肩向耳朵方向耸起，在顶峰处大力收紧斜方肌。"
     }
    }
   }
  },
  "dG7tG5y.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for a moment, then slowly lower your shoulders back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento y baja los hombros despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un attimo, poi riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "稍作停顿，然后缓慢将双肩下放回起始位置。"
     }
    }
   }
  },
  "dG7tG5y.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "重复动作至建议的次数。"
     }
    }
   }
  },
  "ila4NZS.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco da terra con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃传统硬拉"
     }
    }
   }
  },
  "ila4NZS.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and the barbell on the ground in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y la barra en el suelo delante de ti."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e il bilanciere a terra davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，杠铃置于脚掌正上方地面上。"
     }
    }
   }
  },
  "ila4NZS.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees and hinge at the hips to lower your torso and grip the barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas e inclínate desde la cadera para bajar el tronco y agarrar la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega le ginocchia e il busto per impugnare il bilanciere con presa prona, mani poco più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝屈髋俯身下沉躯干，双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "ila4NZS.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your back straight and chest lifted as you drive through your heels to lift the barbell off the ground, extending your hips and knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la espalda recta y el pecho alto mientras empujas con los talones para despegar la barra del suelo, estirando cadera y rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con schiena dritta e petto alto, spingi sui talloni per staccare il bilanciere, stendendo anche e ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背部平直挺拔，挺胸沉肩，双脚脚跟用力蹬地将杠铃拉离地面，伸髋伸膝站直。"
     }
    }
   }
  },
  "ila4NZS.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you stand up straight, squeeze your glutes and keep your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Al terminar de pie, aprieta los glúteos y mantén el core activo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "In piedi, stringi i glutei e tieni il core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "站直身体时充分收缩臀部肌肉，全程收紧核心。"
     }
    }
   }
  },
  "ila4NZS.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell back down to the ground by bending at the hips and knees, keeping your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra al suelo flexionando cadera y rodillas, con la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riabbassa il bilanciere piegando anche e ginocchia, sempre con la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋屈膝将杠铃沿小腿顺势下放回地面，保持背部全程挺直。"
     }
    }
   }
  },
  "wQ2c4XD.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Romanian Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto rumano con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco rumeno con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃罗马尼亚硬拉"
     }
    }
   }
  },
  "wQ2c4XD.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and your toes pointing forward."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las puntas hacia delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le punte in avanti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，脚尖朝向正前方。"
     }
    }
   }
  },
  "wQ2c4XD.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, mani poco più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽站立持杠。"
     }
    }
   }
  },
  "wQ2c4XD.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend at the hips, keeping your back straight and your knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate desde la cadera, con la espalda recta y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega il busto in avanti dalle anche, schiena dritta e ginocchia appena piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋将臀部向后推，保持背部平直，膝盖微屈并保持固定角度。"
     }
    }
   }
  },
  "wQ2c4XD.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the barbell towards the ground, keeping it close to your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la barra hacia el suelo, manteniéndola pegada al cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa il bilanciere verso terra tenendolo vicino al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃贴着腿部向地面方向顺势下放。"
     }
    }
   }
  },
  "wQ2c4XD.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Feel the stretch in your hamstrings as you lower the barbell."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Nota el estiramiento en los isquios mientras bajas la barra."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Senti l'allungamento dei femorali mentre scendi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在下放杠铃过程中，充分感受大腿后侧腘绳肌的拉伸伸展。"
     }
    }
   }
  },
  "KgI0tqW.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Sumo Deadlift"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Peso muerto sumo con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stacco sumo con bilanciere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃相扑硬拉"
     }
    }
   }
  },
  "KgI0tqW.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet wider than shoulder-width apart, toes pointing outwards."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies más abiertos que los hombros y las puntas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi più larghi delle spalle, punte in fuori."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚站距明显宽于双肩，脚尖外展约30至45度。"
     }
    }
   }
  },
  "KgI0tqW.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place a barbell on the ground in front of you, centered between your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca la barra en el suelo delante de ti, centrada entre los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti il bilanciere a terra davanti a te, al centro tra i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将杠铃置于身体正前方的地面上，居于双脚正中心。"
     }
    }
   }
  },
  "KgI0tqW.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees and lower your hips, keeping your back straight and chest up, to grip the barbell with an overhand grip."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas y baja la cadera, con la espalda recta y el pecho alto, para agarrar la barra en pronación."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega le ginocchia e abbassa i fianchi, schiena dritta e petto alto, per impugnare la sbarra con presa prona."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝下沉髋部，保持背部平直挺拔、挺胸抬头，双手置于双腿内侧正握抓住杠铃杆。"
     }
    }
   }
  },
  "KgI0tqW.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and drive through your heels to lift the barbell off the ground, extending your hips and knees simultaneously."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y empuja con los talones para despegar la barra del suelo, estirando cadera y rodillas a la vez."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e spingi sui talloni per staccare, stendendo anche e ginocchia insieme."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心收紧收腹，双脚脚后跟用力蹬地拉起杠铃，同时充分伸展髋部和膝关节。"
     }
    }
   }
  },
  "KgI0tqW.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "As you lift, keep your chest up and back straight, and push your hips forward to fully engage your glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mientras subes, mantén el pecho alto y la espalda recta, y empuja la cadera hacia delante para activar bien los glúteos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mentre sali, tieni petto alto e schiena dritta, spingendo i fianchi avanti per strizzare i glutei."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "起身拉起过程中保持抬头挺胸、脊柱中立，顶峰处向前推送髋部以充分收缩臀大肌。"
     }
    }
   }
  },
  "eZyBC3j.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Barbell Bent Over Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo con barra"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore con bilanciere a busto flesso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "杠铃俯身划船"
     }
    }
   }
  },
  "eZyBC3j.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart and knees slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y las rodillas algo flexionadas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle e le ginocchia appena piegate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双膝微屈。"
     }
    }
   }
  },
  "eZyBC3j.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend forward at the hips while keeping your back straight and chest up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante desde la cadera, con la espalda recta y el pecho alto."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega il busto in avanti dalle anche, schiena dritta e petto alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向前俯身，保持背部平直、挺胸收腹。"
     }
    }
   }
  },
  "eZyBC3j.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Grasp the barbell with an overhand grip, hands slightly wider than shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agarra la barra en pronación, con las manos algo más abiertas que los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Impugna il bilanciere con presa prona, mani poco più larghe delle spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手正握杠铃，握距略宽于肩宽。"
     }
    }
   }
  },
  "eZyBC3j.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the barbell towards your lower chest by retracting your shoulder blades and squeezing your back muscles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira de la barra hacia la parte baja del pecho llevando las escápulas atrás y apretando la espalda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira il bilanciere verso il basso del petto, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "主动收缩背部肌群并向后收回肩胛骨，将杠铃拉向下胸或腹部上方。"
     }
    }
   }
  },
  "eZyBC3j.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the barbell back to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja la barra despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点顶峰收缩片刻，随后控制杠铃缓慢下放回起始位置。"
     }
    }
   }
  },
  "BJ0Hz5L.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Dumbbell Bent Over Row"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Remo con mancuernas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Rematore con manubri a busto flesso"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "哑铃俯身划船"
     }
    }
   }
  },
  "BJ0Hz5L.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, knees slightly bent, and hold a dumbbell in each hand with your palms facing your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros, las rodillas algo flexionadas y una mancuerna en cada mano, con las palmas hacia el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai in piedi con i piedi alla larghezza delle spalle, ginocchia appena piegate, un manubrio per mano con i palmi verso il corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，膝盖微屈，双手各握一只哑铃，掌心朝向身体。"
     }
    }
   }
  },
  "BJ0Hz5L.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend forward at the hips, keeping your back straight and your core engaged."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate hacia delante desde la cadera, con la espalda recta y el core apretado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega il busto in avanti dalle anche, schiena dritta e core attivo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈髋向前俯身，全程保持背部平直、核心收紧。"
     }
    }
   }
  },
  "BJ0Hz5L.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your arms hang straight down towards the floor, with your elbows slightly bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja los brazos colgando hacia el suelo, con los codos algo flexionados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia le braccia tese verso terra, gomiti appena piegati."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂自然下垂朝向地面，手肘保持微屈放松。"
     }
    }
   }
  },
  "BJ0Hz5L.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull the dumbbells up towards your chest, squeezing your shoulder blades together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube las mancuernas hacia el pecho juntando las escápulas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tira i manubri verso il petto, stringendo le scapole."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "背肌发力向后收缩肩胛骨，将哑铃向上拉向胸腹两侧。"
     }
    }
   }
  },
  "BJ0Hz5L.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower the dumbbells back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pausa in alto, poi riabbassa lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿充分挤压背部，然后缓慢将哑铃下放回起始位置。"
     }
    }
   }
  },
  "r0z6xzQ.name": {
   "extractionState": "manual",
   "localizations": {
