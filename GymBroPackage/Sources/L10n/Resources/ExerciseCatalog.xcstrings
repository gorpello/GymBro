      "value": "Hip airplane"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿髋旋转飞机式"
     }
    }
   }
  },
  "hip-airplane.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on one leg and hinge forward with the other leg back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte sobre una pierna e inclínate hacia delante con la otra estirada atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti su una gamba e inclinati in avanti con laltra gamba dietro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "单腿站立，屈髋前倾，非支撑腿向后伸展保持平衡。"
     }
    }
   }
  },
  "hip-airplane.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Reach your arms out to the sides for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre los brazos en cruz para mantener el equilibrio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Allarga le braccia ai lati per lequilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂向身体两侧展开以辅助维持稳定。"
     }
    }
   }
  },
  "hip-airplane.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate your hips open towards the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gira la cadera abriéndola hacia el techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruota i fianchi aprendoli verso il soffitto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "以支撑腿髋关节为轴，向外旋转打开髋部朝向天花板。"
     }
    }
   }
  },
  "hip-airplane.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Rotate them back the other way until they face the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Gírala en sentido contrario hasta ponerla mirando al suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ruotali indietro dall'altro lato finché guardano il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再将髋部向内旋转闭合，直至骨盆完全平行朝向地面。"
     }
    }
   }
  },
  "hip-airplane.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Move slowly and keep the standing knee soft."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Muévete despacio y mantén la rodilla de apoyo algo flexionada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Muoviti lentamente e tieni morbido il ginocchio dappoggio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "动作全程缓慢受控，保持支撑膝微屈不锁死。"
     }
    }
   }
  },
  "side-lying-leg-raise.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Side-Lying Leg Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación lateral de pierna"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Alzate di gamba da sdraiato sul fianco"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧卧侧抬腿"
     }
    }
   }
  },
  "side-lying-leg-raise.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your side with your legs stacked and straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate de lado con las piernas estiradas y apiladas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati su un fianco con le gambe sovrapposte e tese."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧卧在垫上，双腿伸直上下叠放。"
     }
    }
   }
  },
  "side-lying-leg-raise.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Support your head with your bottom arm."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la cabeza en el brazo de abajo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sostieni la testa con il braccio inferiore."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "下侧手臂托住头部作为支撑。"
     }
    }
   }
  },
  "side-lying-leg-raise.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift the top leg towards the ceiling."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la pierna de arriba hacia el techo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva la gamba superiore verso il soffitto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干稳定，将上侧腿向天花板方向笔直抬起。"
     }
    }
   }
  },
  "side-lying-leg-raise.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your toes pointing forward, not up."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la punta del pie mirando al frente, no hacia arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni le punte rivolte in avanti, non in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持脚尖始终指向正前方，避免朝向天花板外旋。"
     }
    }
   }
  },
  "side-lying-leg-raise.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the leg slowly without letting it rest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la pierna despacio sin dejarla descansar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente la gamba senza farla appoggiare."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢下放腿部，不完全放松落地即可进入下一次动作。"
     }
    }
   }
  },
  "banded-glute-bridge.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Glute Bridge"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de glúteos con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte glutei con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带臀桥"
     }
    }
   }
  },
  "banded-glute-bridge.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a short band just above your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda corta justo por encima de las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico corto appena sopra le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将迷你弹力环套在双膝稍上方位置。"
     }
    }
   }
  },
  "banded-glute-bridge.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lie on your back with your knees bent and your feet flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Túmbate boca arriba con las rodillas flexionadas y los pies apoyados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sdraiati sulla schiena con le ginocchia piegate e i piedi piantati a terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "仰卧在垫上，屈膝双脚平踩地面。"
     }
    }
   }
  },
  "banded-glute-bridge.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your knees out against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las rodillas hacia fuera contra la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le ginocchia verso lesterno contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝向外对抗弹力带张力。"
     }
    }
   }
  },
  "banded-glute-bridge.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drive through your heels to lift your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera empujando con los talones."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sui talloni per sollevare i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚后跟蹬地发力，将髋部向上顶起。"
     }
    }
   }
  },
  "banded-glute-bridge.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes at the top and lower slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos arriba y baja despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei in alto e abbassati lentamente."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点顶峰收缩臀肌，随后缓慢下放。"
     }
    }
   }
  },
  "banded-hip-thrust.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Hip Thrust"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Hip thrust con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带臀推"
     }
    }
   }
  },
  "banded-hip-thrust.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit with your upper back on a bench and a band around your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate con la parte alta de la espalda en un banco y una banda sobre la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti con la parte alta della schiena su una panca e un elastico intorno ai fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，上背部靠在长凳边缘，将弹力带横跨套在髋部上方。"
     }
    }
   }
  },
  "banded-hip-thrust.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor both ends of the band under your feet or to the rack."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija los dos extremos de la banda bajo los pies o al rack."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa entrambe le estremità dell'elastico sotto i piedi o al rack."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带两端固定在双脚下或深蹲架立柱上。"
     }
    }
   }
  },
  "banded-hip-thrust.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips up against the band's pull."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube la cadera venciendo la tensión de la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi verso lalto contro la resistenza dell'elastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "挺髋发力对抗弹力带阻力向上推起。"
     }
    }
   }
  },
  "banded-hip-thrust.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes when your body is level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos cuando el cuerpo quede en línea."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei quando il corpo è in linea."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作最高点充分挤压收缩臀大肌，身体成一直线。"
     }
    }
   }
  },
  "banded-hip-thrust.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower your hips slowly without losing the tension."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la cadera despacio sin perder la tensión."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente i fianchi senza perdere la tensione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制核心并缓慢下放髋部，重复动作。"
     }
    }
   }
  },
  "banded-frog-pump.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Frog Pump"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Puente de rana con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Frog pump con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带蛙式臀推"
     }
    }
   }
  },
  "banded-frog-pump.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band above your knees and lie on your back."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda por encima de las rodillas y túmbate boca arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico sopra le ginocchia e sdraiati sulla schiena."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双膝稍上方，仰卧在垫上。"
     }
    }
   }
  },
  "banded-frog-pump.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put the soles of your feet together and let your knees fall open."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Junta las plantas de los pies y deja caer las rodillas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Unisci le piante dei piedi e lascia aprire le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚脚底并拢合十，双膝向两侧自然打开。"
     }
    }
   }
  },
  "banded-frog-pump.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press your knees out against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja las rodillas contra la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le ginocchia verso lesterno contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝持续向外撑开对抗弹力带阻力。"
     }
    }
   }
  },
  "banded-frog-pump.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glutes to lift your hips off the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta los glúteos para despegar la cadera del suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi i glutei per sollevare i fianchi da terra."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "臀大肌发力挤压，将髋部抬离地面。"
     }
    }
   }
  },
  "banded-frog-pump.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower under control and go straight into the next rep."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja con control y encadena la siguiente repetición."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassati in modo controllato e passa subito alla ripetizione dopo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "控制核心平稳下落，随即进行下一次动作。"
     }
    }
   }
  },
  "banded-clamshell.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Clamshell"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Almeja con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Clamshell con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带蚌式开合"
     }
    }
   }
  },
  "banded-clamshell.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band above your knees and lie on your side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda por encima de las rodillas y túmbate de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico sopra le ginocchia e sdraiati su un fianco."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双膝稍上方，身体侧卧在垫上。"
     }
    }
   }
  },
  "banded-clamshell.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees and stack your feet."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona las rodillas y mantén los pies juntos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega le ginocchia e sovrapponi i piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "屈膝约90度，双脚脚后跟紧贴叠放。"
     }
    }
   }
  },
  "banded-clamshell.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Open the top knee against the band without rolling your hips."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abre la rodilla de arriba contra la banda sin girar la cadera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Apri il ginocchio superiore contro lelastico senza ruotare i fianchi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚保持接触，发力对抗弹力带将上侧膝盖打开。"
     }
    }
   }
  },
  "banded-clamshell.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold for a second at the top."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un segundo arriba."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni un secondo in alto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点保持顶峰收缩1秒钟。"
     }
    }
   }
  },
  "banded-clamshell.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Close the knee slowly and keep the tension."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cierra la rodilla despacio sin perder la tensión."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Richiudi lentamente il ginocchio mantenendo la tensione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢并拢膝盖，全程维持弹力带的对抗张力。"
     }
    }
   }
  },
  "banded-lateral-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Lateral Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Paso lateral con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata laterale con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带侧向行走"
     }
    }
   }
  },
  "banded-lateral-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Put a band around your legs, just above the knees or at the ankles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Coloca una banda alrededor de las piernas, por encima de las rodillas o en los tobillos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico intorno alle gambe, appena sopra le ginocchia o alle caviglie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双腿膝盖上方或脚踝处。"
     }
    }
   }
  },
  "banded-lateral-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bend your knees slightly and push them out against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Flexiona un poco las rodillas y empújalas hacia fuera contra la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Piega leggermente le ginocchia e spingile verso lesterno contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "微屈双膝呈半蹲姿态，膝盖向外撑开弹力带。"
     }
    }
   }
  },
  "banded-lateral-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step sideways without letting your feet come together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da pasos laterales sin dejar que los pies se junten."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai passi laterali senza far toccare i piedi tra loro."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "向侧方迈步，迈出时保持双脚始终分开有张力。"
     }
    }
   }
  },
  "banded-lateral-walk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take several steps in one direction."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Haz varios pasos en una dirección."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai diversi passi in una direzione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "沿同一方向连续横向走动数步。"
     }
    }
   }
  },
  "banded-lateral-walk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk back the other way to finish the set."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Vuelve andando hacia el otro lado para terminar la serie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Torna indietro dall'altro lato per finire la serie."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "再反方向沿原路横向走回以完成一组训练。"
     }
    }
   }
  },
  "banded-monster-walk.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Monster Walk"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Monster walk con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Camminata monster con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带怪兽步"
     }
    }
   }
  },
  "banded-monster-walk.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band around your ankles and get into a quarter squat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda en los tobillos y ponte en media sentadilla."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico intorno alle caviglie e abbassati in un quarto di squat."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双脚脚踝周围，进入四分之一深蹲姿势。"
     }
    }
   }
  },
  "banded-monster-walk.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep tension on the band by pushing your knees out."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la tensión empujando las rodillas hacia fuera."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni in tensione lelastico spingendo le ginocchia verso lesterno."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双膝向外顶开，始终保持弹力带处于紧绷状态。"
     }
    }
   }
  },
  "banded-monster-walk.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step forward and out at a diagonal with one foot."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da un paso adelante y en diagonal con un pie."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai un passo in avanti e in diagonale con un piede."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "一只脚向前并呈对角线向外迈出一步。"
     }
    }
   }
  },
  "banded-monster-walk.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat with the other foot, staying low."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite con el otro pie sin levantarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti con laltro piede, restando basso."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持低重心姿势，另一只脚同样斜向外迈出。"
     }
    }
   }
  },
  "banded-monster-walk.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Walk forwards, then walk backwards the same way."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Anda hacia delante y luego vuelve hacia atrás igual."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Cammina in avanti, poi torna indietro allo stesso modo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "先向前行进一定步数，随后以相同动作向后倒退走回。"
     }
    }
   }
  },
  "banded-donkey-kick.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Donkey Kick"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Patada de glúteo con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey kick con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带跪姿后踢"
     }
    }
   }
  },
  "banded-donkey-kick.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band around one foot and hold the other end under your hands."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pasa una banda por un pie y sujeta el otro extremo bajo las manos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico intorno a un piede e tieni laltra estremità sotto le mani."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带一端套在一侧脚底，另一端双手按在垫上固定。"
     }
    }
   }
  },
  "banded-donkey-kick.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Get on all fours with your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte a cuatro patas con la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti a quattro zampe con la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "俯身呈四足跪姿，保持背部平直。"
     }
    }
   }
  },
  "banded-donkey-kick.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push the banded foot up towards the ceiling with the knee bent."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja el pie de la banda hacia el techo con la rodilla flexionada."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi il piede con lelastico verso il soffitto con il ginocchio piegato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "套带脚屈膝发力，将后脚跟朝天花板方向蹬起。"
     }
    }
   }
  },
  "banded-donkey-kick.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute at the top of the kick."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo arriba del todo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo in alto nel calcio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在蹬至最高点时充分挤压收缩臀大肌。"
     }
    }
   }
  },
  "banded-donkey-kick.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the knee back down slowly against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla despacio venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta il ginocchio in basso lentamente contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对抗弹力带回弹阻力，缓慢将膝盖收回。"
     }
    }
   }
  },
  "banded-fire-hydrant.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Fire Hydrant"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción a cuatro patas con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fire hydrant con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带消防栓式外展"
     }
    }
   }
  },
  "banded-fire-hydrant.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band above your knees and get on all fours."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda por encima de las rodillas y ponte a cuatro patas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico sopra le ginocchia e mettiti a quattro zampe."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双膝稍上方，呈四足跪姿支撑。"
     }
    }
   }
  },
  "banded-fire-hydrant.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips level and your back flat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera nivelada y la espalda plana."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i fianchi in linea e la schiena piatta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持骨盆水平稳定，背部平直收紧核心。"
     }
    }
   }
  },
  "banded-fire-hydrant.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift one knee out to the side against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una rodilla hacia el lado venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva un ginocchio lateralmente contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对抗弹力带阻力，将一侧膝盖向侧上方抬起。"
     }
    }
   }
  },
  "banded-fire-hydrant.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Do not let your torso lean to the other side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "No dejes que el tronco se incline hacia el otro lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Non lasciare che il busto si inclini dall'altro lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "避免躯干向对侧过度代偿倾斜。"
     }
    }
   }
  },
  "banded-fire-hydrant.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lower the knee slowly and keep the band under tension."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la rodilla despacio manteniendo la banda tensa."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente il ginocchio tenendo lelastico in tensione."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢有控制地下放膝盖，全程保持弹力带张力。"
     }
    }
   }
  },
  "banded-kickback.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Kickback"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Patada atrás con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Slancio indietro con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带站姿后踢"
     }
    }
   }
  },
  "banded-kickback.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Anchor a band low and loop the free end around one ankle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Fija una banda a poca altura y pasa el extremo libre por un tobillo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fissa un elastico in basso e avvolgi l'estremità libera intorno a una caviglia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带一端固定在低处支架，另一端套在一侧脚踝上。"
     }
    }
   }
  },
  "banded-kickback.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand facing the anchor and hold something for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Colócate de frente al anclaje y agárrate a algo para equilibrarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti di fronte al punto di fissaggio e tieniti a qualcosa per lequilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "面向固定点站立，双手扶稳支撑物以保持平衡。"
     }
    }
   }
  },
  "banded-kickback.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kick the banded leg straight back, keeping it long."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lleva la pierna de la banda recta hacia atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calcia indietro la gamba con lelastico ben tesa, tenendola lunga."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "发力腿伸直，向身体正后方笔直踢出。"
     }
    }
   }
  },
  "banded-kickback.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze your glute at the end of the kick."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo al final del recorrido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo alla fine del calcio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在后踢终点充分挤压收缩臀部肌肉。"
     }
    }
   }
  },
  "banded-kickback.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the leg forward slowly against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve la pierna despacio venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta la gamba in avanti lentamente contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "对抗弹力带拉力，缓慢将腿收回前方。"
     }
    }
   }
  },
  "banded-standing-hip-abduction.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Standing Hip Abduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción de pie con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abduzioni d'anca in piedi con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带站姿髋外展"
     }
    }
   }
  },
  "banded-standing-hip-abduction.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Loop a band around both ankles and stand tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Pon una banda en los dos tobillos y ponte erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Metti un elastico intorno a entrambe le caviglie e stai dritto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将弹力带套在双脚脚踝周围，直立站好。"
     }
    }
   }
  },
  "banded-standing-hip-abduction.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a wall or a rack for balance."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apóyate en una pared o un rack para equilibrarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieniti a un muro o a un rack per lequilibrio."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶墙或深蹲架以保持身体稳定平衡。"
     }
    }
   }
  },
  "banded-standing-hip-abduction.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lift one leg straight out to the side against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube una pierna recta hacia el lado venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva una gamba tesa lateralmente contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持躯干笔直，发力腿向外侧方笔直抬起对抗阻力。"
     }
    }
   }
  },
  "banded-standing-hip-abduction.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your torso upright and your hips square."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el tronco erguido y la cadera de frente."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il busto dritto e i fianchi in linea."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持上半身挺立，骨盆朝向正前方不歪斜。"
     }
    }
   }
  },
  "banded-standing-hip-abduction.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Bring the leg back in slowly and repeat."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la pierna despacio y repite."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta la gamba dentro lentamente e ripeti."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢将腿收回原位，重复动作。"
     }
    }
   }
  },
  "banded-seated-hip-abduction.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Banded Seated Hip Abduction"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Abducción sentado con banda"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abduzioni d'anca da seduto con elastico"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "弹力带坐姿髋外展"
     }
    }
   }
  },
  "banded-seated-hip-abduction.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on a bench with a band looped above your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en un banco con una banda por encima de las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti su una panca con un elastico sopra le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在长凳边缘，将弹力带套在双膝稍上方。"
     }
    }
   }
  },
  "banded-seated-hip-abduction.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Plant your feet and keep your back straight."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya los pies y mantén la espalda recta."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Pianta i piedi e tieni la schiena dritta."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚踩实地面，保持背部挺拔。"
     }
    }
   }
  },
  "banded-seated-hip-abduction.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your knees apart against the band."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Separa las rodillas venciendo la banda."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi le ginocchia verso lesterno contro lelastico."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双腿对抗弹力带阻力，发力将双膝向两侧推开。"
     }
    }
   }
  },
  "banded-seated-hip-abduction.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the open position for a second."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un segundo con las rodillas abiertas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione aperta per un secondo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在外展最大幅度处停顿保持1秒。"
     }
    }
   }
  },
  "banded-seated-hip-abduction.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your knees come back together slowly."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja que las rodillas se junten despacio."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia riavvicinare lentamente le ginocchia."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "缓慢让双膝回拢复原。"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneeling Hip Flexor Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de psoas de rodillas"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch flessori d'anca in ginocchio"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "跪姿髋屈肌拉伸"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on one knee with the other foot flat in front of you."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas sobre una pierna con el otro pie apoyado delante."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in ginocchio con un ginocchio a terra e laltro piede piantato davanti a te."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "采取单膝跪地姿势，另一只脚向前平踩在地面上。"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Tuck your hips under so your lower back flattens."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mete la cadera para aplanar la zona lumbar."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclina i fianchi sotto di te così che la zona lombare si appiattisca."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "骨盆后倾微收，使下背部趋于平整。"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push your hips forward until you feel the front of the back thigh stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja la cadera hacia delante hasta notar el estiramiento en el muslo de atrás."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi i fianchi in avanti finché senti allungarsi la parte anteriore della coscia posteriore."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "髋部向前推移，直至后腿大腿前侧及腹股沟产生明显拉伸感。"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your chest tall and your shoulders relaxed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén el pecho alto y los hombros relajados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni il petto alto e le spalle rilassate."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "保持胸腔挺起，双肩自然下沉放松。"
     }
    }
   }
  },
  "kneeling-hip-flexor-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold, then swap sides."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta y cambia de lado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la posizione, poi cambia lato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "维持拉伸动作一段时间，随后换另一侧进行。"
     }
    }
   }
  },
  "butterfly-stretch.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Butterfly Stretch"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estiramiento de mariposa"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stretch farfalla"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "蝴蝶式拉伸"
     }
    }
   }
  },
  "butterfly-stretch.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the floor and bring the soles of your feet together."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en el suelo y junta las plantas de los pies."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti a terra e unisci le piante dei piedi."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐在地面上，双脚脚底相对并拢。"
     }
    }
   }
  },
  "butterfly-stretch.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pull your heels in towards your body."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Acerca los talones hacia el cuerpo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Avvicina i talloni al corpo."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手拉住双脚，将脚后跟尽量贴近腹股沟。"
     }
    }
   }
  },
  "butterfly-stretch.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold your feet with both hands and sit up tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta los pies con las dos manos y ponte erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni i piedi con entrambe le mani e stai dritto con il busto."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手握住脚部，坐立挺直脊柱。"
     }
    }
   }
  },
  "butterfly-stretch.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Let your knees fall out towards the floor."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Deja caer las rodillas hacia el suelo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Lascia cadere le ginocchia verso il pavimento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "呼气时让双膝自然向地面方向下沉放松。"
     }
    }
   }
  },
  "butterfly-stretch.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lean forward gently and hold the stretch."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclínate un poco hacia delante y aguanta el estiramiento."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inclinati delicatamente in avanti e tieni lallungamento."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体轻柔地从髋部向前微倾，保持静态拉伸。"
     }
    }
   }
  },
  "stair-climber.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stair Climber"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Simulador de escaleras"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stair climber"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "爬梯机训练"
     }
    }
   }
  },
  "stair-climber.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Step onto the stair machine and start it at a slow speed."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Súbete a la máquina de escaleras y arráncala a poca velocidad."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sali sulla macchina per le scale e avviala a bassa velocità"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踏上爬梯机台阶，以慢速启动设备。"
     }
    }
   }
  },
  "stair-climber.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand upright and rest your hands lightly on the rails."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte erguido y apoya las manos suavemente en las barras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stai dritto in piedi e appoggia leggermente le mani sulle sbarre"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "身体保持挺直，双手轻扶在安全扶手两侧。"
     }
    }
   }
  },
  "stair-climber.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Take full steps instead of short, bouncy ones."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Da pasos completos en vez de pasitos con rebote."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai passi completi invece di passi corti e saltellanti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "全脚掌充分踩踏台阶，避免过短且快速颠簸的浅踏步。"
     }
    }
   }
  },
  "stair-climber.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Push through your heel on every step to use the glutes."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Empuja con el talón en cada escalón para usar el glúteo."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi sul tallone a ogni passo per usare i glutei"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "每一步均以后脚跟踩蹬发力，以充分激活臀部肌群。"
     }
    }
   }
  },
  "stair-climber.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Drop the speed before you step off."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja la velocidad antes de bajarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riduci la velocità prima di scendere"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "训练结束离机前务必先降低设备运行速度并停机。"
     }
    }
   }
  },
  "IeDEXTe.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Leg Press Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos en prensa"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf alla leg press"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "腿举机提踵"
     }
    }
   }
  },
  "IeDEXTe.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the seat of the leg press machine so that your knees are slightly bent when your feet are on the footplate."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta el asiento de la prensa para que las rodillas queden algo flexionadas con los pies en la plataforma."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola il sedile della leg press così che le ginocchia siano leggermente piegate quando i piedi sono sulla pedana"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "调整腿举机座椅位置，确保双脚置于脚踏板上时双膝微屈。"
     }
    }
   }
  },
  "IeDEXTe.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Sit on the machine with your back against the backrest and your feet flat on the footplate, shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Siéntate en la máquina con la espalda contra el respaldo y los pies apoyados en la plataforma, a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Siediti alla macchina con la schiena contro lo schienale e i piedi sulla pedana alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "坐上器械，背部贴紧靠背，双脚与肩同宽平放在脚踏板上。"
     }
    }
   }
  },
  "IeDEXTe.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your toes and the balls of your feet on the footplate, keeping your heels off the edge."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya la punta de los pies en la plataforma, con los talones fuera del borde."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia le punte e gli avampiedi sulla pedana tenendo i talloni fuori dal bordo"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将前脚掌踩在踏板下边缘，脚后跟悬空。"
     }
    }
   }
  },
  "IeDEXTe.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Release the safety handles and push the footplate away from you by extending your knees."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Quita los seguros y empuja la plataforma estirando las rodillas."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Sgancia le sicure e spingi la pedana lontano da te estendendo le ginocchia"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "打开安全把手，伸直双腿将踏板推开并保持微屈膝不锁死。"
     }
    }
   }
  },
  "IeDEXTe.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Once your knees are fully extended, slowly lower your heels by flexing your calves."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con las rodillas estiradas del todo, baja los talones despacio flexionando los gemelos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Una volta estese del tutto le ginocchia, abbassa lentamente i talloni flettendo i polpacci"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "膝关节保持稳定，小腿肌群受控离心收缩缓慢下放脚后跟进行拉伸。"
     }
    }
   }
  },
  "LmaFNZS.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Weighted Donkey Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos tipo burro con lastre"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Donkey calf zavorrato"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "负重驴式提踵"
     }
    }
   }
  },
  "LmaFNZS.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand on a raised platform with your toes on the edge and your heels hanging off."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte en una plataforma elevada con la punta de los pies en el borde y los talones al aire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti su una pedana rialzata con le punte sul bordo e i talloni fuori"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚前脚掌站在垫高平台上，脚后跟完全悬空。"
     }
    }
   }
  },
  "LmaFNZS.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold onto a stable object for support."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Agárrate a algo estable para sujetarte."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieniti a un sostegno stabile per supporto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手扶住稳定的支撑物以辅助保持身体平衡。"
     }
    }
   }
  },
  "LmaFNZS.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Raise your heels as high as possible by extending your ankles."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sube los talones todo lo que puedas estirando los tobillos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Solleva i talloni più in alto possibile estendendo le caviglie"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "踝关节充分伸展，尽可能将脚后跟向上抬到最高处。"
     }
    }
   }
  },
  "LmaFNZS.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then slowly lower your heels back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba y baja los talones despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi abbassa lentamente i talloni fino alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在最高点顶峰收缩片刻，随后缓慢下放脚后跟返回起始拉伸位。"
     }
    }
   }
  },
  "LmaFNZS.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Repite las repeticiones que quieras."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Ripeti per il numero di ripetizioni voluto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "按照预定次数重复完成动作。"
     }
    }
   }
  },
  "ykUOVze.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Lever Standing Calf Raise"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Elevación de gemelos de pie en máquina"
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Calf in piedi alla macchina"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "器械站姿提踵"
     }
    }
   }
  },
  "ykUOVze.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Adjust the machine to your height and stand with your feet shoulder-width apart."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ajusta la máquina a tu altura y ponte con los pies a la anchura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Regola la macchina alla tua altezza e mettiti in piedi con i piedi alla larghezza delle spalle"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "根据自身身高调节器械肩垫高度，双脚与肩同宽站立。"
     }
