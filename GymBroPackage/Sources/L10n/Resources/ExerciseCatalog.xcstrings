      "state": "translated",
      "value": "Rest a weight plate on your chest or wear a weighted vest."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Apoya un disco sobre el pecho o ponte un chaleco lastrado."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appoggia un disco sul petto oppure indossa un giubbotto zavorrato."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在胸前放一片杠铃片，或者穿上负重背心。"
     }
    }
   }
  },
