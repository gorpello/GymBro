   }
  },
  "ykUOVze.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Place your shoulders under the pads and hold onto the handles for stability."
     }
    },
    "es": {
