     }
    }
   }
  },
  "3eGE2JC.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Stand with your feet shoulder-width apart, holding a dumbbell in each hand with your palms facing your thighs."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de pie con los pies a la anchura de los hombros y una mancuerna en cada mano, con las palmas mirando a los muslos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Mettiti in piedi con i piedi alla larghezza delle spalle tenendo un manubrio in ogni mano con i palmi rivolti verso le cosce."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双脚与肩同宽站立，双手各持一只哑铃，掌心朝向大腿前侧。"
     }
    }
   }
  },
  "3eGE2JC.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keeping your arms straight, exhale and lift the dumbbells in front of you until they are at shoulder level."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Con los brazos estirados, suelta el aire y sube las mancuernas por delante hasta la altura de los hombros."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Con le braccia tese, espira e solleva i manubri davanti a te fino ad altezza spalle."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "手臂保持伸展微屈，呼气并将哑铃从身前举起至与肩同高。"
     }
    }
   }
  },
  "3eGE2JC.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Pause for a moment at the top, then inhale and slowly lower the dumbbells back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aguanta un momento arriba, coge aire y baja las mancuernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Fai una pausa in alto, poi inspira e abbassa lentamente i manubri fino alla posizione iniziale."
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "在动作顶点稍作停顿，随后吸气并缓慢将哑铃下放回起始位置。"
     }
    }
   }
  },
  "3eGE2JC.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Repeat for the desired number of repetitions."
     }
    },
    "es": {
     "stringUnit": {
