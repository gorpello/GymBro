  "banded-nordic-curl.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Keep your hips straight and your glutes squeezed throughout."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Mantén la cadera estirada y los glúteos apretados todo el rato."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni l'anca distesa e i glutei contratti per tutto il movimento."
     }
    },
    "zh": {
