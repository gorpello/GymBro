  "dumbbell-preacher-curl.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold a dumbbell in each hand with your palms facing up."
     }
    },
    "es": {
     "stringUnit": {
