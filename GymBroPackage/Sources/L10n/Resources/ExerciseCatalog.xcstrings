  "half-kneeling-pallof-press.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Kneel on one knee side-on to a cable set at chest height."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Ponte de rodillas sobre una pierna, de lado a la polea a la altura del pecho."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Inginocchiati su un ginocchio di lato rispetto a un cavo impostato all'altezza del petto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "侧对胸部高度的绳索滑轮呈单膝跪地姿势。"
     }
    }
   }
  },
  "half-kneeling-pallof-press.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hold the handle with both hands at your sternum."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sujeta el agarre con las dos manos a la altura del esternón."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Tieni la maniglia con entrambe le mani allo sterno"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双手在胸骨正中合握把手。"
     }
    }
   }
  },
  "half-kneeling-pallof-press.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Squeeze the glute of the kneeling leg and stay tall."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el glúteo de la pierna apoyada y mantente erguido."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Stringi il gluteo della gamba in ginocchio e resta alto con il busto"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧跪地一侧的臀部，保持躯干直立挺拔。"
     }
    }
   }
  },
  "half-kneeling-pallof-press.step.3": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Press the handle straight out and resist the pull to the side."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Estira los brazos hacia delante aguantando el tirón lateral."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Spingi la maniglia dritta in fuori resistendo alla trazione laterale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将把手向前径直推出，全力对抗绳索的侧向拉力。"
     }
    }
   }
  },
  "half-kneeling-pallof-press.step.4": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Return the handle to your chest without letting your hips turn."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Devuelve el agarre al pecho sin dejar que la cadera gire."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Riporta la maniglia al petto senza far ruotare i fianchi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "将把手平稳收回胸前，全程骨盆保持朝前不转动。"
     }
    }
   }
  },
  "cable-pallof-hold.name": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Cable Pallof Hold"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Isométrico Pallof en polea"
     }
    },
    "it": {
