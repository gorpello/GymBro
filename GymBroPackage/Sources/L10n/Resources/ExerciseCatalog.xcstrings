  "uWpxD4v.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Hang from a pull-up bar with your arms fully extended and your knees bent at a 90-degree angle."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cuélgate de la barra con los brazos estirados del todo y las rodillas a 90 grados."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Appenditi a una sbarra per trazioni con le braccia completamente tese e le ginocchia piegate a 90 gradi"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "双臂悬挂在单杠（或使用悬吊带）上，手臂完全伸直，膝盖弯曲呈90度。"
     }
    }
   }
  },
  "uWpxD4v.step.1": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Engage your core and lift your knees towards your chest, bringing them as close to your elbows as possible."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aprieta el core y sube las rodillas hacia el pecho, acercándolas todo lo posible a los codos."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Attiva il core e solleva le ginocchia verso il petto, portandole il più vicino possibile ai gomiti"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "收紧核心肌群，将双膝向胸口方向卷起，尽量靠近手肘位置。"
     }
    }
   }
  },
  "uWpxD4v.step.2": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Slowly lower your legs back down to the starting position."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Baja las piernas despacio a la posición inicial."
     }
    },
    "it": {
     "stringUnit": {
      "state": "translated",
      "value": "Abbassa lentamente le gambe per tornare alla posizione iniziale"
     }
    },
    "zh": {
     "stringUnit": {
      "state": "translated",
      "value": "核心受力控制，缓慢将双腿下放回起始悬垂位置。"
     }
