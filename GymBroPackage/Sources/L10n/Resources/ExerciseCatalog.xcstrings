  "dumbbell-preacher-curl.step.0": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Set the preacher bench so your armpits rest on top of the pad."
     }
    },
    "es": {
